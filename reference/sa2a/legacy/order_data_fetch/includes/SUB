*&      Form  MODIFY_SCREEN
*&---------------------------------------------------------------------*
FORM modify_screen .
  LOOP AT SCREEN.
    IF screen-group1 = 'OLD'.
      IF pa_old IS INITIAL.
        screen-input = '0'.
      ELSE.
        screen-input = '1'.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.
    IF screen-group1 = 'NEW'.
      IF pa_new IS INITIAL.
        screen-input = '0'.
      ELSE.
        screen-input = '1'.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.
    IF screen-name = 'P_CHKARC'.
      "Checkbox für Prüfung auf Archivdaten vorhanden; Berechtigung eingeschränkt
      IF  gv_auth_check_arch = abap_true.
        screen-input = 1.  "eingebbar
      ELSE.
        screen-input = '0'.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.

    "Referenzdatum für Berechnungen
    IF screen-name = 'P_REFDAT'.
      "Bei Nachtlauf auch Mitternacht starten - deshalb per Varianten Tagesdatum + 1
      IF  gv_auth_check_arch = abap_true.
        screen-input = 1.  "eingebbar
      ELSE.
        screen-input = '0'.
      ENDIF.
      MODIFY SCREEN.
    ENDIF.

  ENDLOOP.

ENDFORM.                    " MODIFY_SCREEN
