*&---------------------------------------------------------------------*
FORM build_calculated_fields.

  DATA: lv_basisdatum     TYPE sydatum,
        lv_datefrom       TYPE sydatum,
        lv_dateto         TYPE sydatum,
        lv_fdatefrom      LIKE scal-facdate,
        lv_fdateto        LIKE scal-facdate,
        lv_fksaa          TYPE vbup-fksaa,

        lv_akz            TYPE /cellag/akz,                "HB110318 verwenden für Repdau-Berechnung
        lv_akz_is_old     TYPE abap_bool,

        lv_offset_1day    TYPE int4,                        "HB130717
        lv_repdauer       TYPE /cellag/repdauer,            "HB130717

        ls_vbkd           TYPE tys_vbkd,                    "HB140718

        lo_err_arithmetic TYPE REF TO cx_sy_arithmetic_overflow.     "Arithmetic overflow


* begin -fhu130308
*  RANGES: lr_kunnr FOR /cellag/repdau-kunnr,
*          lr_bautl FOR /cellag/repdau-bautl,
*          lr_akz FOR /cellag/repdau-/cellag/akz,
*          lr_kvgr1 FOR /cellag/repdau-kvgr1,
*          lr_matkl FOR /cellag/repdau-matkl.
* end   -fhu130308

  "wieder rein neutral
  RANGES: lr_kunnr FOR kna1-kunnr,
          lr_bautl FOR qmfe-bautl,
*          lr_akz FOR /cellag/repdau-/cellag/akz,
          lr_kvgr1 FOR vbak-kvgr1,
          lr_matkl FOR mara-matkl.

* begin +fhu130308
  RANGES: lr_wktnr FOR vbap-wktnr,
          lr_wktps FOR vbap-wktps,
          lr_akz   FOR /cellag/repdau-/cellag/akz,
*          lr_kunwe FOR /cellag/repdau-kunwe.
          lr_kunwe FOR vbrk-kunwe.                 "gleicher Typ

  DATA:   ls_vbap  LIKE gt_vbap.
* end   +fhu130308


  DATA: lv_cutofft  TYPE syuzeit,
        lv_lpges    TYPE i,
        lv_lpoffen  TYPE i,
        lv_erledigt TYPE abap_bool,
        lv_skz_sav  TYPE /cellag/skz.


  FIELD-SYMBOLS:
    <ls_zordview_cust1>   TYPE zordview_cust1,
    <ls_zordview_cutofft> TYPE zordview_cutofft,
*    <ls_zordview_clos_ex> TYPE zordview_clos_ex,            "HB010518
    <ls_afvc>             TYPE tys_afvc,
    <ls_afru>             TYPE tys_afru,
    <ls_liefpos>          TYPE tys_liefpos.

  "-------------------------------------------------------------
  " Closed über Ausnahmetabelle ZORDVIEW_CLOS_EX  HB010518
  "  -> verlagert ans Ende
  "-------------------------------------------------------------
*  IF gt_orderview-closed_exception IS INITIAL.
*    READ TABLE gt_zordview_clos_ex ASSIGNING <ls_zordview_clos_ex> WITH TABLE KEY qmnum = gt_orderview-qmnum
*                                                                                  fenum = gt_orderview-fenum.
*    IF sy-subrc = 0.
*      "Erstmalig eingtragen
*      gt_orderview-closed_exception = abap_true.
*      gt_orderview-dateclosed = p_refdat.   "sy-datum.
*      gt_orderview-orderstatecompl = c_closed.
*    ENDIF.
*  ENDIF.

  "-------------------------------------------------------------
  " Prüfungen nach Auftragstyp
  "-------------------------------------------------------------

  CASE gt_orderview-otgrp.
    WHEN 'ZRS4S'.  "Same 4 Same

      IF NOT gt_orderview-readytoship IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        gt_orderview-dateclosed = gt_orderview-readytoship.
      ENDIF.

      IF NOT gt_orderview-deliverdate IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        IF gt_orderview-dateclosed  IS INITIAL.
          gt_orderview-dateclosed = gt_orderview-deliverdate.
        ENDIF.
      ENDIF.

      CLEAR gt_qmur.
      READ TABLE gt_qmur WITH KEY qmnum = gt_orderview_add-qmnum_z2
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        IF gt_orderview-dateclosed IS INITIAL.
          gt_orderview-dateclosed = gt_qmur-aedat.
        ENDIF.
        IF gt_orderview-dateclosed IS INITIAL.
          gt_orderview-dateclosed = gt_qmur-erdat.
        ENDIF.
      ENDIF.

    WHEN 'ZRL4L' OR 'ZRADR' OR  "Like 4 Like / ADR  Tauschvorgänge
         'ZRREF' OR                                         "HB270416
         'ZRREFRS' OR                                       "HB200517
         'ZSWUPDAT'.                                        "MK280817
      "--------------------------------------------------------------
      " Lieferpositionen betrachten: Bedingung für erledigt ermitteln
      "--------------------------------------------------------------
      CLEAR: lv_lpges, lv_lpoffen, lv_erledigt.
      LOOP AT gt_liefpos ASSIGNING <ls_liefpos> WHERE vbeln = gt_orderview-vbeln
                                                  AND uepos = gt_orderview-posnr.
        ADD 1 TO lv_lpges.
        IF <ls_liefpos>-abgru IS INITIAL.
          ADD 1 TO lv_lpoffen.
        ENDIF.
      ENDLOOP.
      "Bedingung für erledigt: mindestens eine Lieferposition existiert und keine
      "nicht abgesagte Lieferpositionen existieren
      IF NOT lv_lpges IS INITIAL AND lv_lpoffen IS INITIAL.
        lv_erledigt = abap_true.
      ENDIF.

      "--------------------------------------------------------------
      " 3 Konstellationen für Tauschpositionen zu CLOSED
      "--------------------------------------------------------------

      IF ( NOT gt_orderview-deliverdate IS INITIAL OR
           lv_erledigt = abap_true )
        AND NOT gt_orderview-einlagerdate IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        gt_orderview-dateclosed = gt_orderview-einlagerdate.
      ENDIF.
      IF ( NOT gt_orderview-deliverdate IS INITIAL OR
           lv_erledigt = abap_true )
        AND ( gt_qmfe-oteil = 'MM' OR gt_qmfe-oteil = 'MO' ).
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        gt_orderview-dateclosed = gt_qmfe-aedat.
      ENDIF.

      "Closed bei Tauschvorgängen - auch wenn Retourenpos abgesagt  HB121213
      IF ( NOT gt_orderview-deliverdate IS INITIAL OR
           lv_erledigt = abap_true )
         AND NOT gt_orderview-abgru_ret IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        IF gt_orderview-deliverdate > gt_orderview-abgru_aedat.
          gt_orderview-dateclosed = gt_orderview-deliverdate.
        ELSE.
          gt_orderview-dateclosed = gt_orderview-abgru_aedat.
        ENDIF.
      ENDIF.

    WHEN 'ZFL' OR   "reiner Vorwärtslogistikprozess
         'ZMTO' OR                                          "HB160621
         'ZRET' OR                                          "HB100325
         'ZTRANS'.                                          "HB100325
      IF NOT gt_orderview-deliverdate IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        IF gt_orderview-dateclosed  IS INITIAL.
          gt_orderview-dateclosed = gt_orderview-deliverdate.
        ENDIF.
      ENDIF.

    WHEN 'ZIL'.  "reiner Rückwärtslogistikprozess
      IF NOT gt_orderview-receivedate IS INITIAL.
        IF gt_orderview-orderstatecompl <> c_deleted.
          gt_orderview-orderstatecompl = c_closed.
        ENDIF.
        IF gt_orderview-dateclosed  IS INITIAL.
