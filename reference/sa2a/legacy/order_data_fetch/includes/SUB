FORM get_lfa1_data.

  DATA: lt_lifnr_par LIKE gt_lifnr OCCURS 0 WITH HEADER LINE.
  CLEAR gt_lfa1. REFRESH gt_lfa1.

  IF NOT gt_lifnr[] IS INITIAL.
    DO.
      build_table gt_lifnr lt_lifnr_par.

      SELECT lifnr name1 FROM lfa1
      APPENDING TABLE gt_lfa1
      FOR ALL ENTRIES IN lt_lifnr_par
      WHERE lifnr = lt_lifnr_par-lifnr.
    ENDDO.
  ENDIF.

  SORT gt_lfa1 BY lifnr.

  syst-tfill = lines( gt_lfa1 ).
  PERFORM prot_line USING syst-tfill 'BUILD lfa1_data                               :'.

