*&      Form  BUILD_REMARKS_DATA
*&---------------------------------------------------------------------*
FORM build_remarks_data .
  DATA: BEGIN OF lt_termin OCCURS 0,
          aedat     LIKE qmma-aedat,
          aezeit    LIKE qmma-aezeit,
          qmanum    LIKE qmma-qmnum,
          value(20),
        END OF lt_termin.

  DATA: lt_tlines TYPE STANDARD TABLE OF tline,
        ls_tlines TYPE tline.

  DATA: lv_index_qmma   TYPE sytabix,
        lv_index_termin TYPE sytabix,
        lv_datum        TYPE sydatum,
        lv_week         LIKE scal-week,
        lv_string       TYPE string,
        lv_name         LIKE thead-tdname.

  gt_orderview-flag_qmferm = c_true.
  gt_orderview_add-qmnum_z2 = gt_qmfe_rm-qmnum.

  IF NOT gt_qmfe_rm-kzloesch IS INITIAL.
    EXIT.
  ENDIF.

  CLEAR gt_jest_rm.
  READ TABLE gt_jest_rm WITH KEY objnr = gt_qmfe_rm-objnr
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    EXIT.
  ENDIF.

  gt_orderview-fcode = gt_qmfe_rm-fegrp.
  gt_orderview-flage = gt_qmfe_rm-oteil.

  "------------------------------------------------------------------------------------------
  " Aus Kopftext zur Meldung Feld errortext belegen
  "------------------------------------------------------------------------------------------
  CLEAR lv_name.
  CLEAR lt_tlines. REFRESH lt_tlines.
  MOVE gt_qmfe_rm-qmnum TO lv_name.
  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      id                      = 'LTXT'
*     language                = sy-langu
      language                = gt_qmfe_rm-kzmla  "1403-605 in der hinterlegten Sprache lesen
      name                    = lv_name
      object                  = 'QMEL'
    TABLES
      lines                   = lt_tlines
    EXCEPTIONS
      id                      = 1
      language                = 2
      name                    = 3
      not_found               = 4
      object                  = 5
      reference_check         = 6
      wrong_access_to_archive = 7
      OTHERS                  = 8.
  IF sy-subrc = 0.
    CLEAR ls_tlines.
    LOOP AT lt_tlines INTO ls_tlines.
      REPLACE '*' IN  ls_tlines-tdline WITH ' '.
      CONDENSE ls_tlines-tdline.
      IF sy-tabix > 1.
        CONCATENATE gt_orderview-errortext ';' ls_tlines-tdline INTO gt_orderview-errortext.
      ELSE.
        gt_orderview-errortext = ls_tlines-tdline.
      ENDIF.
    ENDLOOP.
  ENDIF.

  CLEAR gt_tq80.
  READ TABLE gt_tq80 WITH KEY qmart = 'Z2'.

  CLEAR gt_qpct.
  READ TABLE gt_qpct WITH KEY katalogart = gt_tq80-otkat   "katalogart = '5'
                              codegruppe = gt_qmfe_rm-otgrp
                              code = gt_qmfe_rm-oteil
  BINARY SEARCH.
  gt_orderview-flagetxt = gt_qpct-kurztext.

  CLEAR gt_qpgt.
  READ TABLE gt_qpgt WITH KEY katalogart = gt_tq80-fekat   "katalogart = 'Z'
                              codegruppe = gt_qmfe_rm-fegrp
  BINARY SEARCH.
  gt_orderview-fcodetext = gt_qpgt-kurztext.

  gt_orderview-fart = gt_qmfe_rm-fecod.

  CLEAR gt_qpct.
  READ TABLE gt_qpct WITH KEY katalogart = gt_tq80-fekat   "katalogart = 'Z'
                              codegruppe = gt_qmfe_rm-fegrp
                              code = gt_qmfe_rm-fecod
  BINARY SEARCH.
  gt_orderview-farttext = gt_qpct-kurztext.
  gt_orderview-fehler1 = gt_qmfe_rm-besz.

  SORT gt_qmma BY qmnum ASCENDING aedat DESCENDING aezeit DESCENDING qmanum ASCENDING.

  CLEAR gt_qmma.
  READ TABLE gt_qmma WITH KEY qmnum = gt_qmfe_rm-qmnum
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    lv_datum = p_refdat - 7.  "sy-datu
    gt_orderview_add-aedat = gt_qmma-aedat.
    gt_orderview_add-aeuhr = gt_qmma-aezeit.
    gt_orderview_add-aenam = gt_qmma-aenam.

    IF gt_qmma-aedat GE lv_datum.
      gt_orderview_add-changes = c_true.
    ENDIF.
  ENDIF.

  CLEAR lt_termin. REFRESH lt_termin.

  CLEAR lv_index_termin.
  CLEAR gt_qmma.
  READ TABLE gt_qmma WITH KEY qmnum = gt_qmfe_rm-qmnum
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    lv_index_qmma = sy-tabix.
    LOOP AT gt_qmma FROM lv_index_qmma.
      IF gt_qmma-qmnum <> gt_qmfe_rm-qmnum.
        EXIT.
      ENDIF.
      IF gt_qmma-mngrp ='ZRGSIDT'.  "aktuell bestätigter Liefertermin
        lv_index_termin = lv_index_termin + 1.
        IF lv_index_termin LE 5.
          lt_termin-aedat = gt_qmma-aedat.
          lt_termin-aezeit = gt_qmma-aezeit.
          lt_termin-qmanum = gt_qmma-qmanum.
          CASE gt_qmma-mncod.
            WHEN '00'.
              lt_termin-value = gt_qmma-peter.
            WHEN '99'.
              lt_termin-value = 'MISSING'.
          ENDCASE.
          COLLECT lt_termin.
          CLEAR lt_termin.
        ENDIF.
        IF lv_index_termin = 1.
          CASE gt_qmma-mncod.
            WHEN '00'.
              gt_orderview_add-actualcommitdate = gt_qmma-peter.
              CLEAR lv_week.
              CALL FUNCTION 'GET_WEEK_INFO_BASED_ON_DATE' "#EC CI_USAGE_OK[2296016] "INS S4CONV ECC - HPC(2508-614)
                EXPORTING
                  date = gt_orderview_add-actualcommitdate
                IMPORTING
                  week = lv_week.
              CONCATENATE 'CW' lv_week+4(2) INTO gt_orderview_add-deliverplan
              SEPARATED BY space.
              CONCATENATE gt_orderview_add-deliverplan ',' lv_week(4) INTO gt_orderview_add-deliverplan.
            WHEN '99'.
              gt_orderview_add-actualcommitdate = '20201010'.
              gt_orderview_add-deliverplan = 'MISSING'.
          ENDCASE.
          gt_orderview_add-lastcommitdate = gt_qmma-aedat.

        ELSEIF lv_index_termin = 2.
          CASE gt_qmma-mncod.
            WHEN '00'.
              gt_orderview_add-recommitedhist = gt_qmma-peter.
            WHEN '99'.
              gt_orderview_add-recommitedhist = '20201010'.
          ENDCASE.
        ENDIF.
      ELSE.
        PERFORM fill_remarks_data USING gt_qmma.
      ENDIF.
    ENDLOOP.
  ENDIF.

  CLEAR lt_termin.
  SORT lt_termin BY aedat aezeit qmanum.

  CLEAR lt_termin.
  LOOP AT lt_termin.
    IF lt_termin-value = 'MISSING'.
      IF gt_orderview_add-deliverplanhist IS INITIAL.
        gt_orderview_add-deliverplanhist = lt_termin-value.
      ELSE.
        CONCATENATE gt_orderview_add-deliverplanhist ';' lt_termin-value
        INTO gt_orderview_add-deliverplanhist.
      ENDIF.
    ELSE.
      CLEAR lv_datum.
      MOVE lt_termin-value TO lv_datum.
      CLEAR: lv_string,
             lv_week.
      CALL FUNCTION 'GET_WEEK_INFO_BASED_ON_DATE' "#EC CI_USAGE_OK[2296016] "INS S4CONV ECC - HPC(2508-614)
        EXPORTING
          date = lv_datum
        IMPORTING
          week = lv_week.
      CONCATENATE 'CW' lv_week+4(2) INTO lv_string
      SEPARATED BY space.
      CONCATENATE lv_string ',' lv_week(4) INTO lv_string.
      IF gt_orderview_add-deliverplanhist IS INITIAL.
        gt_orderview_add-deliverplanhist = lv_string.
      ELSE.
        CONCATENATE gt_orderview_add-deliverplanhist ';' lv_string
        INTO gt_orderview_add-deliverplanhist.
      ENDIF.
    ENDIF.
  ENDLOOP.

  "GSI-Remarks mit Maßnahmennr 9999
  "greift nicht mehr mit neuer Logik ab 11/2023
*  PERFORM build_gsi_remarks TABLES gt_qmma.
ENDFORM.                    " BUILD_REMARKS_DATA
*&---------------------------------------------------------------------*
*&      Form  FILL_REMARKS_DATA
*&---------------------------------------------------------------------*
FORM fill_remarks_data USING if_qmma STRUCTURE gt_qmma.

  DATA:
    ls_qmma_rem TYPE tys_qmma_rem,
    lv_fill_rem TYPE abap_bool.

  "Erweiterung Sammeln remarks Z2 für späteres Zusammenmischen
  "lediglich für die Kommentar-Mngrps
  lv_fill_rem = abap_false.
  CLEAR: ls_qmma_rem.


  CASE gt_qmma-mngrp.
    WHEN 'ZRRS01'.   "Repairshop
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarksrs IS INITIAL.
        gt_orderview_add-remarksrs = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarksrs '/' if_qmma-line
        INTO gt_orderview_add-remarksrs.
      ENDIF.
      IF gt_orderview_add-timestamprs IS INITIAL.
        gt_orderview_add-timestamprs = if_qmma-aedat.
      ENDIF.

    WHEN 'ZROC01'.   "Order control
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarksoc IS INITIAL.
        gt_orderview_add-remarksoc = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarksoc '/' if_qmma-line
        INTO gt_orderview_add-remarksoc.
      ENDIF.
      IF gt_orderview_add-timestampoc IS INITIAL.
        gt_orderview_add-timestampoc = if_qmma-aedat.
      ENDIF.

    WHEN 'ZRVM01'.   "Vendor Management
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarksvm IS INITIAL.
        gt_orderview_add-remarksvm = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarksvm '/' if_qmma-line
        INTO gt_orderview_add-remarksvm.
      ENDIF.
      IF gt_orderview_add-timestampvm IS INITIAL.
        gt_orderview_add-timestampvm = if_qmma-aedat.
      ENDIF.

    WHEN 'ZRSP01'.   "SpareParsManagement
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarksspm IS INITIAL.
        gt_orderview_add-remarksspm = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarksspm '/' if_qmma-line
        INTO gt_orderview_add-remarksspm.
      ENDIF.
      IF gt_orderview_add-timestampspm IS INITIAL.
        gt_orderview_add-timestampspm = if_qmma-aedat.
      ENDIF.

    WHEN 'ZRPU01'.   "Purschasing
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarkspur IS INITIAL.
        gt_orderview_add-remarkspur = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarkspur '/' if_qmma-line
        INTO gt_orderview_add-remarkspur.
      ENDIF.
      IF gt_orderview_add-timestamppur IS INITIAL.
        gt_orderview_add-timestamppur = if_qmma-aedat.
      ENDIF.

    WHEN 'ZRLO01'.   "Logistik
      lv_fill_rem = abap_true.
      IF gt_orderview_add-remarkslog IS INITIAL.
        gt_orderview_add-remarkslog = if_qmma-line.
      ELSE.
        CONCATENATE gt_orderview_add-remarkslog '/' if_qmma-line
        INTO gt_orderview_add-remarkslog.
      ENDIF.
      IF gt_orderview_add-timestamplog IS INITIAL.
        gt_orderview_add-timestamplog = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRGSIST'.  "GSI-Status
      IF gt_orderview_add-status IS INITIAL.
        gt_orderview_add-status = if_qmma-mncod.
      ENDIF.
  ENDCASE.

  "falls Kommentar relevant, dann in Tabelle merken
  "Kurztext und Langtext separat in 2 Einträgen wegen unterschiedl. Zeitstempe
  IF lv_fill_rem = abap_true.
    "unschön und unsicher...
    ls_qmma_rem-qmnum = gt_orderview-qmnum.
    ls_qmma_rem-fenum = gt_orderview-fenum.

    ls_qmma_rem-manum  = if_qmma-manum.
    ls_qmma_rem-mngrp  = if_qmma-mngrp.
    ls_qmma_rem-aedat  = if_qmma-aedat.
    ls_qmma_rem-aenam  = if_qmma-aenam.
    ls_qmma_rem-aezeit = if_qmma-aezeit.
    IF if_qmma-matxt IS NOT INITIAL.
      ls_qmma_rem-line = if_qmma-matxt.
      APPEND ls_qmma_rem TO gt_qmma_rem_z2.
    ENDIF.

    "Langtext vorhanden? Dann nochmals eine Zeile
    IF if_qmma-line IS NOT INITIAL.
      ls_qmma_rem-line   = if_qmma-line.
      ls_qmma_rem-aenam  = if_qmma-tdluser .
      ls_qmma_rem-aedat  = if_qmma-tdldate.
      ls_qmma_rem-aezeit = if_qmma-tdltime.
      APPEND ls_qmma_rem TO gt_qmma_rem_z2.
    ENDIF.
  ENDIF.
ENDFORM.                    " FILL_REMARKS_DATA
