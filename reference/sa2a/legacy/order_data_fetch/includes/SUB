*&---------------------------------------------------------------------*
*&      Form  UPDATE_GSI_STATUS
*&---------------------------------------------------------------------*
FORM update_gsi_status.

  DATA: BEGIN OF lt_ord_add_new OCCURS 0,
          qmnum_z2 LIKE /cellag/ord_add-qmnum_z2,
          aufnr    LIKE aufk-aufnr,
          aedat    LIKE /cellag/ord_add-aedat,
          aeuhr    LIKE /cellag/ord_add-aeuhr,
          aenam    LIKE /cellag/ord_add-aenam,
          changes  LIKE /cellag/ord_add-changes,
          status   LIKE /cellag/ord_add-status,
        END OF lt_ord_add_new.

  DATA: ls_objk_aufnr LIKE gt_objk_aufnr.

  DATA: lv_index           TYPE syindex,
        lv_index_mod       TYPE syindex,
        lv_index_objk      TYPE syindex,
        lv_lines_objk      TYPE syindex,
        lv_subrc           TYPE sysubrc,
        lv_rest            TYPE bdmng,

        lv_count_gsi_5m    TYPE i,
        lv_count_gsi_1     TYPE i,
        lv_count_gsi_1_chg TYPE i,
        lv_count_gsi_5e    TYPE i,
        lv_count_gsi_other TYPE i,
        lv_count_create_z2 TYPE i,
        lv_gsi_1_or_5e     TYPE abap_bool,
        lv_gsi_other       TYPE abap_bool,
        lv_matxt           TYPE mftext,

        ls_qmma            TYPE qmma,
        lv_changed         TYPE abap_bool,
        lv_aedat           TYPE aedat,
        lv_aeuhr           TYPE aeuhr,
        lv_aenam           TYPE aenam.

  DATA:
    lt_resb  TYPE STANDARD TABLE OF resb,
    ls_nomat TYPE tys_nomat.                                "HB230224

  FIELD-SYMBOLS:
    <ls_resb> TYPE resb.

  CLEAR        gt_t024. REFRESH gt_t024.
  SELECT ekgrp eknam FROM t024 INTO TABLE gt_t024.
  SORT gt_t024 BY ekgrp.

  SORT gt_qmma_gsi BY qmnum ASCENDING manum DESCENDING.
  SORT gt_qmma BY qmnum mngrp mncod.


  syst-tfill = lines( gt_qmma_gsi ).
  PERFORM prot_line USING syst-tfill 'Start Update GSI-Status. Anzahl gt_qmma_gsi   :'.

  CLEAR gt_tj02t.
  READ TABLE gt_tj02t WITH KEY txt04 = 'TABG'
    BINARY SEARCH.

  CLEAR lt_ord_add_new. REFRESH lt_ord_add_new.

  CLEAR gt_orderview.
  LOOP AT gt_orderview.                              "#EC CI_SEL_NESTED

    CLEAR lv_subrc.

    CHECK gt_orderview-orderstatecompl <> c_closed.

    CHECK NOT gt_orderview-fanumber IS INITIAL.

    CLEAR gt_afko.
    READ TABLE gt_afko WITH KEY aufnr = gt_orderview-fanumber
    BINARY SEARCH.
    CHECK gt_afko-gamng EQ 1.  "Gesamte Auftragsmenge

    CLEAR gt_orderview_add.
    READ TABLE gt_orderview_add WITH KEY qmnum = gt_orderview-qmnum
                                         fenum = gt_orderview-fenum
                                         counter = gt_orderview-counter
    BINARY SEARCH.

    IF sy-subrc EQ 0.
      "-------------------------------------------------------------------
      " Es gibt in Eintrag in ORRDERVIEW_ADD
      "-------------------------------------------------------------------
      lv_index_mod = sy-tabix.
      CLEAR lt_ord_add_new.
      READ TABLE lt_ord_add_new WITH KEY qmnum_z2 = gt_orderview_add-qmnum_z2.
      IF sy-subrc EQ 0.
        gt_orderview_add-aedat = lt_ord_add_new-aedat.
        gt_orderview_add-aeuhr = lt_ord_add_new-aeuhr.
        gt_orderview_add-aenam = lt_ord_add_new-aenam.
        gt_orderview_add-changes = lt_ord_add_new-changes.
        gt_orderview_add-status = lt_ord_add_new-status.
        MODIFY gt_orderview_add INDEX lv_index_mod.
        CONTINUE.
      ENDIF.

      "---------------------------------------------------------------
      " Prüfen ob GSI-Status 1, 5E oder sonstiger GSi-Status vorhanden
      "---------------------------------------------------------------
      CLEAR: gt_qmma, lv_gsi_1_or_5e, lv_gsi_other.
      READ TABLE gt_qmma WITH KEY qmnum = gt_orderview_add-qmnum_z2
                                  mngrp = 'ZRGSIST'
                                  mncod = '1'   "Component
      BINARY SEARCH.
      IF sy-subrc = 0.
        "letzte Maßnahmennummer bestimmen; Maßnahmen sind nach QMNUm und AEDAT sortiert.
        ADD 1 TO lv_count_gsi_1.
        lv_gsi_1_or_5e = abap_true.
      ELSE.
        CLEAR gt_qmma.
        READ TABLE gt_qmma WITH KEY qmnum = gt_orderview_add-qmnum_z2
                                    mngrp = 'ZRGSIST'
                                    mncod = '5E'  "Component received
        BINARY SEARCH.
        IF sy-subrc = 0.
          ADD 1 TO lv_count_gsi_5e.
          lv_gsi_1_or_5e = abap_true.
        ELSE.
          "irgendein anderer GSI-Status ausser 1 oder 5E
          READ TABLE gt_qmma WITH KEY qmnum = gt_orderview_add-qmnum_z2
                                      mngrp = 'ZRGSIST'.
          IF sy-subrc = 0.
            ADD 1 TO lv_count_gsi_other.
            lv_gsi_other = abap_true.
          ENDIF.
        ENDIF.
      ENDIF.

      "Entweder Status 1 oder 5E oder sonstiger GSI-Status
      IF lv_gsi_1_or_5e = abap_true OR lv_gsi_other = abap_true.
        "------------------------------------------------------
        " GSI-Status vorhanden; offene Reservierungen bestimmen
        "------------------------------------------------------

        CLEAR gt_resb.
        READ TABLE gt_resb WITH KEY aufnr = gt_orderview-fanumber
        BINARY SEARCH.
        IF sy-subrc NE 0.
          lv_subrc = 0.
        ENDIF.
        lv_index = sy-tabix.
        "--------------------------------------------------------------
        " Prüfen auf offene Bedarfe; falls vorhanden, in lokale Tabelle
        "--------------------------------------------------------------
        CLEAR: gt_resb, lt_resb[].
        LOOP AT gt_resb FROM lv_index.
          IF gt_resb-aufnr <> gt_orderview-fanumber.
            EXIT.
          ENDIF.
          "Noch Bedarf vorhanden?
          lv_rest = gt_resb-bdmng - gt_resb-enmng.
          IF lv_rest > 0.
            INSERT INITIAL LINE INTO TABLE lt_resb ASSIGNING <ls_resb>.
            MOVE-CORRESPONDING gt_resb TO <ls_resb>.
          ENDIF.
        ENDLOOP.
        IF lt_resb[] IS INITIAL .
          IF lv_gsi_1_or_5e = abap_true.
            "---------------------------------------------------------------------------
            " nur bei GSIStatus 1 oder 5E
            " Es gibt keine offene Reservierung mehr in RESB
            " Status 5M setzen - Material arrived - item in repair
            "---------------------------------------------------------------------------
            PERFORM create_gsi_status_5m CHANGING lv_subrc.

            IF lv_subrc = 0.
              MODIFY gt_orderview_add INDEX lv_index_mod.
              lt_ord_add_new-qmnum_z2 = gt_orderview_add-qmnum_z2.
              lt_ord_add_new-aufnr = gt_orderview-fanumber.
              lt_ord_add_new-aedat = gt_orderview_add-aedat.
              lt_ord_add_new-aeuhr = gt_orderview_add-aeuhr.
              lt_ord_add_new-aenam = gt_orderview_add-aenam.
              lt_ord_add_new-changes = gt_orderview_add-changes.
              lt_ord_add_new-status = gt_orderview_add-status.
              COLLECT lt_ord_add_new.
              CLEAR lt_ord_add_new.
            ENDIF.
          ENDIF.
        ELSE.
          "---------------------------------------------------------------------------
          " GSI-Status sitzt und  offene Bedarfsmenge da
          "---------------------------------------------------------------------------
          "GSI-Status auf 1 ändern, falls aktueller Status in Cust-Tabelle ZORDVIEW_GSIREPL zugelassen
          MOVE-CORRESPONDING gt_qmma TO ls_qmma.  "In Standardstruktur für Parameterübergabe

          "Änderungen durchführen; Bedingung Cust-Tabelle in Methode geprüft
          CALL METHOD zcl_order_data_fetch=>change_z2_gsi_status
            EXPORTING
              iv_qmnum_z2 = gt_orderview_add-qmnum_z2
              iv_fanum    = gt_orderview-fanumber
              is_qmma     = ls_qmma
              iv_mncod_to = '1'
            IMPORTING
              ev_changed  = lv_changed
              ev_aedat    = lv_aedat
              ev_aeuhr    = lv_aeuhr
              ev_aenam    = lv_aenam.
          IF lv_changed = abap_true.
            gt_orderview_add-aedat = lv_aedat.
            gt_orderview_add-aeuhr = lv_aeuhr.
            gt_orderview_add-aenam = lv_aenam.
            gt_orderview_add-changes = abap_true.
            gt_orderview_add-status = '1'.
            MODIFY gt_orderview_add INDEX lv_index_mod.
            lt_ord_add_new-qmnum_z2 = gt_orderview_add-qmnum_z2.
            lt_ord_add_new-aufnr = gt_orderview-fanumber.
            lt_ord_add_new-aedat = gt_orderview_add-aedat.
            lt_ord_add_new-aeuhr = gt_orderview_add-aeuhr.
            lt_ord_add_new-aenam = gt_orderview_add-aenam.
            lt_ord_add_new-changes = gt_orderview_add-changes.
            lt_ord_add_new-status = gt_orderview_add-status.
            COLLECT lt_ord_add_new.
            CLEAR lt_ord_add_new.

            ADD 1 TO lv_count_gsi_1_chg.
          ENDIF.


          " falls ZRSP01 nicht da, dann anlegen
          "2011-984 Erweiterung Orderview Fetch  Aktionstext ZRSP01
          "Maßnahmen anlegen pro offenem Bedarf
          CLEAR: lv_matxt.
          lv_matxt = zcl_order_data_fetch=>create_z2_mma_zrsp01(
            EXPORTING
              iv_qmnum = gt_orderview_add-qmnum_z2
              iv_werks = gt_orderview-werks
              it_resb  = lt_resb ).
          IF NOT lv_matxt IS INITIAL.                       "HB230224
            "Zwischenspeichern in interner Tabelle; am Ende direkt in ORDER_ADD
            ls_nomat-qmnum = gt_orderview-qmnum.
            ls_nomat-fenum = gt_orderview-fenum.
            ls_nomat-counter = gt_orderview-counter.
            ls_nomat-qmnum_z2 = gt_orderview_add-qmnum_z2.
            ls_nomat-matxt = lv_matxt.
            APPEND ls_nomat TO gt_nomat.
          ENDIF.
        ENDIF.

      ELSE.
        "---------------------------------
        " There is no GSI-Status
        "---------------------------------

        "Es gibt keine Maßnahme 'ZRGSIST'
        CLEAR gt_aufnr_objnr.
        READ TABLE gt_aufnr_objnr WITH KEY aufnr = gt_orderview-fanumber
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        CLEAR gt_jest.
        READ TABLE gt_jest WITH KEY objnr = gt_aufnr_objnr-objnr
                                    stat = gt_tj02t-istat   "TABG
                                    inact = ' '
        BINARY SEARCH.
        CHECK sy-subrc NE 0.

        "Auftrag noch nicht TABG
        CLEAR gt_resb.
        READ TABLE gt_resb WITH KEY aufnr = gt_orderview-fanumber
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        lv_index = sy-tabix.
        CLEAR gt_resb.
        "---------------------------------------------------------
        " Falls offene Reservierung dann GSI-Status 1 anlegen
        "---------------------------------------------------------
        LOOP AT gt_resb FROM lv_index.
          IF gt_resb-aufnr <> gt_orderview-fanumber.
            EXIT.
          ENDIF.
          CLEAR lv_rest.
          lv_rest = gt_resb-bdmng - gt_resb-enmng.
          IF lv_rest > 0.
            "------------------------------------------------
            "  GSI-Maßnahme 1 anlegen
            "------------------------------------------------
            PERFORM create_gsi_status_1 CHANGING lv_subrc.
            IF lv_subrc EQ 0.
              MODIFY gt_orderview_add INDEX lv_index_mod.
              lt_ord_add_new-qmnum_z2 = gt_orderview_add-qmnum_z2.
              lt_ord_add_new-aufnr = gt_orderview-fanumber.
              lt_ord_add_new-aedat = gt_orderview_add-aedat.
              lt_ord_add_new-aeuhr = gt_orderview_add-aeuhr.
              lt_ord_add_new-aenam = gt_orderview_add-aenam.
              lt_ord_add_new-changes = gt_orderview_add-changes.
              lt_ord_add_new-status = gt_orderview_add-status.
              COLLECT lt_ord_add_new.
              CLEAR lt_ord_add_new.
            ENDIF.

            "nur 1x GSI-Status 1 anlegen; raus aus LOOP
            EXIT.
          ENDIF.
        ENDLOOP.

      ENDIF.  "lv_gsi_1_or_5e = abap_true lv_gsi_other = abap_true.

    ELSE.
      "-------------------------------------------------------------------
      " Es gibt keinen Eintrag in ORRDERVIEW_ADD
      "-------------------------------------------------------------------

      CLEAR gt_aufnr_objnr.
      READ TABLE gt_aufnr_objnr WITH KEY aufnr = gt_orderview-fanumber
      BINARY SEARCH.
      CHECK sy-subrc EQ 0.
      CLEAR gt_jest.
      READ TABLE gt_jest WITH KEY objnr = gt_aufnr_objnr-objnr
                                  stat = gt_tj30t-estat  "'TABG'
                                  inact = ' '
      BINARY SEARCH.
      CHECK sy-subrc NE 0.
      CLEAR gt_resb.
      READ TABLE gt_resb WITH KEY aufnr = gt_orderview-fanumber
      BINARY SEARCH.
      CHECK sy-subrc EQ 0.
      lv_index = sy-tabix.
      CLEAR gt_resb.
      LOOP AT gt_resb FROM lv_index.
        IF gt_resb-aufnr <> gt_orderview-fanumber.
          EXIT.
        ENDIF.
        CLEAR lv_rest.
        lv_rest = gt_resb-bdmng - gt_resb-enmng.
        IF lv_rest > 0.
          "------------------------------------------
          " offener Bedarf vorhanden
          "------------------------------------------
          CLEAR gt_afih.
          READ TABLE gt_afih WITH KEY aufnr = gt_orderview-fanumber
          BINARY SEARCH.
          CLEAR ls_objk_aufnr.
          READ TABLE gt_objk_aufnr_gsi INTO ls_objk_aufnr WITH KEY obknr = gt_afih-obknr
          BINARY SEARCH.
          CHECK sy-subrc EQ 0.

          CLEAR lv_lines_objk.
          lv_index_objk = sy-tabix.
          CLEAR gt_objk_aufnr_gsi.
          LOOP AT gt_objk_aufnr_gsi FROM lv_index_objk.
            IF gt_objk_aufnr_gsi-obknr <> gt_afih-obknr.
              EXIT.
            ENDIF.
            lv_lines_objk = lv_lines_objk + 1.
            IF lv_lines_objk GE 2.
              EXIT.
            ENDIF.
          ENDLOOP.

          CHECK lv_lines_objk EQ 1.

          "-----------------------------------------
          " Z2-Meldung mit GSI-Status 1 anlegen
          "-----------------------------------------
          ADD 1 TO lv_count_create_z2.
          PERFORM create_z2_meldung USING ls_objk_aufnr.

          IF NOT gt_orderview_add-qmnum_z2 IS INITIAL.
            APPEND gt_orderview_add.
            CLEAR gt_orderview_add.
            SORT gt_orderview_add BY qmnum fenum counter.
          ENDIF.

          EXIT.
        ENDIF.
      ENDLOOP.

    ENDIF.

  ENDLOOP.

  "Anzahl ausgeben Protokoll
  PERFORM prot_line USING lv_count_gsi_1  'Ende Update GSI-Status. Anzahl GSI 1          :'.
  PERFORM prot_line USING lv_count_gsi_1_chg 'Ende Update GSI-Status. Anzahl GSI auf 1 geänd:'.
  PERFORM prot_line USING lv_count_gsi_5m 'Ende Update GSI-Status. Anzahl GSI 5M         :'.
  PERFORM prot_line USING lv_count_gsi_5e 'Ende Update GSI-Status. Anzahl GSI 5E         :'.
  PERFORM prot_line USING lv_count_create_z2 'Ende Update GSI-Status. Anzahl Create Z2      :'.

ENDFORM.                    " UPDATE_GSI_STATUS
*&---------------------------------------------------------------------*
*&      Form  CREATE_Z2_MELDUNG
*&---------------------------------------------------------------------*
FORM create_z2_meldung USING if_objk STRUCTURE gt_objk_aufnr.

  DATA: ls_viqmel LIKE viqmel,
        ls_riqs5  LIKE riqs5.   "PM/SM/QM-Meldungen: I/O-Daten für Anlegen Meldung

  DATA: ls_caufv LIKE caufv,
        ls_afih  LIKE afih,
        ls_iloa  LIKE iloa,
        ls_objk  LIKE gt_objk_aufnr.


  DATA: ls_notifheader_save LIKE bapi2080_nothdre.
  DATA: lt_notifactv LIKE bapi2080_notactvi OCCURS 0 WITH HEADER LINE,
        lt_return    LIKE bapiret2 OCCURS 0 WITH HEADER LINE.

  DATA: lv_subrc TYPE sysubrc.

  CLEAR: ls_riqs5,
         ls_viqmel.

  CLEAR ls_caufv.
  SELECT SINGLE * FROM caufv INTO ls_caufv WHERE aufnr = gt_orderview-fanumber.

  CLEAR ls_afih.   "Auftragskopf Instandhaltung
  SELECT SINGLE * FROM afih INTO ls_afih WHERE aufnr = gt_orderview-fanumber.

  CLEAR ls_iloa.
  SELECT SINGLE * FROM iloa INTO ls_iloa WHERE iloan = ls_afih-iloan.

  CLEAR ls_objk.
  ls_objk = if_objk.

  CLEAR ls_riqs5.

  "Daten für Z2-Meldung zusammenstellen
  ls_riqs5-deviceid = ls_afih-deviceid.
  ls_riqs5-tplnr    = ls_iloa-tplnr.
  ls_riqs5-bautl    = ls_afih-bautl.
  ls_riqs5-qmtxt    = ls_caufv-ktext.


  IF ls_afih-priok IS INITIAL.
    ls_riqs5-strmn = ls_caufv-gstrp.
    ls_riqs5-ltrmn = ls_caufv-gltrp.
    ls_riqs5-strur = ls_caufv-gsuzp.
    ls_riqs5-ltrur = ls_caufv-gluzp.

  ELSE.
    ls_riqs5-strmn = sy-datlo.
    ls_riqs5-strur = sy-timlo.
  ENDIF.

  ls_riqs5-priok = ls_afih-priok.   "Priorität  T356

  ls_riqs5-arbplwerk = ls_caufv-wawrk.
  ls_riqs5-arbpl = ls_afih-gewrk.
  ls_riqs5-crobjty = ls_afih-pm_objty.
  ls_riqs5-kdauf = ls_caufv-kdauf.
  ls_riqs5-kdpos = ls_caufv-kdpos.
  ls_riqs5-iwerk = ls_afih-iwerk.
  ls_riqs5-ingrp = ls_afih-ingpr.

  ls_riqs5-equnr = if_objk-equnr.
  ls_riqs5-serialnr = if_objk-sernr.
  ls_riqs5-matnr = if_objk-matnr.
  ls_riqs5-bautl = if_objk-bautl.
  ls_riqs5-uii = if_objk-uii.

  CALL FUNCTION 'IQS0_CREATE_NOTIF_TO_ORDER'
    EXPORTING
      i_aufnr                    = gt_orderview-fanumber
      i_qmart                    = 'Z2'
      i_riqs5                    = ls_riqs5
      i_initial                  = c_true
      i_reset                    = c_true
      i_no_msg                   = c_true
    IMPORTING
      e_viqmel                   = ls_viqmel
    EXCEPTIONS
      invalid_entry              = 1
      notification_not_in_buffer = 2
      OTHERS                     = 3.

  CHECK sy-subrc EQ 0.

  CLEAR lt_return. REFRESH lt_return.
  CLEAR ls_notifheader_save.
  CALL FUNCTION 'BAPI_ALM_NOTIF_SAVE'      "#EC CI_USAGE_OK[2438131]     "INS S4CONV ECC - HPC(2508-614)
    EXPORTING
      number      = ls_viqmel-qmnum
    IMPORTING
      notifheader = ls_notifheader_save
    TABLES
      return      = lt_return.

  CLEAR lt_return.
  READ TABLE lt_return WITH KEY type = 'E'.
  CHECK sy-subrc NE 0.

  CLEAR lt_return. REFRESH lt_return.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait   = c_true
    IMPORTING
      return = lt_return.

  CLEAR lt_return.
  READ TABLE lt_return WITH KEY type = 'E'.
  CHECK sy-subrc NE 0.

  CLEAR: ls_objk-equnr,
         ls_objk-bautl,
         ls_objk-iloan,
         ls_objk-sortf,
         ls_objk-bearb,
         ls_objk-sernr,
         ls_objk-matnr.

  ls_objk-ihnum = ls_notifheader_save-notif_no.
  MODIFY objk FROM ls_objk.
  COMMIT WORK AND WAIT.

  IF gt_orderview-sernraufnr <> if_objk-sernr.
    gt_orderview-sernraufnr = if_objk-sernr.
    MODIFY gt_orderview.
  ENDIF.

  CLEAR gt_orderview_add.

  CLEAR lv_subrc.
  gt_orderview_add-qmnum = gt_orderview-qmnum.
  gt_orderview_add-fenum = gt_orderview-fenum.
  gt_orderview_add-counter = gt_orderview-counter.
  gt_orderview_add-qmnum_z2 = ls_notifheader_save-notif_no.

  PERFORM create_gsi_status_1 CHANGING lv_subrc.

ENDFORM.                    " CREATE_Z2_MELDUNG
