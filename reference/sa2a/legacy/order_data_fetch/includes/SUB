FORM build_lips_102 USING if_vbap_ret STRUCTURE gt_vbap
                    CHANGING cf_lif_found.
  DATA: ls_lips LIKE gt_lips_lif.
  DATA: lv_index_del TYPE sytabix.

  CLEAR gt_lips_ret.
  READ TABLE gt_lips_ret WITH KEY vgbel = if_vbap_ret-vbeln
                                  vgpos = if_vbap_ret-posnr
  BINARY SEARCH.
  IF sy-subrc EQ 0.

    lv_index_del = sy-tabix.
    gt_orderview-serialrec = gt_lips_ret-serge.
    gt_orderview-sernrrec = gt_lips_ret-sernr.
    gt_orderview-equipmentnummer = gt_lips_ret-equnr.

    IF gt_orderview-dockdate IS INITIAL.
      gt_orderview-dockdate = gt_lips_ret-bldat.
    ENDIF.
    gt_orderview-receivedate = gt_lips_ret-wadat_ist.

    gt_orderview-retoure = gt_lips_ret-vbeln.
    gt_orderview-retoure_posnr = gt_lips_ret-posnr.

    IF gt_lips_ret-matnr <> gt_orderview-ctdisapmatnummer.
      CLEAR gt_mara.
      READ TABLE gt_mara WITH KEY matnr = gt_lips_ret-matnr
      BINARY SEARCH.
      gt_orderview-partnumberin = gt_mara-mfrpn.
    ELSE.
      gt_orderview-partnumberin = gt_orderview-partnumberalc.
    ENDIF.
    gt_orderview-matnr_in = gt_lips_ret-matnr.              "HB170514

    IF NOT gt_lips_ret-sernr IS INITIAL.
      DELETE gt_lips_ret INDEX lv_index_del.
    ELSE.
      IF gt_lips_ret-lfimg = 1.
        DELETE gt_lips_ret INDEX lv_index_del.
      ELSE.
        ls_lips = gt_lips_ret.
        ls_lips-lfimg = gt_lips_ret-lfimg - 1.
        MODIFY gt_lips_ret FROM ls_lips INDEX lv_index_del TRANSPORTING lfimg.
      ENDIF.
    ENDIF.

    IF gt_orderview-fast_good_parts = abap_true.            "HB251018
      gt_orderview-labelprint = gt_orderview-receivedate.
      gt_orderview-einlagerdate = gt_orderview-receivedate.
    ENDIF.

    cf_lif_found = c_true.
  ENDIF.
ENDFORM.                    " BUILD_LIPS_102
