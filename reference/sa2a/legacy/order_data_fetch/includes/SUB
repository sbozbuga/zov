        AND vbtyp_v = /dsd/if_emse_me_badi=>gc_vbtyp_v_ord.
    SORT lt_vbfa BY vbelv ASCENDING
                    posnv ASCENDING
                    vbeln DESCENDING.
    DELETE ADJACENT DUPLICATES FROM lt_vbfa COMPARING vbelv posnv.
    lt_vbfa_h[] = lt_vbfa[].
    CLEAR lt_vbfa[].

    IF NOT lt_vbfa_h[] IS INITIAL.
      SELECT
        vbeln
        posnr
        uepos
      FROM vbap
      INTO TABLE lt_vbap_uepos
      FOR ALL ENTRIES IN lt_vbfa_h
        WHERE vbeln = lt_vbfa_h-vbelv
          AND posnr = lt_vbfa_h-posnv.

      LOOP AT lt_vbrp ASSIGNING <ls_vbrp> WHERE vbelv = space.
        READ TABLE lt_vbfa_h ASSIGNING <ls_vbfa> WITH TABLE KEY vbeln = <ls_vbrp>-vbeln
                                                                posnn = <ls_vbrp>-posnr.
        IF sy-subrc = 0.
          "Problem Haupt/Unterpos: falls es eine Unterpos ist, dann Nummer Hauptpos eintragen
          READ TABLE lt_vbap_uepos ASSIGNING <ls_vbap_uepos> WITH TABLE KEY vbeln = <ls_vbfa>-vbelv
                                                                            posnr = <ls_vbfa>-posnv.
          IF sy-subrc = 0.
            <ls_vbrp>-vbelv = <ls_vbfa>-vbelv.
            ADD 1 TO lv_count.
            IF <ls_vbap_uepos>-uepos IS INITIAL.
              <ls_vbrp>-posnv = <ls_vbfa>-posnv.
            ELSE.
              <ls_vbrp>-posnv = <ls_vbap_uepos>-uepos.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.

    IF NOT lv_count IS INITIAL.
      PERFORM prot_line USING lv_count 'Rechnungspositionen: Vorgängerbeleg ergänzt   :'.
    ENDIF.
  ENDIF.

  gt_vbrp[] = lt_vbrp[].   "umkopieren in sortierte Tabelle

  CLEAR: lt_vbrp[], lt_vbrp_s[], lt_vbfa_h[].


  IF lr_pstyv_bil[] IS INITIAL.                       "MK211116 Rechnungspositionen
    SELECT valsign valoption valfrom valto FROM setleaf
       INTO TABLE lt_setleaf WHERE setname = 'ZBIL_POSTYP'.
    IF sy-subrc = 0.
      LOOP AT lt_setleaf INTO ls_setleaf.
        lr_pstyv_bil-sign   = ls_setleaf-valsign.
        lr_pstyv_bil-option = ls_setleaf-valoption.
        lr_pstyv_bil-low    = ls_setleaf-valfrom.
        lr_pstyv_bil-high   = ls_setleaf-valto.
        APPEND lr_pstyv_bil.
      ENDLOOP.
    ENDIF.

    CLEAR lr_pstyv_bil.
  ENDIF.

  CLEAR gt_vbap_aux. REFRESH gt_vbap_aux.
  CLEAR gt_vbap_rep. REFRESH gt_vbap_rep.
  CLEAR gt_vbap_lif. REFRESH gt_vbap_lif.
  CLEAR gt_vbap_ret. REFRESH gt_vbap_ret.
  CLEAR gt_vbap_zirl. REFRESH gt_vbap_zirl.
  CLEAR gt_vbap_bil. REFRESH gt_vbap_bil.             "MK211116 Rechnungspositionen
  CLEAR gt_vbap_zirc. REFRESH gt_vbap_zirc.
  CLEAR gt_wktnr. REFRESH gt_wktnr.

  CLEAR gt_vbap.
  SORT gt_vbap BY vbeln posnr.                              "HB251018
  LOOP AT gt_vbap.
    CASE gt_vbap-vkgru.
      WHEN '101'.
        IF gt_vbap-abgru = 'ZG'.                            "HB251018
          "Sonderfall Fast Good Parts 1810-435
          "Retourenpos ist abgesagt; dafür gibt es eine ZREG-Pos, die als Vorgänger für Retoure gilt
          lv_pos_zg = gt_vbap-uepos.
        ELSE.
          CLEAR: lv_pos_zg.
          APPEND gt_vbap TO gt_vbap_ret.
        ENDIF.
      WHEN '102'.
        APPEND gt_vbap TO gt_vbap_rep.
      WHEN '103' OR '106'.
        APPEND gt_vbap TO gt_vbap_lif.
      WHEN space.                                           "HB251018
        IF lv_pos_zg = gt_vbap-uepos AND gt_vbap-pstyv = 'ZREG'.
          APPEND gt_vbap TO gt_vbap_ret.
          CLEAR: lv_pos_zg.
        ENDIF.
    ENDCASE.
    IF gt_vbap-uepos IS INITIAL.
      "Hauptpositionen Posnr 1000
      APPEND gt_vbap TO gt_vbap_aux.
    ENDIF.

    CASE gt_vbap-pstyv.
      WHEN 'ZIRL'.
        MOVE-CORRESPONDING gt_vbap TO gt_vbap_zirl.
        APPEND gt_vbap_zirl.
      WHEN 'ZIRC'.
        MOVE-CORRESPONDING gt_vbap TO gt_vbap_zirc.
        APPEND gt_vbap_zirc.

        gt_matnr-matnr = gt_vbap-matnr.
        COLLECT gt_matnr.
        CLEAR gt_matnr.
    ENDCASE.

    IF lr_pstyv_bil[] IS NOT INITIAL.
      IF gt_vbap-pstyv IN lr_pstyv_bil.                   "MK211116 Rechnungspositionen
        IF gt_vbap-abgru IS INITIAL.                      "HB280720 nur die nicht abgesagten
          "2007-580 Fakturastatus wird nicht angezeigt
          MOVE-CORRESPONDING gt_vbap TO gt_vbap_bil.
          APPEND gt_vbap_bil.
        ENDIF.
      ENDIF.
    ENDIF.

    IF NOT gt_vbap-wktnr IS INITIAL.
      gt_wktnr-wktnr = gt_vbap-wktnr.
      gt_wktnr-wktps = gt_vbap-wktps.
      COLLECT gt_wktnr.
      CLEAR gt_wktnr.
    ENDIF.

    CLEAR: gt_vbap_rep,
           gt_vbap_ret,
           gt_vbap_lif,
           gt_vbap_aux,
           gt_vbap_zirl,
           gt_vbap_zirc,
           gt_vbap_bil.                                 "MK211116 Rechnungspositionen
  ENDLOOP.


  SORT gt_vbap_aux BY qmnum fenum.
  SORT gt_vbap_lif ASCENDING BY vbeln uepos posnr.
  SORT gt_vbap_rep ASCENDING BY vbeln posnr.
  SORT gt_vbap_ret ASCENDING BY vbeln uepos posnr.
  SORT gt_vbap_zirl ASCENDING BY vbeln uepos matnr posnr.
  SORT gt_vbap_zirc ASCENDING BY vbeln uepos matnr posnr.
  SORT gt_vbap_bil ASCENDING BY vbeln uepos posnr."MK211116 Rechnungspositionen

*  CLEAR gt_vbap. REFRESH gt_vbap.

  SORT gt_vbpa BY vbeln posnr parvw.
  SORT gt_lips_aux BY obknr.
  SORT gt_vbfa BY vbelv posnv ASCENDING vbeln DESCENDING.

ENDFORM.                    " GET_VBELN_DATA
