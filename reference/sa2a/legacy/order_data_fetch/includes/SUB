FORM get_values_otgrp USING if_otgrp.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      retfield        = 'CODEGRUPPE'
      value_org       = 'S'
    TABLES
      value_tab       = gt_value_tab
      return_tab      = gt_return_tab
    EXCEPTIONS
      parameter_error = 1
      no_values_found = 2
      OTHERS          = 3.

  CHECK sy-subrc EQ 0.
  if_otgrp = gt_return_tab-fieldval.

ENDFORM.                    " GET_VALUES_OTGRP
