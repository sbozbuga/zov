FORM build_mkpf_data .

  DATA: BEGIN OF lt_mkpf OCCURS 0,
          mblnr LIKE mkpf-mblnr,
          mjahr LIKE mkpf-mjahr,
        END OF lt_mkpf,
        lt_mkpf2 TYPE tyt_mkpf.                             "HB031018

  DATA: lt_mkpf_par LIKE lt_mkpf OCCURS 0 WITH HEADER LINE.

  FIELD-SYMBOLS:
    <ls_mkpf> TYPE tys_mkpf.                                "HB031018

  RANGES: lr_aufnr_par FOR aufk-aufnr.


  IF NOT gr_aufnr[] IS INITIAL.
    DO.
      build_range gr_aufnr lr_aufnr_par.
      SELECT a~mblnr a~mjahr a~bldat a~xblnr
      b~obknr
      c~sernr
      FROM mkpf AS a
      INNER JOIN ser03 AS b
      ON a~mblnr = b~mblnr AND
         a~mjahr = b~mjahr
      INNER JOIN objk AS c
      ON b~obknr = c~obknr
         APPENDING TABLE lt_mkpf2
      WHERE a~xblnr IN lr_aufnr_par AND
            c~taser = 'SER03'.
    ENDDO.

  ENDIF.

  "Umkopieren in sortierte Tabelle
  gt_mkpf[] = lt_mkpf2[].                                   "HB031018

  CLEAR lt_mkpf. REFRESH lt_mkpf.

  LOOP AT gt_mkpf ASSIGNING <ls_mkpf>.
    lt_mkpf-mblnr = <ls_mkpf>-mblnr.
    lt_mkpf-mjahr = <ls_mkpf>-mjahr.
    COLLECT lt_mkpf.
    CLEAR lt_mkpf.
  ENDLOOP.

  CLEAR gt_mseg_aussond. REFRESH gt_mseg_aussond.
  IF NOT lt_mkpf[] IS INITIAL.
    DO.
      build_table lt_mkpf lt_mkpf_par.
      SELECT mblnr mjahr zeile bwart charg FROM mseg
      APPENDING TABLE gt_mseg_aussond
      FOR ALL ENTRIES IN lt_mkpf_par
      WHERE mblnr = lt_mkpf_par-mblnr AND
            mjahr = lt_mkpf_par-mjahr AND
            shkzg = 'S'.
    ENDDO.
  ENDIF.

  SORT gt_mseg_aussond BY mblnr mjahr bwart charg.

  syst-tfill = lines( gt_mkpf ).
  PERFORM prot_line USING syst-tfill 'BUILD mkpf_data                               :'.
ENDFORM.                    " BUILD_MKPF_DATA
