                               if_sernr
                         CHANGING cf_lif_found.

  DATA: ls_lips LIKE gt_lips_lif.
  DATA: lv_index_del TYPE sytabix.
  CLEAR gt_lips_lif.
  READ TABLE gt_lips_lif WITH KEY vgbel = if_vbeln
                                  vgpos = if_posnr
                                  sernr = if_sernr
  BINARY SEARCH.
  IF sy-subrc NE 0 AND gt_vbap_aux-kwmeng = 1.
    CLEAR gt_lips_lif.
    READ TABLE gt_lips_lif WITH KEY vgbel = if_vbeln
                                    vgpos = if_posnr
    BINARY SEARCH.
  ENDIF.

  IF sy-subrc EQ 0.

    lv_index_del = sy-tabix.
    PERFORM fill_lips_lif_fields USING gt_lips_lif.

    IF NOT gt_lips_lif-sernr IS INITIAL.
      DELETE gt_lips_lif INDEX lv_index_del.
    ELSE.
      IF gt_lips_lif-lfimg = 1.
        DELETE gt_lips_lif INDEX lv_index_del.
      ELSE.
        ls_lips = gt_lips_lif.
        ls_lips-lfimg = gt_lips_lif-lfimg - 1.
        MODIFY gt_lips_lif FROM ls_lips INDEX lv_index_del TRANSPORTING lfimg.
      ENDIF.
    ENDIF.
    cf_lif_found = c_true.
  ENDIF.

ENDFORM.                    " BUILD_LIPS_103_LIST
