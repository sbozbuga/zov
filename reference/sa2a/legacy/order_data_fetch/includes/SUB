    gt_lifnr-lifnr = <ls_vttp>-tdlnr.
    COLLECT gt_lifnr.
    CLEAR gt_lifnr.
  ENDLOOP.

  SORT gt_lifnr.

  gt_vttp[] = lt_vttp[].  "Umkopieren in sortierte Tabelle

  syst-tfill = lines( gt_vttp ).
  PERFORM prot_line USING syst-tfill 'BUILD vttp_data                               :'.

ENDFORM.                    " GET_VTTP_DATA
*&---------------------------------------------------------------------*
*&      Form  GET_QMFE_Z2_DATA
*&---------------------------------------------------------------------*
FORM get_qmfe_z2_data .

  DATA: BEGIN OF lt_objnr OCCURS 0,
          objnr LIKE jest-objnr,
        END OF lt_objnr.

  DATA: lt_qmfe_rm_par LIKE gt_qmfe_rm OCCURS 0 WITH HEADER LINE,
        lt_objnr_par   LIKE lt_objnr OCCURS 0 WITH HEADER LINE.

  DATA: lt_tlines TYPE STANDARD TABLE OF tline,
        ls_tlines TYPE tline.

  DATA: lv_name LIKE thead-tdname.

  DATA: ls_thead    TYPE thead,
        ls_qmma_rem TYPE tys_qmma_rem.


  RANGES: lr_aufnr_par FOR qmel-aufnr,
          lr_urcod FOR qmur-urcod.

  CLEAR lr_urcod. REFRESH lr_urcod.
  lr_urcod-sign = 'I'.
  lr_urcod-option = 'CP'.
  lr_urcod-low = 'A*'.
  APPEND lr_urcod. REFRESH lr_urcod.

  CLEAR gt_qmfe_rm. REFRESH gt_qmfe_rm.

  IF NOT gr_aufnr[] IS INITIAL.

    "-------------------------------------------------------------------------
    " zu allen Fertigungsaufträgen die zugehörigen Z2-Meldungen bestimmen
    "-------------------------------------------------------------------------

    DO.
      build_range gr_aufnr lr_aufnr_par.

      SELECT a~qmnum a~aufnr a~matnr a~objnr a~qmcod a~serialnr a~kzloesch
      b~fenum
      b~erdat b~fetxt b~fegrp b~fecod b~otgrp
      b~oteil b~besz
      a~kzmla
      FROM qmel AS a LEFT OUTER JOIN qmfe AS b
      ON a~qmnum = b~qmnum
      APPENDING TABLE gt_qmfe_rm
      WHERE a~qmart = 'Z2' AND
            a~aufnr IN lr_aufnr_par.
    ENDDO.

  ENDIF.

  SORT gt_qmfe_rm BY qmnum.

  CLEAR gt_qmfe_rm_qmnum. REFRESH gt_qmfe_rm_qmnum.
  gt_qmfe_rm_qmnum[] = gt_qmfe_rm[].

  SORT gt_qmfe_rm_qmnum BY qmnum.

  CLEAR gt_objk_aufnr.
  LOOP AT gt_objk_aufnr.
    IF NOT gt_objk_aufnr-ihnum IS INITIAL.
      CLEAR gt_qmfe_rm.
      READ TABLE gt_qmfe_rm WITH KEY qmnum = gt_objk_aufnr-ihnum
      BINARY SEARCH.
      gt_objk_aufnr-equnr = gt_objk_aufnr-sernr = gt_qmfe_rm-serialnr.
      gt_objk_aufnr-matnr = gt_qmfe_rm-matnr.
      MODIFY gt_objk_aufnr.
    ENDIF.
  ENDLOOP.

  SORT gt_objk_aufnr ASCENDING BY obknr sernr.

  CLEAR gt_objk_aufnr_gsi. REFRESH gt_objk_aufnr_gsi.
  gt_objk_aufnr_gsi[] = gt_objk_aufnr[].
  SORT gt_objk_aufnr_gsi ASCENDING BY obknr sernr.

  SORT gt_qmfe_rm BY aufnr matnr serialnr qmnum fenum.

  CLEAR lt_objnr. REFRESH lt_objnr.
  CLEAR gt_qmfe_rm.
  LOOP AT gt_qmfe_rm.
    lt_objnr-objnr = gt_qmfe_rm-objnr.
    COLLECT lt_objnr.
    CLEAR lt_objnr.
  ENDLOOP.

  CLEAR gt_tj02t.
  READ TABLE gt_tj02t WITH KEY txt04 = 'LÖVM'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    SORT lt_objnr.
    CLEAR gt_jest_rm. REFRESH gt_jest_rm.
    IF NOT lt_objnr[] IS INITIAL.
      DO.
        build_table lt_objnr lt_objnr_par.
        SELECT objnr FROM jest
        APPENDING TABLE gt_jest_rm
        FOR ALL ENTRIES IN lt_objnr_par
        WHERE objnr = lt_objnr_par-objnr AND
              stat EQ gt_tj02t-istat AND
              inact = ' '.
      ENDDO.
    ENDIF.
    SORT gt_jest_rm BY objnr.
  ENDIF.

  CLEAR gt_qmma_aux. REFRESH gt_qmma_aux.
  CLEAR gt_qmma_gsi. REFRESH gt_qmma_gsi.
  CLEAR gt_qmur. REFRESH gt_qmur.

  IF NOT gt_qmfe_rm[] IS INITIAL.

    "-------------------------------------------------------------------------
    " zu allen Z2-Meldungen die Maßnahmen bestimmen aus QMMA
    "-------------------------------------------------------------------------

    DO.

      "-------------------------------------------------------------------------
      " zu allen Z2-Meldungen Kopf die Maßnahmen in gt_qmma_aux - nicht gelöscht
      "-------------------------------------------------------------------------
      build_table gt_qmfe_rm lt_qmfe_rm_par.
      SELECT qmnum manum fenum mngrp mncod matxt ernam erdat
      aenam aedat peter indtx kzmla  "HB291123  Textsprache
        erzeit aezeit qmanum
      FROM qmma APPENDING TABLE gt_qmma_aux
      FOR ALL ENTRIES IN lt_qmfe_rm_par
      WHERE qmnum = lt_qmfe_rm_par-qmnum AND
            fenum EQ space AND
            kzloesch EQ space.

      "-------------------------------------------------------------------------
      " zu allen Z2-Meldungen Kopf die Maßnahmenschüssel in gt_qmma_gsi
      "-------------------------------------------------------------------------
      SELECT qmnum manum mngrp mncod kzloesch FROM qmma
      APPENDING TABLE gt_qmma_gsi
      FOR ALL ENTRIES IN lt_qmfe_rm_par
      WHERE qmnum = lt_qmfe_rm_par-qmnum AND
            fenum EQ space.

      SELECT qmnum erdat aedat urgrp urcod FROM qmur
      APPENDING TABLE gt_qmur
      FOR ALL ENTRIES IN lt_qmfe_rm_par
      WHERE qmnum = lt_qmfe_rm_par-qmnum AND
            urgrp = 'ZAKZ' AND
            urcod IN lr_urcod AND
            kzloesch = ' '.
    ENDDO.
  ENDIF.

  SORT gt_qmma_aux BY qmnum ASCENDING aedat DESCENDING aezeit DESCENDING qmanum ASCENDING.

  CLEAR gt_qmma. REFRESH gt_qmma.

  CLEAR gt_qmma_aux.
  LOOP AT gt_qmma_aux.
    "-------------------------------------------------------------------------
    " Maßnahmen anreichern
    "   AENAM, AEDAT und AEZEIT aus ERNAM usw. vorbelegen
    "   QMMA-Text lesen und an QMMA-LINE anhängen LINE 255 Zeichen
    "-------------------------------------------------------------------------


    MOVE-CORRESPONDING gt_qmma_aux TO gt_qmma.
    IF gt_qmma-aenam IS INITIAL.
      gt_qmma-aenam = gt_qmma-ernam.
    ENDIF.
    IF gt_qmma-aedat IS INITIAL.
      gt_qmma-aedat = gt_qmma-erdat.
    ENDIF.
    IF gt_qmma-aezeit IS INITIAL.
      gt_qmma-aezeit = gt_qmma-erzeit.
    ENDIF.
    "Kurztext bleibt


    IF NOT gt_qmma-indtx IS INITIAL.

      "Langtext als eigenständige Einheit betrachten - ergibt separaten Eintrag
      "mit eigenem Zeitstempel

      CLEAR lt_tlines. REFRESH lt_tlines.
      CLEAR lv_name.
      CLEAR ls_qmma_rem.

      CONCATENATE gt_qmma-qmnum gt_qmma-manum INTO lv_name.
      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          id                      = 'LTXT'
          language                = gt_qmma-kzmla   "HB291123 in der gespeicherten Sprache
          name                    = lv_name
          object                  = 'QMMA'
        IMPORTING
          header                  = ls_thead        "HB011223 wegen Zeitstempel
        TABLES
          lines                   = lt_tlines
        EXCEPTIONS
          id                      = 1
          language                = 2
          name                    = 3
          not_found               = 4
          object                  = 5
          reference_check         = 6
          wrong_access_to_archive = 7
          OTHERS                  = 8.
      IF sy-subrc EQ 0.
        "Zeitstempel immer Änddatum
        gt_qmma-tdluser  = ls_thead-tdluser.
        gt_qmma-tdldate  = ls_thead-tdldate.
        gt_qmma-tdltime  = ls_thead-tdltime.

        "Langtext in line aufsammeln
        CLEAR: ls_tlines.  "neue Zeile
        LOOP AT lt_tlines INTO ls_tlines.
*          CONDENSE ls_tlines-tdline.
          IF gt_qmma-line IS INITIAL.
            gt_qmma-line = ls_tlines-tdline.
          ELSE.
            CONCATENATE gt_qmma-line ls_tlines-tdline INTO gt_qmma-line.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.

    APPEND gt_qmma.
    CLEAR gt_qmma.
  ENDLOOP.

  SORT gt_qmur BY qmnum.

  syst-tfill = lines( gt_qmma ).
  PERFORM prot_line USING syst-tfill 'get_qmfe_z2_data, READ_TEXT Aufrufe           :'.

ENDFORM.                    " GET_QMFE_Z2_DATA
