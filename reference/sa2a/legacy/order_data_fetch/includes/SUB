FORM get_adrc_data .

  DATA: BEGIN OF lt_adrnr OCCURS 0,
          adrnr LIKE vbpa-adrnr,
        END OF lt_adrnr.

  DATA: BEGIN OF lt_kunnr OCCURS 0,
          kunnr LIKE knvv-kunnr,
        END OF lt_kunnr.

  DATA: lt_adrnr_par LIKE lt_adrnr OCCURS 0 WITH HEADER LINE,
        lt_kunnr_par LIKE lt_kunnr OCCURS 0 WITH HEADER LINE.

* Get ADRC data/ Get KNVV data / Get KNMT data
  CLEAR lt_adrnr. REFRESH lt_adrnr.
  CLEAR lt_kunnr. REFRESH lt_kunnr.

  CLEAR gt_vbpa.
  LOOP AT gt_vbpa.
    IF NOT gt_vbpa-adrnr IS INITIAL.
      lt_adrnr-adrnr = gt_vbpa-adrnr.
      COLLECT lt_adrnr.
      CLEAR lt_adrnr.
    ENDIF.
    IF NOT gt_vbpa-kunnr IS INITIAL.
      lt_kunnr-kunnr = gt_vbpa-kunnr.
      COLLECT lt_kunnr.
      CLEAR lt_kunnr.
    ENDIF.
  ENDLOOP.

  SORT lt_adrnr BY adrnr.
  SORT lt_kunnr BY kunnr.

* ADRC data
  PERFORM show_progress USING TEXT-l04.
  CLEAR gt_adrc. REFRESH gt_adrc.

  IF NOT lt_adrnr[] IS INITIAL.

    DO.
      build_table lt_adrnr lt_adrnr_par.

      SELECT addrnumber name1 name2 name3 city1 post_code1
      street house_num1 sort1
      FROM adrc APPENDING TABLE gt_adrc
      FOR ALL ENTRIES IN lt_adrnr_par
      WHERE addrnumber = lt_adrnr_par-adrnr.
    ENDDO.
  ENDIF.

  SORT gt_adrc BY addrnumber.

* Get KNVV data
  PERFORM show_progress USING TEXT-l05.

  CLEAR gt_knmt. REFRESH gt_knmt.
  CLEAR gt_knvv. REFRESH gt_knvv.

  IF NOT lt_kunnr[] IS INITIAL.

    DO.

      build_table lt_kunnr lt_kunnr_par.

      SELECT kunnr vkorg vtweg spart kvgr1 FROM knvv
      APPENDING TABLE gt_knvv
      FOR ALL ENTRIES IN lt_kunnr_par
      WHERE kunnr = lt_kunnr_par-kunnr.

      SELECT vkorg vtweg kunnr matnr
             kdmat
        FROM knmt
      APPENDING TABLE gt_knmt
      FOR ALL ENTRIES IN lt_kunnr_par
      WHERE kunnr = lt_kunnr_par-kunnr.

    ENDDO.
  ENDIF.

  SORT gt_knvv ASCENDING BY kunnr vkorg vtweg spart.
  SORT gt_knmt ASCENDING BY vkorg vtweg kunnr matnr.


ENDFORM.                    " GET_ADRC_DATA
