  CLEAR gt_lips_ret. REFRESH gt_lips_ret.
  CLEAR gr_lips. REFRESH gr_lips.

  gr_lips-sign = 'I'.
  gr_lips-option = 'EQ'.

  CLEAR gt_lips_aux.
  LOOP AT gt_lips_aux.
    CLEAR ls_lips.
    CLEAR gt_vbep.
    READ TABLE gt_vbep WITH KEY vbeln = gt_lips_aux-vgbel
                                posnr = gt_lips_aux-vgpos
    BINARY SEARCH.
    IF NOT gt_lips_aux-obknr IS INITIAL.
      CLEAR lv_index.
      CLEAR gt_objk.
      READ TABLE gt_objk WITH KEY obknr = gt_lips_aux-obknr
                                  taser = 'SER01'
      BINARY SEARCH.
      lv_index = sy-tabix.
      CLEAR gt_objk.
      LOOP AT gt_objk FROM lv_index.
        IF gt_objk-obknr <> gt_lips_aux-obknr.
          EXIT.
        ENDIF.
        CHECK gt_objk-taser = 'SER01'.
        MOVE-CORRESPONDING gt_lips_aux TO ls_lips.
        ls_lips-sernr = gt_objk-sernr.
        ls_lips-edatu = gt_vbep-edatu.
        CLEAR gt_equi.
        READ TABLE gt_equi WITH KEY equnr = gt_objk-equnr
        BINARY SEARCH.
        IF sy-subrc EQ 0.
          ls_lips-serge = gt_equi-serge.
          ls_lips-equnr = gt_equi-equnr.
        ENDIF.

        CASE gt_lips_aux-vbtyp.
          WHEN 'J'.
            APPEND ls_lips TO gt_lips_lif.
          WHEN 'T'.
            APPEND ls_lips TO gt_lips_ret.
        ENDCASE.
        CLEAR ls_lips.
      ENDLOOP.

    ELSE.
      MOVE-CORRESPONDING gt_lips_aux TO ls_lips.
      ls_lips-edatu = gt_vbep-edatu.
      CASE gt_lips_aux-vbtyp.
        WHEN 'J'.
          APPEND ls_lips TO gt_lips_lif.
        WHEN 'T'.
          APPEND ls_lips TO gt_lips_ret.
      ENDCASE.
      CLEAR ls_lips.
    ENDIF.

    IF NOT gt_lips_aux-vbeln IS INITIAL.
      lt_objky-objky = gt_lips_aux-vbeln.
      COLLECT lt_objky.
      CLEAR lt_objky.
    ENDIF.

    IF NOT gt_lips_aux-matnr IS INITIAL.
      gt_matnr-matnr = gt_lips_aux-matnr.
      COLLECT gt_matnr.
      CLEAR gt_matnr.
    ENDIF.

    IF gt_lips_aux-vbtyp = 'J'.  "Auslieferung
      gr_lips-low = gt_lips_aux-vbeln.
      COLLECT gr_lips.
    ENDIF.

  ENDLOOP.
  CLEAR gr_lips.

  SORT gt_lips_lif BY vgbel vgpos sernr.
  SORT gt_lips_ret BY vgbel vgpos sernr.
  SORT gr_lips BY low.

  CLEAR gt_lips_aux. REFRESH gt_lips_aux.

  CLEAR gt_nast. REFRESH gt_nast.
  IF NOT lt_objky[] IS INITIAL.
    DO.
      build_table lt_objky lt_objky_par.

      SELECT DISTINCT objky datvr FROM nast APPENDING TABLE gt_nast
      FOR ALL ENTRIES IN lt_objky_par
      WHERE kappl = 'V2' AND
            objky = lt_objky_par-objky AND
            kschl = 'ZLSS' AND
            vstat = '1'.
    ENDDO.

  ENDIF.

  SORT gt_nast ASCENDING BY objky.

  syst-tfill = lines( gt_lips_lif ).
  PERFORM prot_line USING syst-tfill 'BUILD lips_data                               :'.


ENDFORM.                    " BUILD_LIPS_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_VBEP_DATA
*&---------------------------------------------------------------------*
FORM build_vbep_data .
  DATA: lv_index TYPE syindex,
        lv_obknr LIKE objk-obknr.

  gr_objnr-sign = 'I'.
  gr_objnr-option = 'EQ'.

  CLEAR gt_vbep. REFRESH gt_vbep.
  CLEAR gt_vbep_aux.
  LOOP AT gt_vbep_aux.
    CLEAR gt_vbap_rep.
    READ TABLE gt_vbap_rep WITH KEY vbeln = gt_vbep_aux-vbeln
                                    posnr = gt_vbep_aux-posnr
    BINARY SEARCH.
    CHECK sy-subrc EQ 0.
    CLEAR lv_index.
    CLEAR gt_objk.
    READ TABLE gt_objk WITH KEY obknr = gt_vbep_aux-obknr
                                taser = 'SER02'
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lv_index = sy-tabix.
      CLEAR gt_objk.
      LOOP AT gt_objk FROM lv_index.
        IF gt_objk-obknr <> gt_vbep_aux-obknr.
          EXIT.
        ENDIF.
        MOVE-CORRESPONDING gt_vbep_aux TO gt_vbep.
        gt_vbep-uepos = gt_vbap_rep-uepos.
        gt_vbep-sernr = gt_objk-sernr.
        gt_vbep-equnr = gt_objk-equnr.
        APPEND gt_vbep.
        CLEAR gt_vbep.
      ENDLOOP.
    ELSEIF sy-subrc NE 0.
      CHECK NOT gt_vbep_aux-aufnr IS INITIAL.
      CLEAR gt_afih.
      READ TABLE gt_afih WITH KEY aufnr = gt_vbep_aux-aufnr
      BINARY SEARCH.

      CLEAR gt_objk.
      READ TABLE gt_objk_aufnr WITH KEY obknr = gt_afih-obknr
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        lv_index = sy-tabix.
        CLEAR gt_objk_aufnr.
        LOOP AT gt_objk_aufnr FROM lv_index.
          IF gt_objk_aufnr-obknr <> gt_afih-obknr.
            EXIT.
          ENDIF.
          MOVE-CORRESPONDING gt_vbep_aux TO gt_vbep.
          gt_vbep-uepos = gt_vbap_rep-uepos.
          gt_vbep-sernr = gt_objk_aufnr-sernr.
          gt_vbep-equnr = gt_objk_aufnr-equnr.
          APPEND gt_vbep.
          CLEAR gt_vbep.
        ENDLOOP.

      ELSE.
        MOVE-CORRESPONDING gt_vbep_aux TO gt_vbep.
        CLEAR gt_vbap_rep.
        READ TABLE gt_vbap_rep WITH KEY vbeln = gt_vbep-vbeln
                                        posnr = gt_vbep-posnr
        BINARY SEARCH.
        gt_vbep-uepos = gt_vbap_rep-uepos.
        APPEND gt_vbep.
        CLEAR gt_vbep.

      ENDIF.
    ENDIF.
    IF NOT gt_vbep_aux-objnr IS INITIAL.
      gr_objnr-low = gt_vbep_aux-objnr.
      COLLECT gr_objnr.
    ENDIF.

  ENDLOOP.

  SORT gt_vbep BY vbeln uepos sernr autyp.   "HB180213  AUTYP

  CLEAR gt_vbep_aux.
*  FREE gt_vbep_aux.

  syst-tfill = lines( gt_vbep ).
  PERFORM prot_line USING syst-tfill 'BUILD vbep_data                               :'.

ENDFORM.                    " BUILD_VBEP_DATA
