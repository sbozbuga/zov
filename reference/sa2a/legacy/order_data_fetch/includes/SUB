*&---------------------------------------------------------------------*
FORM build_resb_data .

  DATA: BEGIN OF lt_matnr OCCURS 0,
          matnr LIKE mara-matnr,
        END OF lt_matnr.

  DATA: BEGIN OF lt_mara_comp OCCURS 0,
          matnr LIKE mara-matnr,
        END OF lt_mara_comp.

  DATA: lt_matnr_par LIKE lt_matnr OCCURS 0 WITH HEADER LINE.

  CLEAR lt_matnr. REFRESH lt_matnr.

  CLEAR gt_resb.
  LOOP AT gt_resb.
    IF NOT gt_resb-matnr IS INITIAL.
      lt_matnr-matnr = gt_resb-matnr.
      COLLECT lt_matnr.
      CLEAR lt_matnr.
    ENDIF.
  ENDLOOP.

  SORT lt_matnr.

  CLEAR lt_mara_comp. REFRESH lt_mara_comp.

  IF NOT lt_matnr[] IS INITIAL.
    DO.
      build_table lt_matnr lt_matnr_par.
      SELECT matnr FROM mara APPENDING TABLE lt_mara_comp
      FOR ALL ENTRIES IN lt_matnr_par
      WHERE matnr = lt_matnr_par-matnr AND
            mtart = 'ZCOM'.
    ENDDO.
  ENDIF.

  SORT lt_mara_comp.

  CLEAR gt_resb.
  LOOP AT gt_resb.
    CLEAR lt_mara_comp.
    READ TABLE lt_mara_comp WITH KEY matnr = gt_resb-matnr
    BINARY SEARCH.
    IF sy-subrc NE 0.
      DELETE gt_resb.
    ENDIF.
  ENDLOOP.

  syst-tfill = lines( gt_resb ).
  PERFORM prot_line USING syst-tfill 'BUILD Resb_data                               :'.

ENDFORM.                    " BUILD_RESB_DATA
