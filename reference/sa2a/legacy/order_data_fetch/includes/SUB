FORM get_ordview_data .
  SELECT * FROM /cellag/ordview INTO TABLE gt_orderview_changed
  WHERE archivflag      EQ space   AND
        orderstatecompl IN s_statc AND
        orderdate       IN s_odate AND
        qmnum           IN s_qmnu2 AND
        otgrp           IN s_otgr2 AND
        wktnr           IN s_wktnr AND
        customergroup   IN s_kdgrp AND
        fkstk           IN s_fkstk.

  IF p_orddt0 = abap_true.                                  "HB200419
    "Auftragsdaten mit Datum leer anhängen
    SELECT * FROM /cellag/ordview APPENDING TABLE gt_orderview_changed
      WHERE archivflag      EQ space   AND
            orderstatecompl IN s_statc AND
            orderdate       =  '00000000' AND
            qmnum           IN s_qmnu2 AND
            otgrp           IN s_otgr2 AND
            wktnr           IN s_wktnr AND
            customergroup   IN s_kdgrp AND
            fkstk           IN s_fkstk.
  ENDIF.

  syst-tfill = lines( gt_orderview_changed ).
  PERFORM prot_line USING syst-tfill 'Gespeicherte Sätze lesen /cellag/ordview      :'.

ENDFORM.                    " GET_ORDVIEW_DATA
