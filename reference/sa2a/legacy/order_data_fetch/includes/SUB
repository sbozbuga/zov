FORM build_vbap_prices USING if_vbap_aux STRUCTURE gt_vbap.
  DATA: lv_index TYPE sytabix,
        lv_subrc TYPE sysubrc,
        lv_bemot LIKE a501-bemot.


  "Korrektur 1601-360  Orderview auf PA1 Feld Price
  "an dieser Stelle Preisinit!
  CLEAR: gt_orderview-price.

  CLEAR gt_vbap_zirc.
  READ TABLE gt_vbap_zirc WITH KEY vbeln = if_vbap_aux-vbeln
                                   uepos = if_vbap_aux-posnr
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    gt_orderview-kpwaers = gt_vbap_zirc-waerk.
    lv_index = sy-tabix.
    CLEAR gt_vbap_zirc.
    LOOP AT gt_vbap_zirc FROM lv_index.
      IF gt_vbap_zirc-vbeln <> if_vbap_aux-vbeln.
        EXIT.
      ENDIF.
      IF gt_vbap_zirc-uepos <> if_vbap_aux-posnr.
        EXIT.
      ENDIF.
      gt_orderview-komppreis = gt_orderview-komppreis + gt_vbap_zirc-netwr.
    ENDLOOP.

  ENDIF.


  CLEAR gt_vbap_zirl.
  READ TABLE gt_vbap_zirl WITH KEY vbeln = if_vbap_aux-vbeln
                                   uepos = if_vbap_aux-posnr
                                   matnr = 'Z_SKZ_PRICE'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    lv_index = sy-tabix.
    CLEAR gt_vbap_zirl.
    LOOP AT gt_vbap_zirl FROM lv_index.
      IF gt_vbap_zirl-vbeln <> if_vbap_aux-vbeln.
        EXIT.
      ENDIF.
      IF gt_vbap_zirl-uepos <> if_vbap_aux-posnr.
        EXIT.
      ENDIF.
      IF gt_vbap_zirl-matnr <> 'Z_SKZ_PRICE'.
        EXIT.
      ENDIF.
      gt_orderview-price = gt_orderview-price + gt_vbap_zirl-netwr.
    ENDLOOP.

  ELSEIF sy-subrc NE 0.
    lv_subrc = 4.
    CLEAR lv_bemot.
    MOVE gt_orderview-skz TO lv_bemot.

    CLEAR gt_a501.
    READ TABLE gt_a501 WITH KEY kappl = 'V'
                                kschl = 'ZSKZ'
                                wktnr = if_vbap_aux-wktnr
                                wktps = if_vbap_aux-wktps
                                bemot = lv_bemot
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lv_index = sy-tabix.
      CLEAR gt_a501.
      LOOP AT gt_a501 FROM lv_index.
        IF gt_a501-wktnr <> if_vbap_aux-wktnr.
          EXIT.
        ENDIF.
        IF gt_a501-wktps <> if_vbap_aux-wktps.
          EXIT.
        ENDIF.
        IF gt_a501-bemot <> lv_bemot.
          EXIT.
        ENDIF.

        CHECK gt_a501-datab LE if_vbap_aux-prsdt.
        CHECK gt_a501-datbi GE if_vbap_aux-prsdt.

        CLEAR gt_konp.
        READ TABLE gt_konp WITH KEY knumh = gt_a501-knumh
        BINARY SEARCH.
        IF sy-subrc EQ 0.
          lv_subrc = sy-subrc.
          gt_orderview-price = gt_konp-kbetr.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
    IF lv_subrc NE 0.
      CLEAR gt_a502.
      READ TABLE gt_a502 WITH KEY kappl = 'V'
                                  kschl = 'ZSKZ'
                                  wktnr = if_vbap_aux-wktnr
                                  matnr = if_vbap_aux-matnr
                                  bemot = lv_bemot
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        lv_index = sy-tabix.
        CLEAR gt_a502.
        LOOP AT gt_a502 FROM lv_index.
          IF gt_a502-wktnr <> if_vbap_aux-wktnr.
            EXIT.
          ENDIF.
          IF gt_a502-matnr <> if_vbap_aux-matnr.
            EXIT.
          ENDIF.
          IF gt_a502-bemot <> lv_bemot.
            EXIT.
          ENDIF.

          CHECK gt_a502-datab LE if_vbap_aux-prsdt.
          CHECK gt_a502-datbi GE if_vbap_aux-prsdt.

          CLEAR gt_konp.
          READ TABLE gt_konp WITH KEY knumh = gt_a502-knumh
          BINARY SEARCH.
          IF sy-subrc EQ 0.
            lv_subrc = sy-subrc.
            gt_orderview-price = gt_konp-kbetr.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.

    IF lv_subrc NE 0.
      CLEAR gt_a503.
      READ TABLE gt_a503 WITH KEY kappl = 'V'
                                  kschl = 'ZSKZ'
                                  wktnr = if_vbap_aux-wktnr
                                  bemot = lv_bemot
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        lv_index = sy-tabix.
        CLEAR gt_a503.
        LOOP AT gt_a503 FROM lv_index.
          IF gt_a503-wktnr <> if_vbap_aux-wktnr.
            EXIT.
          ENDIF.
          IF gt_a503-bemot <> lv_bemot.
            EXIT.
          ENDIF.

          CHECK gt_a503-datab LE if_vbap_aux-prsdt.
          CHECK gt_a503-datbi GE if_vbap_aux-prsdt.

          CLEAR gt_konp.
          READ TABLE gt_konp WITH KEY knumh = gt_a503-knumh
          BINARY SEARCH.
          IF sy-subrc EQ 0.
            lv_subrc = sy-subrc.
            gt_orderview-price = gt_konp-kbetr.
            EXIT.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.

    IF lv_subrc NE 0.
      CLEAR gt_a504.
      READ TABLE gt_a504 WITH KEY kappl = 'V'
                                  kschl = 'ZSKZ'
                                  bemot = lv_bemot
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        lv_index = sy-tabix.
        CLEAR gt_a504.
        LOOP AT gt_a504 FROM lv_index.
          IF gt_a504-bemot <> lv_bemot.
            EXIT.
          ENDIF.

          CHECK gt_a504-datab LE if_vbap_aux-prsdt.
          CHECK gt_a504-datbi GE if_vbap_aux-prsdt.

          CLEAR gt_konp.
          READ TABLE gt_konp WITH KEY knumh = gt_a504-knumh
          BINARY SEARCH.
          IF sy-subrc EQ 0.
            lv_subrc = sy-subrc.
            gt_orderview-price = gt_konp-kbetr.
            EXIT.
          ENDIF.
        ENDLOOP.

      ENDIF.
    ENDIF.

  ENDIF.

ENDFORM.                    " BUILD_VBAP_PRICES
