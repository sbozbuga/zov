      ELSE.
        TRY.
            gt_orderview-overdue = gt_orderview-dateclosed - gt_orderview-auftragsendesoll.
          CATCH cx_sy_arithmetic_overflow INTO lo_err_arithmetic.
            "Anzeige Sondersituation mit Wert 999    Herm 13.04.2014
            gt_orderview-overdue = '999'.
        ENDTRY.
      ENDIF.
    ENDIF.
  ELSE.                                                     "Z1 usw.
    TRY.
        gt_orderview-overdue = gt_orderview-tat - gt_orderview-repdauer.
      CATCH cx_sy_arithmetic_overflow INTO lo_err_arithmetic.
        "Anzeige Sondersituation mit Wert 999    Herm 13.04.2014
        gt_orderview-overdue = '999'.
    ENDTRY.
  ENDIF.

  IF gt_orderview-overdue LT 0.
    gt_orderview-overdue = 0.
  ENDIF.


  CASE gt_orderview-otgrp.
    WHEN 'ZRS4S'.
      IF NOT gt_orderview-auftragsendesoll IS INITIAL.
*        gt_orderview-kundewunschterm = gt_orderview-auftragsendesoll.   "HB230918
        gt_orderview-initcommitdate = gt_orderview-auftragsendesoll.
      ENDIF.

    WHEN 'ZRL4L'.                                           "HB190514
      "Bei ZRL4L (Like for Like) müssen wir erst dann liefern,
      "wenn die Defektbaugruppe bei uns im WE aufschlägt
      IF NOT gt_orderview-receivedate IS INITIAL.
        gt_orderview-initcommitdate = gt_orderview-receivedate.
      ENDIF.

    WHEN 'ZRADR'   OR
         'ZFL'     OR                                       "HB180514
         'ZMTO'    OR                                       "HB160621
         'ZRET'    OR                                       "HB100325
         'ZTRANS'  OR                                       "HB100325
         'ZRREF'   OR                                       "HB270416
         'ZRREFRS' OR                                       "HB200517
         'ZSWUPDAT'.                                        "MK280817
      IF NOT gt_orderview-orderdate IS INITIAL.
        "CutOff-Zeit ermitteln aus Cust
        lv_cutofft = '160000'.  "Default    HB29062015
        READ TABLE gt_zordview_cutofft WITH TABLE KEY wktnr = gt_orderview-wktnr
                                       ASSIGNING <ls_zordview_cutofft>.
        IF sy-subrc = 0.
          lv_cutofft = <ls_zordview_cutofft>-ab_uzeit.
        ENDIF.

        IF gt_orderview-uhrzeitorder >= lv_cutofft.
          gt_orderview-initcommitdate = gt_orderview-orderdate + 1.
        ELSE.
          gt_orderview-initcommitdate = gt_orderview-orderdate.
        ENDIF.

        CLEAR gt_t001w.
        READ TABLE gt_t001w WITH KEY werks = gt_orderview-werks.

        CALL FUNCTION 'DATE_CONVERT_TO_FACTORYDATE'
          EXPORTING
            date                         = gt_orderview-initcommitdate
            factory_calendar_id          = gt_t001w-fabkl
          IMPORTING
            date                         = gt_orderview-initcommitdate
          EXCEPTIONS
            calendar_buffer_not_loadable = 1
            correct_option_invalid       = 2
            date_after_range             = 3
            date_before_range            = 4
            date_invalid                 = 5
            factory_calendar_not_found   = 6
            OTHERS                       = 7.

        IF gt_orderview-otgrp = 'ZFL'  OR
           gt_orderview-otgrp = 'ZMTO' OR                   "HB160621
           gt_orderview-otgrp = 'ZRET' OR                   "HB100325
           gt_orderview-otgrp = 'ZTRANS'.                   "HB100325

          "Ausnahmefall Vorwärtslogistik = Lieferterminsoll
          gt_orderview-auftragsendesoll = gt_orderview-initcommitdate. "HB190514
        ENDIF.
      ENDIF.

  ENDCASE.

ENDFORM.                    " BUILD_CALCULATED_FIELDS
*&---------------------------------------------------------------------*
*&      Form  GET_EKPO_DATA
*&---------------------------------------------------------------------*
FORM get_ekpo_data .


  TYPES:
    BEGIN OF tys_ekpo,
      ebeln   TYPE ebeln,
      ebelp   TYPE ebelp,
      menge   TYPE bstmg,
      netwr   TYPE bwert,
      zzrmano TYPE zzrmano,
    END OF tys_ekpo,
    tyt_ekpo TYPE HASHED TABLE OF  tys_ekpo WITH UNIQUE KEY ebeln ebelp,

    BEGIN OF tys_ekko,
      ebeln TYPE ebeln,
      lifnr TYPE elifn,
      waers TYPE waers,
      bedat TYPE ebdat,
    END OF tys_ekko,
    tyt_ekko TYPE HASHED TABLE OF  tys_ekko WITH UNIQUE KEY ebeln.

  DATA:
    lt_ekpo TYPE tyt_ekpo,
    lt_ekko TYPE tyt_ekko.

  DATA: BEGIN OF lt_ebeln OCCURS 0,
          ebeln LIKE ekpo-ebeln,
          ebelp LIKE ekpo-ebelp,
        END OF lt_ebeln.

  DATA: BEGIN OF lt_belnr OCCURS 0,
          belnr LIKE ekbe-belnr,
        END OF lt_belnr.

  DATA: BEGIN OF lt_obknr_po OCCURS 0,
          obknr LIKE objk-obknr,
        END OF lt_obknr_po.

  DATA: lt_ebeln_par    LIKE lt_ebeln OCCURS 0 WITH HEADER LINE,
        lt_belnr_par    LIKE lt_belnr OCCURS 0 WITH HEADER LINE,
        lt_obknr_po_par LIKE lt_obknr_po OCCURS 0 WITH HEADER LINE.


  RANGES: lr_aufnr_par FOR ekkn-aufnr,
          lr_ebeln FOR ekpo-ebeln,
          lr_ebeln_par FOR ekpo-ebeln.

  FIELD-SYMBOLS:
    <ls_ekpo>     TYPE tys_ekpo,
    <ls_ekko>     TYPE tys_ekko,
    <ls_ekpo_aux> LIKE LINE OF gt_ekpo_aux.

* Get purchase orders
  CLEAR gt_ekpo_aux. REFRESH gt_ekpo_aux.
  SORT gr_aufnr ASCENDING.

  IF NOT gr_aufnr[] IS INITIAL.

*---------------------------------------------------
* ungewöhnliche Laufzeit des Joins; SQL-Explain zeigt
* TABLE ACCESS FULL EKKO/EKPO
* deshalb "manueller" Join über separate Select und
* abmischen: auch kein Erfolg...
*---------------------------------------------------
    IF 1 = 2.
      "Nov 2022: Dauer DA1 350 s
      DO.
        build_range gr_aufnr lr_aufnr_par.

        SELECT ebeln
               ebelp
               aufnr
          FROM ekkn
          APPENDING CORRESPONDING FIELDS OF TABLE gt_ekpo_aux
          WHERE aufnr IN lr_aufnr_par.


*      SELECT a~ebeln a~ebelp a~aufnr
*      b~lifnr b~waers b~bedat
*      c~menge c~netwr c~zzrmano
*      c~loekz   "HB041122 Performance
*      c~uebpo   "HB041122 Performance
*      FROM ekkn AS a INNER JOIN ekko AS b
*      ON a~ebeln = b~ebeln
*      INNER JOIN ekpo AS c
*      ON a~ebeln = c~ebeln AND
*         a~ebelp = c~ebelp
*      APPENDING TABLE gt_ekpo_aux
*      WHERE a~aufnr IN lr_aufnr_par.  "AND
**            c~loekz <> 'L' AND      "HB310817 1707-609
**            c~uebpo EQ space.
      ENDDO.
    ELSE.
      "Nov 2022: Dauer DA1 4 s: also wesentlich besser!!!
      SELECT ebeln
             ebelp
             aufnr
        FROM ekkn
        APPENDING CORRESPONDING FIELDS OF TABLE gt_ekpo_aux
        FOR ALL ENTRIES IN gr_aufnr
        WHERE aufnr = gr_aufnr-low.
    ENDIF.

    syst-tfill = lines( gt_ekpo_aux ).
    PERFORM prot_line USING syst-tfill 'ekpo_data gt_ekpo_aux                         :'.

    IF NOT gt_ekpo_aux[] IS INITIAL.

      "EKPO separat selektieren
      SELECT ebeln
             ebelp
             menge
             netwr
             zzrmano
        FROM ekpo
        INTO TABLE lt_ekpo
        FOR ALL ENTRIES IN gt_ekpo_aux
        WHERE ebeln = gt_ekpo_aux-ebeln
          AND ebelp = gt_ekpo_aux-ebelp
          AND loekz <> 'L'
          AND uebpo EQ space.

      syst-tfill = lines( lt_ekpo ).
      PERFORM prot_line USING syst-tfill 'ekpo_data lt_ekpo                            :'.


      "EKKO separat selektieren
      SELECT ebeln
             lifnr
             waers
             bedat
        FROM ekko
        INTO TABLE lt_ekko
        FOR ALL ENTRIES IN gt_ekpo_aux
        WHERE ebeln = gt_ekpo_aux-ebeln.

      syst-tfill = lines( lt_ekko ).
      PERFORM prot_line USING syst-tfill 'ekpo_data lt_ekko                            :'.

      "zusammenmischen
      LOOP AT gt_ekpo_aux ASSIGNING <ls_ekpo_aux>.
        READ TABLE lt_ekpo ASSIGNING <ls_ekpo> WITH TABLE KEY ebeln = <ls_ekpo_aux>-ebeln
                                                              ebelp = <ls_ekpo_aux>-ebelp.
        IF sy-subrc = 0.
          <ls_ekpo_aux>-menge   = <ls_ekpo>-menge.
          <ls_ekpo_aux>-netwr   = <ls_ekpo>-netwr.
          <ls_ekpo_aux>-zzrmano = <ls_ekpo>-zzrmano.

          READ TABLE lt_ekko ASSIGNING <ls_ekko> WITH TABLE KEY ebeln = <ls_ekpo_aux>-ebeln.
          IF sy-subrc = 0.
            <ls_ekpo_aux>-lifnr   = <ls_ekko>-lifnr.
            <ls_ekpo_aux>-waers   = <ls_ekko>-waers.
            <ls_ekpo_aux>-bedat   = <ls_ekko>-bedat.
          ENDIF.

        ELSE.
          "EKPO hat Löschkennzeichen   2403-977 Vendorbestellung ermitteln LOEKZ = L
          "deshalb hier auch rausnehmen
          DELETE gt_ekpo_aux.
        ENDIF.
      ENDLOOP.
    ENDIF.

  ENDIF.

  SORT gt_ekpo_aux BY aufnr ASCENDING                       "HB160416
                      ebeln DESCENDING.
  DELETE ADJACENT DUPLICATES FROM gt_ekpo_aux COMPARING aufnr.

  SORT gt_ekpo_aux BY ebeln ebelp.

  syst-tfill = lines( gt_ekpo_aux ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_ekpo_aux                         :'.

  CLEAR lt_ebeln. REFRESH lt_ebeln.
  CLEAR lr_ebeln. REFRESH lr_ebeln.
  lr_ebeln-sign = 'I'.
  lr_ebeln-option = 'EQ'.

  CLEAR gt_ekpo_aux.
  LOOP AT gt_ekpo_aux.
    lt_ebeln-ebeln = gt_ekpo_aux-ebeln.
    lt_ebeln-ebelp = gt_ekpo_aux-ebelp.
    COLLECT lt_ebeln.
    CLEAR lt_ebeln.
    lr_ebeln-low = gt_ekpo_aux-ebeln.
    COLLECT lr_ebeln.
    gt_lifnr-lifnr = gt_ekpo_aux-lifnr.
    COLLECT gt_lifnr.
    CLEAR gt_lifnr.
  ENDLOOP.

  CLEAR lr_ebeln.

  SORT lr_ebeln.
  SORT lt_ebeln.
  SORT gt_lifnr.

* Get serial numbers for purchase order
  CLEAR gt_ser08_po. REFRESH gt_ser08_po.
  IF NOT lr_ebeln[] IS INITIAL.
    DO.
      build_range lr_ebeln lr_ebeln_par.
      SELECT a~obknr a~ebeln a~ebelp
      b~sernr
      FROM ser08 AS a INNER JOIN objk AS b
      ON a~obknr = b~obknr
      APPENDING TABLE gt_ser08_po
      WHERE a~ebeln IN lr_ebeln_par.
    ENDDO.
  ENDIF.

  SORT gt_ser08_po BY ebeln ebelp.
  syst-tfill = lines( gt_ser08_po ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_ser08_po                         :'.

* Get Purchase order history
  CLEAR gt_ekbe_aux. REFRESH gt_ekbe_aux.
  IF NOT lt_ebeln[] IS INITIAL.
    DO.
      build_table lt_ebeln lt_ebeln_par.
      SELECT ebeln ebelp zekkn vgabe gjahr belnr buzei budat menge shkzg matnr FROM ekbe
      APPENDING TABLE gt_ekbe_aux
      FOR ALL ENTRIES IN lt_ebeln_par
      WHERE ebeln = lt_ebeln_par-ebeln AND
            ebelp = lt_ebeln_par-ebelp AND
            ( vgabe = '1' OR vgabe = '8' ).     "WE/Auslief.
    ENDDO.
  ENDIF.

  syst-tfill = lines( gt_ekbe_aux ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_ekbe_aux                         :'.

* Get deliveries (PO)
  CLEAR gt_lips_po_aux. REFRESH gt_lips_po_aux.
  IF NOT lr_ebeln[] IS INITIAL.
    DO.
      build_range lr_ebeln lr_ebeln_par.
      SELECT a~vbeln a~posnr a~lfimg a~vgbel a~vgpos
             b~wadat_ist
             b~erdat                                        "HB060216
             c~obknr
      FROM lips AS a INNER JOIN likp AS b
      ON a~vbeln = b~vbeln
      LEFT OUTER JOIN ser01 AS c
      ON a~vbeln = c~lief_nr AND
         a~posnr = c~posnr
      APPENDING TABLE gt_lips_po_aux
      WHERE a~vgbel IN lr_ebeln_par.
    ENDDO.
  ENDIF.

  syst-tfill = lines( gt_lips_po_aux ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_lips_po_aux                      :'.

* Get serial numbers for goods movement
  CLEAR lt_belnr. REFRESH lt_belnr.

  SORT gt_ekbe_aux BY vgabe.
  CLEAR gt_ekbe_aux.
  LOOP AT gt_ekbe_aux.
    IF gt_ekbe_aux-vgabe <> '1'.
      EXIT.
    ENDIF.
    IF NOT gt_ekbe_aux-belnr IS INITIAL.
      lt_belnr-belnr = gt_ekbe_aux-belnr.
      COLLECT lt_belnr. CLEAR lt_belnr.
    ENDIF.
  ENDLOOP.

  SORT lt_belnr ASCENDING.

* Get serial numbers
  CLEAR gt_mseg. REFRESH gt_mseg.
  CLEAR gt_ser03. REFRESH gt_ser03.
  IF NOT lt_belnr[] IS INITIAL.
    DO.
      build_table lt_belnr lt_belnr_par.
      SELECT obknr mblnr FROM ser03 APPENDING TABLE gt_ser03
      FOR ALL ENTRIES IN lt_belnr_par
      WHERE mblnr = lt_belnr_par-belnr AND
            bwart = '101'.

* Get material document (only reversal documents)
      SELECT mblnr zeile sjahr smbln FROM mseg
      APPENDING TABLE gt_mseg
      FOR ALL ENTRIES IN lt_belnr_par
      WHERE mblnr = lt_belnr_par-belnr AND
            bwart = '102'.
    ENDDO.
  ENDIF.

  SORT gt_ser03 BY mblnr obknr.
  SORT gt_mseg BY sjahr smbln.

  syst-tfill = lines( gt_ser03 ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_ser03                            :'.


  CLEAR lt_obknr_po. REFRESH lt_obknr_po.

  CLEAR gt_lips_po_aux.
  LOOP AT gt_lips_po_aux.
    IF NOT gt_lips_po_aux-obknr IS INITIAL.
      lt_obknr_po-obknr = gt_lips_po_aux-obknr.
      APPEND lt_obknr_po. CLEAR lt_obknr_po.
    ENDIF.
  ENDLOOP.

  CLEAR gt_ser03.
  LOOP AT gt_ser03.
    lt_obknr_po-obknr = gt_ser03-obknr.
    APPEND lt_obknr_po. CLEAR lt_obknr_po.
  ENDLOOP.
  SORT lt_obknr_po ASCENDING.
  DELETE ADJACENT DUPLICATES FROM lt_obknr_po.

  CLEAR gt_objk_po. REFRESH gt_objk_po.
  IF NOT lt_obknr_po[] IS INITIAL.
    DO.
      build_table lt_obknr_po lt_obknr_po_par.
      SELECT obknr obzae sernr taser FROM objk
      APPENDING TABLE gt_objk_po
      FOR ALL ENTRIES IN lt_obknr_po_par
      WHERE obknr = lt_obknr_po_par-obknr.
    ENDDO.
  ENDIF.
  SORT gt_objk_po BY obknr taser.

  syst-tfill = lines( gt_objk_po ).
  PERFORM prot_line USING syst-tfill 'ekpo_data gt_objk_po                          :'.

  PERFORM build_ekpo_data.
  PERFORM build_ekbe_data.
  PERFORM build_lips_po_data.

ENDFORM.                    " GET_EKPO_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_EKPO_DATA
*&---------------------------------------------------------------------*
FORM build_ekpo_data .
  DATA: lv_index_ser08 TYPE sytabix.

  CLEAR gt_ekpo. REFRESH gt_ekpo.

  CLEAR gt_ekpo_aux.
  LOOP AT gt_ekpo_aux.
    CLEAR gt_ser08_po.
    READ TABLE gt_ser08_po WITH KEY ebeln = gt_ekpo_aux-ebeln
                                    ebelp = gt_ekpo_aux-ebelp
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lv_index_ser08 = sy-tabix.
      LOOP AT gt_ser08_po FROM lv_index_ser08.
        IF gt_ser08_po-ebeln <> gt_ekpo_aux-ebeln.
          EXIT.
        ENDIF.
        IF gt_ser08_po-ebelp <> gt_ekpo_aux-ebelp.
          EXIT.
        ENDIF.
        MOVE-CORRESPONDING gt_ekpo_aux TO gt_ekpo.
        gt_ekpo-sernr = gt_ser08_po-sernr.
        APPEND gt_ekpo.
        CLEAR gt_ekpo.

      ENDLOOP.

    ELSE.
      MOVE-CORRESPONDING gt_ekpo_aux TO gt_ekpo.
      APPEND gt_ekpo.
      CLEAR gt_ekpo.
    ENDIF.
  ENDLOOP.

  CLEAR gt_ekpo_aux. REFRESH gt_ekpo_aux.
  SORT gt_ekpo BY aufnr sernr ebeln ebelp.

  syst-tfill = lines( gt_ekpo ).
  PERFORM prot_line USING syst-tfill 'BUILD ekpo_data                               :'.

ENDFORM.                    " BUILD_EKPO_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_EKBE_DATA
*&---------------------------------------------------------------------*
FORM build_ekbe_data .
  DATA: lv_index_ser03 TYPE syindex,
        lv_index_objk  TYPE syindex.

  DATA: lt_mseg_mblnr LIKE gt_mseg OCCURS 0 WITH HEADER LINE.

  CLEAR lt_mseg_mblnr. REFRESH lt_mseg_mblnr.

  lt_mseg_mblnr[] = gt_mseg[].
  SORT lt_mseg_mblnr BY sjahr mblnr.

  CLEAR gt_ekbe. REFRESH gt_ekbe.
  SORT gt_ekbe_aux BY vgabe ebeln ebelp zekkn.

  CLEAR gt_ekbe_aux.
  LOOP AT gt_ekbe_aux.
    CLEAR lv_index_ser03.
    IF gt_ekbe_aux-vgabe <> '1'.
      EXIT.
    ENDIF.

    CLEAR gt_mseg.
    READ TABLE gt_mseg WITH KEY sjahr = gt_ekbe_aux-gjahr
                                smbln = gt_ekbe_aux-belnr
    BINARY SEARCH.
    CHECK sy-subrc NE 0.
    CLEAR gt_mseg.
    READ TABLE lt_mseg_mblnr WITH KEY sjahr = gt_ekbe_aux-gjahr
                                      mblnr = gt_ekbe_aux-belnr
    BINARY SEARCH.
    CHECK sy-subrc NE 0.

    CLEAR gt_ser03.
    READ TABLE gt_ser03 WITH KEY mblnr = gt_ekbe_aux-belnr
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lv_index_ser03 = sy-tabix.
      CLEAR gt_ser03.
      LOOP AT gt_ser03 FROM lv_index_ser03.
        CLEAR lv_index_objk.
        IF gt_ser03-mblnr <> gt_ekbe_aux-belnr.
          EXIT.
        ENDIF.
        CLEAR gt_objk_po.
        READ TABLE gt_objk_po WITH KEY obknr = gt_ser03-obknr
                                       taser = 'SER03'
        BINARY SEARCH.
        lv_index_objk = sy-tabix.
        CLEAR gt_objk_po.
        LOOP AT gt_objk_po FROM lv_index_objk.
          IF gt_objk_po-obknr <> gt_ser03-obknr.
            EXIT.
          ENDIF.
          CHECK gt_objk_po-taser = 'SER03'.
          MOVE-CORRESPONDING gt_ekbe_aux TO gt_ekbe.
          gt_ekbe-aufnr = gt_ekpo-aufnr.
          gt_ekbe-sernr = gt_objk_po-sernr.
          APPEND gt_ekbe.
          CLEAR gt_ekbe.
        ENDLOOP.
      ENDLOOP.

    ELSE.
      MOVE-CORRESPONDING gt_ekbe_aux TO gt_ekbe.
      gt_ekbe-aufnr = gt_ekpo-aufnr.
      APPEND gt_ekbe.
      CLEAR gt_ekbe.
    ENDIF.

  ENDLOOP.

  CLEAR gt_ekbe_aux.   REFRESH gt_ekbe_aux.
  CLEAR gt_mseg. REFRESH gt_mseg.
  CLEAR lt_mseg_mblnr. REFRESH lt_mseg_mblnr.

  SORT gt_ekbe ASCENDING BY ebeln ebelp sernr.

  syst-tfill = lines( gt_ekbe ).
  PERFORM prot_line USING syst-tfill 'BUILD ekbe_data                               :'.

ENDFORM.                    " BUILD_EKBE_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_EKPO_LIST
*&---------------------------------------------------------------------*
FORM build_ekpo_list .

  DATA: lv_index_ekpo    TYPE sytabix,
        lv_index_ekbe    TYPE sytabix,
        lv_index_lips_po TYPE sytabix.

  DATA: ls_ekbe    LIKE gt_ekbe,
        ls_ekpo    LIKE gt_ekpo,
        ls_lips_po LIKE gt_lips_po.

  CLEAR gt_ekpo.
  READ TABLE gt_ekpo WITH KEY aufnr = gt_vbep-aufnr
                              sernr = gt_vbep-sernr
  BINARY SEARCH.
  IF sy-subrc NE 0.
    CLEAR gt_ekpo.
    READ TABLE gt_ekpo WITH KEY aufnr = gt_vbep-aufnr
                                sernr = gt_orderview-sernrrec
    BINARY SEARCH.
  ENDIF.
  IF sy-subrc NE 0 AND gt_vbap_aux-kwmeng = 1.
    CLEAR gt_ekpo.
    READ TABLE gt_ekpo WITH KEY aufnr = gt_vbep-aufnr
    BINARY SEARCH.
  ENDIF.

  IF sy-subrc EQ 0.
    lv_index_ekpo = sy-tabix.

    gt_orderview-flag_ekpo = c_true.
    gt_orderview-purchasenumber = gt_ekpo-ebeln.
    gt_orderview-ebelp = gt_ekpo-ebelp.
    gt_orderview-vendornummer = gt_ekpo-lifnr.
    gt_orderview-vendordate = gt_ekpo-bedat.
    gt_orderview-zyrmano = gt_ekpo-zzrmano.
    gt_orderview-vendorpreis = gt_ekpo-netwr.
    gt_orderview-hswae = gt_ekpo-waers.

    CLEAR gt_lfa1.
    READ TABLE gt_lfa1 WITH KEY lifnr = gt_ekpo-lifnr
    BINARY SEARCH.
    gt_orderview-vendor = gt_lfa1-name1.

    CLEAR gt_ekbe.
    READ TABLE gt_ekbe WITH KEY ebeln = gt_ekpo-ebeln
                                ebelp = gt_ekpo-ebelp
                                sernr = gt_ekpo-sernr
    BINARY SEARCH.
    IF sy-subrc NE 0.
      CLEAR gt_ekbe.
      READ TABLE gt_ekbe WITH KEY ebeln = gt_ekpo-ebeln
                                  ebelp = gt_ekpo-ebelp
                                  sernr = ' '.
    ENDIF.
    IF sy-subrc NE 0 AND gt_ekpo-menge = 1.
      CLEAR gt_ekbe.
      READ TABLE gt_ekbe WITH KEY ebeln = gt_ekpo-ebeln
                                  ebelp = gt_ekpo-ebelp
      BINARY SEARCH.
    ENDIF.

    IF sy-subrc EQ 0.
      lv_index_ekbe = sy-tabix.
      gt_orderview-vendorrueck = gt_ekbe-budat.

      IF NOT gt_ekbe-sernr IS INITIAL.
        DELETE gt_ekbe INDEX lv_index_ekbe.
      ELSE.
        IF gt_ekbe-menge = 1.
          DELETE gt_ekbe INDEX lv_index_ekbe.
        ELSE.
          ls_ekbe = gt_ekbe.
          ls_ekbe-menge = ls_ekbe-menge - 1.
          MODIFY gt_ekbe FROM ls_ekbe INDEX lv_index_ekbe TRANSPORTING menge.
        ENDIF.
      ENDIF.
    ENDIF.

    CLEAR gt_lips_po.
    READ TABLE gt_lips_po WITH KEY vgbel = gt_ekpo-ebeln
                                   vgpos = gt_ekpo-ebelp
                                   sernr = gt_ekpo-sernr
    BINARY SEARCH.
    IF sy-subrc NE 0 AND gt_ekpo-menge = 1.
      CLEAR gt_lips_po.
      READ TABLE gt_lips_po WITH KEY vgbel = gt_ekpo-ebeln
                                     vgpos = gt_ekpo-ebelp
      BINARY SEARCH.
    ENDIF.
    IF sy-subrc EQ 0.
      lv_index_lips_po = sy-tabix.
      gt_orderview-yliefvend = gt_lips_po-vbeln.
      gt_orderview-yliefvendpos = gt_lips_po-posnr.
      gt_orderview-yliefvendvdat = gt_lips_po-wadat_ist.
      gt_orderview-likp_erdat    = gt_lips_po-erdat.        "HB060216

      IF NOT gt_lips_po-sernr IS INITIAL.
        DELETE gt_lips_po INDEX lv_index_lips_po.
      ELSE.
        IF gt_lips_po-lfimg = 1.
          DELETE gt_lips_po INDEX lv_index_lips_po.
        ELSE.
          ls_lips_po-lfimg = gt_lips_po-lfimg - 1.
          MODIFY gt_lips_po FROM ls_lips_po INDEX lv_index_lips_po TRANSPORTING lfimg.
        ENDIF.
      ENDIF.
    ENDIF.

    IF NOT gt_ekpo-sernr IS INITIAL.
      DELETE gt_ekpo INDEX lv_index_ekpo.
    ELSE.
      IF gt_ekpo-menge = 1.
        DELETE gt_ekpo INDEX lv_index_ekpo.
      ELSE.
        ls_ekpo = gt_ekpo.
        ls_ekpo-menge = gt_ekpo-menge - 1.
        MODIFY gt_ekpo FROM ls_ekpo INDEX lv_index_ekpo TRANSPORTING menge.
      ENDIF.
    ENDIF.

  ENDIF.

ENDFORM.                    " BUILD_EKPO_LIST
*&---------------------------------------------------------------------*
*&      Form  GET_PRICES
*&---------------------------------------------------------------------*
FORM get_prices .
  DATA: lt_wktnr_par LIKE gt_wktnr OCCURS 0 WITH HEADER LINE.
  DATA: BEGIN OF lt_knumh OCCURS 0,
          knumh LIKE konp-knumh,
        END OF lt_knumh.

  DATA: lt_knumh_par LIKE lt_knumh OCCURS 0 WITH HEADER LINE.

  CLEAR gt_a501. REFRESH gt_a501.
  CLEAR gt_a502. REFRESH gt_a502.
  CLEAR gt_a503. REFRESH gt_a503.
  CLEAR gt_a504. REFRESH gt_a504.

  IF NOT gt_wktnr[] IS INITIAL.
    DO.
      build_table gt_wktnr lt_wktnr_par.
      SELECT * FROM a501 APPENDING TABLE gt_a501
      FOR ALL ENTRIES IN lt_wktnr_par
      WHERE kappl = 'V' AND
            kschl = 'ZSKZ' AND
            wktnr = lt_wktnr_par-wktnr AND
            wktps = lt_wktnr_par-wktps.

      SELECT * FROM a502 APPENDING TABLE gt_a502
      FOR ALL ENTRIES IN lt_wktnr_par
      WHERE kappl = 'V' AND
            kschl = 'ZSKZ' AND
            wktnr = lt_wktnr_par-wktnr.

      SELECT * FROM a503 APPENDING TABLE gt_a503
      FOR ALL ENTRIES IN lt_wktnr_par
      WHERE kappl = 'V' AND
            kschl = 'ZSKZ' AND
            wktnr = lt_wktnr_par-wktnr.
    ENDDO.

  ENDIF.

  SELECT * FROM a504 INTO TABLE gt_a504
  WHERE kappl = 'V' AND
        kschl = 'ZSKZ'.

  SORT gt_a501 BY kappl kschl wktnr wktps bemot.
  SORT gt_a502 BY kappl kschl wktnr matnr bemot.
  SORT gt_a503 BY kappl kschl wktnr bemot.
  SORT gt_a504 BY kappl kschl bemot.

  CLEAR lt_knumh. REFRESH lt_knumh.
  CLEAR gt_a501.
  LOOP AT gt_a501.
    lt_knumh-knumh = gt_a501-knumh.
    COLLECT lt_knumh.
    CLEAR lt_knumh.
  ENDLOOP.

  CLEAR gt_a502.
  LOOP AT gt_a502.
    lt_knumh-knumh = gt_a502-knumh.
    COLLECT lt_knumh.
    CLEAR lt_knumh.
  ENDLOOP.

  CLEAR gt_a503.
  LOOP AT gt_a503.
    lt_knumh-knumh = gt_a503-knumh.
    COLLECT lt_knumh.
    CLEAR lt_knumh.
  ENDLOOP.

  CLEAR gt_a504.
  LOOP AT gt_a504.
    lt_knumh-knumh = gt_a504-knumh.
    COLLECT lt_knumh.
    CLEAR lt_knumh.
  ENDLOOP.

  SORT lt_knumh.

  CLEAR gt_konp. REFRESH gt_konp.
  IF NOT lt_knumh[] IS INITIAL.
    DO.
      build_table lt_knumh lt_knumh_par.
      SELECT knumh kbetr FROM konp
      APPENDING TABLE gt_konp
      FOR ALL ENTRIES IN lt_knumh_par
      WHERE knumh = lt_knumh_par-knumh AND
            kappl = 'V' AND
            kschl = 'ZSKZ' AND
            loevm_ko EQ space.
    ENDDO.
  ENDIF.

  SORT gt_konp BY knumh.
ENDFORM.                    " GET_PRICES
