*&---------------------------------------------------------------------*
FORM build_vbfa_zw51_list USING if_vbap_aux STRUCTURE gt_vbap.

  DATA
  lt_vbrp          TYPE tyt_vbrp.

* Quick Fix Replace data element VBTYP with data element VBTYPL
* Transport SA2K902251 MKU20260331 RM S4HANA Custom Code 2.1 ADOPT 2508-614
* Replaced Code:
*  DATA:
*    lt_vbrp          TYPE tyt_vbrp,
*    lv_vbtyp         TYPE vbtyp,
  DATA lv_vbtyp         TYPE VBTYPL.

* End of Quick Fix
  DATA lv_netwr         TYPE netwr_fp.
  DATA lv_rechnr_storno TYPE vbeln_vf.
  DATA lv_fkdat_storno  TYPE fkdat.
  DATA lv_lines         TYPE i.

  FIELD-SYMBOLS:
    <ls_vbrp>  TYPE tys_vbrp,
    <ls_vbrp2> TYPE tys_vbrp.

  CLEAR gt_zw51_ser.
  READ TABLE gt_zw51_ser WITH KEY qmnum = gt_qmfe-qmnum
                                  fenum = gt_qmfe-fenum
  BINARY SEARCH.
  gwa_orderview-serialmeld = gt_zw51_ser-serge.

*  CLEAR gt_vbfa.
*  READ TABLE gt_vbfa WITH KEY vbelv = if_vbap_aux-vbeln
*                              posnv = if_vbap_aux-posnr
*  BINARY SEARCH.
*  IF sy-subrc EQ 0.
*    gwa_orderview-rechnummer = gt_vbfa-vbeln.
*
*    CLEAR gt_vbrp.

  "2001-250 Orderview - Rechnunganzeige Inkorrekt bei Stornos  HB130120
  "2004-280 Anpassung Orderview - Gesamtwert aller Fakturen
  "alle Belegpos addieren - bei Stornos (N) abziehen
  LOOP AT gt_vbrp ASSIGNING <ls_vbrp> WHERE vbelv = if_vbap_aux-vbeln
                                        AND posnv = if_vbap_aux-posnr.
    INSERT INITIAL LINE INTO TABLE lt_vbrp ASSIGNING <ls_vbrp2>.
    <ls_vbrp2> = <ls_vbrp>.
  ENDLOOP.

  IF NOT lt_vbrp[] IS INITIAL.
    lv_lines = lines( lt_vbrp ).
    IF lv_lines > 1.
      "zuerst Stornos, dann Fkaturen, letzte nummer am Schlußü
      SORT lt_vbrp BY vbtyp DESCENDING fkdat ASCENDING.
    ENDIF.

    CLEAR: lv_netwr,
           lv_rechnr_storno,
           lv_fkdat_storno.

    LOOP AT lt_vbrp ASSIGNING <ls_vbrp>.
      CASE <ls_vbrp>-vbtyp.
        WHEN 'N'.  "Storno
          lv_netwr = lv_netwr - <ls_vbrp>-netwr.

          "festhalten Stornodaten
          lv_rechnr_storno = <ls_vbrp>-vbeln.
          lv_fkdat_storno = <ls_vbrp>-vbeln.

        WHEN 'M'.
          lv_netwr = lv_netwr + <ls_vbrp>-netwr.

          "letzte Rechnung gewinnt...
          gwa_orderview-rechdatum    = <ls_vbrp>-fkdat.
          gwa_orderview-waers        = <ls_vbrp>-waerk.
          gwa_orderview-rechnummer   = <ls_vbrp>-vbeln.

        WHEN OTHERS.
          "????
      ENDCASE.
    ENDLOOP.

    "Entscheidung bei Wert 0, ob Faktura fortgeschieben werden soll - nicht falls letzter Beleg Storno
    IF lv_netwr IS INITIAL.
      IF lv_fkdat_storno >= gwa_orderview-rechdatum.
        IF lv_fkdat_storno = gwa_orderview-rechdatum.
          "Faktura am gleichen Tag
          IF lv_rechnr_storno > gwa_orderview-rechnummer.
            "Storno nach Rechnung
            CLEAR: gwa_orderview-rechdatum,
                  gwa_orderview-waers,
                  gwa_orderview-rechnummer.
          ENDIF.
        ELSE.
          "Storno nach Rechnung
          CLEAR: gwa_orderview-rechdatum,
                 gwa_orderview-waers,
                 gwa_orderview-rechnummer.
        ENDIF.
      ENDIF.    "BHE20210215 Unschärfe in Orderview Rechnungsnr    2102-363
    ENDIF.      "ENDIF falsch

    "Summe aller Stornos + Fakturen
    gwa_orderview-fakturapreis = lv_netwr .
  ENDIF.
ENDFORM.                    " BUILD_VBFA_ZW51_LIST
