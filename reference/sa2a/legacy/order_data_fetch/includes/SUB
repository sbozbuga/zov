FORM update_database .

*  data: LT_ORDERVIEW_PAR like GT_ORDERVIEW occurs 0 with header line,
*        LT_ORDERVIEW_ADD_PAR like GT_ORDERVIEW_ADD occurs 0 with header line.
*
*  ranges: LR_QMNUM for QMEL-QMNUM,
*          LR_QMNUM_PAR for QMEL-QMNUM.
*
*  clear LR_QMNUM. refresh LR_QMNUM.
*  LR_QMNUM-SIGN = 'I'.
*  LR_QMNUM-OPTION = 'EQ'.
*
*  clear GT_ORDERVIEW.
*  loop at GT_ORDERVIEW.
*    LR_QMNUM-LOW = GT_ORDERVIEW-QMNUM.
*    collect LR_QMNUM.
*  endloop.
*  clear LR_QMNUM.
*
*  if not LR_QMNUM[] is initial.
*    do.
*      BUILD_RANGE LR_QMNUM LR_QMNUM_PAR.
*      delete from /CELLAG/ORDVIEW where QMNUM in LR_QMNUM_PAR.
*      commit work.
*      delete from /CELLAG/ORD_ADD where QMNUM in LR_QMNUM_PAR.
*      commit work.
*    enddo.
*  endif.
*
*  do.
*    BUILD_TABLE GT_ORDERVIEW LT_ORDERVIEW_PAR.
**   Modify immer im DM Buffer {nta140401
*    refresh GT_ORDERVIEW_MOD.
*    loop at LT_ORDERVIEW_PAR.
*      clear GT_ORDERVIEW_MOD.
*      move-corresponding LT_ORDERVIEW_PAR to GT_ORDERVIEW_MOD.
*      append GT_ORDERVIEW_MOD.
*    endloop.
*    modify /CELLAG/ORDVIEW from table GT_ORDERVIEW_MOD.
**   MODIFY /cellag/ordview FROM TABLE lt_orderview_par. "}nta140401
*    commit work.
*  enddo.
*
*  do.
*    BUILD_TABLE GT_ORDERVIEW_ADD LT_ORDERVIEW_ADD_PAR.
*    modify /CELLAG/ORD_ADD from table LT_ORDERVIEW_ADD_PAR.
*    commit work.
*  enddo.

* Ausgangspunkt sind die geänderten Daten in GT_ORDERVIEW und GT_ORDERVIEW_ADD
* Blockweise Verarbeitung


  DATA: lv_idx_von       TYPE i,
        lv_idx_bis       TYPE i,
        lv_size          TYPE i,
        lv_archiv_set    TYPE i,
        lv_deleted       TYPE i,
        lv_open          TYPE i,
        lv_closed        TYPE i,
        lv_undef         TYPE i,

        lt_orderview2    TYPE STANDARD TABLE OF /cellag/ordview,
        lt_orderview_add TYPE STANDARD TABLE OF /cellag/ord_add,

        lo_err_sql       TYPE REF TO cx_sy_open_sql_db,
        lv_error_occured TYPE abap_bool.


  FIELD-SYMBOLS:
    <ls_orderview>      LIKE LINE OF gt_orderview,
    <ls_orderview2>     TYPE /cellag/ordview,
    <ls_orderview_add>  TYPE /cellag/ord_add,
    <ls_orderview_add2> TYPE /cellag/ord_add.

  CONSTANTS:
        co_blocksize     TYPE i VALUE '1000'.

  "--------------------------------------------
  "ORDERVIEW-Tabelle
  "--------------------------------------------
  "Daten in lokale Blocktabelle umkopieren
  CLEAR: lv_idx_bis, lv_archiv_set.
  DO.
    lv_idx_von = lv_idx_bis + 1.
    lv_idx_bis = lv_idx_von + co_blocksize.
    CLEAR: lt_orderview2[], lv_size, lo_err_sql.

    "Orderview-Daten
    LOOP AT gt_orderview ASSIGNING <ls_orderview> FROM lv_idx_von TO lv_idx_bis.
      INSERT INITIAL LINE INTO TABLE lt_orderview2 ASSIGNING <ls_orderview2>.
      MOVE-CORRESPONDING <ls_orderview> TO <ls_orderview2>.

      "numerische Wertgrenzen prüfen (Jobabbruch)
      IF <ls_orderview2>-repdauer < 0 OR <ls_orderview2>-repdauer > 999.
        <ls_orderview2>-repdauer = '999'.
      ENDIF.

      IF <ls_orderview2>-webaz < 0 OR <ls_orderview2>-webaz > 999.
        <ls_orderview2>-webaz = '999'.
      ENDIF.

      IF <ls_orderview2>-tat < 0 OR <ls_orderview2>-webaz > 999.
        <ls_orderview2>-tat = '999'.
      ENDIF.

      IF <ls_orderview2>-overdue < 0 OR <ls_orderview2>-overdue > 999.
        <ls_orderview2>-overdue = '999'.
      ENDIF.

      IF <ls_orderview2>-breakduration < 0 OR <ls_orderview2>-breakduration > 999.
        <ls_orderview2>-breakduration = '999'.
      ENDIF.

      IF <ls_orderview2>-bmeng < 0 OR <ls_orderview2>-bmeng > 999999.
        <ls_orderview2>-bmeng = '999999'.
      ENDIF.

      IF <ls_orderview2>-archivflag = abap_true.
        ADD 1 TO lv_archiv_set.
      ENDIF.
      ADD 1 TO lv_size.  "tatsächl. Anzahl

      CASE <ls_orderview2>-orderstatecompl.
        WHEN c_deleted.
          ADD 1 TO lv_deleted.
        WHEN c_open.
          ADD 1 TO lv_open.
        WHEN c_closed.
          ADD 1 TO lv_closed.
        WHEN OTHERS.
          ADD 1 TO lv_undef.
      ENDCASE.
    ENDLOOP.

    TRY.
        MODIFY /cellag/ordview FROM TABLE lt_orderview2.

      CATCH cx_sy_open_sql_db INTO lo_err_sql.
        lv_error_occured = abap_true.
    ENDTRY.
    COMMIT WORK.

    IF lv_error_occured = abap_true.
      "einzeln verbuchen.
      LOOP AT lt_orderview2 ASSIGNING <ls_orderview2>.
        TRY.
            MODIFY /cellag/ordview FROM <ls_orderview2>.
            COMMIT WORK.

          CATCH cx_sy_open_sql_db INTO lo_err_sql.
            WRITE:/.
            WRITE:/ '!!! Fehler Datenbankverbuchung. QMNUM/FENUM: ', <ls_orderview2>-qmnum, <ls_orderview2>-fenum.


        ENDTRY.
      ENDLOOP.
    ENDIF.

    "Endekriterium; weniger als die gesamte Blockgröße -> letzter Block erreicht!
    IF lv_size <= co_blocksize.
      EXIT.
    ENDIF.
  ENDDO.

  "--------------------------------------------
  "ORDERVIEW_ADD-Tabelle
  "--------------------------------------------

  "--------------------------------------------
  " ab 11/2023 - Text auch zur Z1/ZX-Meldung
  " dazumischen oder neuen Eintrag anlegen
  "--------------------------------------------
  PERFORM merge_remarks_rem.


  "Daten in lokale Blocktabelle umkopieren
  CLEAR: lv_idx_bis.
  DO.
    lv_idx_von = lv_idx_bis + 1.
    lv_idx_bis = lv_idx_von + co_blocksize.
    CLEAR:lt_orderview_add[], lv_size.

    "Orderview-Daten
    LOOP AT gt_orderview_add ASSIGNING <ls_orderview_add> FROM lv_idx_von TO lv_idx_bis.
      INSERT INITIAL LINE INTO TABLE lt_orderview_add ASSIGNING <ls_orderview_add2>.
      MOVE  <ls_orderview_add> TO <ls_orderview_add2>.  "gleiche Struktur
      ADD 1 TO lv_size.  "tatsächl. Anzahl
    ENDLOOP.
    MODIFY /cellag/ord_add FROM TABLE lt_orderview_add.
    COMMIT WORK.

    "Endekriterium; weniger als die gesamte Blockgröße -> letzter Block erreicht!
    IF lv_size <= co_blocksize.
      EXIT.
    ENDIF.
  ENDDO.

  "Workaround direkt angelegte Aktionen  HB230224
  "werden nach dem Anlegen nicht in ORDER_ADD geschrieben
  IF NOT gt_nomat[] IS INITIAL.
    PERFORM add_comments_zrsp01.
  ENDIF.


  PERFORM prot_line USING lv_archiv_set ''.   "Leerzeile
  PERFORM prot_line USING lv_archiv_set 'Archivflag gesetzt                            :'.
  PERFORM prot_line USING lv_deleted 'Status DELETED                                :'.
  PERFORM prot_line USING lv_closed 'Status CLOSED                                 :'.
  PERFORM prot_line USING lv_open 'Status OPEN                                   :'.
  IF NOT lv_undef IS INITIAL.
    PERFORM prot_line USING lv_undef 'Status ???                                    :'.
  ENDIF.
  PERFORM prot_line USING lv_archiv_set ''.   "Leerzeile
ENDFORM.                    " UPDATE_DATABASE
*&---------------------------------------------------------------------*
*&      Form  GET_QMFE_DATA
*&---------------------------------------------------------------------*
FORM get_qmfe_data .

  TYPES: BEGIN OF tys_ihpa,
           objnr TYPE j_objnr,
           parnr TYPE i_parnr,
         END OF tys_ihpa,
         tyt_ihpa   TYPE STANDARD TABLE OF tys_ihpa,
         tyt_ihpa_h TYPE HASHED TABLE OF tys_ihpa WITH UNIQUE KEY objnr,

         BEGIN OF tys_qmnum,
           qmnum TYPE qmnum,
         END OF tys_qmnum,
         tyt_qmnum TYPE STANDARD TABLE OF tys_qmnum.

  DATA: lt_ihpa           TYPE tyt_ihpa,
        lt_ihpa2          TYPE tyt_ihpa_h,
        lt_qmfe           TYPE tyt_qmfe,
        lv_objnr          TYPE j_objnr,
        lt_qmnum          TYPE tyt_qmnum,
        lv_count          TYPE i,
        lv_count_archiv   TYPE i,
        lt_ord_archiv     TYPE STANDARD TABLE OF zordview_archiv, "HB221021
        lt_ord_add_archiv TYPE STANDARD TABLE OF zord_add_archiv, "HB071021
        lt_qmfe2          TYPE tys_qmfe OCCURS 0 WITH HEADER LINE.


  DATA:
    lv_jobname   TYPE btcjob,
    lv_jobcount  TYPE btcjobcnt,
    lv_stepcount TYPE btcstepcnt,
    lv_variant   TYPE btcvariant,
    ls_tbtcp     TYPE tbtcp,
    ls_arcprot   TYPE zordview_arcprot.


  FIELD-SYMBOLS:
    <ls_qmfe>  TYPE tys_qmfe,
    <ls_ihpa>  TYPE tys_ihpa,
    <lv_qmnum> LIKE LINE OF lt_qmnum.

  IF sy-batch = abap_false.  "Ausführung im Vordergrund
    IF gv_auth_check_arch = abap_false.
      MESSAGE i022(zctdi_he).
*   Achtung. Ausführung kein Batch: max. 100 Meldungspos erlaubt!
    ENDIF.
  ENDIF.

* Get QMEL/QMFE data
  CLEAR gt_qmfe. REFRESH gt_qmfe.
  SELECT a~qmnum a~vbeln a~objnr
         a~qmart                                            "HB110713
          b~fenum b~aedat b~fegrp b~fecod b~otgrp b~oteil
          b~bautl
          b~erdat                                           "HB280715
          b~erzeit b~anzfehler b~kzloesch b~usr02 b~usr03
          b~usr08                                           "HB060514
          a~qwrnum                                          "HB200514
          a~bstnk                                           "HB230116
          b~usr18                                           "HB230918
          b~ymds                                            "HB150619
          b~fetxt                                           "HB220421
  FROM
      qmel AS a INNER JOIN qmfe AS b
  ON a~qmnum = b~qmnum
 INTO TABLE gt_qmfe
  WHERE a~qmnum IN s_qmnum AND
        ( a~qmart = 'Z1' OR
          a~qmart = 'ZX' ) AND                              "HB080713
        b~erdat IN s_erdat AND
        b~otgrp IN s_otgrp.
*        b~archivflag EQ space.

  sy-tfill = lines( gt_qmfe ).
  PERFORM prot_line USING syst-tfill 'Sätze lesen qmfe/qmel                         :'.

  IF gt_qmfe[] IS INITIAL.
    "Keine weitere Verarbeitung
    RETURN.
  ENDIF.


  "------------------------------------------------------------------
  "Suche nach Auftraggeber berücksichtigen?
  "------------------------------------------------------------------
  IF NOT s_parnr[] IS INITIAL.

    "Achtung: Partnernr nur 10-stellig (in 12stelligem Feld)
    "erste 2 0 weg
    LOOP AT s_parnr.
      SHIFT s_parnr-low LEFT BY 2 PLACES.
      MODIFY s_parnr.
    ENDLOOP.

    "Hilfstabelle qmfe
    lt_qmfe[] = gt_qmfe[].
    SORT lt_qmfe BY qmnum.
    DELETE ADJACENT DUPLICATES FROM lt_qmfe COMPARING qmnum.

    "Hilfstabelle mit IHPA-Schlüsseln aufbauen
    LOOP AT lt_qmfe ASSIGNING <ls_qmfe>.
      INSERT INITIAL LINE INTO TABLE lt_ihpa ASSIGNING <ls_ihpa>.
      CONCATENATE 'QM' <ls_qmfe>-qmnum INTO <ls_ihpa>-objnr.
    ENDLOOP.

    "nur die mit Auftraggeber angegeben
    SELECT objnr
           parnr
      FROM ihpa
      INTO TABLE lt_ihpa2
      FOR ALL ENTRIES IN lt_ihpa
      WHERE objnr = lt_ihpa-objnr
        AND parvw = 'AG'
        AND parnr IN s_parnr.

    "die nicht zu den angegebenen Auftraggebern gehören, rauswerfen
    CLEAR: lv_count.
    LOOP AT gt_qmfe ASSIGNING <ls_qmfe>.
      CONCATENATE 'QM' <ls_qmfe>-qmnum INTO lv_objnr.
      READ TABLE lt_ihpa2 ASSIGNING <ls_ihpa> WITH TABLE KEY objnr = lv_objnr.
      IF sy-subrc <> 0.
        DELETE gt_qmfe.
        ADD 1 TO lv_count.
      ENDIF.

    ENDLOOP.
    PERFORM prot_line USING lv_count 'Meldungspos  ausgeschlossen (Auftraggeber)    :'.
  ENDIF.


  "Normaluser max 100 Meldungspositionen
  IF gv_auth_check_arch = abap_false.
    lv_count = lines( gt_qmfe ).
    IF lv_count > 100.
      INSERT LINES OF gt_qmfe FROM 1 TO 100 INTO TABLE lt_qmfe2.
      gt_qmfe[] = lt_qmfe2[].  "alte Tabelle ersetzen
      CLEAR: lt_qmfe2[].

      IF sy-batch = abap_false.  "Ausführung im Vordergrund
        MESSAGE i023(zctdi_he) WITH lv_count.
*   &1 Meldungen selektiert. Nur 100 Meldungspositionemn werden aktualisiert.
      ENDIF.
    ENDIF.
  ENDIF.

  SORT gt_qmfe BY qmnum fenum.

  lv_count = lines( gt_qmfe ).
  PERFORM prot_line USING lv_count 'Meldungspositionen selektiert                 :'.

  "---------------------------------------------------------------
  " Archiv berücksichtigen; falls bereits in Archiv, dann diese Daten
  " im Archiv löschen, damit nicht doppelt vcrhanden   HB071021
  " nur prüfen wenn Option p_chkarc aktiviert; nicht bei TÄGLICH/BATCH
  "---------------------------------------------------------------
  IF pa_test = abap_false AND p_chkarc = abap_true.
    CLEAR: lv_count.
    SELECT qmnum FROM zordview_archiv
      INTO TABLE lt_qmnum
      FOR ALL ENTRIES IN gt_qmfe
      WHERE qmnum = gt_qmfe-qmnum.
    IF sy-subrc = 0.  "Es gibt Meldungen daraus bereits im Archiv

      lv_count = lines( lt_qmnum ).
      PERFORM prot_line USING lv_count 'Meldungspositionen bereits im Archiv          :'.

      "Verschieben aus Archivtabelle in /CELLAG/ORDVIEW
      PERFORM show_progress USING TEXT-l18.

      "HB151221 Protokollierung, falls Daten in Archivtabelle gelöscht

      "Grunddaten Protokollsatz
      GET TIME.
      ls_arcprot-created_date   = sy-datum.
      ls_arcprot-created_time   = sy-uzeit.
      ls_arcprot-number_entries = lv_count.
      ls_arcprot-username       = sy-uname.

      CALL FUNCTION 'GET_JOB_RUNTIME_INFO'
        IMPORTING
          jobcount        = lv_jobcount
          jobname         = lv_jobname
          stepcount       = lv_stepcount
        EXCEPTIONS
          no_runtime_info = 1
          OTHERS          = 2.
      IF sy-subrc = 0.
        "Jobinfos beschaffen
        SELECT SINGLE * FROM tbtcp INTO ls_tbtcp
          WHERE jobname   = lv_jobname
          AND   jobcount  = lv_jobcount
          AND   stepcount = lv_stepcount.
        IF sy-subrc = 0.
          ls_arcprot-jobname = lv_jobname.
          ls_arcprot-variant = ls_tbtcp-variant.
        ENDIF.
      ENDIF.
      INSERT zordview_arcprot FROM ls_arcprot.
      COMMIT WORK.


      "Alle zugehörigen Positionen löschen; Verarbeitung pro Meldung
      LOOP AT lt_qmnum ASSIGNING <lv_qmnum>.
        SELECT * FROM zordview_archiv
          INTO TABLE lt_ord_archiv
          WHERE qmnum = <lv_qmnum>.
        IF sy-subrc = 0.
          ADD sy-dbcnt TO lv_count_archiv.

          "Hauptdaten
          MODIFY /cellag/ordview FROM TABLE lt_ord_archiv.
          DELETE FROM zordview_archiv WHERE qmnum = <lv_qmnum>.


          "Zusatzdaten
          SELECT * FROM zord_add_archiv
            INTO TABLE lt_ord_add_archiv
            WHERE qmnum = <lv_qmnum>.
          IF sy-subrc = 0.
            "hier mit MODIFY arbeiten, falls doch schon mal was vorhanden ist
            "in der "aktiven" Tabelle anlegen, damit diese nicht verloren gehen
            "Auftrags- und Meldungsdaten manuell ergänzt
            MODIFY /cellag/ord_add FROM TABLE lt_ord_add_archiv.
            DELETE FROM zord_add_archiv WHERE qmnum = <lv_qmnum>.
          ENDIF.
          "Daten vorhanden
          COMMIT WORK.
        ENDIF.
      ENDLOOP.
      PERFORM prot_line USING lv_count_archiv 'Meldungspos  aus Archivtabellen gelöscht      :'.
    ENDIF.

    "Ausgabe wegen Selektionszeit
    PERFORM prot_line USING lv_count 'Prüfung erfolgt Meldungen bereits im  Archiv  :'.

  ENDIF.


ENDFORM.                    " GET_QMFE_DATA
