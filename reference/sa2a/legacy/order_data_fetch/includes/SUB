FORM fill_vbep_fields USING if_vbep STRUCTURE gt_vbep
                            if_not_assigned.

  DATA:
    lv_objectid   TYPE cdhdr-objectid,
    lv_index_del  TYPE sytabix,
    lv_index_objk TYPE sytabix,
    lv_lines_objk TYPE sytabix.

  FIELD-SYMBOLS:
    <ls_mkpf> TYPE tys_mkpf.                                "HB031018

  gt_orderview-flag_vbep = c_true.
  CLEAR gt_vbap_rep.
  READ TABLE gt_vbap_rep WITH KEY vbeln = if_vbep-vbeln
                                  posnr = if_vbep-posnr
  BINARY SEARCH.

  gt_orderview-fanumber = if_vbep-aufnr.
  gt_orderview-fadate = if_vbep-erdat.
  gt_orderview-rsende = if_vbep-gltrp.

  gt_orderview-kostv = if_vbep-kostv.                       "HB040618

*-->DEL HB250914
*  CLEAR lv_objectid.
*  CONCATENATE sy-mandt if_vbep-autyp if_vbep-aufnr INTO lv_objectid.
*  READ TABLE gt_cdhdr_aufnr WITH KEY objectid = lv_objectid
*  BINARY SEARCH.
*  IF sy-subrc EQ 0.
*    gt_orderview-fastart = gt_cdhdr_aufnr-udate.
*  ENDIF.
*<--DEL HB250914

  gt_orderview-auftragsendesoll = if_vbep-edatu.

  CLEAR gt_tj30t.
  READ TABLE gt_tj30t WITH KEY txt04 = 'WFER'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    CLEAR gt_jest.
    READ TABLE gt_jest WITH KEY objnr = if_vbep-objnr
                                stat = gt_tj30t-estat
                                inact = ' '
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      gt_orderview-faend = gt_jest-udate.
    ENDIF.
  ENDIF.

  CLEAR gt_tj30t.
  READ TABLE gt_tj30t WITH KEY txt04 = 'HOLD'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    CLEAR gt_jest.
    READ TABLE gt_jest WITH KEY objnr = if_vbep-objnr
                                stat = gt_tj30t-estat
                               inact = ' '
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      gt_orderview-breakstart = gt_jest-udate.
    ENDIF.

    CLEAR gt_jest.
    READ TABLE gt_jest WITH KEY objnr = if_vbep-objnr
                                stat = gt_tj30t-estat
                                inact = c_true
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      gt_orderview-breakend = gt_jest-udate.

      CLEAR gt_jcds_e0003.
      READ TABLE gt_jcds_e0003 WITH KEY objnr = if_vbep-objnr
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        gt_orderview-breakstart = gt_jcds_e0003-udate.
      ENDIF.
    ENDIF.
  ENDIF.

  IF NOT gt_orderview-breakstart IS INITIAL AND
     NOT gt_orderview-breakend IS INITIAL.
    gt_orderview-breakduration =
    gt_orderview-breakend - gt_orderview-breakstart.
  ENDIF.


  "2507-721 Workaround: Serialnr in SD-Auftrag nicht korrekt
  "kein Datum für „Etikettendruck
  "fehlt SERNRAUFNR
  "Sernr aus Werkstattauftrag ermitteln und diesen nehmen

  DATA:
    lv_sernr TYPE  gernr.

  "Init
  lv_sernr = if_vbep-sernr.

  "Serialnr bestimmen aus Werkstatt-Auftrag
  IF NOT if_vbep-aufnr IS INITIAL.
    CLEAR gt_afih.
    READ TABLE gt_afih WITH KEY aufnr = if_vbep-aufnr
     BINARY SEARCH.
    IF sy-subrc EQ 0.
      CLEAR gt_objk_aufnr.
      LOOP AT  gt_objk_aufnr WHERE obknr = gt_afih-obknr
                               AND sernr > space.
        lv_sernr = gt_objk_aufnr-sernr.
      ENDLOOP.
    ENDIF.
  ENDIF.


  "Es kann mehrere Buchungsbelege geben; alle prüfen     "HB031018
  LOOP AT gt_mkpf ASSIGNING <ls_mkpf> WHERE xblnr = if_vbep-aufnr
                                        AND sernr = lv_sernr.
    IF gt_orderview-otgrp <> 'ZRS4S'.
      IF <ls_mkpf>-bldat < co_einlagerdate.
        gt_orderview-einlagerdate = <ls_mkpf>-bldat.
      ENDIF.
    ENDIF.

    IF gt_orderview-fast_good_parts = abap_false.           "HB251018
      gt_orderview-labelprint = <ls_mkpf>-bldat.
    ELSE.
      gt_orderview-labelprint = gt_orderview-receivedate.   "HB251018
      gt_orderview-einlagerdate = gt_orderview-receivedate. "HB251018
    ENDIF.

    CLEAR gt_mseg_aussond.
    READ TABLE gt_mseg_aussond WITH KEY mblnr = <ls_mkpf>-mblnr
                                        mjahr = <ls_mkpf>-mjahr
                                        bwart = '309'
                                        charg = 'DEF'
    BINARY SEARCH.
    IF sy-subrc NE 0.
      CLEAR gt_mseg_aussond.
      READ TABLE gt_mseg_aussond WITH KEY mblnr = <ls_mkpf>-mblnr
                                          mjahr = <ls_mkpf>-mjahr
                                          bwart = '344'
                                          charg = 'DEF'
      BINARY SEARCH.
    ENDIF.

    IF NOT gt_mseg_aussond IS INITIAL.
      gt_orderview-aussonderung = <ls_mkpf>-bldat.
    ENDIF.
  ENDLOOP.

  IF NOT if_vbep-aufnr IS INITIAL.
    CLEAR gt_afih.
    READ TABLE gt_afih WITH KEY aufnr = if_vbep-aufnr
     BINARY SEARCH.

    CHECK sy-subrc EQ 0.
    CLEAR gt_objk_aufnr.
    READ TABLE gt_objk_aufnr WITH KEY obknr = gt_afih-obknr
                                      sernr = lv_sernr
    BINARY SEARCH.

    IF sy-subrc EQ 0.
      lv_index_objk = sy-tabix.
* Serialnumber found
      gt_orderview-sernraufnr = gt_objk_aufnr-sernr.
      IF NOT gt_objk_aufnr-ihnum IS INITIAL.
* Z2-Meldung in the object list
        CLEAR gt_qmfe_rm_qmnum.
        READ TABLE gt_qmfe_rm_qmnum WITH KEY qmnum = gt_objk_aufnr-ihnum
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        CLEAR gt_qmfe_rm.
        READ TABLE gt_qmfe_rm WITH KEY aufnr = gt_qmfe_rm_qmnum-aufnr
                                       matnr = gt_qmfe_rm_qmnum-matnr
                                       serialnr = gt_qmfe_rm_qmnum-serialnr
                                       qmnum = gt_qmfe_rm_qmnum-qmnum
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        lv_index_del = sy-tabix.
        PERFORM build_remarks_data.
        DELETE gt_qmfe_rm INDEX lv_index_del.
      ELSE.
* No Z2-Meldung in the object list
        CLEAR gt_qmfe_rm.
        READ TABLE gt_qmfe_rm WITH KEY aufnr = if_vbep-aufnr
                                       matnr = gt_objk_aufnr-matnr
                                       serialnr = gt_objk_aufnr-sernr
        BINARY SEARCH.
        IF sy-subrc EQ 0.
* Z2-Meldung was found
          lv_index_del = sy-tabix.
          PERFORM build_remarks_data.
          DELETE gt_qmfe_rm INDEX lv_index_del.
        ELSEIF sy-subrc NE 0.
          gt_orderview-flag_qmferm = c_true.
        ENDIF.
      ENDIF.
      DELETE gt_objk_aufnr INDEX lv_index_objk.

    ELSEIF sy-subrc NE 0.
* Serialnumber not found

* Not assigned serial numbers?
      CLEAR gt_objk_aufnr.
      READ TABLE gt_objk_aufnr WITH KEY obknr = gt_afih-obknr
      BINARY SEARCH.
      lv_index_objk = sy-tabix.
      CASE if_not_assigned.
        WHEN ' '.
          CHECK gt_vbap_aux-kwmeng = 1.
          CLEAR lv_lines_objk.
          CLEAR gt_objk_aufnr.
          LOOP AT gt_objk_aufnr FROM lv_index_objk.
            IF gt_objk_aufnr-obknr <> gt_afih-obknr.
              EXIT.
            ENDIF.
            lv_lines_objk = lv_lines_objk + 1.
            IF lv_lines_objk GE 2.
              EXIT.
            ENDIF.
          ENDLOOP.

          CHECK lv_lines_objk EQ 1.
          CLEAR gt_objk_aufnr.
          READ TABLE gt_objk_aufnr WITH KEY obknr = gt_afih-obknr
          BINARY SEARCH.
      ENDCASE.

      gt_orderview-sernraufnr = gt_objk_aufnr-sernr.

      IF NOT gt_objk_aufnr-ihnum IS INITIAL.
* Z2-Meldung in the object list
        CLEAR gt_qmfe_rm_qmnum.
        READ TABLE gt_qmfe_rm_qmnum WITH KEY qmnum = gt_objk_aufnr-ihnum
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        CLEAR gt_qmfe_rm.
        READ TABLE gt_qmfe_rm WITH KEY aufnr = gt_qmfe_rm_qmnum-aufnr
                                       matnr = gt_qmfe_rm_qmnum-matnr
                                       serialnr = gt_qmfe_rm_qmnum-serialnr
                                       qmnum = gt_qmfe_rm_qmnum-qmnum
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        lv_index_del = sy-tabix.
        PERFORM build_remarks_data.
        DELETE gt_qmfe_rm INDEX lv_index_del.
      ELSE.
* No Z2-Meldung in the object list
        CLEAR gt_qmfe_rm.
        READ TABLE gt_qmfe_rm WITH KEY aufnr = if_vbep-aufnr
                                       matnr = gt_objk_aufnr-matnr
                                       serialnr = gt_objk_aufnr-sernr
        BINARY SEARCH.
        IF sy-subrc EQ 0.
* Z2-Meldung was found
          lv_index_del = sy-tabix.
          PERFORM build_remarks_data.
          DELETE gt_qmfe_rm INDEX lv_index_del.
        ELSEIF sy-subrc NE 0.
          gt_orderview-flag_qmferm = c_true.
        ENDIF.
      ENDIF.

      DELETE gt_objk_aufnr INDEX lv_index_objk.

    ENDIF.

  ENDIF.

ENDFORM.                    " FILL_VBEP_FIELDS
