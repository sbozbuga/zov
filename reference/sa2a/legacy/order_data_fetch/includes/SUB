FORM get_mara_data .

  DATA: lt_matnr_par LIKE gt_matnr OCCURS 0 WITH HEADER LINE.

  SORT gt_matnr BY matnr.

  CLEAR gt_mara. REFRESH gt_mara.
  CLEAR gt_makt. REFRESH gt_makt.
  CLEAR gt_mbew. REFRESH gt_mbew.

  IF NOT gt_matnr[] IS INITIAL.
    DO.
      build_table gt_matnr lt_matnr_par.

      SELECT matnr matkl normt extwg mfrpn mfrnr FROM mara
      APPENDING TABLE gt_mara
      FOR ALL ENTRIES IN lt_matnr_par
      WHERE matnr = lt_matnr_par-matnr.

      SELECT matnr maktx FROM makt
      APPENDING TABLE gt_makt
      FOR ALL ENTRIES IN lt_matnr_par
      WHERE matnr = lt_matnr_par-matnr AND
            spras = sy-langu.

      SELECT matnr bwkey verpr stprs peinh FROM mbew
      APPENDING TABLE gt_mbew
      FOR ALL ENTRIES IN lt_matnr_par
      WHERE matnr = lt_matnr_par-matnr.
    ENDDO.
  ENDIF.

  SORT gt_mara BY matnr.
  SORT gt_makt BY matnr.
  SORT gt_mbew BY matnr bwkey.

  syst-tfill = lines( gt_mara ).
  PERFORM prot_line USING syst-tfill 'BUILD mara, makt, mbew                        :'.

ENDFORM.                    " GET_MARA_DATA
