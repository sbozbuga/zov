*&---------------------------------------------------------------------*
FORM get_merkmal_data .

  DATA: BEGIN OF lt_objek OCCURS 0,
          objek LIKE rmclf-objek,
        END OF lt_objek.

  DATA: lt_objek_par LIKE lt_objek OCCURS 0 WITH HEADER LINE.

  DATA: ls_wktnr LIKE gt_wktnr.

  DATA: lt_values       LIKE ibvalue0 OCCURS 0 WITH HEADER LINE,
        lv_key          TYPE /cellag/cnfobjkey,
        lv_atinn_output TYPE atinn,
        lv_pack(16)     TYPE p DECIMALS 2,
        lv_tabix        TYPE sytabix.

  FIELD-SYMBOLS: <f>.

  CLEAR gt_cabn. REFRESH gt_cabn.
  SELECT atinn atnam FROM cabn INTO TABLE gt_cabn
  WHERE ( atnam = 'CCM_HKZ3' OR
          atnam = 'C_INV_COMP_SUM' OR
          atnam = 'CCM_MATUI' OR
          atnam = 'CCM_OOP' OR
          atnam = 'CCM_SYSTEM' OR
          atnam = 'CCM_MATNO_01' OR                         "HB090215
          atnam = 'CCM_MATNO_02' OR
          atnam = 'CCM_MATNO_03' OR
          atnam = 'CCM_VENDOR' OR
          atnam = 'CCM_VENDOR_ADR' OR
          atnam = 'CCM_VENDOR_INFO_1' OR
          atnam = 'CCM_VENDOR_INFO_2' OR
          atnam = 'CCM_ZINFO1' OR
          atnam = 'CCM_ZINFO2' OR
          atnam = 'CCM_ZINFO3' ).

  SORT gt_cabn BY atinn.

  CLEAR lt_objek. REFRESH lt_objek.

  CLEAR gt_knmt.
  LOOP AT gt_knmt.
    CLEAR gwa_objek.
    MOVE-CORRESPONDING gt_knmt TO gwa_objek.
    lt_objek-objek = gwa_objek.
    COLLECT lt_objek.
    CLEAR lt_objek.
  ENDLOOP.

  CLEAR gt_ausp. REFRESH gt_ausp.
  IF NOT lt_objek[] IS INITIAL.
    DO.
      build_table lt_objek lt_objek_par.
      SELECT * FROM ausp APPENDING TABLE gt_ausp
      FOR ALL ENTRIES IN lt_objek_par
      WHERE objek = lt_objek_par-objek.
    ENDDO.
  ENDIF.

  SORT gt_ausp BY objek.

  CLEAR lv_atinn_output.
  CLEAR gt_cabn.
  READ TABLE gt_cabn WITH KEY atnam = 'C_INV_COMP_SUM'.
  lv_atinn_output = gt_cabn-atinn.

  CLEAR gt_wktnr.
  LOOP AT gt_wktnr.
    CLEAR lv_tabix.
    lv_tabix = sy-tabix.

    CLEAR ls_wktnr.
    MOVE-CORRESPONDING gt_wktnr TO ls_wktnr.

    CLEAR: lv_key,
           lv_pack.

    lv_key-vbeln_co = gt_wktnr-wktnr.
    lv_key-posnr_co = gt_wktnr-wktps.

    CLEAR lt_values. REFRESH lt_values.
    CALL FUNCTION '/CELLAG/CSC_CNF_GET'
      EXPORTING
        is_key    = lv_key
      TABLES
        et_values = lt_values.

    CLEAR lt_values.
    READ TABLE lt_values WITH KEY atinn = lv_atinn_output.
    IF sy-subrc EQ 0.
      ASSIGN lv_pack TO <f> DECIMALS 2.
      <f> = lt_values-atflv.
      ls_wktnr-wert = lv_pack.
      MODIFY gt_wktnr INDEX lv_tabix
      FROM ls_wktnr TRANSPORTING wert.
    ENDIF.
  ENDLOOP.

  SORT gt_wktnr BY wktnr wktps.
ENDFORM.                    " GET_MERKMAL_DATA
