FORM get_pspnr.


  DATA: lt_vbap  TYPE tyt_vbap,
        lt_wktps TYPE tyt_wktps.

  lt_vbap[] = gt_vbap_aux[].

  CHECK NOT  lt_vbap[] IS INITIAL.

  SELECT vbeln
         posnr
         ps_psp_pnr
    FROM vbap
    INTO TABLE lt_wktps
    FOR ALL ENTRIES IN lt_vbap
    WHERE vbeln = lt_vbap-wktnr
      AND posnr = lt_vbap-wktps.

  SORT lt_wktps BY vbeln posnr.
  DELETE ADJACENT DUPLICATES FROM lt_wktps COMPARING vbeln posnr.
  gt_wktps_h[] = lt_wktps[].

ENDFORM.                    " GET_PSPNR