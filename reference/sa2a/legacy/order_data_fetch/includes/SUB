FORM create_gsi_status_1 CHANGING cf_subrc.

  DATA: ls_notifheader LIKE bapi2080_nothdre,
        lt_notifactv   LIKE bapi2080_notactvi OCCURS 0 WITH HEADER LINE,
        lt_return      LIKE bapiret2 OCCURS 0 WITH HEADER LINE,
        ls_notifactv   TYPE bapi2080_notactvi,
        ls_nomat       TYPE tys_nomat,                      "HB230224

        lv_index       TYPE syindex,
        lv_rest        TYPE bdmng,
        lv_manum       TYPE qmma-manum,
        lv_matxt       TYPE mftext.

  DATA:
    lt_resb TYPE STANDARD TABLE OF resb.

  FIELD-SYMBOLS:
    <ls_resb> TYPE resb.

  CLEAR lt_notifactv. REFRESH lt_notifactv.
  CLEAR lt_return. REFRESH lt_return.

  CLEAR gt_qmma_gsi.
  READ TABLE gt_qmma_gsi WITH KEY qmnum = gt_orderview_add-qmnum_z2
  BINARY SEARCH.

  CLEAR lv_manum.
  lv_manum = gt_qmma_gsi-manum + 1.

  lt_notifactv-act_key = lv_manum.
  lt_notifactv-act_sort_no = lv_manum.
  lt_notifactv-act_codegrp = 'ZRGSIST'.
  lt_notifactv-act_code = '1'.
  APPEND lt_notifactv.
  CLEAR lt_notifactv.


  CALL FUNCTION 'BAPI_SERVNOT_ADD_DATA'
    EXPORTING
      number    = gt_orderview_add-qmnum_z2
      i_bapi    = ' '
    TABLES
      notifactv = lt_notifactv
      return    = lt_return.

  CLEAR lt_return.
  READ TABLE lt_return WITH KEY type = 'E'.
  IF sy-subrc EQ 0.
    cf_subrc = 4.
    EXIT.
  ENDIF.

  CLEAR ls_notifheader.
  CLEAR lt_return. REFRESH lt_return.
  CALL FUNCTION 'BAPI_SERVNOT_SAVE'
    EXPORTING
      number      = gt_orderview_add-qmnum_z2
    IMPORTING
      notifheader = ls_notifheader
    TABLES
      return      = lt_return.


  CLEAR lt_return.
  READ TABLE lt_return WITH KEY type = 'E'.
  IF sy-subrc EQ 0.
    cf_subrc = 4.
    RETURN.
  ENDIF.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait = abap_true.

  "---------------------------------------------------------------------------
  " auch Aktion ZRSP01 anlegen 2011-984
  "---------------------------------------------------------------------------

  CLEAR: lv_matxt.

  READ TABLE gt_resb WITH KEY aufnr = gt_orderview-fanumber
    BINARY SEARCH.
  IF sy-subrc = 0.
    lv_index = sy-tabix.

    "--------------------------------------------------------------
    " Prüfen auf offene Bedarfe; falls vorhanden, in lokale Tabelle
    "--------------------------------------------------------------
    CLEAR: gt_resb, lt_resb[].
    LOOP AT gt_resb FROM lv_index.
      IF gt_resb-aufnr <> gt_orderview-fanumber.
        EXIT.
      ENDIF.
      "Noch Bedarf vorhanden?
      lv_rest = gt_resb-bdmng - gt_resb-enmng.
      IF lv_rest > 0.
        INSERT INITIAL LINE INTO TABLE lt_resb ASSIGNING <ls_resb>.
        MOVE-CORRESPONDING gt_resb TO <ls_resb>.
      ENDIF.
    ENDLOOP.
    IF NOT lt_resb[] IS INITIAL.
      lv_matxt = zcl_order_data_fetch=>create_z2_mma_zrsp01(
         EXPORTING
           iv_qmnum = gt_orderview_add-qmnum_z2
           iv_werks = gt_orderview-werks
           it_resb  = lt_resb ).
      IF NOT lv_matxt IS INITIAL.                           "HB230224
        "Zwischenspeichern in interner Tabelle; am Ende direkt in ORDER_ADD
        ls_nomat-qmnum = gt_orderview-qmnum.
        ls_nomat-fenum = gt_orderview-fenum.
        ls_nomat-counter = gt_orderview-counter.
        ls_nomat-qmnum_z2 = gt_orderview_add-qmnum_z2.
        ls_nomat-matxt = lv_matxt.
        APPEND ls_nomat TO gt_nomat.
      ENDIF.

    ENDIF.
  ENDIF.

  "Aktualisierung ZMTS_SFC: 2011-970 Erweiterung FETCH Programm
  CALL METHOD zcl_order_data_fetch=>update_z2_zmts_sfc
    EXPORTING
      iv_aufnr    = gt_orderview-fanumber
      iv_act_code = '1'
      iv_acttext  = lv_matxt.


  CLEAR lt_return. REFRESH lt_return.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
    EXPORTING
      wait   = c_true
    IMPORTING
      return = lt_return.


  CLEAR lt_return.
  READ TABLE lt_return WITH KEY type = 'E'.
  IF sy-subrc EQ 0.
    cf_subrc = 4.
    EXIT.
  ENDIF.

  gt_orderview_add-aedat = ls_notifheader-changed_on.
  gt_orderview_add-aeuhr = ls_notifheader-changed_at.
  gt_orderview_add-aenam = ls_notifheader-changed_by.
  gt_orderview_add-changes = c_true.
  gt_orderview_add-status = '1'.

ENDFORM.                    " CREATE_GSI_STATUS_1
