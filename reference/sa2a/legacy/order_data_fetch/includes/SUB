FORM build_jest_data .

  RANGES: lr_objnr_par FOR jest-objnr,
          lr_stat FOR jest-stat.

  CLEAR lr_stat. REFRESH lr_stat.
  lr_stat-sign = 'I'.
  lr_stat-option = 'EQ'.

  CLEAR gt_tj30t.
  READ TABLE gt_tj30t WITH KEY txt04 = 'WFER'
  BINARY SEARCH.
  lr_stat-low = gt_tj30t-estat.
  APPEND lr_stat.

  CLEAR gt_tj30t.
  READ TABLE gt_tj30t WITH KEY txt04 = 'HOLD'
  BINARY SEARCH.
  lr_stat-low = gt_tj30t-estat.
  APPEND lr_stat.

  CLEAR gt_tj02t.
  READ TABLE gt_tj02t WITH KEY txt04 = 'LÖVM'
  BINARY SEARCH.
  lr_stat-low = gt_tj02t-istat.
  APPEND lr_stat.

  READ TABLE gt_tj02t WITH KEY txt04 = 'TABG'
  BINARY SEARCH.
  lr_stat-low = gt_tj02t-istat.
  APPEND lr_stat.
  CLEAR lr_stat.

  CLEAR gt_jest. REFRESH gt_jest.
  CLEAR gt_jcds_e0003. REFRESH gt_jcds_e0003.

  CLEAR gt_tj30t.
  READ TABLE gt_tj30t WITH KEY txt04 = 'HOLD'
  BINARY SEARCH.

  SORT gr_objnr.
  IF NOT gr_objnr[] IS INITIAL.
    DO.
      build_range gr_objnr lr_objnr_par.

      SELECT a~objnr a~stat a~inact a~chgnr
      b~udate
      FROM jest AS a
      INNER JOIN jcds AS b
      ON a~objnr = b~objnr AND
      a~stat = b~stat AND
      a~chgnr = b~chgnr
      APPENDING TABLE gt_jest
      WHERE a~objnr IN lr_objnr_par AND
            a~stat IN lr_stat.

      SELECT objnr chgnr udate FROM jcds
      APPENDING TABLE gt_jcds_e0003
      WHERE objnr IN lr_objnr_par AND
            stat EQ gt_tj30t-estat AND
            inact EQ space.
    ENDDO.
  ENDIF.

  SORT gt_jest BY objnr stat inact.
  SORT gt_jcds_e0003 BY objnr ASCENDING chgnr DESCENDING.
  DELETE ADJACENT DUPLICATES FROM gt_jcds_e0003 COMPARING objnr.

  syst-tfill = lines( gt_jest ).
  PERFORM prot_line USING syst-tfill 'BUILD jest_data                               :'.

ENDFORM.                    " BUILD_JEST_DATA
