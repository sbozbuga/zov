*&      Form  BUILD_QMFE_DATA
*&---------------------------------------------------------------------*
FORM build_qmfe_data .

  RANGES: lr_katalogart FOR qpct-katalogart.

  DATA: BEGIN OF lt_qmnum OCCURS 0,
          qmnum LIKE qmfe-qmnum,
        END OF lt_qmnum.

  DATA: lt_qmnum_par LIKE lt_qmnum OCCURS 0 WITH HEADER LINE.

*--> workaround wegen Überholer HB100613
  DATA: lt_otab  TYPE abap_sortorder_tab,
        ls_otab  TYPE abap_sortorder,
        lt_dfies TYPE TABLE OF dfies.

  FIELD-SYMBOLS:
    <ls_dfies>      TYPE dfies,
    <ls_vbeln_miss> TYPE tys_vbeln_miss,
    <ls_qmfe>       LIKE LINE OF gt_qmfe,
    <ls_orderview>  TYPE /cellag/ordview.
*<--

  CLEAR lt_qmnum. REFRESH lt_qmnum.
  LOOP AT gt_orderview_changed ASSIGNING <ls_orderview>.

    READ TABLE gt_qmfe WITH KEY qmnum = <ls_orderview>-qmnum
    BINARY SEARCH.
    IF sy-subrc NE 0.
      lt_qmnum-qmnum = <ls_orderview>-qmnum.
      COLLECT lt_qmnum.
      CLEAR lt_qmnum.
    ENDIF.
  ENDLOOP.

  IF NOT lt_qmnum[] IS INITIAL.
    DO.
      build_table lt_qmnum lt_qmnum_par.

      SELECT a~qmnum a~vbeln a~objnr
             a~qmart                                        "HB110813
        b~fenum b~aedat b~fegrp b~fecod b~otgrp b~oteil
        b~bautl
        b~erdat                                             "HB280715
        b~erzeit b~anzfehler b~kzloesch
        b~usr02 b~usr03
        b~usr08                                             "HB080514
        a~qwrnum                                            "HB230918
        a~bstnk                                             "HB230918
        b~usr18                                             "HB230918
        b~ymds                                              "HB150619
        b~fetxt                                             "HB220421
      FROM qmel AS a INNER JOIN qmfe AS b
      ON a~qmnum = b~qmnum APPENDING TABLE gt_qmfe
      FOR ALL ENTRIES IN lt_qmnum_par
      WHERE a~qmnum = lt_qmnum_par-qmnum AND
            ( a~qmart = 'Z1' OR
              a~qmart = 'ZX' ).                             "HB080713

    ENDDO.
  ENDIF.

  SORT gt_qmfe BY qmnum fenum.

  IF gt_qmfe[] IS INITIAL.
    RETURN.
    CLEAR sscrfields-ucomm.
* Error message
*    MESSAGE e000(/cellag/messages_sd) WITH text-e01.
  ENDIF.


  PERFORM get_without_vbeln.

  "-------------------------------------------------------------------
  " Workaround; mehrere Auftragsnummern pro Meldung; korrekte
  " Auftragnummer nachtragen                                HB260715
  "-------------------------------------------------------------------
  LOOP AT gt_vbeln_miss ASSIGNING <ls_vbeln_miss>.
    READ TABLE gt_qmfe WITH KEY qmnum = <ls_vbeln_miss>-qmnum
                                fenum = <ls_vbeln_miss>-fenum
                       ASSIGNING <ls_qmfe>
                       BINARY SEARCH.
    IF sy-subrc = 0.
      <ls_qmfe>-vbeln = <ls_vbeln_miss>-vbeln.
*        <ls_qmfe>-posnr = <ls_vbeln_miss>-posnr.
    ENDIF.
  ENDLOOP.


  CLEAR gt_matnr. REFRESH gt_matnr.
  CLEAR gr_objnr. REFRESH gr_objnr.
  CLEAR gr_vbeln. REFRESH gr_vbeln.
  CLEAR lt_qmnum. REFRESH lt_qmnum.

  gr_vbeln-sign = 'I'.
  gr_vbeln-option = 'EQ'.

  gr_objnr-sign = 'I'.
  gr_objnr-option = 'EQ'.

  CLEAR gt_qmfe.
  LOOP AT gt_qmfe.
    IF NOT gt_qmfe-bautl IS INITIAL.
      gt_matnr-matnr = gt_qmfe-bautl.
      COLLECT gt_matnr.
      CLEAR gt_matnr.
    ENDIF.
    IF NOT gt_qmfe-vbeln IS INITIAL.
      gr_vbeln-low = gt_qmfe-vbeln.
      COLLECT gr_vbeln.
    ENDIF.

    IF NOT gt_qmfe-objnr IS INITIAL.
      gr_objnr-low = gt_qmfe-objnr.
      COLLECT gr_objnr.
    ENDIF.

    lt_qmnum-qmnum = gt_qmfe-qmnum.
    COLLECT lt_qmnum.
    CLEAR lt_qmnum.
  ENDLOOP.

  CLEAR gr_vbeln.
  CLEAR gr_objnr.

  CLEAR gt_zw51_ser. REFRESH gt_zw51_ser.
  CLEAR gt_qmsm_zpepo. REFRESH gt_qmsm_zpepo.
  IF NOT lt_qmnum[] IS INITIAL.
    SORT lt_qmnum.
    DO.
      build_table lt_qmnum lt_qmnum_par.
      SELECT qmnum fenum lfdnr serge FROM /cellag/zw51_ser
      APPENDING TABLE gt_zw51_ser
      FOR ALL ENTRIES IN lt_qmnum_par
      WHERE qmnum = lt_qmnum_par-qmnum.

      SELECT qmnum manum erldat fenum FROM qmsm
      APPENDING TABLE gt_qmsm_zpepo
      FOR ALL ENTRIES IN lt_qmnum_par
      WHERE qmnum = lt_qmnum_par-qmnum AND
            mnkat = '2' AND
            mngrp = 'ZPEPO' AND
            mncod = '1300' AND
            kzloesch EQ space.
    ENDDO.
  ENDIF.

  SORT gt_zw51_ser BY qmnum fenum lfdnr.
  SORT gt_qmsm_zpepo BY qmnum fenum manum.

  CLEAR lr_katalogart. REFRESH lr_katalogart.
  lr_katalogart-sign = 'I'.
  lr_katalogart-option = 'EQ'.
  CLEAR gt_tq80.
  LOOP AT gt_tq80.
    lr_katalogart-low = gt_tq80-otkat.
    APPEND lr_katalogart.
    lr_katalogart-low = gt_tq80-fekat.
    APPEND lr_katalogart.
  ENDLOOP.
  CLEAR lr_katalogart.
  SORT lr_katalogart.

  CLEAR gt_qpct. REFRESH gt_qpct.
  SELECT katalogart codegruppe code kurztext FROM qpct INTO TABLE gt_qpct
*  WHERE ( katalogart = '5' OR katalogart = '9' OR katalogart = 'B' OR katalogart = 'Z' ) AND
   WHERE katalogart IN lr_katalogart AND
         sprache = sy-langu.

  CLEAR gt_qpgt. REFRESH gt_qpgt.
  SELECT katalogart codegruppe kurztext FROM qpgt INTO TABLE gt_qpgt
*  WHERE ( katalogart = '5' OR katalogart = '9' OR katalogart = 'B' OR katalogart = 'Z' ) AND
   WHERE katalogart IN lr_katalogart AND
         sprache = sy-langu.

  SORT gt_qpct BY katalogart codegruppe code.
  SORT gt_qpgt BY katalogart codegruppe.

  CLEAR gt_repdau. REFRESH gt_repdau.
  SELECT * FROM /cellag/repdau INTO TABLE gt_repdau.

*  SORT gt_repdau DESCENDING BY kunnr bautl /cellag/akz kvgr1 matkl.  " -fhu130308
*  SORT gt_repdau DESCENDING BY wktnr wktps /cellag/akz kunwe.         " +fhu130308

  "wegen Überholer workaround dynamisch sortieren HB100613
  CALL FUNCTION 'DDIF_FIELDINFO_GET'
    EXPORTING
      tabname        = '/CELLAG/REPDAU'
*     FIELDNAME      = ' '
      langu          = sy-langu
*     LFIELDNAME     = ' '
*     ALL_TYPES      = ' '
*     GROUP_NAMES    = ' '
*     UCLEN          =
* IMPORTING
*     X030L_WA       =
*     DDOBJTYPE      =
*     DFIES_WA       =
*     LINES_DESCR    =
    TABLES
      dfies_tab      = lt_dfies
*     FIXED_VALUES   =
    EXCEPTIONS
      not_found      = 1
      internal_error = 2
      OTHERS         = 3.
  IF sy-subrc <> 0.
* MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
*         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

  "alte oder neue Version?
  CLEAR: ls_otab, lt_otab[], gv_is_repdau_old, gv_sortcrit.
  READ TABLE lt_dfies WITH KEY fieldname = 'WKTNR' ASSIGNING <ls_dfies>.
  IF sy-subrc = 0.
    "neue Tabellenstruktur
    "SORT gt_repdau DESCENDING BY wktnr wktps /cellag/akz kunwe.         " +fhu130308
    ls_otab-name       = 'WKTNR'.
    ls_otab-descending = 'X'.
    gv_sortcrit = ls_otab-name.

    APPEND ls_otab TO lt_otab.
    ls_otab-name = 'WKTPS'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = '/CELLAG/AKZ'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = 'KUNWE'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.
  ELSE.
    "alte Tabellenstruktur
    "SORT gt_repdau DESCENDING BY kunnr bautl /cellag/akz kvgr1 matkl.  " -fhu130308

    gv_is_repdau_old   = abap_true.
    ls_otab-name       = 'KUNNR'.
    ls_otab-descending = 'X'.
    gv_sortcrit = ls_otab-name.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = 'BAUTL'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = '/CELLAG/AKZ'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = 'KVGR1'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.

    ls_otab-name = 'MATKL'.
    CONCATENATE gv_sortcrit ls_otab-name INTO gv_sortcrit SEPARATED BY space.
    APPEND ls_otab TO lt_otab.
  ENDIF.

  "dynamisch
  SORT gt_repdau BY (lt_otab).
ENDFORM.                    " BUILD_QMFE_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_EKBE_DATA_OLD
*&---------------------------------------------------------------------*
FORM build_ekbe_data_old.
  DATA: lv_index_ser03 TYPE syindex,
        lv_index_objk  TYPE syindex.

  CLEAR gt_ekbe. REFRESH gt_ekbe.
  SORT gt_ekbe_aux BY vgabe ebeln ebelp zekkn.

  CLEAR gt_ekbe_aux.
  LOOP AT gt_ekbe_aux.
    CLEAR lv_index_ser03.
    IF gt_ekbe_aux-vgabe <> '1'.
      EXIT.
    ENDIF.
    CLEAR gt_mseg.
    READ TABLE gt_mseg WITH KEY sjahr = gt_ekbe_aux-gjahr
                                smbln = gt_ekbe_aux-belnr
    BINARY SEARCH.
    CHECK sy-subrc NE 0.

    CLEAR gt_ekpo.
    READ TABLE gt_ekpo WITH KEY ebeln = gt_ekbe_aux-ebeln
                                ebelp = gt_ekbe_aux-ebelp
    BINARY SEARCH.

    CLEAR gt_ser03.
    READ TABLE gt_ser03 WITH KEY mblnr = gt_ekbe_aux-belnr
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lv_index_ser03 = sy-tabix.
      CLEAR gt_ser03.
      LOOP AT gt_ser03 FROM lv_index_ser03.
        CLEAR lv_index_objk.
        IF gt_ser03-mblnr <> gt_ekbe_aux-belnr.
          EXIT.
        ENDIF.
        CLEAR gt_objk_po.
        READ TABLE gt_objk_po WITH KEY obknr = gt_ser03-obknr
                                       taser = 'SER03'
        BINARY SEARCH.
        lv_index_objk = sy-tabix.
        CLEAR gt_objk_po.
        LOOP AT gt_objk_po FROM lv_index_objk.
          IF gt_objk_po-obknr <> gt_ser03-obknr.
            EXIT.
          ENDIF.
          CHECK gt_objk_po-taser = 'SER03'.
          MOVE-CORRESPONDING gt_ekbe_aux TO gt_ekbe.
          gt_ekbe-aufnr = gt_ekpo-aufnr.
          gt_ekbe-sernr = gt_objk_po-sernr.
          APPEND gt_ekbe.
          CLEAR gt_ekbe.
        ENDLOOP.
      ENDLOOP.

    ELSE.
      MOVE-CORRESPONDING gt_ekbe_aux TO gt_ekbe.
      gt_ekbe-aufnr = gt_ekpo-aufnr.
      APPEND gt_ekbe.
      CLEAR gt_ekbe.
    ENDIF.

  ENDLOOP.

  REFRESH gt_ekbe_aux. CLEAR gt_ekbe_aux.

  SORT gt_ekbe ASCENDING BY aufnr sernr ebeln ebelp.

ENDFORM.                    " BUILD_EKBE_DATA_OLD
