FORM get_vttp_data .

  RANGES: lr_lips_par FOR lips-vbeln.

  "Performance wegen SORTED Table

  DATA: lt_vttp TYPE STANDARD TABLE OF tys_vttp.

  FIELD-SYMBOLS:
    <ls_vttp> TYPE tys_vttp.

  IF NOT gr_lips[] IS INITIAL.
    DO.
      build_range gr_lips lr_lips_par.

      SELECT
        a~tknum
        a~tpnum
        a~vbeln
        b~exti1                                             "HB060514
        b~datbg
        b~daten                                             "HB050614
        b~uaten                                             "HB220816
        b~tdlnr
        c~trackn
        c~tracktstmp                                        "HB101213
        c~trkstat                                           "MK120416
        c~xsitd                                               "HB260920  Deutsche Bahn 2 Dienstleister
      FROM vttp AS a
        INNER JOIN vttk AS b
          ON a~tknum = b~tknum
        LEFT OUTER JOIN vtrkh AS c
          ON a~tknum = c~uevbeln
      APPENDING TABLE lt_vttp
      WHERE a~vbeln IN lr_lips_par.
    ENDDO.
