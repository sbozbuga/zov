FORM build_data .

  DATA: lv_counter      TYPE qanzfehl4,
        lv_counter_key  TYPE /cellag/ordview-counter,       "HB040222
        lv_del_counter  TYPE i,                             "HB040222  Zähler für Reduz Auftragsmenge
        ls_qmfe         LIKE LINE OF gt_qmfe,
        lv_kwmeng       LIKE vbap-kwmeng,
        lv_index_rep    TYPE syindex,
        lv_index_lif    TYPE syindex,
        lv_index_vbep   TYPE syindex,
        lv_lif_found(1).

  CLEAR gt_orderview_add. REFRESH gt_orderview_add.
  CLEAR gt_orderview. REFRESH gt_orderview.
  CLEAR gwa_orderview.
  CLEAR gt_qmfe.

  LOOP AT gt_qmfe.
    lv_counter = 1.
    ls_qmfe = gt_qmfe.  "zwischensichern

    PERFORM build_qmfe_list.

    PERFORM build_mara_list.

    CLEAR gt_vbap_aux.
    READ TABLE gt_vbap_aux WITH KEY qmnum = gt_qmfe-qmnum
                                    fenum = gt_qmfe-fenum
    BINARY SEARCH.

    IF sy-subrc EQ 0.

      PERFORM build_vbap_list USING gt_vbap_aux.

      "Werk muss bestimmt sein
      PERFORM build_marc_list.                              "HB230716

      PERFORM get_nlpti USING gt_vbap_aux.                  "HB261013

      PERFORM build_adrc_list USING gt_vbap_aux.

      PERFORM build_knvv_list USING gt_vbap_aux.

      PERFORM build_merkmal_list USING gt_vbap_aux.

      PERFORM build_vbfa_zw51_list USING gt_vbap_aux.

      PERFORM get_fastart_from_old.    "FAStart aus gespeicherten Daten lesen wegen Performance

      gt_orderview = gwa_orderview.
      CLEAR lv_kwmeng.
      lv_kwmeng = gt_vbap_aux-kwmeng.
      IF lv_kwmeng IS INITIAL.
        lv_kwmeng = 1.
      ENDIF.

      CASE gt_vbap_aux-pstyv.
          "---------------------------------------------------------
        WHEN 'ZS4S' OR 'ZL4L'.
          "---------------------------------------------------------
          WHILE lv_counter LE lv_kwmeng.

            "Abbruch Vereinzelung, falls kein SERNP                 HB230716
            IF lv_counter > 1 AND gwa_orderview-sernp IS INITIAL.
              EXIT.
            ENDIF.

            gt_orderview = gwa_orderview.
            CLEAR lv_lif_found.

            CLEAR gt_vbap_ret.
            READ TABLE gt_vbap_ret WITH KEY vbeln = gt_vbap_aux-vbeln
                                            uepos = gt_vbap_aux-posnr
            BINARY SEARCH.
            IF sy-subrc EQ 0.

              "Absagegrund festhalten
              gt_orderview-abgru_ret   = gt_vbap_ret-abgru. "HB121213
              gt_orderview-abgru_aedat = gt_vbap_ret-aedat. "HB161213

              "Kennzeichen Fast Good Parts
              IF gt_vbap_ret-pstyv = 'ZREG'.                "HB251018
                gt_orderview-fast_good_parts = abap_true.
              ENDIF.

              lv_index_rep = sy-tabix.
              CLEAR lv_lif_found.
              CLEAR gt_vbap_ret.
              LOOP AT gt_vbap_ret FROM lv_index_rep.
                IF gt_vbap_ret-vbeln <> gt_vbap_aux-vbeln.
                  EXIT.
                ENDIF.
                IF gt_vbap_ret-uepos <> gt_vbap_aux-posnr.
                  EXIT.
                ENDIF.


                IF NOT gt_lips_ret[] IS INITIAL.
                  PERFORM build_lips_102 USING gt_vbap_ret
                                         CHANGING lv_lif_found.
                ENDIF.
                IF lv_lif_found EQ c_true.
                  PERFORM build_vbep_list USING gt_vbap_ret-vbeln
                                                gt_vbap_ret-uepos
                                                gt_lips_ret-sernr.
                ENDIF.
                IF lv_lif_found EQ c_true.
                  EXIT.
                ENDIF.
              ENDLOOP.
            ENDIF.

            PERFORM build_ekpo_list.
* Search for delivery with serialnumber
            CLEAR gt_vbap_lif.
            READ TABLE gt_vbap_lif WITH KEY vbeln = gt_vbap_aux-vbeln
                                            uepos = gt_vbap_aux-posnr
            BINARY SEARCH.
            IF sy-subrc EQ 0.
              lv_index_lif = sy-tabix.
              CLEAR lv_lif_found.

              CLEAR gt_vbap_lif.
              LOOP AT gt_vbap_lif FROM lv_index_lif.

                IF gt_vbap_lif-vbeln <> gt_vbap_aux-vbeln.
                  EXIT.
                ENDIF.
                IF gt_vbap_lif-uepos <> gt_vbap_aux-posnr.
                  EXIT.
                ENDIF.

                CASE gt_vbap_lif-vkgru.
                  WHEN '103'.   "S4S
                    IF NOT gt_lips_lif[] IS INITIAL.
                      PERFORM build_lips_103_list USING gt_vbap_lif-vbeln
                                                        gt_vbap_lif-posnr
                                                        gt_vbep-sernr
                                                  CHANGING lv_lif_found.
                    ENDIF.
                    IF lv_lif_found EQ c_true.
                      EXIT.
                    ENDIF.
                  WHEN '106'.                               "L4L/ADR
                    "Lagerort aus VKPos nehmen      HB170213
                    "falls noch nicht beliefert, Lagerort aus VKPos nehmen (von Erfassung)
                    "bisher nur definiert für Tauschvorgänge, Postyp ZDNS (=VKGRU 106)
                    IF gt_orderview-lieferlager IS INITIAL.
                      gt_orderview-lieferlager = gt_vbap_lif-lgort.
                      gt_orderview-lieferwerk  = gt_vbap_lif-werks.
                    ENDIF.

                    IF NOT gt_lips_lif[] IS INITIAL.
                      PERFORM build_lips_106_list USING gt_vbap_lif-vbeln
                                                        gt_vbap_lif-posnr
                                                  CHANGING lv_lif_found.
                    ENDIF.
                    IF lv_lif_found EQ c_true.
                      EXIT.
                    ENDIF.
                ENDCASE.
              ENDLOOP.
            ENDIF.

            gt_orderview-counter = lv_counter.

            PERFORM build_calculated_fields.
            PERFORM build_vbap_prices USING gt_vbap_aux.


            IF NOT gt_orderview_add IS INITIAL.
              gt_orderview_add-qmnum = gt_orderview-qmnum.
              gt_orderview_add-fenum = gt_orderview-fenum.
              gt_orderview_add-counter = gt_orderview-counter.

              APPEND gt_orderview_add.
              CLEAR gt_orderview_add.
            ENDIF.


            APPEND gt_orderview.
            CLEAR gt_orderview.

            CLEAR: gt_lips_ret,
                   gt_lips_lif,
                   gt_vbap_zirl,
                   gt_vbap_ret,
                   gt_vbep,
                   gt_qmfe,
                   gt_vbap,
                   gt_qmfe_rm.

            ADD 1 TO lv_counter.
          ENDWHILE.


          "---------------------------------------------------------
        WHEN 'ZADR' OR
             'ZADE' OR                                      "HB270416
             'ZARS'.                                        "HB200517
          " Reparatur pos. is not necessary to have a delivery position
          "---------------------------------------------------------

          WHILE lv_counter LE lv_kwmeng.

            "Abbruch Vereinzelung, falls kein SERNP                 HB230716
            IF lv_counter > 1 AND gwa_orderview-sernp IS INITIAL.
              EXIT.
            ENDIF.

            gt_orderview = gwa_orderview.
            CLEAR lv_lif_found.

            CLEAR gt_vbap_lif.
            READ TABLE gt_vbap_lif WITH KEY vbeln = gt_vbap_aux-vbeln
                                            uepos = gt_vbap_aux-posnr
            BINARY SEARCH.
            IF sy-subrc EQ 0.

              lv_index_lif = sy-tabix.
              CLEAR lv_lif_found.

              CLEAR gt_vbap_lif.
              LOOP AT gt_vbap_lif FROM lv_index_lif.
                IF gt_vbap_lif-vkgru =  '106'.              "L4L/ADR
                  "Lagerort aus VKPos nehmen      HB170213
                  "falls noch nicht beliefert, Lagerort aus VKPos nehmen (von Erfassung)
                  "bisher nur definiert für Tauschvorgänge, Postyp ZDNS (=VKGRU 106)
                  IF gt_orderview-lieferlager IS INITIAL.
                    gt_orderview-lieferlager = gt_vbap_lif-lgort.
                    gt_orderview-lieferwerk  = gt_vbap_lif-werks.
                  ENDIF.
                ENDIF.

                IF gt_vbap_lif-vbeln <> gt_vbap_aux-vbeln.
                  EXIT.
                ENDIF.
                IF gt_vbap_lif-uepos <> gt_vbap_aux-posnr.
                  EXIT.
                ENDIF.
                IF NOT gt_lips_lif[] IS INITIAL.
                  PERFORM build_lips_106_list USING gt_vbap_lif-vbeln
                                                    gt_vbap_lif-posnr
                                              CHANGING lv_lif_found.
                ENDIF.
                IF lv_lif_found EQ c_true.
                  EXIT.
                ENDIF.
              ENDLOOP.

            ENDIF.

            CLEAR gt_vbap_ret.
            READ TABLE gt_vbap_ret WITH KEY vbeln = gt_vbap_aux-vbeln
                                            uepos = gt_vbap_aux-posnr
            BINARY SEARCH.

            IF sy-subrc EQ 0.

              "Absagegrund festhalten
              gt_orderview-abgru_ret   = gt_vbap_ret-abgru. "HB121213
              gt_orderview-abgru_aedat = gt_vbap_ret-aedat. "HB070717

              "Kennzeichen Fast Good Parts
              IF gt_vbap_ret-pstyv = 'ZREG'.                "HB251018
                gt_orderview-fast_good_parts = abap_true.
              ENDIF.

              lv_index_rep = sy-tabix.
              CLEAR gt_vbap_ret.
              LOOP AT gt_vbap_ret FROM lv_index_rep.
                IF gt_vbap_ret-vbeln <> gt_vbap_aux-vbeln.
                  EXIT.
                ENDIF.
                IF gt_vbap_ret-uepos <> gt_vbap_aux-posnr.
                  EXIT.
                ENDIF.

                IF NOT gt_lips_ret[] IS INITIAL.
                  PERFORM build_lips_102 USING gt_vbap_ret
                                         CHANGING lv_lif_found.
                ENDIF.
                IF lv_lif_found EQ c_true.
                  PERFORM build_vbep_list USING gt_vbap_ret-vbeln
                                                gt_vbap_ret-uepos
                                                gt_lips_ret-sernr.

                ENDIF.
                IF lv_lif_found EQ c_true.
                  EXIT.
                ENDIF.
              ENDLOOP.
            ENDIF.

            PERFORM build_ekpo_list.

            gt_orderview-counter = lv_counter.

            PERFORM build_calculated_fields.
            PERFORM build_vbap_prices USING gt_vbap_aux.

            IF NOT gt_orderview_add IS INITIAL.
              gt_orderview_add-qmnum = gt_orderview-qmnum.
              gt_orderview_add-fenum = gt_orderview-fenum.
              gt_orderview_add-counter = gt_orderview-counter.
              APPEND gt_orderview_add.
              CLEAR gt_orderview_add.
            ENDIF.

            APPEND gt_orderview.
            CLEAR gt_orderview.
            ADD 1 TO lv_counter.

            CLEAR: gt_lips_ret,
                   gt_lips_lif,
                   gt_vbap_zirl,
                   gt_vbap_ret,
                   gt_vbep,
                   gt_qmfe,
                   gt_vbap,
                   gt_qmfe_rm.

          ENDWHILE.

          "an dieser Stelle ist bei ZFL noch kein Lieferdatum eingetragen
          "Closed-Prüfung funktioniert nicht   HB161214
*          "---------------------------------------------------------
*        WHEN 'ZODS' OR    "Out delivery service
*             'ZODL' OR    "Out delivery product
*             'ZOHT' OR    "Out delivery prod.TZ
*             'ZOHS' OR    "Out delivery service
*             'ZOHL'.      "Out delivery product
*          "---------------------------------------------------------
*
*            PERFORM build_calculated_fields.  "HB131214
*            gwa_orderview = gt_orderview.

      ENDCASE.

      WHILE lv_counter LE lv_kwmeng.
        "Abbruch Vereinzelung, falls kein SERNP                 HB230716
        IF lv_counter > 1 AND gwa_orderview-sernp IS INITIAL.
          EXIT.
        ENDIF.
        gt_orderview = gwa_orderview.
        gt_orderview-counter = lv_counter.
        APPEND gt_orderview.
        CLEAR gt_orderview.
        lv_counter = lv_counter + 1.
      ENDWHILE.

      "Falls Auftragsmenge reduziert wurde, werden COUNTER-Pos > kwmeng nicht mehr benötigt HB040222
      IF lv_kwmeng > 1 AND pa_test = abap_false.
        lv_counter_key = lv_kwmeng. "umkonvertieren
        DELETE FROM /cellag/ordview WHERE qmnum   = gwa_orderview-qmnum
                                      AND fenum   = gwa_orderview-fenum
                                      AND counter > lv_counter_key.
        IF sy-subrc = 0.
          "Es gab welche; aufsummieren
          lv_del_counter = lv_del_counter + sy-dbcnt.
          COMMIT WORK.
        ENDIF.
      ENDIF.

    ELSEIF sy-subrc NE 0.
      gt_orderview = gwa_orderview.
      gt_orderview-counter = 1.

      "2004-299 Orderview Tabelle ZORDVIEW_CLOS_EX
      "nicht mehr erforderlich, da ausser KL alle abgesagten da
*      gt_orderview-qmnum = gt_qmfe-qmnum.
*      gt_orderview-fenum = gt_qmfe-fenum.
*      PERFORM build_calculated_fields.

      APPEND gt_orderview.
      CLEAR gt_orderview.

    ENDIF.

    CLEAR lv_counter.
    CLEAR gwa_orderview.

  ENDLOOP.

  IF lv_del_counter > 0.                                    "HB040222
    PERFORM prot_line USING lv_del_counter 'CounterPos Löschen wegen Reduzierung Auftrmng :'.
  ENDIF.

  SORT gt_vbap_aux BY vbeln posnr.

  "Retourenanlieferung ergänzen bei Rückwärtslogistik ZIL
  PERFORM get_retoure_zil.                                  "HB300914

  PERFORM fill_missing_data.

  PERFORM bemot_from_zmir_pos.                              "HB140718

  PERFORM get_trackdata_vendor.


  SORT gt_orderview BY qmnum fenum counter.
  SORT gt_orderview_add BY qmnum fenum counter.


  PERFORM set_fastart_date.                                 "HB250914

  PERFORM set_kostv_rest.                                   "HB040618

  PERFORM get_matkost_aufm.                                 "HB240517

  "Hilfstabellen für Zuordnung Z1 und ZX     HB200514
  PERFORM build_z1_zx_add.

  PERFORM add_zx_z1_link.                                   "HB200514

  PERFORM we_vendor_upos.                                   "HB030814

  PERFORM vendor_auftragsbezogen.                           "HB090417

  "auch ZMTO, ZMT1                                            "HB160621
  PERFORM handle_zfl.                                       "HB161214

*  PERFORM vereinzelung.                                     "HB280114


  "ursprüngliche Serialnr setzen aus /CELLAG/ZW51_SER
  PERFORM set_serialrec_original.                           "HB111214

  PERFORM check_faktstatus_delivery.                        "HB181215  setzt Archivflag

  PERFORM get_ta_qdat.                                      "HB231215

  PERFORM vereinzelung.                                     "HB020222 Position nach hinten; ARCHIVFLAG ggf. gesetzt


  IF pa_test IS INITIAL.
    PERFORM update_gsi_status.
  ENDIF.

  SORT gt_orderview BY qmnum fenum counter.
  SORT gt_orderview_add BY qmnum fenum counter.

ENDFORM.                    " BUILD_DATA
