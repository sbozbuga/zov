FORM fill_lips_lif_fields USING if_lips_lif STRUCTURE gt_lips_lif.

  DATA:
    lv_time          TYPE sy-uzeit,
    ls_vttp          TYPE tys_vttp,
    ls_vttp_transmed TYPE tys_vttp.

  FIELD-SYMBOLS:
    <ls_vttp> TYPE tys_vttp.                                "HB260920

  gt_orderview-flag_lif = c_true.
  gt_orderview-serialdeliver = if_lips_lif-serge.
  gt_orderview-sernrlif = if_lips_lif-sernr.
  gt_orderview-lieferlager = if_lips_lif-lgort.
  gt_orderview-lieferwerk = if_lips_lif-werks.
  gt_orderview-deliverdate = if_lips_lif-wadat_ist.
  gt_orderview-delnotenumber = if_lips_lif-vbeln.
  gt_orderview-delnoteposnr = if_lips_lif-posnr.
  gt_orderview-vsbed = if_lips_lif-vsbed.
  gt_orderview-wbsta = if_lips_lif-wbsta.
  gt_orderview-matnr_out = if_lips_lif-matnr.
*  gt_orderview-kundewunschterm = if_lips_lif-edatu.   "HB230918

  gt_orderview-route           = if_lips_lif-route.         "HB270614


  IF NOT if_lips_lif-tduhr IS INITIAL.
    gt_orderview-readytoship = if_lips_lif-tddat.
  ENDIF.

  IF gt_orderview-matnr_out <> gt_orderview-ctdisapmatnummer.
    CLEAR gt_mara.
    READ TABLE gt_mara WITH KEY matnr = gt_orderview-matnr_out
    BINARY SEARCH.
    gt_orderview-partnumberout = gt_mara-mfrpn.
  ELSE.
    gt_orderview-partnumberout = gt_orderview-partnumberalc.
  ENDIF.

  "----------------------------------------------------------------------------
  " Sonderbehandlung Deutsche Bahn -  2009-878  Orderview FETCH -Trackingnummer
  " hier gibt es 2 Einträge TOP und TRANSMED; Als AWB immer die von  TRANSMED nehmen
  " falls es sonstige Projekte mit mehreren gibt, dann die nehmen die befüllt nehmen (sortiert nach XSITD)
  "----------------------------------------------------------------------------
  CLEAR:
    ls_vttp_transmed,
    ls_vttp.

  LOOP AT gt_vttp ASSIGNING <ls_vttp> WHERE vbeln = if_lips_lif-vbeln. "HB260920

    IF <ls_vttp>-xsitd = co_xsitd_transmed.  "'TRANSMED'.
      ls_vttp_transmed = <ls_vttp>.
    ENDIF.

    IF ls_vttp-trackn IS INITIAL.
      ls_vttp-trackn = <ls_vttp>-trackn.
    ENDIF.
    IF ls_vttp-datbg IS INITIAL.
      ls_vttp-datbg = <ls_vttp>-datbg.
    ENDIF.
    IF ls_vttp-tknum IS INITIAL.
      ls_vttp-tknum = <ls_vttp>-tknum.
    ENDIF.
    IF ls_vttp-exti1 IS INITIAL.
      ls_vttp-exti1 = <ls_vttp>-exti1.
    ENDIF.
    IF ls_vttp-tracktstmp IS INITIAL.
      ls_vttp-tracktstmp = <ls_vttp>-tracktstmp.
    ENDIF.
    IF ls_vttp-trkstat IS INITIAL.
      ls_vttp-trkstat = <ls_vttp>-trkstat.
    ENDIF.
    IF ls_vttp-daten IS INITIAL.
      ls_vttp-daten = <ls_vttp>-daten.
    ENDIF.
    IF ls_vttp-uaten IS INITIAL.
      ls_vttp-uaten = <ls_vttp>-uaten.
    ENDIF.
    IF ls_vttp-tdlnr IS INITIAL.
      ls_vttp-tdlnr = <ls_vttp>-tdlnr.
    ENDIF.

  ENDLOOP.

  IF NOT ls_vttp_transmed IS INITIAL.
    "von hier immer die Trackingnr nehmen
    IF NOT ls_vttp_transmed-trackn IS INITIAL.
      ls_vttp-trackn = ls_vttp_transmed-trackn.
    ENDIF.
  ENDIF.

  IF NOT ls_vttp IS INITIAL.  "Trackingnr gefunden?
    gt_orderview-awb      = ls_vttp-trackn.
    gt_orderview-shipdate = ls_vttp-datbg.
    gt_orderview-tknum    = ls_vttp-tknum.                  "HB060514
    gt_orderview-exti1    = ls_vttp-exti1.                  "HB060514

    "Ablieferdatum                       "HB10122013
    IF NOT ls_vttp-tracktstmp IS INITIAL AND ls_vttp-trkstat = 'C'. "MK120416 (TRKSTAT) Ticket 1604-260
*      CONVERT TIME STAMP gt_vttp-tracktstmp TIME ZONE 'CET   '
      "Analog PF7; 1807-584 Orderview falsche Trackzeit
      CONVERT TIME STAMP ls_vttp-tracktstmp TIME ZONE 'UTC   ' "HB250718
        INTO DATE gt_orderview-trackdate TIME lv_time.
      gt_orderview-tracktime = lv_time.                     "HB220816
    ELSE.
      "nehme aus Transportendedatum: 1506-132  HB050615
      gt_orderview-trackdate = ls_vttp-daten.
      gt_orderview-tracktime = ls_vttp-uaten.               "HB220816
    ENDIF.

    CLEAR gt_lfa1.
    READ TABLE gt_lfa1 WITH KEY lifnr = ls_vttp-tdlnr.
    IF sy-subrc EQ 0.
      gt_orderview-shipper = gt_lfa1-name1.
    ENDIF.
  ENDIF.  "Trackingnr gefunden

  CLEAR gt_nast.
  READ TABLE gt_nast WITH KEY objky = if_lips_lif-vbeln.
  IF sy-subrc EQ 0.
    gt_orderview-delnoteprint = gt_nast-datvr.
  ENDIF.

ENDFORM.                    " FILL_LIPS_LIF_FIELDS
*&---------------------------------------------------------------------*
*&      Form  FILL_MISSING_DATA
*&---------------------------------------------------------------------*
FORM fill_missing_data .

  TYPES: tyt_vbap_h TYPE HASHED TABLE OF tys_vbap WITH UNIQUE KEY vbeln posnr.

  DATA: lv_index_lif    TYPE syindex,
        lv_index_z2     TYPE syindex,
        lv_index_order  TYPE syindex,
        lv_index_obknr  TYPE syindex,
        lv_lif_found(1),

        lt_vbap_h       TYPE tyt_vbap_h.

  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_vbap>      TYPE tys_vbap.


  SORT gt_orderview_add BY qmnum fenum counter.
  SORT gt_orderview BY vbeln posnr flag_vbep.

  IF NOT gt_vbep[] IS INITIAL.
    CLEAR gt_vbep.
    LOOP AT gt_vbep.
      CLEAR gt_orderview_add.

      CLEAR gt_orderview.
      READ TABLE gt_orderview WITH KEY vbeln = gt_vbep-vbeln
                                       posnr = gt_vbep-uepos
                                       flag_vbep = space
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        lv_index_order = sy-tabix.
        CLEAR gt_orderview_add.
        READ TABLE gt_orderview_add WITH KEY qmnum = gt_orderview-qmnum
                                             fenum = gt_orderview-fenum
                                             counter = gt_orderview-counter
        BINARY SEARCH.
        IF sy-subrc EQ 0.
          lv_index_z2 = sy-tabix.
        ENDIF.

        CLEAR gt_vbap_aux.
        READ TABLE gt_vbap_aux WITH KEY vbeln = gt_orderview-vbeln
                                        posnr = gt_orderview-posnr
        BINARY SEARCH.

        PERFORM fill_vbep_fields USING gt_vbep
                                       c_true.
        PERFORM build_ekpo_list.

        CASE gt_vbap_aux-pstyv.
          WHEN 'ZS4S'.
            IF NOT gt_lips_lif[] IS INITIAL AND
            gt_orderview-flag_lif IS INITIAL.
              CLEAR gt_vbap_lif.
              READ TABLE gt_vbap_lif WITH KEY vbeln = gt_vbap_aux-vbeln
                                              uepos = gt_vbap_aux-posnr
              BINARY SEARCH.
              IF sy-subrc EQ 0.
                lv_index_lif = sy-tabix.
                CLEAR lv_lif_found.

                CLEAR gt_vbap_lif.
                LOOP AT gt_vbap_lif FROM lv_index_lif.

                  IF gt_vbap_lif-vbeln <> gt_vbap_aux-vbeln.
                    EXIT.
                  ENDIF.
                  IF gt_vbap_lif-uepos <> gt_vbap_aux-posnr.
                    EXIT.
                  ENDIF.

                  CASE gt_vbap_lif-vkgru.
                    WHEN '103'.   "S4S
                      IF NOT gt_lips_lif[] IS INITIAL.
                        PERFORM build_lips_103_list USING gt_vbap_lif-vbeln
                                                          gt_vbap_lif-posnr
                                                          gt_vbep-sernr
                                                    CHANGING lv_lif_found.
                      ENDIF.
                      IF lv_lif_found EQ c_true.
                        EXIT.
                      ENDIF.
                    WHEN '106'.                             "L4L/ADR
                      IF NOT gt_lips_lif[] IS INITIAL.
                        PERFORM build_lips_106_list USING gt_vbap_lif-vbeln
                                                          gt_vbap_lif-posnr
                                                    CHANGING lv_lif_found.
                      ENDIF.
                      IF lv_lif_found EQ c_true.
                        EXIT.
                      ENDIF.
                  ENDCASE.
                ENDLOOP.
              ENDIF.
            ENDIF.
        ENDCASE.


        PERFORM build_calculated_fields.
        MODIFY gt_orderview INDEX lv_index_order.

        IF NOT lv_index_z2 IS INITIAL.
          MODIFY gt_orderview_add INDEX lv_index_z2.
        ELSE.
          IF NOT gt_orderview_add IS INITIAL.
            gt_orderview_add-qmnum = gt_orderview-qmnum.
            gt_orderview_add-fenum = gt_orderview-fenum.
            gt_orderview_add-counter = gt_orderview-counter.

            APPEND gt_orderview_add.
            CLEAR gt_orderview_add.
          ENDIF.
        ENDIF.

      ENDIF.
    ENDLOOP.
  ENDIF.

*  SORT gt_orderview BY vbeln posnr flag_lif.
  SORT gt_orderview BY vbeln posnr counter flag_lif.        "HB090115

  IF NOT gt_lips_lif[] IS INITIAL.
    CLEAR gt_lips_lif.
    LOOP AT gt_lips_lif.
      CLEAR gt_orderview.
      READ TABLE gt_orderview WITH KEY vbeln = gt_lips_lif-vgbel
                                       posnr = gt_lips_lif-vgpos
                                       flag_lif = space
      BINARY SEARCH.

      IF sy-subrc EQ 0.
        lv_index_order = sy-tabix.

        CLEAR gt_vbap_aux.
        READ TABLE gt_vbap_aux WITH KEY vbeln = gt_orderview-vbeln
                                        posnr = gt_orderview-posnr
        BINARY SEARCH.

        PERFORM fill_lips_lif_fields USING gt_lips_lif.

        PERFORM build_calculated_fields.

        MODIFY gt_orderview INDEX lv_index_order.
      ENDIF.
    ENDLOOP.

  ENDIF.

  SORT gt_orderview BY fanumber flag_qmferm.
  IF NOT gt_qmfe_rm[] IS INITIAL.
    CLEAR gt_qmfe_rm.
    LOOP AT gt_qmfe_rm.
      CLEAR gt_orderview_add.
      CLEAR gt_orderview.
      READ TABLE gt_orderview WITH KEY fanumber = gt_qmfe_rm-aufnr
                                       flag_qmferm = space
      BINARY SEARCH.
      IF sy-subrc EQ 0.
        CLEAR gt_orderview_add.
        READ TABLE gt_orderview_add WITH KEY qmnum = gt_orderview-qmnum
                                             fenum = gt_orderview-fenum
                                             counter = gt_orderview-counter
        BINARY SEARCH.
        CHECK sy-subrc NE 0.

        CLEAR gt_afih.
        READ TABLE gt_afih WITH KEY aufnr = gt_orderview-fanumber
        BINARY SEARCH.
        CLEAR gt_objk_aufnr.
        READ TABLE gt_objk_aufnr WITH KEY obknr = gt_afih-obknr
                                          sernr = gt_qmfe_rm-serialnr
        BINARY SEARCH.
        CHECK sy-subrc EQ 0.
        lv_index_obknr = sy-tabix.
        gt_orderview-sernraufnr = gt_objk_aufnr-sernr.
        PERFORM build_remarks_data.
        IF NOT gt_orderview_add IS INITIAL.
          gt_orderview_add-qmnum = gt_orderview-qmnum.
          gt_orderview_add-fenum = gt_orderview-fenum.
          gt_orderview_add-counter = gt_orderview-counter.

          APPEND gt_orderview_add.
          CLEAR gt_orderview_add.
        ENDIF.
        DELETE gt_objk_aufnr INDEX lv_index_obknr.
      ENDIF.
    ENDLOOP.
  ENDIF.

  "Route ergänzen, falls nicht bereits durch Lieferung gesetzt   "HB270614
  "Route aus Hauptpos/Lieferrelevant nehmen

  "umkoieren in Suchoptimierte Hash-Tabelle
  lt_vbap_h[] = gt_vbap_aux[].
*  DELETE lt_vbap_h WHERE route = space.   "nur die mit ROute belassen
  CHECK NOT lt_vbap_h[] IS INITIAL.

  LOOP AT gt_orderview ASSIGNING <ls_orderview>.
    IF <ls_orderview>-route = space.
      READ TABLE lt_vbap_h ASSIGNING <ls_vbap> WITH TABLE KEY vbeln = <ls_orderview>-vbeln
                                                              posnr = <ls_orderview>-posnr.
      IF sy-subrc = 0.
        <ls_orderview>-route = <ls_vbap>-route.

        "HB141014 1410-401 Lagerort für ZFL wird nicht ausgegeben
        IF ( <ls_orderview>-otgrp = 'ZFL' OR <ls_orderview>-otgrp = 'ZMTO' OR <ls_orderview>-otgrp = 'ZRET' OR <ls_orderview>-otgrp = 'ZTRANS' )
          AND <ls_orderview>-lieferlager IS INITIAL.        "HB160621
          <ls_orderview>-lieferlager = <ls_vbap>-lgort.
          <ls_orderview>-lieferwerk  = <ls_vbap>-werks.
        ENDIF.
      ENDIF.
    ENDIF.

    "nochmal falls nicht oben versorgt  HB141014
    IF ( <ls_orderview>-otgrp = 'ZFL' OR <ls_orderview>-otgrp = 'ZMTO' OR <ls_orderview>-otgrp = 'ZRET' OR <ls_orderview>-otgrp = 'ZTRANS' )
      AND <ls_orderview>-lieferlager IS INITIAL.            "HB160621
      READ TABLE lt_vbap_h ASSIGNING <ls_vbap> WITH TABLE KEY vbeln = <ls_orderview>-vbeln
                                                              posnr = <ls_orderview>-posnr.
      IF sy-subrc = 0.
        <ls_orderview>-lieferlager = <ls_vbap>-lgort.
        <ls_orderview>-lieferwerk  = <ls_vbap>-werks.
      ENDIF.
    ENDIF.
  ENDLOOP.

ENDFORM.                    " FILL_MISSING_DATA
