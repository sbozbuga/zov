*&---------------------------------------------------------------------*
*&      Form  GET_TRACKDATA_VENDOR
*&---------------------------------------------------------------------*
*       Basis ist die Tabelle gt_orderview
*----------------------------------------------------------------------*
FORM get_trackdata_vendor .

  TYPES: BEGIN OF tys_vtrkh,   "Lieferscheinpos/kopf/vbup
           vbeln      TYPE vtrkh-vbeln,
           uevbeln    TYPE vtrkh-uevbeln,
           trackn     TYPE vtrkh-trackn,
           tracktstmp TYPE vtrkh-tracktstmp,
           trkstat    TYPE vtrkh-trkstat,
         END   OF tys_vtrkh,

         tyt_vtrkh  TYPE SORTED TABLE OF tys_vtrkh
                   WITH NON-UNIQUE KEY uevbeln,
         tyt_vtrkh2 TYPE SORTED TABLE OF tys_vtrkh
                  WITH NON-UNIQUE KEY vbeln,


         BEGIN OF tys_vepo,  "Handlingsunit
           vbeln TYPE vepo-vbeln,
           posnr TYPE vepo-posnr,
           venum TYPE vepo-venum,
         END   OF tys_vepo,

         tyt_vepo TYPE SORTED TABLE OF tys_vepo
                  WITH NON-UNIQUE KEY vbeln posnr.

  DATA: lt_orderview TYPE tyt_orderview,
        lt_vtrkh     TYPE tyt_vtrkh,
        lt_vtrkh2    TYPE tyt_vtrkh2,
        lt_vepo      TYPE tyt_vepo,
        lv_date      TYPE sy-datum,
        lv_time      TYPE sy-uzeit,
        lv_count     TYPE i.

  FIELD-SYMBOLS:
    <ls_vtrkh>     TYPE tys_vtrkh,
    <ls_vepo>      TYPE tys_vepo,
    <ls_orderview> TYPE tys_orderview.


  "umkopieren in lokale Tabelle und nur die mit Vendorlieferung belassen
  lt_orderview[] = gt_orderview[].
  DELETE lt_orderview WHERE yliefvend = space.

  syst-tfill = lines( lt_orderview ).
  PERFORM prot_line USING syst-tfill 'yliefvend = space  Anzahl                     :'.

*----------------------------------------------------------------
*    Trackingnummern mit Lieferschein/Handlings-Unit
*----------------------------------------------------------------
  IF NOT lt_orderview[] IS INITIAL.
    SELECT vbeln
           uevbeln
           trackn
           tracktstmp        "Tracking Zeitpunkt in UTC-Format
           trkstat           "Status: A = abgeholt, C = geliefert
      FROM vtrkh
      INTO TABLE lt_vtrkh
      FOR ALL ENTRIES IN lt_orderview
      WHERE uevbtyp = 'J'
        AND uevbeln = lt_orderview-yliefvend.  "Verwendung Index 003

    syst-tfill = lines( lt_vtrkh ).
    PERFORM prot_line USING syst-tfill 'lt_vtrkh           Anzahl                     :'.

    "Trackingdaten ergänzen in Ursprungstabelle
    LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE yliefvend > space.
      READ TABLE lt_vtrkh WITH TABLE KEY uevbeln = <ls_orderview>-yliefvend
                          ASSIGNING <ls_vtrkh>.
      IF sy-subrc = 0.
        <ls_orderview>-tracknvend = <ls_vtrkh>-trackn.
        CONVERT TIME STAMP <ls_vtrkh>-tracktstmp TIME ZONE 'CET   '
            INTO DATE lv_date TIME lv_time.
        IF NOT lv_date IS INITIAL.
          IF <ls_vtrkh>-trkstat = 'C'.
            <ls_orderview>-trackdatevend = lv_date.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.

*----------------------------------------------------------------
*    Trackingnummern mit Transporten
*----------------------------------------------------------------
  "umkopieren in lokale Tabelle und nur die mit Vendorlieferung belassen
  lt_orderview[] = gt_orderview[].
  DELETE lt_orderview WHERE yliefvend  = space AND
                            tracknvend = space.

  syst-tfill = lines( lt_orderview ).
  PERFORM prot_line USING syst-tfill 'tracknvend = space  Anzahl                    :'.

  IF NOT lt_orderview[] IS INITIAL.
    "Selektion der restlichen HandlingsUnits
    SELECT vbeln
           posnr
           venum                  "HU-Nr
      FROM vepo                   "Verpacken: Handling Unit Position (Inhalt)
      INTO TABLE lt_vepo
      FOR ALL ENTRIES IN lt_orderview
      WHERE vbeln = lt_orderview-yliefvend
        AND posnr = lt_orderview-yliefvendpos.

    IF NOT lt_vepo[] IS INITIAL.
      SELECT vbeln
             uevbeln
             trackn
             tracktstmp        "Tracking Zeitpunkt in UTC-Format
             trkstat           "Status: A = abgeholt, C = geliefert
        FROM vtrkh
        INTO TABLE lt_vtrkh2
        FOR ALL ENTRIES IN lt_vepo
        WHERE vbtyp = 'X'               "Handling Unit
          AND vbeln = lt_vepo-venum.

      syst-tfill = lines( lt_vtrkh2 ).
      PERFORM prot_line USING syst-tfill 'lt_vtrkh2          Anzahl                     :'.

      "Trackingdaten ergänzen in Ursprungstabelle
      LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE yliefvend IS NOT INITIAL AND
                                                          tracknvend IS INITIAL.
        READ TABLE lt_vepo WITH TABLE KEY vbeln = <ls_orderview>-yliefvend
                                          posnr = <ls_orderview>-yliefvendpos
                                ASSIGNING <ls_vepo>.
        IF sy-subrc = 0.
          READ TABLE lt_vtrkh2 WITH TABLE KEY vbeln = <ls_vepo>-venum
                                    ASSIGNING <ls_vtrkh>.
          IF sy-subrc = 0.
            <ls_orderview>-tracknvend = <ls_vtrkh>-trackn.
            CONVERT TIME STAMP <ls_vtrkh>-tracktstmp TIME ZONE 'CET   '
                INTO DATE lv_date TIME lv_time.
            IF NOT lv_date IS INITIAL.
              IF <ls_vtrkh>-trkstat = 'C'.
                <ls_orderview>-trackdatevend = lv_date.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

*----------------------------------------------------------------
*    Trackingnummern aus vttp; analog YLE01 1808-372
*----------------------------------------------------------------
  "umkopieren in lokale Tabelle und nur die mit Vendorlieferung belassen
  lt_orderview[] = gt_orderview[].
  DELETE lt_orderview WHERE yliefvend  = space AND
                            tracknvend = space.

  syst-tfill = lines( lt_orderview ).
  PERFORM prot_line USING syst-tfill 'yliefvend/tracknvend = space  Anzahl          :'.

  IF NOT lt_orderview[] IS INITIAL.
    SELECT a~vbeln
           c~uevbeln
           c~trackn
           c~tracktstmp        "Tracking Zeitpunkt in UTC-Format
           c~trkstat           "Status: A = abgeholt, C = geliefert
     FROM ( ( vttp AS a                 "Transportposition
       INNER JOIN vttk AS b         "Transportkopf
         ON a~tknum = b~tknum )
       LEFT OUTER JOIN vtrkh AS c   "Trackingdaten Kopf
         ON  c~uevbtyp = 'J'    "Zum Index zählt UEVBTYP Teil1: J = Lieferung
         AND c~uevbeln = a~tknum )
     INTO TABLE lt_vtrkh2
     FOR ALL ENTRIES IN lt_orderview
     WHERE a~vbeln = lt_orderview-yliefvend.

    SELECT a~vbeln
           c~uevbeln
           c~trackn
           c~tracktstmp        "Tracking Zeitpunkt in UTC-Format
           c~trkstat           "Status: A = abgeholt, C = geliefert
     FROM ( ( vttp AS a                 "Transportposition
       INNER JOIN vttk AS b         "Transportkopf
         ON a~tknum = b~tknum )
       LEFT OUTER JOIN vtrkh AS c   "Trackingdaten Kopf
         ON  c~uevbtyp = '8'    "Zum Index zählt UEVBTYP Teil 2 8 = Transport
         AND c~uevbeln = a~tknum )
     APPENDING TABLE lt_vtrkh2
     FOR ALL ENTRIES IN lt_orderview
     WHERE a~vbeln = lt_orderview-yliefvend.

    syst-tfill = lines( lt_vtrkh2 ).
    PERFORM prot_line USING syst-tfill 'lt_vtrkh2   Anzahl                            :'.

    "Trackingdaten ergänzen in Ursprungstabelle
    LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE yliefvend > space.
      LOOP AT lt_vtrkh2 ASSIGNING <ls_vtrkh>
                          WHERE vbeln  = <ls_orderview>-yliefvend
                            AND trackn > space.
        <ls_orderview>-tracknvend = <ls_vtrkh>-trackn.
        CONVERT TIME STAMP <ls_vtrkh>-tracktstmp TIME ZONE 'CET   '
            INTO DATE lv_date TIME lv_time.
        IF NOT lv_date IS INITIAL.
          IF <ls_vtrkh>-trkstat = 'C'.
            <ls_orderview>-trackdatevend = lv_date.
          ENDIF.
        ENDIF.
      ENDLOOP.
    ENDLOOP.
  ENDIF.

ENDFORM.                    " GET_TRACKDATA_VENDOR
*&---------------------------------------------------------------------*
*&      Form  GET_WITHOUT_VBELN
*&---------------------------------------------------------------------*
*       Für Workaround: alle ohne Vertriebsbeleg lesen
*       Dazu aus vbap Meldungsnummer bestimmen
*       Meldungspositionen sind bereits gelesen in gt_qmfe
*----------------------------------------------------------------------*
FORM get_without_vbeln .

  TYPES:
    tyt_ordview TYPE STANDARD TABLE OF ztordview_ord_mi,

    BEGIN OF tys_otgrp,
      qmnum TYPE qmnum,
      count TYPE i,       "erkennen mehrfache otgrps
    END OF tys_otgrp,
    tyt_otgrp TYPE HASHED TABLE OF tys_otgrp WITH UNIQUE KEY qmnum.


  DATA:
    lt_ordview    TYPE tyt_ordview,
    lt_qmfe       TYPE tyt_qmfe,
    lt_vbeln_miss TYPE tyt_vbeln_miss,
    ls_otgrp      TYPE tys_otgrp,
    lt_otgrp      TYPE tyt_otgrp.

  FIELD-SYMBOLS:
    <ls_qmfe>    TYPE tys_qmfe,
    <ls_qmfe2>   TYPE tys_qmfe,
    <ls_otgrp>   TYPE tys_otgrp,
    <ls_ordview> TYPE ztordview_ord_mi.

  "1. Alle vorhandenen aus Orderview; Bei Start Funktion oder Restmenge
  SELECT qmnum
         fenum
         archivflag
    FROM /cellag/ordview
    INTO CORRESPONDING FIELDS OF TABLE lt_ordview
    WHERE vbeln      =  space.

  SORT lt_ordview BY qmnum fenum.
  DELETE ADJACENT DUPLICATES FROM lt_ordview COMPARING qmnum fenum.

  MODIFY ztordview_ord_mi FROM TABLE lt_ordview.
  COMMIT WORK AND WAIT.

  "2. Die heute oder gestern gelesenen direkt abgleichen

  "Hilfstabelle in lt_qmfe; 2 Aufträge bekommen die mit Unterschiedl OTGRP pro Meldung
  CLEAR: lt_ordview[].
  LOOP AT gt_qmfe ASSIGNING <ls_qmfe>.
    INSERT INITIAL LINE INTO TABLE lt_qmfe  ASSIGNING <ls_qmfe2>.
    <ls_qmfe2>-qmnum = <ls_qmfe>-qmnum.
    <ls_qmfe2>-fenum = <ls_qmfe>-fenum.
    <ls_qmfe2>-otgrp = <ls_qmfe>-otgrp.  "Kandidaten an abweichender erkennen
  ENDLOOP.

  IF NOT lt_qmfe[] IS INITIAL.
    SORT lt_qmfe BY qmnum otgrp.
    DELETE ADJACENT DUPLICATES FROM lt_qmfe COMPARING qmnum otgrp.
    LOOP AT lt_qmfe ASSIGNING <ls_qmfe>.
      ls_otgrp-qmnum = <ls_qmfe>-qmnum.
      ls_otgrp-count = 1.
      COLLECT ls_otgrp INTO lt_otgrp.
    ENDLOOP.

    "Die mit mehr als ein Eintrag sind die richtigen
    SORT lt_qmfe BY qmnum fenum.  "Reihenfolge nach FENUM!
    LOOP AT lt_otgrp ASSIGNING <ls_otgrp> WHERE count > 1.
      LOOP AT lt_qmfe ASSIGNING <ls_qmfe> WHERE qmnum = <ls_otgrp>-qmnum.
        "der erste ist der richtige; der wäre später ohne Auftragsnummer
        INSERT INITIAL LINE INTO TABLE lt_ordview ASSIGNING <ls_ordview>.
        <ls_ordview>-qmnum = <ls_qmfe>-qmnum.
        <ls_ordview>-fenum = <ls_qmfe>-fenum.
        EXIT.
      ENDLOOP.
    ENDLOOP.

    IF NOT lt_ordview[] IS INITIAL.
      "die neuen auch hinzufügen
      MODIFY ztordview_ord_mi FROM TABLE lt_ordview.
      COMMIT WORK AND WAIT.
    ENDIF.
  ENDIF.

  "3. Gesamtumfang zur Verarbeitung
  SELECT *
    FROM ztordview_ord_mi
    INTO TABLE lt_ordview
    WHERE archivflag = space.

  CHECK NOT lt_ordview[] IS INITIAL.

  SELECT /cellag/qmnum AS qmnum
         /cellag/fenum AS fenum
         vbeln
    FROM vbap
    INTO TABLE gt_vbeln_miss
    FOR ALL ENTRIES IN lt_ordview
    WHERE /cellag/qmnum = lt_ordview-qmnum
      AND /cellag/fenum = lt_ordview-fenum.


ENDFORM.                    " GET_WITHOUT_VBELN
