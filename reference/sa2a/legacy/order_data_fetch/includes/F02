*&---------------------------------------------------------------------*
*&      Form  GET_QMMA_Z1
*&---------------------------------------------------------------------*
*       Aktionen zu den QMFE aus Z1/ZX-Meldungen lesen
*----------------------------------------------------------------------*
FORM get_qmma_z1 .

  DATA:
    lv_count    TYPE i,
    lv_tdname   TYPE tdobname,
    lt_tlines   TYPE STANDARD TABLE OF tline,

    lt_qmma_z1  TYPE tyt_qmma_z1,
    ls_qmma_rem TYPE tys_qmma_rem.

  DATA: ls_thead TYPE thead.


  "alle Aktionen zu den Z1/ZX-Meldungen lesen
  SELECT qmnum
         manum
         fenum
         mngrp
         matxt
         erdat
         ernam
         erzeit
         aedat
         aenam
         aezeit
         indtx
         kzmla
    FROM qmma
    INTO CORRESPONDING FIELDS OF TABLE lt_qmma_z1
    FOR ALL ENTRIES IN gt_qmfe
    WHERE qmnum    = gt_qmfe-qmnum
      AND fenum    = gt_qmfe-fenum
      AND kzloesch = space.          "BHE20240606 RL Orderview Fetch Komment LOEKZ   2406-072
  IF sy-subrc = 0.
    lv_count = lines( lt_qmma_z1 ).
    PERFORM prot_line USING lv_count 'Bemerkungen aus Z1-Meldungen                  :'.

    "Infos aus Langtexten in eigene Zeilen, falls vorhanden  mit eigenem Zeitstempel aus Langtexten
    LOOP AT lt_qmma_z1 ASSIGNING FIELD-SYMBOL(<ls_qmma_z1>) WHERE indtx = abap_true.

      CONCATENATE <ls_qmma_z1>-qmnum <ls_qmma_z1>-manum INTO lv_tdname.  "Textidentifier

      CLEAR: lt_tlines[].
      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          id                      = 'LTXT'
          language                = <ls_qmma_z1>-kzmla
          name                    = lv_tdname
          object                  = 'QMMA'
        IMPORTING
          header                  = ls_thead        "HB011223 wegen Zeitstempel
        TABLES
          lines                   = lt_tlines
        EXCEPTIONS
          id                      = 1
          language                = 2
          name                    = 3
          not_found               = 4
          object                  = 5
          reference_check         = 6
          wrong_access_to_archive = 7
          OTHERS                  = 8.
      IF sy-subrc EQ 0.

        CLEAR: ls_qmma_rem.
        ls_qmma_rem-qmnum = <ls_qmma_z1>-qmnum.
        ls_qmma_rem-fenum = <ls_qmma_z1>-fenum.
        ls_qmma_rem-manum = <ls_qmma_z1>-manum.
        ls_qmma_rem-mngrp = <ls_qmma_z1>-mngrp.
        ls_qmma_rem-aedat = ls_thead-tdldate.
        ls_qmma_rem-aenam = ls_thead-tdluser.
        ls_qmma_rem-aezeit = ls_thead-tdltime.
        CLEAR ls_qmma_rem-line.

        LOOP AT lt_tlines ASSIGNING FIELD-SYMBOL(<ls_tlines>).
*          CONDENSE ls_tlines-tdline.
          IF ls_qmma_rem-line IS INITIAL.
            ls_qmma_rem-line = <ls_tlines>-tdline.
          ELSE.
            CONCATENATE ls_qmma_rem-line <ls_tlines>-tdline INTO ls_qmma_rem-line.
          ENDIF.
        ENDLOOP.
        APPEND ls_qmma_rem TO gt_qmma_rem_z1.

      ENDIF.
    ENDLOOP.

    "Jetzt rem bauen für eigentliche Maßnahmen und anhängen
    LOOP AT lt_qmma_z1 ASSIGNING <ls_qmma_z1>.

      "AEDAT belegen aus ERDAT falls leer
      IF <ls_qmma_z1>-aedat IS INITIAL.
        <ls_qmma_z1>-aedat  = <ls_qmma_z1>-erdat.
        <ls_qmma_z1>-aenam  = <ls_qmma_z1>-ernam.
        <ls_qmma_z1>-aezeit = <ls_qmma_z1>-erzeit.
      ENDIF.

      "jetzt anhängen an Gesamtliste
      CLEAR: ls_qmma_rem.
      ls_qmma_rem-qmnum = <ls_qmma_z1>-qmnum.
      ls_qmma_rem-fenum = <ls_qmma_z1>-fenum.
      ls_qmma_rem-manum = <ls_qmma_z1>-manum.
      ls_qmma_rem-mngrp = <ls_qmma_z1>-mngrp.
      ls_qmma_rem-aedat = <ls_qmma_z1>-aedat.
      ls_qmma_rem-aenam = <ls_qmma_z1>-aenam.
      ls_qmma_rem-aezeit = <ls_qmma_z1>-aezeit.
      ls_qmma_rem-line   = <ls_qmma_z1>-matxt.
      APPEND ls_qmma_rem TO gt_qmma_rem_z1.
    ENDLOOP.
  ENDIF.

ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  MERGE_REMARKS_REM
*&---------------------------------------------------------------------*
*       Es gibt sowohl Bemerkungen aus Z1-Meldungen (neu ab 11.2023),
*       also auch zu den Z2-Meldungen (wie bisher)
*       Add-Einträge zu Z1-Meldungen ohne Z2 werden neu angelegt.
*       Gibt es auch Z2-Bemerkungen werden die Z1-Bemerkungen dazugemischt.
*       Annahme: Die Z1-Bemerkungen waren zuerst da, deshalb Texte zuerst
*       oben einfügen.
*
*       gt_orderview_add wird wie bisher aus den Aktionen zu Z2 erstellt
*       in gt_qmma_z1 werden die Textinfos aus den Z1-Meldungen bereitgestellt
*
*       Vorgehensweise: da gt_orderview_add kein schneller Zugriff, diese
*       durchschleifen und jeweils prüfen ob Z1-Texte da. falls gefunden,
*       diese markieren mit F = found
*       Anschließend aus den nicht mit F-markierten zusätzliche Einträge
*       anhängen an gt_orderview_add
*----------------------------------------------------------------------*
FORM merge_remarks_rem .

  DATA:
    lv_count         TYPE i,
    lv_no_save       TYPE abap_bool,
    lv_found         TYPE abap_bool,
    lv_line          TYPE rtxline,

    ls_orderview_add LIKE LINE OF gt_orderview_add,
    lt_orderview_add TYPE STANDARD TABLE OF /cellag/ord_add.

  "beide Tabellen zusammenmischen und sortieren pro Meldpos; neueste oben
  APPEND LINES OF gt_qmma_rem_z1 TO gt_qmma_rem_z2.
  SORT gt_qmma_rem_z2 BY qmnum ASCENDING fenum ASCENDING aedat DESCENDING aezeit DESCENDING
                         manum ASCENDING.  "Falls gleiche Uhrezeit - dann nach MANUM


  LOOP AT gt_orderview_add ASSIGNING FIELD-SYMBOL(<ls_orderview_add>).

    "Bemerkungsfelder INIT
    CLEAR:
      <ls_orderview_add>-remarksrs,
      <ls_orderview_add>-timestamprs,

      <ls_orderview_add>-remarksoc,
      <ls_orderview_add>-timestampoc,

      <ls_orderview_add>-remarksvm,
      <ls_orderview_add>-timestampvm,

      <ls_orderview_add>-remarksspm,
      <ls_orderview_add>-timestampspm,

      <ls_orderview_add>-remarkspur,
      <ls_orderview_add>-timestamppur,

      <ls_orderview_add>-remarkslog,
      <ls_orderview_add>-timestamplog.



    LOOP AT gt_qmma_rem_z2 ASSIGNING FIELD-SYMBOL(<ls_qmma_rem>) WHERE qmnum = <ls_orderview_add>-qmnum
                                                                   AND fenum = <ls_orderview_add>-fenum.
      <ls_qmma_rem>-flag = 'X'.  "markieren vorhanden

      CASE <ls_qmma_rem>-mngrp.

        WHEN 'ZRRS01'.   "Repairshop
          IF <ls_orderview_add>-remarksrs IS INITIAL.
            <ls_orderview_add>-remarksrs = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.  "2405-180 RL Orderview Fetch Kommentare / am Ende
              CONCATENATE   <ls_orderview_add>-remarksrs '/' <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarksrs.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestamprs IS INITIAL.
            <ls_orderview_add>-timestamprs = <ls_qmma_rem>-aedat.
          ENDIF.

        WHEN 'ZROC01'.   "Order control
          IF <ls_orderview_add>-remarksoc IS INITIAL.
            <ls_orderview_add>-remarksoc = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.
              CONCATENATE <ls_orderview_add>-remarksoc '/' <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarksoc.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestampoc IS INITIAL.
            <ls_orderview_add>-timestampoc = <ls_qmma_rem>-aedat.
          ENDIF.

        WHEN 'ZRVM01'.   "Vendor Management
          IF <ls_orderview_add>-remarksvm IS INITIAL.
            <ls_orderview_add>-remarksvm = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.
              CONCATENATE <ls_orderview_add>-remarksvm  '/' <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarksvm.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestampvm IS INITIAL.
            <ls_orderview_add>-timestampvm = <ls_qmma_rem>-aedat.
          ENDIF.

        WHEN 'ZRSP01'.   "SpareParsManagement
          IF <ls_orderview_add>-remarksspm IS INITIAL.
            <ls_orderview_add>-remarksspm = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.
              CONCATENATE <ls_orderview_add>-remarksspm '/'  <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarksspm.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestampspm IS INITIAL.
            <ls_orderview_add>-timestampspm = <ls_qmma_rem>-aedat.
          ENDIF.

        WHEN 'ZRPU01'.   "Purschasing
          IF <ls_orderview_add>-remarkspur IS INITIAL.
            <ls_orderview_add>-remarkspur = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.
              CONCATENATE  <ls_orderview_add>-remarkspur '/' <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarkspur.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestamppur IS INITIAL.
            <ls_orderview_add>-timestamppur = <ls_qmma_rem>-aedat.
          ENDIF.


        WHEN 'ZRLO01'.   "Logistik
          IF <ls_orderview_add>-remarkslog IS INITIAL.
            <ls_orderview_add>-remarkslog = <ls_qmma_rem>-line.
          ELSE.
            IF <ls_qmma_rem>-line IS NOT INITIAL.
              CONCATENATE <ls_orderview_add>-remarkslog '/' <ls_qmma_rem>-line
                INTO <ls_orderview_add>-remarkslog.
            ENDIF.
          ENDIF.
          IF <ls_orderview_add>-timestamplog IS INITIAL.
            <ls_orderview_add>-timestamplog = <ls_qmma_rem>-aedat.
          ENDIF.

      ENDCASE.
    ENDLOOP. "AT gt_qmma_rem_z2
  ENDLOOP.

  "---------------------------------------------------------------------------------
  "  neue Zeilen, falls bisher noch nicht vorhanden
  "---------------------------------------------------------------------------------
  CLEAR: ls_orderview_add.

  LOOP AT gt_qmma_rem_z2 ASSIGNING <ls_qmma_rem> WHERE flag = space.

    IF NOT ( <ls_qmma_rem>-qmnum = ls_orderview_add-qmnum AND <ls_qmma_rem>-fenum = ls_orderview_add-fenum ).
      IF NOT ls_orderview_add IS INITIAL.
        APPEND ls_orderview_add TO lt_orderview_add.
      ENDIF.
      CLEAR: ls_orderview_add.
      ls_orderview_add-qmnum   = <ls_qmma_rem>-qmnum.
      ls_orderview_add-fenum   = <ls_qmma_rem>-fenum.
      ls_orderview_add-counter = 1.  "???
      ls_orderview_add-aedat = <ls_qmma_rem>-aedat.
      ls_orderview_add-aeuhr = <ls_qmma_rem>-aezeit.
      ls_orderview_add-aenam = <ls_qmma_rem>-aenam.
    ENDIF.


    CASE <ls_qmma_rem>-mngrp.

      WHEN 'ZRRS01'.   "Repairshop
        IF ls_orderview_add-remarksrs IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarksrs '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarksrs.
          ENDIF.
        ELSE.
          ls_orderview_add-remarksrs = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestamprs IS INITIAL.
          ls_orderview_add-timestamprs = <ls_qmma_rem>-aedat.
        ENDIF.

      WHEN 'ZROC01'.   "Order control
        IF ls_orderview_add-remarksoc IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarksoc '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarksoc.
          ENDIF.
        ELSE.
          ls_orderview_add-remarksoc = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestampoc IS INITIAL.
          ls_orderview_add-timestampoc = <ls_qmma_rem>-aedat.
        ENDIF.

      WHEN 'ZRVM01'.   "Vendor Management
        IF ls_orderview_add-remarksvm IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarksvm '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarksvm.
          ENDIF.
        ELSE.
          ls_orderview_add-remarksvm = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestampvm IS INITIAL.
          ls_orderview_add-timestampvm = <ls_qmma_rem>-aedat.
        ENDIF.

      WHEN 'ZRSP01'.   "SpareParsManagement
        IF ls_orderview_add-remarksspm IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarksspm '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarksspm.
          ENDIF.
        ELSE.
          ls_orderview_add-remarksspm = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestampspm IS INITIAL.
          ls_orderview_add-timestampspm = <ls_qmma_rem>-aedat.
        ENDIF.

      WHEN 'ZRPU01'.   "Purschasing
        IF ls_orderview_add-remarkspur IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarkspur '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarkspur.
          ENDIF.
        ELSE.
          ls_orderview_add-remarkspur = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestamppur IS INITIAL.
          ls_orderview_add-timestamppur = <ls_qmma_rem>-aedat.
        ENDIF.

      WHEN 'ZRLO01'.   "Logistik
        IF ls_orderview_add-remarkslog IS NOT INITIAL.
          "Text dranhängen, falls mehrere Aktionen
          IF <ls_qmma_rem>-line IS NOT INITIAL.
            CONCATENATE ls_orderview_add-remarkslog '/'  <ls_qmma_rem>-line INTO ls_orderview_add-remarkslog.
          ENDIF.
        ELSE.
          ls_orderview_add-remarkslog = <ls_qmma_rem>-line.
        ENDIF.
        IF ls_orderview_add-timestamplog IS INITIAL.
          ls_orderview_add-timestamplog = <ls_qmma_rem>-aedat.
        ENDIF.

    ENDCASE.

  ENDLOOP.  "LOOP AT ggt_qmma_rem_z2

  "letzer Satz
  IF NOT ls_orderview_add IS INITIAL.
    APPEND ls_orderview_add TO lt_orderview_add.
  ENDIF.

  IF NOT lt_orderview_add[] IS  INITIAL.

    lv_count = lines( lt_orderview_add ).
    PERFORM prot_line USING lv_count 'Neue Einträge ADD Bemerkungen aus Z1-Meldungen:'.

    APPEND LINES OF lt_orderview_add TO gt_orderview_add.
  ENDIF.

  "GSI-Bemerkung ergänzen; in der gesamten DB gibt es keine Einträge QMMA mit QMANUM = 9999
  "Bemerkungen GSI addiert die Texte der Kommentarfelder im ORDERVIEW in folgender Reihenfolge
  "Repairshop + Logistik + Vendormanagement + SPM + Purchasing
  LOOP AT gt_orderview_add ASSIGNING <ls_orderview_add>.

    CLEAR: <ls_orderview_add>-gsiremarks.

    IF <ls_orderview_add>-remarksrs IS NOT INITIAL.
      <ls_orderview_add>-gsiremarks = <ls_orderview_add>-remarksrs.
    ENDIF.

    IF <ls_orderview_add>-remarkslog IS NOT INITIAL.
      IF <ls_orderview_add>-gsiremarks IS INITIAL.
        <ls_orderview_add>-gsiremarks = <ls_orderview_add>-remarkslog.
      ELSE.
        CONCATENATE <ls_orderview_add>-gsiremarks '/' <ls_orderview_add>-remarkslog INTO <ls_orderview_add>-gsiremarks.
      ENDIF.
    ENDIF.

    IF <ls_orderview_add>-remarksvm IS NOT INITIAL.
      IF <ls_orderview_add>-gsiremarks IS INITIAL.
        <ls_orderview_add>-gsiremarks = <ls_orderview_add>-remarksvm.
      ELSE.
        CONCATENATE <ls_orderview_add>-gsiremarks '/' <ls_orderview_add>-remarksvm INTO <ls_orderview_add>-gsiremarks.
      ENDIF.
    ENDIF.

    IF <ls_orderview_add>-remarksspm IS NOT INITIAL.
      IF <ls_orderview_add>-gsiremarks IS INITIAL.
        <ls_orderview_add>-gsiremarks = <ls_orderview_add>-remarksspm.
      ELSE.
        CONCATENATE <ls_orderview_add>-gsiremarks '/' <ls_orderview_add>-remarksspm INTO <ls_orderview_add>-gsiremarks.
      ENDIF.
    ENDIF.

    IF <ls_orderview_add>-remarkspur IS NOT INITIAL.
      IF <ls_orderview_add>-gsiremarks IS INITIAL.
        <ls_orderview_add>-gsiremarks = <ls_orderview_add>-remarkspur.
      ELSE.
        CONCATENATE <ls_orderview_add>-gsiremarks '/' <ls_orderview_add>-remarkspur INTO <ls_orderview_add>-gsiremarks.
      ENDIF.
    ENDIF.

  ENDLOOP.
ENDFORM.
*&---------------------------------------------------------------------*
*&      Form  ADD_COMMENTS_ZRSP01
*&---------------------------------------------------------------------*
*       Mit ZCL_ORDER_DATA_FETCH=>CREATE_Z2_MMA_ZRSP01 angelegte Aktionen
*       werden direkt nach dem Anlegen nicht in ORDER_ADD aktualisiert
*       Workaround: direkt in ORDER_ADD-Tabelle schrieben; lediglich REMARKSSPM
*       es sind sehr wenige Fälle pro Tag ( 1, 2?)
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM add_comments_zrsp01 .

  DATA:
    ls_order_add TYPE /cellag/ord_add.

  LOOP AT gt_nomat ASSIGNING FIELD-SYMBOL(<ls_nomat>).

    CLEAR: ls_order_add.

    "gibts Satz schon?
    SELECT SINGLE * FROM /cellag/ord_add
      WHERE qmnum   = @<ls_nomat>-qmnum
        AND fenum   = @<ls_nomat>-fenum
        AND counter = @<ls_nomat>-counter
      INTO @ls_order_add.

    IF sy-subrc = 0.
      "vorhandenen Satz Kommentar und Zeitstempel anpassen
      IF ls_order_add-remarksspm IS INITIAL.
        ls_order_add-remarksspm = <ls_nomat>-matxt.
      ELSE.
        IF NOT <ls_nomat>-matxt IS INITIAL.
          CONCATENATE ls_order_add-remarksspm <ls_nomat>-matxt INTO ls_order_add-remarksspm SEPARATED BY '/'.
        ENDIF.
      ENDIF.
      ls_order_add-timestampspm = sy-datum.

      ls_order_add-aedat = sy-datum.
      ls_order_add-aeuhr = sy-uzeit.
      ls_order_add-aenam = sy-uname.
      UPDATE /cellag/ord_add FROM ls_order_add.

    ELSE.
      "anlegen
      ls_order_add-qmnum = <ls_nomat>-qmnum.
      ls_order_add-fenum = <ls_nomat>-fenum.
      ls_order_add-counter = <ls_nomat>-counter.
      ls_order_add-qmnum_z2 = <ls_nomat>-qmnum_z2.

      ls_order_add-remarksspm = <ls_nomat>-matxt.
      ls_order_add-timestampspm = sy-datum.

      ls_order_add-aedat = sy-datum.
      ls_order_add-aeuhr = sy-uzeit.
      ls_order_add-aenam = sy-uname.
      INSERT /cellag/ord_add FROM ls_order_add.

    ENDIF.

    COMMIT WORK.
  ENDLOOP.

ENDFORM.
