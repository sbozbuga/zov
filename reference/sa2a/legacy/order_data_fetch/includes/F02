        lv_count TYPE i.

  FIELD-SYMBOLS:
    <ls_zx_add>    TYPE tys_zx_add,
    <ls_orderview> LIKE LINE OF gt_orderview.

  lv_count = lines( gt_zx_add ).
  PERFORM prot_line USING lv_count 'ZX-Zusatzinfos für Verknüpfung                :'.


