*&---------------------------------------------------------------------*
*&      Form  GET_TA_QDAT
*&---------------------------------------------------------------------*
*       1511-375 Erweiterung Orderview Einlagerung
*       1.TANUM	        Transportauftragsnummer
*       2.EINLAGERDATE  Einlagerungsdatum
*       3.EINLAGZT      Uhrzeit Einlagerung
*       4.DATUM_Q_FREI  Datum Umlagerung Q nach Frei
*       5.UZEIT_Q_FREI  Uhrzeit Einlagerung Q nach Frei
*
*       Bestimmung der Felder über TA.
*       Materialbeleg über gt_mkpf bestimmen (Bezug zur FANUMER)
*       LTAP bestimmen über /CTDI/MBLNR_Q: 1/2/3
*       aus LTAP /CTDI/MBLNR_FREI: 4/5
*----------------------------------------------------------------------*
FORM get_ta_qdat .

  TYPES:

    BEGIN OF tys_mkpf2,
      mblnr LIKE mkpf-mblnr,
      mjahr LIKE mkpf-mjahr,
      cpudt LIKE mkpf-cpudt,
      cputm LIKE mkpf-cputm,
    END OF tys_mkpf2,
    tyt_mkpf2 TYPE HASHED TABLE OF tys_mkpf2 WITH UNIQUE KEY mblnr mjahr,

    BEGIN OF tys_ltap,
      tanum            TYPE tanum,
      qdatu            TYPE ltap_qdatu,
      qzeit            TYPE ltap_qzeit,
      /ctdi/mblnr_q    TYPE /ctdi/mblnr_q,
      /ctdi/mblnr_frei TYPE /ctdi/mblnr_frei,
      /ctdi/mjahr_frei TYPE /ctdi/mjahr_frei,
    END OF tys_ltap,
    tyt_ltap   TYPE STANDARD TABLE OF tys_ltap,
    tyt_ltap_h TYPE HASHED TABLE OF tys_ltap WITH UNIQUE KEY /ctdi/mblnr_q.

  DATA:
    lt_mkpf    TYPE tyt_mkpf,
    lt_mkpf_s  TYPE tyt_mkpf_s,
    lt_mkpf2   TYPE tyt_mkpf2,
    lt_ltap    TYPE tyt_ltap,
    lt_ltap_h  TYPE tyt_ltap_h,

    lv_count_t TYPE i,
    lv_count_m TYPE i.



  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_mkpf>      TYPE tys_mkpf,
    <ls_ltap>      TYPE tys_ltap,
    <ls_mkpf2>     TYPE tys_mkpf2.

  lt_mkpf[] = gt_mkpf[].
  SORT lt_mkpf BY xblnr mblnr.
  DELETE ADJACENT DUPLICATES FROM lt_mkpf COMPARING xblnr mblnr.
  lt_mkpf_s[] = lt_mkpf[].
  CLEAR:  lt_mkpf[].

  IF NOT lt_mkpf_s[] IS INITIAL.
    "Transportaufträge bestimmen
    SELECT tanum
           qdatu
           qzeit
           /ctdi/mblnr_q
           /ctdi/mblnr_frei
           /ctdi/mjahr_frei
      FROM ltap
      INTO TABLE lt_ltap
      FOR ALL ENTRIES IN lt_mkpf_s
      WHERE /ctdi/mblnr_q =  lt_mkpf_s-mblnr
        AND /ctdi/mjahr_q =  lt_mkpf_s-mjahr.
*      AND qdatu         >= co_einlagerdate.   "nur die ab 1.12.2015   auch nicht quittierte
    SORT lt_ltap BY /ctdi/mblnr_q.
    DELETE ADJACENT DUPLICATES FROM lt_ltap COMPARING /ctdi/mblnr_q.
    lt_ltap_h[] = lt_ltap[].
    CLEAR: lt_ltap[].

    "Materialbelege Buchung frei bestimmen
    IF NOT lt_ltap_h[] IS INITIAL.
      SELECT mblnr
             mjahr
             cpudt
             cputm
        FROM mkpf
        INTO TABLE lt_mkpf2
        FOR ALL ENTRIES IN lt_ltap_h
        WHERE mblnr = lt_ltap_h-/ctdi/mblnr_frei
          AND mjahr = lt_ltap_h-/ctdi/mjahr_frei.

    ENDIF.
  ENDIF.

  "Daten abmischen
  LOOP AT gt_orderview ASSIGNING <ls_orderview>.

    "MELDPOS  HB230116
    CONCATENATE <ls_orderview>-qmnum <ls_orderview>-fenum INTO <ls_orderview>-meldpos.

    LOOP AT lt_mkpf_s ASSIGNING <ls_mkpf> WHERE xblnr = <ls_orderview>-fanumber.
      READ TABLE lt_ltap_h ASSIGNING <ls_ltap> WITH TABLE KEY /ctdi/mblnr_q = <ls_mkpf>-mblnr.
      IF sy-subrc = 0.
        <ls_orderview>-tanum        = <ls_ltap>-tanum.
        IF <ls_orderview>-einlagerdate IS INITIAL AND NOT <ls_ltap>-qdatu IS INITIAL.
          <ls_orderview>-einlagerdate = <ls_ltap>-qdatu.
          <ls_orderview>-einlagzt     = <ls_ltap>-qzeit.

          "Form Build_calculated_Fields wird nicht durchlaufen; deshalb hier Closed setzen
          IF NOT <ls_orderview>-einlagerdate IS INITIAL.
            IF   NOT <ls_orderview>-deliverdate IS INITIAL.
              IF gt_orderview-orderstatecompl <> c_deleted.
                <ls_orderview>-orderstatecompl = c_closed.
              ENDIF.
              <ls_orderview>-dateclosed      = <ls_orderview>-einlagerdate.
            ENDIF.
          ENDIF.

          ADD 1 TO lv_count_t.
        ELSEIF <ls_orderview>-einlagerdate IS NOT INITIAL.
          CLEAR: <ls_orderview>-tanum.
        ENDIF.

        IF NOT <ls_ltap>-/ctdi/mblnr_frei IS INITIAL.
          IF NOT  <ls_orderview>-tanum IS INITIAL.
            READ TABLE lt_mkpf2 ASSIGNING <ls_mkpf2> WITH TABLE KEY mblnr = <ls_ltap>-/ctdi/mblnr_frei
                                                                    mjahr = <ls_ltap>-/ctdi/mjahr_frei.
            IF sy-subrc = 0.
              <ls_orderview>-datum_q_frei = <ls_mkpf2>-cpudt.
              <ls_orderview>-uzeit_q_frei = <ls_mkpf2>-cputm.
              ADD 1 TO lv_count_m.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.  "AT lt_mkpf_s
  ENDLOOP.    "AT gt_orderview

  PERFORM prot_line USING lv_count_t 'Ermittelt TA Einlagerung                      :'.
  PERFORM prot_line USING lv_count_m 'Ermittelt MatBeleg Kubestand an frei          :'.

ENDFORM.                    " GET_TA_QDAT
