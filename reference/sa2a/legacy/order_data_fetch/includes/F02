*&---------------------------------------------------------------------*
*       Es werden offensichtlich nicht alle Aufträge mit Kostv ermittelt
*       Die fehlenden versuchen zu ermitteln... (KOSTV aber keine Muss)
*----------------------------------------------------------------------*
FORM set_kostv_rest .

  TYPES:
    BEGIN OF tys_aufk,
      aufnr TYPE aufnr,
      kostv TYPE aufkostv,                                  "HB040618
    END OF tys_aufk,
    tyt_aufk TYPE HASHED TABLE OF tys_aufk WITH UNIQUE KEY aufnr.

  DATA:
    lt_aufk      TYPE tyt_aufk,
    lt_orderview TYPE tyt_orderview,
    lv_count     TYPE i,
    lv_count2    TYPE i.

  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_aufk>      TYPE tys_aufk.

  "umkopieren in lokale Tabelle und nur die ohne FASTART belassen
  lt_orderview[] = gt_orderview[].
  DELETE lt_orderview WHERE fanumber > space
                        AND kostv    > space.

  syst-tfill = lines( lt_orderview ).
  PERFORM prot_line USING syst-tfill 'Ohne KOSTV     Anzahl                         :'.

  CHECK NOT lt_orderview[] IS INITIAL.

  SELECT aufnr
         kostv
    FROM aufk
    INTO TABLE lt_aufk
    FOR ALL ENTRIES IN lt_orderview
    WHERE aufnr = lt_orderview-fanumber.

  LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE fanumber > space
                                                  AND kostv    = space.
    READ TABLE lt_aufk ASSIGNING <ls_aufk> WITH TABLE KEY aufnr = <ls_orderview>-fanumber.
    IF sy-subrc = 0.
      <ls_orderview>-kostv = <ls_aufk>-kostv.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " SET_KOSTV_REST
*&---------------------------------------------------------------------*
*&      Form  BEMOT_FROM_ZMIR_POS
*&---------------------------------------------------------------------*
*       1807-332 Orderview Berechnungsmotiv ZMIR-Pos VKBeleg
*       Mögliche  VK-Belege sind der Tabelle gt_vbkd_sel gesammelt
*       Je Pos, zu denen es noch keine Rückmeldung gibt
*       Die lesen mit BEMOT
*----------------------------------------------------------------------*
FORM bemot_from_zmir_pos .

  DATA:
    lt_vbap_zmir TYPE tyt_vbkd,
    lt_vbkd_h    TYPE tyt_vbkd_h2,
    lv_count     TYPE i.

  FIELD-SYMBOLS:
    <ls_vbkd>      TYPE tys_vbkd,
    <ls_vbkd2>     TYPE tys_vbkd,
    <ls_orderview> LIKE LINE OF gt_orderview.

  CHECK NOT gt_vbkd_sel[] IS INITIAL.

  "ZMIR-Positionen selektieren
  SELECT vbeln
         uepos
         posnr
    FROM vbap
    INTO CORRESPONDING FIELDS OF TABLE lt_vbap_zmir
    FOR ALL ENTRIES IN gt_vbkd_sel
    WHERE vbeln = gt_vbkd_sel-vbeln
      AND uepos = gt_vbkd_sel-posnr
      AND pstyv = 'ZMIR'
      AND ( abgru = space OR    "HB040222  2202-137 abgesagte ZMIR Positionen
            abgru = 'ZZ' ).     "zugelassen auch solche mit ZZ manuelle Handlerechnung
  "gesetzt mit ZFAKTSTATUS_C_SET

  CHECK NOT lt_vbap_zmir[] IS INITIAL.

  "vorhandene BEMOT lesen aus VBKD
  SELECT vbeln
         posnr
         bemot
    FROM vbkd
    INTO CORRESPONDING FIELDS OF TABLE lt_vbkd_h
    FOR ALL ENTRIES IN lt_vbap_zmir
    WHERE vbeln = lt_vbap_zmir-vbeln
      AND posnr = lt_vbap_zmir-posnr
      AND bemot > space.

  CHECK NOT lt_vbkd_h[] IS INITIAL.

  "Abmischen und BEMOT in lt_vbap_zmir übernehmen
  LOOP AT lt_vbap_zmir ASSIGNING <ls_vbkd>.
    READ TABLE lt_vbkd_h ASSIGNING <ls_vbkd2> WITH TABLE KEY vbeln = <ls_vbkd>-vbeln
                                                             posnr = <ls_vbkd>-posnr.
    IF sy-subrc = 0.
      <ls_vbkd>-bemot = <ls_vbkd2>-bemot.
    ELSE.
      DELETE lt_vbap_zmir.
    ENDIF.
  ENDLOOP.

  CHECK NOT lt_vbap_zmir[] IS INITIAL.
  SORT lt_vbap_zmir BY vbeln uepos.
  DELETE ADJACENT DUPLICATES FROM lt_vbap_zmir COMPARING vbeln uepos.
  gt_vbkd_h[] = lt_vbap_zmir[].

  syst-tfill = lines( gt_vbkd_h ).
  PERFORM prot_line USING syst-tfill 'ZMIR-Pos mit BEMOT     Anzahl                 :'.

  "Bemot austauschen, falls Eintrag in gt_vbkd_h
  LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE skz > space.
    READ TABLE gt_vbkd_h ASSIGNING <ls_vbkd> WITH TABLE KEY vbeln = <ls_orderview>-vbeln
                                                            uepos = <ls_orderview>-posnr.
    IF sy-subrc = 0.
      ADD 1 TO lv_count.
      <ls_orderview>-skz = <ls_vbkd>-bemot.
    ENDIF.
  ENDLOOP.

  IF NOT  lv_count IS INITIAL.
    PERFORM prot_line USING lv_count 'BEMOT gesetzt aus ZMIR Anzahl                 :'.
  ENDIF.

ENDFORM.                    " BEMOT_FROM_ZMIR_POS
