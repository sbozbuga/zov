        <ls_orderview>-zx_remarksvm   = <ls_zx_add>-remarksvm. "HB300714
        ADD 1 TO lv_count.
      ENDIF.
    ENDIF.
  ENDLOOP.

  PERFORM prot_line USING lv_count 'Verknüpfung Z1 mit ZX-Meldung                 :'.

