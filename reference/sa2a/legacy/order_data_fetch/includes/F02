        IF sy-subrc = 0.
          ADD 1 TO lv_count.
          <ls_orderview>-fkstk = 'C'.
          IF <ls_orderview>-trackdate      > '20010101' OR           "Ablieferdatum nicht leer
            ( <ls_orderview>-deliverdate    < gv_10days_back AND
