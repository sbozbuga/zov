*----------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Form  SET_FASTART_DATE
*&---------------------------------------------------------------------*
*       Versorgen Feld FASTART aus Änderungsbelegen
*       Lediglich die ohne Datum
*----------------------------------------------------------------------*
FORM set_fastart_date .

  TYPES:
    BEGIN OF tys_vbep,
      vbeln LIKE vbep-vbeln,
      posnr LIKE vbep-posnr,
      etenr LIKE vbep-etenr,
      edatu LIKE vbep-edatu,
      bmeng LIKE vbep-bmeng,
      aufnr LIKE vbep-aufnr,
      autyp LIKE aufk-autyp,
      erdat LIKE aufk-erdat,
      idat1 LIKE aufk-idat1,
      idat2 LIKE aufk-idat2,
      objnr LIKE aufk-objnr,
      kostv TYPE aufk-kostv,                                "HB040618
      gltrp LIKE afko-gltrp,
      rsnum LIKE afko-rsnum,
      aufpl LIKE afko-aufpl,
      obknr LIKE ser02-obknr,
    END OF tys_vbep,
    tyt_vbep   TYPE STANDARD TABLE OF tys_vbep,
    tyt_vbep_h TYPE HASHED TABLE OF tys_vbep WITH UNIQUE KEY aufnr,

    BEGIN OF tys_objectid,
      qmnum    TYPE qmnum,
      fenum    TYPE fenum,
      counter  TYPE cim_count,
      objectid TYPE cdobjectv,
      kostv    TYPE aufkostv,                               "HB040618
    END OF tys_objectid,
    tyt_objectid TYPE HASHED TABLE OF tys_objectid WITH UNIQUE KEY qmnum fenum counter,

    BEGIN OF tys_cdpos,
      objectid TYPE cdobjectv,
      changenr TYPE cdchangenr,
    END OF tys_cdpos,
    tyt_cdpos TYPE STANDARD TABLE OF tys_cdpos,

    BEGIN OF tys_cdhdr,
      objectid TYPE cdobjectv,
      changenr TYPE cdchangenr,
      udate    TYPE cddatum,
    END OF tys_cdhdr,
    tyt_cdhdr   TYPE STANDARD TABLE OF tys_cdhdr,
    tyt_cdhdr_h TYPE HASHED TABLE OF tys_cdhdr WITH UNIQUE KEY objectid.

  DATA:
    lt_vbep      TYPE tyt_vbep,
    lt_vbep_h    TYPE tyt_vbep_h,
    lt_objectid  TYPE tyt_objectid,
    lt_cdpos     TYPE tyt_cdpos,
    lt_cdhdr     TYPE tyt_cdhdr,
    lt_cdhdr_h   TYPE tyt_cdhdr_h,
    lt_orderview TYPE tyt_orderview,

    ls_objectid  TYPE tys_objectid,

    lv_count     TYPE i,
    lv_count2    TYPE i.

  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_vbep>      TYPE tys_vbep,
    <ls_objectid>  TYPE tys_objectid,
    <ls_cdhdr>     TYPE tys_cdhdr.

  lt_vbep[] =  gt_vbep_aux[].
  SORT lt_vbep BY aufnr.
  DELETE ADJACENT DUPLICATES FROM lt_vbep COMPARING aufnr.
  lt_vbep_h[] = lt_vbep[].

  "umkopieren in lokale Tabelle und nur die ohne FASTART belassen
  lt_orderview[] = gt_orderview[].
  DELETE lt_orderview WHERE fanumber = space
                            OR ( fanumber > space AND
                                 fastart  > '19000101' ). "bereits gesetzt
*                            OR ( fanumber > space AND                       "HB231018
*                                 faend    > '19000101' ). "bereits beendet

  syst-tfill = lines( lt_orderview ).
  PERFORM prot_line USING syst-tfill 'Ohne FASTART   Anzahl                         :'.

  "objectid bauen
  LOOP AT lt_orderview ASSIGNING <ls_orderview>.
    READ TABLE lt_vbep_h ASSIGNING <ls_vbep> WITH TABLE KEY aufnr = <ls_orderview>-fanumber.
    IF sy-subrc = 0.
      ls_objectid-qmnum   = <ls_orderview>-qmnum.
      ls_objectid-fenum   = <ls_orderview>-fenum.
      ls_objectid-counter = <ls_orderview>-counter.
      ls_objectid-kostv   = <ls_vbep>-kostv.                "HB040618
      CONCATENATE sy-mandt <ls_vbep>-autyp <ls_vbep>-aufnr INTO ls_objectid-objectid.
      INSERT ls_objectid INTO TABLE lt_objectid.
    ENDIF.
  ENDLOOP.

  CLEAR: lt_vbep_h[],
         lt_vbep[].

  CHECK NOT lt_objectid[] IS INITIAL.

  SELECT objectid
         changenr
    FROM cdpos
    INTO TABLE lt_cdpos
    FOR ALL ENTRIES IN lt_objectid
    WHERE objectclas = 'ORDER'
      AND objectid  = lt_objectid-objectid
      AND fname     = 'STEUS'
      AND chngind   = 'U'
      AND value_new = 'ZM02'
      AND value_old = 'ZM01'.

  CHECK NOT lt_cdpos[] IS INITIAL.
  syst-tfill = lines( lt_cdpos ).
  PERFORM prot_line USING syst-tfill 'Wechsel ZM01->ZM02                            :'.

  SELECT objectid
         changenr
         udate
    FROM cdhdr
    INTO TABLE lt_cdhdr
    FOR ALL ENTRIES IN lt_cdpos
    WHERE objectclas = 'ORDER'
      AND objectid = lt_cdpos-objectid
      AND changenr = lt_cdpos-changenr.
  "neueste Änderung
  SORT lt_cdhdr BY objectid ASCENDING
                   udate    DESCENDING.
  DELETE ADJACENT DUPLICATES FROM lt_cdhdr COMPARING objectid.
  lt_cdhdr_h[] = lt_cdhdr[].
  CLEAR: lt_cdhdr[],
         lt_cdpos[].

  "In Originaltabelle ergänzen
  LOOP AT gt_orderview ASSIGNING <ls_orderview>
                       WHERE fanumber > space
                         AND fastart IS INITIAL.
    ADD 1 TO lv_count2.
    READ TABLE lt_objectid ASSIGNING <ls_objectid>
                           WITH TABLE KEY qmnum   = <ls_orderview>-qmnum
                                          fenum   = <ls_orderview>-fenum
                                          counter = <ls_orderview>-counter.
    IF sy-subrc = 0.
      <ls_orderview>-kostv = <ls_objectid>-kostv.           "HB040618
      READ TABLE lt_cdhdr_h ASSIGNING <ls_cdhdr>
                            WITH TABLE KEY objectid = <ls_objectid>-objectid.
      IF sy-subrc = 0.
        ADD 1 TO lv_count.
        <ls_orderview>-fastart = <ls_cdhdr>-udate.
      ENDIF.
    ENDIF.
  ENDLOOP.

  PERFORM prot_line USING lv_count2 'Vorgänge FASTART leer                         :'.
  PERFORM prot_line USING lv_count 'FASTART gesetzt                               :'.


ENDFORM.                    " SET_FASTART_DATE
*&---------------------------------------------------------------------*
*&      Form  GET_RETOURE_ZIL
*&---------------------------------------------------------------------*
*       HB310817: fehlen Matnr, Serialnr zur Retoure 1708-755
*       analog YLE01 beschaffen
*&---------------------------------------------------------------------*
*       HB210622 auch ohne Serialnr
*----------------------------------------------------------------------*
FORM get_retoure_zil .

  TYPES:
    BEGIN OF tys_likp,
      vbeln     TYPE vbeln_vl,
      wadat_ist TYPE wadat_ist,
      bldat     TYPE bldat,
    END OF tys_likp,
    tyt_likp TYPE HASHED TABLE OF tys_likp WITH UNIQUE KEY vbeln,

    BEGIN OF tys_lips_ret,
      vbeln     TYPE vbeln_vl,
      posnr     TYPE posnr_vl,
      matnr     TYPE matnr,
      erdat     TYPE erdat,
      wadat_ist TYPE wadat_ist,
      bldat     TYPE bldat,
    END OF tys_lips_ret,
    tyt_lips_ret TYPE HASHED TABLE OF tys_lips_ret
                         WITH UNIQUE KEY vbeln
                                         posnr,

    BEGIN OF tys_ser01,
      obknr   TYPE ser01-obknr,
      lief_nr TYPE ser01-lief_nr,
      posnr   TYPE ser01-posnr,
      equnr   TYPE objk-equnr,
    END OF tys_ser01,
    tyt_ser01   TYPE STANDARD TABLE OF tys_ser01,
    tyt_ser01_h TYPE HASHED TABLE OF tys_ser01 WITH UNIQUE KEY lief_nr
                                                             posnr,

    BEGIN OF tys_equi,
      equnr TYPE equi-equnr,
      serge TYPE equi-serge,  "Herstellerserialnr
      sernr TYPE equi-sernr,
    END OF tys_equi,
    tyt_equi TYPE HASHED TABLE OF tys_equi WITH UNIQUE KEY equnr.


  DATA:
    lt_orderview TYPE tyt_orderview,
    lv_count     TYPE i,

    lt_vbfa      TYPE tyt_vbfa,
    lt_vbfa_h    TYPE tyt_vbfa_h,
    lt_lips_ret  TYPE tyt_lips_ret,
    lt_ser01     TYPE tyt_ser01,
    lt_ser01_h   TYPE tyt_ser01_h,
    lt_equi      TYPE tyt_equi.


  FIELD-SYMBOLS:
    <ls_zordview_cust1> TYPE zordview_cust1,
    <ls_orderview>      LIKE LINE OF gt_orderview,
    <ls_orderview2>     LIKE LINE OF gt_orderview,
    <ls_vbfa>           TYPE tys_vbfa,
    <ls_lips>           TYPE tys_lips_ret,
    <ls_ser01>          TYPE tys_ser01,
    <ls_equi>           TYPE tys_equi.


  "ZIL-Sätze separieren
  LOOP AT gt_orderview ASSIGNING <ls_orderview>
                       WHERE otgrp = 'ZIL'.
    INSERT INITIAL LINE INTO TABLE lt_orderview ASSIGNING <ls_orderview2>.
    <ls_orderview2> = <ls_orderview>.
    DELETE gt_orderview.  "raus
  ENDLOOP.

  CHECK lt_orderview[] IS NOT INITIAL.

  SELECT vbelv
         posnv
         vbeln
         posnn
    FROM vbfa
    INTO TABLE lt_vbfa
    FOR ALL ENTRIES IN lt_orderview
    WHERE vbelv   = lt_orderview-vbeln
      AND posnv   = lt_orderview-posnr
      AND vbtyp_n = 'T'.    "Retourenlieferung zum Auftrag

  IF lt_vbfa[] IS NOT INITIAL.
    SORT lt_vbfa BY vbelv ASCENDING
                    posnv ASCENDING
                    vbeln DESCENDING.   "neuester nehmen, falls mehrere
    DELETE ADJACENT DUPLICATES FROM lt_vbfa COMPARING vbelv posnv.
    lt_vbfa_h[] = lt_vbfa[].
    CLEAR:   lt_vbfa[].

    PERFORM prot_line USING syst-tfill 'ZIL Retouren ermittelt                        :'.

    "Lieferscheindaten ermittelt
    SELECT a~vbeln
           a~posnr
           a~matnr
           b~erdat                                          "HB180216
           b~wadat_ist
           b~bldat                                          "MK260716
      FROM lips AS a
        INNER JOIN likp AS b
          ON a~vbeln = b~vbeln
      INTO TABLE lt_lips_ret
      FOR ALL ENTRIES IN lt_vbfa_h
      WHERE a~vbeln = lt_vbfa_h-vbeln
        AND a~posnr = lt_vbfa_h-posnn.

    IF lt_lips_ret[] IS NOT INITIAL.

      "Serialnummern Retoure
      SELECT a~obknr
             a~lief_nr
             a~posnr
             b~equnr
        FROM ser01 AS a
          LEFT OUTER JOIN objk AS b
          ON b~obknr = a~obknr
        INTO TABLE lt_ser01
        FOR ALL ENTRIES IN lt_lips_ret
        WHERE a~lief_nr = lt_lips_ret-vbeln
          AND a~posnr   = lt_lips_ret-posnr.
      SORT lt_ser01 BY lief_nr
                       posnr.
      DELETE ADJACENT DUPLICATES FROM lt_ser01 COMPARING lief_nr
                                                         posnr.
      lt_ser01_h[] = lt_ser01[].
      CLEAR: lt_ser01[].

      IF lt_ser01_h[] IS NOT INITIAL.
        SELECT equnr
               serge
               sernr
          FROM equi
          INTO TABLE lt_equi
          FOR ALL ENTRIES IN lt_ser01_h
          WHERE equnr = lt_ser01_h-equnr.
      ENDIF.  "  IF lt_ser01_h[] IS NOT INITIAL.

      "Retourenanlieferungen und Serialnr ergänzen ergänzen
      LOOP AT lt_orderview ASSIGNING <ls_orderview>.
        READ TABLE lt_vbfa_h ASSIGNING <ls_vbfa> WITH TABLE KEY vbelv = <ls_orderview>-vbeln
                                                                posnv = <ls_orderview>-posnr.
        IF sy-subrc = 0.
          <ls_orderview>-retoure = <ls_vbfa>-vbeln.
          "Receivedate?  gt_orderview-receivedate = gt_lips_ret-wadat_ist.
          "Dockdate?  likp-bldat
          READ TABLE lt_lips_ret ASSIGNING <ls_lips> WITH TABLE KEY vbeln = <ls_vbfa>-vbeln
                                                                    posnr = <ls_vbfa>-posnn.
          IF sy-subrc = 0.
            <ls_orderview>-receivedate = <ls_lips>-wadat_ist.
            <ls_orderview>-dockdate    = <ls_lips>-bldat.
            <ls_orderview>-matnr_in    = <ls_lips>-matnr.

            "Form Build_calculated_Fields wird nicht durchlaufen; deshalb hier Closed setzen
            IF NOT <ls_lips>-wadat_ist IS INITIAL.
              <ls_orderview>-orderstatecompl = c_closed.
              <ls_orderview>-dateclosed      = <ls_lips>-wadat_ist.

              "Archivkennzeichen, falls keine Faktura erwartet      HB090617
              "1706-096 Codegruppe ZIL bekommt kein Archivkennzeichen
              READ TABLE gt_zordview_cust1 ASSIGNING <ls_zordview_cust1> WITH TABLE KEY wktnr = <ls_orderview>-wktnr.
              IF sy-subrc = 0.
                "Archivkennzeichen setzen? auch wenn keine Faktura existiert
                IF <ls_zordview_cust1>-no_invoic_sd = abap_true.
                  <ls_orderview>-archivflag = abap_true.
                ENDIF.

              ELSE.  "2105-324 Unschärfe bei ZIL Meldungen Archivkz
                "Archivflag setzen falls Gesamtstatus GBSTK  = C sitzt
                READ TABLE gt_vbap_aux WITH KEY qmnum = <ls_orderview>-qmnum
                                                fenum = <ls_orderview>-fenum BINARY SEARCH.

                IF sy-subrc EQ 0.
                  IF gt_vbap_aux-gbstk = cl_wsso_wd_as_dlv=>gc_sd_doc_status_complete.  "C
                    <ls_orderview>-archivflag = abap_true.
                    <ls_orderview>-gbstk = cl_wsso_wd_as_dlv=>gc_sd_doc_status_complete.  "C
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.

            "Serialnr-Daten
            READ TABLE lt_ser01_h ASSIGNING <ls_ser01> WITH TABLE KEY lief_nr = <ls_lips>-vbeln
                                                                      posnr   = <ls_lips>-posnr.
            IF sy-subrc = 0.
              READ TABLE lt_equi ASSIGNING <ls_equi> WITH TABLE KEY equnr = <ls_ser01>-equnr.
              IF sy-subrc = 0.
                <ls_orderview>-serialrec       = <ls_equi>-serge.
                <ls_orderview>-sernrrec        = <ls_equi>-sernr.
                <ls_orderview>-equipmentnummer = <ls_equi>-equnr.
              ENDIF.
            ENDIF.
          ENDIF.
        ENDIF.

      ENDLOOP.

    ENDIF.  "IF lt_lips_ret[] IS NOT INITIAL.
  ENDIF.  "IF lt_vbfa[] IS NOT INITIAL.

  "wieder anhängen
  APPEND LINES OF lt_orderview TO gt_orderview.

ENDFORM.                    "get_retoure_zil
*&---------------------------------------------------------------------*
*&      Form  SET_SERIALREC_ORIGINAL
*&---------------------------------------------------------------------*
*       ursprüngliche Serialnr setzen aus /CELLAG/ZW51_SER
*       aktualisieren gt_orderview[].
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM set_serialrec_original .

  TYPES:
    BEGIN OF tys_zw51_ser,
      qmnum TYPE qmnum,
      fenum TYPE felfd,
      equnr TYPE equnr,
      serge TYPE /cellag/serge,
    END OF tys_zw51_ser,
    tyt_zw51_ser  TYPE STANDARD TABLE OF tys_zw51_ser,
    tyt_zw51_serh TYPE HASHED TABLE OF tys_zw51_ser WITH UNIQUE KEY qmnum fenum equnr.

  DATA:
    lt_orderview TYPE tyt_orderview,
    lt_zw51_ser  TYPE tyt_zw51_ser,
    lt_zw51_serh TYPE tyt_zw51_serh,

    lv_equnr     TYPE equnr,

    lv_count     TYPE i.

  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_zw51_ser>  TYPE tys_zw51_ser.

  lt_orderview[] = gt_orderview[].
  SORT lt_orderview BY qmnum.
  DELETE ADJACENT DUPLICATES FROM lt_orderview COMPARING qmnum.
  CLEAR: lt_zw51_ser[].

  SELECT qmnum
         fenum
         equnr
         serge
    FROM /cellag/zw51_ser
    INTO TABLE lt_zw51_ser
    FOR ALL ENTRIES IN gt_orderview
    WHERE qmnum = gt_orderview-qmnum
      AND equnr > '000000000000000000'.
  IF NOT lt_zw51_ser[] IS INITIAL.                          "HB040222
    SORT lt_zw51_ser BY qmnum fenum equnr.
    DELETE ADJACENT DUPLICATES FROM lt_zw51_ser COMPARING qmnum fenum equnr.
    lt_zw51_serh[] = lt_zw51_ser[].

    LOOP AT gt_orderview ASSIGNING <ls_orderview>.
      lv_equnr = <ls_orderview>-sernrrec.
      "führende 0; so gespeichert in zw51_ser
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
        EXPORTING
          input  = lv_equnr
        IMPORTING
          output = lv_equnr.

      READ TABLE lt_zw51_serh WITH TABLE KEY qmnum = <ls_orderview>-qmnum
                                             fenum = <ls_orderview>-fenum
                                             equnr = lv_equnr
                             ASSIGNING <ls_zw51_ser>.
      IF sy-subrc = 0.
        IF <ls_orderview>-serialrec <> <ls_zw51_ser>-serge.
          ADD 1 TO lv_count.
          "Ausgabe
*        IF lv_count < 10.
*          WRITE:/ <ls_orderview>-qmnum, <ls_orderview>-fenum, <ls_orderview>-sernrrec.
*          WRITE:/ 'akt:', <ls_orderview>-serialrec, 'org:', <ls_zw51_ser>-serge.
*        ENDIF.

          <ls_orderview>-serialrec = <ls_zw51_ser>-serge.
        ENDIF.
      ENDIF.
    ENDLOOP.

    PERFORM prot_line USING lv_count 'Original-Inbound-Serial gesetzt               :'.
  ENDIF.  "IF NOT lt_zw51_ser[] IS INITIAL
ENDFORM.                    " SET_SERIALREC_ORIGINAL
*&---------------------------------------------------------------------*
*&      Form  HANDLE_ZFL
*&---------------------------------------------------------------------*
*       Behandlung Codegruppe ZFL
*       Closed-Prüfung
*-----------------------------------------------------------------------
*       1710-456 Axa Unterpos Lieferungen      HB221017
*       Serialnr nachtragen; Posnr Lieferung korrigieren
*       Daten aus gt_lips_aux
*-----------------------------------------------------------------------
*       2010-1008 ORDERVIEW New process type ZMTO_ZMT1  HB160621
*       ZMTO ist ein Forwärts Logistik Prozess wie ZFL
*       ZMT1 Verkaufsbeleg und eine Rechnung. Keine Lieferung
*----------------------------------------------------------------------*
FORM handle_zfl .

  TYPES:
    BEGIN OF tys_lips_lif.
*        vbeln LIKE likp-vbeln,
*        posnr LIKE lips-posnr,
*        matnr LIKE lips-matnr,
*        werks LIKE lips-werks,
*        lgort LIKE lips-lgort,
*        lfimg LIKE lips-lfimg,
*        vgbel LIKE lips-vgbel,
*        vgpos LIKE lips-vgpos,
*        /cellag/akz LIKE lips-/cellag/akz,
*        uecha TYPE uecha,                                   "HB201017
*        vbtyp LIKE likp-vbtyp,
*        vsbed LIKE likp-vsbed,
*        bldat LIKE likp-bldat,
*        tddat LIKE likp-tddat,
*        wadat_ist LIKE likp-wadat_ist,
*        tduhr LIKE likp-tduhr,
*        wbsta LIKE vbup-wbsta,
*        obknr LIKE ser01-obknr,
*        route TYPE route,                                   "HB270614
*        erdat TYPE erdat,                                   "HB060216
*        edatu LIKE vbep-edatu,
*        equnr LIKE objk-equnr,
*        sernr LIKE objk-sernr,
*        serge LIKE equi-serge,
      INCLUDE STRUCTURE gt_lips_lif.
      TYPES:
    END OF tys_lips_lif,
    tyt_lips_lif   TYPE STANDARD TABLE OF tys_lips_lif,
    tyt_lips_lif_h TYPE HASHED TABLE OF tys_lips_lif WITH UNIQUE KEY vgbel vgpos.



  DATA:
    lv_count      TYPE i,
    lv_cutofft    TYPE syuzeit,

    lt_lips_lif   TYPE tyt_lips_lif,
    lt_lips_lif_h TYPE tyt_lips_lif_h.


  FIELD-SYMBOLS:
    <ls_zordview_cutofft> TYPE zordview_cutofft,
    <ls_orderview>        LIKE LINE OF gt_orderview,
    <ls_lips_lif>         TYPE tys_lips_lif.

  "Daten aus Tabelle Lieferungen übernehmen
  lt_lips_lif[] = gt_lips_lif[].
  SORT lt_lips_lif BY vgbel vgpos posnr.
  DELETE ADJACENT DUPLICATES FROM lt_lips_lif COMPARING vgbel vgpos.
  lt_lips_lif_h[] =  lt_lips_lif[].
  CLEAR: lt_lips_lif[].

  LOOP AT gt_orderview ASSIGNING <ls_orderview>
                       WHERE ( otgrp = 'ZFL'  OR
                               otgrp = 'ZMT1' OR            "HB160621
                               otgrp = 'ZMTO' OR            "HB160621
                               otgrp = 'ZRET' OR            "HB100325
                               otgrp = 'ZTRANS' ).          "HB100325

    IF <ls_orderview>-counter > '00000001'.
      "1712-154 Fehler bei der Vereinzelung in Orderview
      "korrekte Werte für vereinzelte werte bereits ermittelt
      CONTINUE.
    ENDIF.
    "Serialnr übernehmen; Posnr Lieferung korrigieren auf Hauptpos
    "vgl. Form  FILL_LIPS_LIF_FIELDS
    READ TABLE lt_lips_lif_h WITH TABLE KEY vgbel = <ls_orderview>-vbeln
                                            vgpos = <ls_orderview>-posnr
                             ASSIGNING <ls_lips_lif>.
    IF sy-subrc = 0.
      ADD 1 TO lv_count.
      <ls_orderview>-delnoteposnr    = <ls_lips_lif>-posnr.  "Korrektur Altfälle

      <ls_orderview>-serialdeliver   = <ls_lips_lif>-serge.
      <ls_orderview>-sernrlif        = <ls_lips_lif>-sernr.
      <ls_orderview>-lieferlager     = <ls_lips_lif>-lgort.
      <ls_orderview>-lieferwerk      = <ls_lips_lif>-werks.
      <ls_orderview>-deliverdate     = <ls_lips_lif>-wadat_ist.
      <ls_orderview>-delnotenumber   = <ls_lips_lif>-vbeln.
      <ls_orderview>-delnoteposnr    = <ls_lips_lif>-posnr.
      <ls_orderview>-vsbed           = <ls_lips_lif>-vsbed.
      <ls_orderview>-wbsta           = <ls_lips_lif>-wbsta.
      <ls_orderview>-matnr_out       = <ls_lips_lif>-matnr.
*      <ls_orderview>-kundewunschterm = <ls_lips_lif>-edatu.    "HB230918

      <ls_orderview>-route           = <ls_lips_lif>-route. "HB270614


*      IF NOT <ls_lips_lif>-tddat IS INITIAL.    "HB240418   (vorher TDUHR)
      IF NOT <ls_lips_lif>-tduhr IS INITIAL.                "HB040320
        "2003-114 Unschärfe Orderview -  Ready To ship Datum
        <ls_orderview>-readytoship   = <ls_lips_lif>-tddat.
      ENDIF.
    ENDIF.

*    PERFORM build_calculated_fields.
    "nur Code-Extract speziell ZFL, da sonst zu viel Aktionen

    IF NOT <ls_orderview>-orderdate IS INITIAL.
      "CutOff-Zeit ermitteln aus Cust
      lv_cutofft = '160000'.  "Default    HB190915
      READ TABLE gt_zordview_cutofft WITH TABLE KEY wktnr = <ls_orderview>-wktnr
                                     ASSIGNING <ls_zordview_cutofft>.
      IF sy-subrc = 0.
        lv_cutofft = <ls_zordview_cutofft>-ab_uzeit.
      ENDIF.

      IF <ls_orderview>-uhrzeitorder >= lv_cutofft.
        <ls_orderview>-initcommitdate = <ls_orderview>-orderdate + 1.
      ELSE.
        <ls_orderview>-initcommitdate = <ls_orderview>-orderdate.
      ENDIF.

      CLEAR gt_t001w.
      READ TABLE gt_t001w WITH KEY werks = <ls_orderview>-werks.

      CALL FUNCTION 'DATE_CONVERT_TO_FACTORYDATE'
        EXPORTING
          date                         = <ls_orderview>-initcommitdate
          factory_calendar_id          = gt_t001w-fabkl
        IMPORTING
          date                         = <ls_orderview>-initcommitdate
        EXCEPTIONS
          calendar_buffer_not_loadable = 1
          correct_option_invalid       = 2
          date_after_range             = 3
          date_before_range            = 4
          date_invalid                 = 5
          factory_calendar_not_found   = 6
          OTHERS                       = 7.

*        if <ls_orderview>-otgrp = 'ZFL'.
      "Ausnahmefall Vorwärtslogistik = Lieferterminsoll
      <ls_orderview>-auftragsendesoll = <ls_orderview>-initcommitdate. "HB190514
*        endif.
    ENDIF.

    IF <ls_orderview>-archivflag IS INITIAL.                "HB090115
      IF <ls_orderview>-orderstatecompl <> c_closed.
        IF <ls_orderview>-otgrp = 'ZFL'  OR <ls_orderview>-otgrp = 'ZMTO' OR "HB160621
           <ls_orderview>-otgrp = 'ZRET' OR <ls_orderview>-otgrp = 'ZTRANS'. "HB100325
          "Mit Lieferung
          IF NOT <ls_orderview>-deliverdate IS INITIAL.
            IF <ls_orderview>-orderstatecompl <> c_deleted.
              <ls_orderview>-orderstatecompl = c_closed.
            ENDIF.
            IF <ls_orderview>-dateclosed  IS INITIAL.
              <ls_orderview>-dateclosed = <ls_orderview>-deliverdate.
            ENDIF.
          ENDIF.
        ELSEIF <ls_orderview>-otgrp = 'ZMT1'.               "HB160621
          "keine Lieferung, nur Rechnung
          IF NOT <ls_orderview>-rechdatum IS INITIAL.
            IF <ls_orderview>-orderstatecompl <> c_deleted.
              <ls_orderview>-orderstatecompl = c_closed.
            ENDIF.
            IF <ls_orderview>-dateclosed  IS INITIAL.
              <ls_orderview>-dateclosed = <ls_orderview>-rechdatum.
            ENDIF.
          ENDIF.

          "Archivkennzeichen ZMT1
          " a) Orderstatus = C und Fakturastatus = C  oder
          " b) Orderstatus =C und Gesamtbelegstatus des Verkaufbelegs = C
          IF <ls_orderview>-orderstatecompl = c_closed.
            IF <ls_orderview>-fkstk = c_closed OR
               <ls_orderview>-gbstk = c_closed.
              <ls_orderview>-archivflag = abap_true.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDLOOP.

  PERFORM prot_line USING lv_count 'HANDLE_ZFL Unterpos. Anzahl                   :'.

ENDFORM.                    " HANDLE_ZFL

*&---------------------------------------------------------------------*
*&      Form  VEREINZELUNG
*&---------------------------------------------------------------------*
*       Setzen der Lieferungen und Serialnummern für Vereinzelung
*       zurvor war: SORT gt_orderview BY qmnum fenum counter.
*       nur bei denen die Counter > 1 haben
*
*       Ausgelagert, da Änderungen im alten Coding einiges an Umbau
*       erfordern würde - sehr umständlich und altbacken programmiert!
*
**DATA: BEGIN OF gt_orderview OCCURS 0.
*        INCLUDE STRUCTURE /cellag/ordview.
*DATA: flag_vbep,
*      flag_lif,
*      flag_ekpo,
*      flag_qmferm,
*      abgru_ret        type ABGRU_VA,   "HB121213
*      abgru_aedat      type aedat.      "HB161213
*DATA: END OF gt_orderview.
*
*  delnoteprint evtl. noch ein Problem
*----------------------------------------------------------------------*
*    1501-223 Unschärfe in Orderview - Faktura bei Vereinzelung
*    HERMB 17.01.2015 Rechnungsnummern fehlen ebenfalls; aus VBFA zu Lief
*----------------------------------------------------------------------*
FORM vereinzelung .

  TYPES: BEGIN OF tys_lif,
           qmnum TYPE qmnum,
           fenum TYPE fenum,
           vbeln TYPE vbeln_vl,
           posnr TYPE posnr_vl,
         END OF tys_lif,
         tyt_lif   TYPE STANDARD TABLE OF tys_lif,
         tyt_lif_h TYPE HASHED TABLE OF tys_lif WITH UNIQUE KEY qmnum fenum,

         BEGIN OF tys_vbfa,
           vbelv TYPE vbeln_von,
           posnv TYPE posnr_von,
           vbeln TYPE vbeln_nach,
           posnn TYPE posnr_nach,
           erdat TYPE erdat,
           rfwrt TYPE rfwrt,
           waers TYPE waers_v,
         END OF tys_vbfa,
         tyt_vbfa   TYPE STANDARD TABLE OF tys_vbfa,
         tyt_vbfa_h TYPE HASHED TABLE OF tys_vbfa WITH UNIQUE KEY vbelv posnv,

         BEGIN OF tys_ser01,
           lief_nr TYPE vbeln_vl,
           posnr   TYPE posnr_vl,
           obknr   TYPE objknr,
         END OF tys_ser01,
         tyt_ser01   TYPE STANDARD TABLE OF tys_ser01,
         tyt_ser01_h TYPE HASHED TABLE OF tys_ser01 WITH UNIQUE KEY lief_nr
                                                                    posnr,

         BEGIN OF tys_likp,
           vbeln     TYPE vbeln_vl,
           tddat     TYPE tddat_d,
           tduhr     TYPE tduhr,                            "HB060222
           wadat_ist TYPE wadat_ist,
           erdat     TYPE erdat,
         END OF tys_likp,
         tyt_likp TYPE HASHED TABLE OF tys_likp WITH UNIQUE KEY vbeln,

         BEGIN OF tys_objk,
           obknr TYPE objknr,
           obzae TYPE objza,
           equnr TYPE equnr,
           sernr TYPE gernr,
         END OF tys_objk,
         tyt_objk TYPE HASHED TABLE OF tys_objk WITH UNIQUE KEY obknr obzae,

         BEGIN OF tys_mara,
           matnr TYPE matnr,
           mfrpn TYPE mfrpn,
         END OF tys_mara,
         tyt_mara TYPE HASHED TABLE OF tys_mara WITH UNIQUE KEY matnr,

         BEGIN OF tys_equi,
           equnr TYPE equnr,
           serge TYPE serge,
         END OF tys_equi,
         tyt_equi TYPE HASHED TABLE OF tys_equi WITH UNIQUE KEY equnr,

         BEGIN OF tys_lips,
           vbeln TYPE vbeln_va,
           posnr TYPE posnr_va,
           werks TYPE werks_ext,
           lgort TYPE lgort_d,
           matnr TYPE matnr,
         END OF tys_lips,
         tyt_lips TYPE HASHED TABLE OF tys_lips WITH UNIQUE KEY vbeln posnr,

         BEGIN OF tys_repdau,
           qmnum    TYPE qmnum,
           fenum    TYPE fenum,
           repdauer TYPE /cellag/repdauer,
         END OF tys_repdau,
         tyt_repdau TYPE STANDARD TABLE OF tys_repdau.

  DATA: lv_count       TYPE i,
        lv_obzae       TYPE objza,

        ls_orderview   LIKE LINE OF gt_orderview,
        lt_orderview_s TYPE tyt_orderview_s,
        lt_lif         TYPE tyt_lif,
        lt_lif2        TYPE tyt_lif,
        lt_lif_h       TYPE tyt_lif_h,
        lt_vbfa        TYPE tyt_vbfa,
        lt_vbfa2       TYPE tyt_vbfa,     "Faktura
        lt_vbfa_h      TYPE tyt_vbfa_h,
        lt_vbfa_h2     TYPE tyt_vbfa_h,   "Faktura
        lt_ser01       TYPE tyt_ser01,
        lt_ser01_h     TYPE tyt_ser01_h,
        lt_likp        TYPE tyt_likp,
        lt_objk        TYPE tyt_objk,
        lt_mara        TYPE tyt_mara,
        lt_equi        TYPE tyt_equi,
        lt_lips        TYPE tyt_lips,
        lv_repdauer    TYPE /cellag/repdauer,
        lv_countrep0   TYPE i.


  FIELD-SYMBOLS:
    <ls_lif>       TYPE tys_lif,
    <ls_lif2>      TYPE tys_lif,
    <ls_ser01>     TYPE tys_ser01,
    <ls_mara>      TYPE tys_mara,
    <ls_lips>      TYPE tys_lips,
    <ls_vbfa>      TYPE tys_vbfa,
    <ls_likp>      TYPE tys_likp,
    <ls_objk>      TYPE tys_objk,
    <ls_equi>      TYPE tys_equi,
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_vttp>      TYPE tys_vttp.

  "Betroffene Positionen ermitteln; eigene Tabelle aufbauen
  "genau ein Satz pro Meldungsnr + Pos
  LOOP AT gt_orderview WHERE counter = 1.
    INSERT INITIAL LINE INTO TABLE lt_lif ASSIGNING <ls_lif>.
    <ls_lif>-qmnum    = gt_orderview-qmnum.
    <ls_lif>-fenum    = gt_orderview-fenum.
    <ls_lif>-vbeln    = gt_orderview-vbeln.
    <ls_lif>-posnr    = gt_orderview-posnr.
  ENDLOOP.

  CHECK lt_lif[] IS NOT INITIAL.
  syst-tfill = lines( lt_lif ).
  PERFORM prot_line USING syst-tfill 'Vereinzelung. Pos mit Counter 1               :'.

  "Problem: Lieferscheinnummer teilweise nicht vorhanden - neu bestimmen
  "Lieferungen aus Vertriebsbelegfluss
  "es gibt im Test mehrere Lieferscheinnummern pro Auftrag; diese entfernen (keine Vereinzelung)
  SELECT vbelv
         posnv
         vbeln                      "Kundenlieferung
         posnn
    FROM vbfa
    INTO CORRESPONDING FIELDS OF TABLE lt_vbfa
    FOR ALL ENTRIES IN lt_lif
    WHERE vbelv = lt_lif-vbeln
      AND posnv = lt_lif-posnr
      AND vbtyp_n = 'J'.            "Lieferung
  SORT lt_vbfa BY vbelv posnv.
  DELETE ADJACENT DUPLICATES FROM lt_vbfa COMPARING vbelv posnv.
  lt_vbfa_h[] = lt_vbfa[].

  "Restliche ohne bestimmen
  LOOP AT lt_lif ASSIGNING <ls_lif>.
    READ TABLE lt_vbfa_h ASSIGNING <ls_vbfa> WITH TABLE KEY vbelv = <ls_lif>-vbeln
                                                            posnv = <ls_lif>-posnr.
    IF sy-subrc = 0.
      <ls_lif>-vbeln  = <ls_vbfa>-vbeln.   "Lieferscheinnr
      <ls_lif>-posnr = <ls_vbfa>-posnn.    "Lieferposnr
    ELSE.
      CLEAR: <ls_lif>-vbeln,
             <ls_lif>-posnr.
    ENDIF.
  ENDLOOP.

  "Löschen die ohne Lieferung
  DELETE lt_lif WHERE vbeln = space.

  IF NOT lt_lif[] IS INITIAL.
    "Readtoship aus TDDAT
    SELECT vbeln
           tddat
           tduhr                                            "HB060222
           wadat_ist
           erdat
      FROM likp
      INTO TABLE lt_likp
      FOR ALL ENTRIES IN lt_lif
      WHERE vbeln = lt_lif-vbeln.

    "LIPS lesen wegen Lieferlager
    SELECT vbeln
           posnr
           werks
           lgort
           matnr
      FROM lips
      INTO TABLE lt_lips
      FOR ALL ENTRIES IN lt_lif
      WHERE vbeln = lt_lif-vbeln
        AND posnr = lt_lif-posnr.

    IF NOT lt_lips[] IS INITIAL.
      "Materialstamm lesen
      SELECT matnr
             mfrpn
        FROM mara
        INTO TABLE lt_mara
        FOR ALL ENTRIES IN lt_lips
        WHERE matnr = lt_lips-matnr.
    ENDIF.
  ENDIF.

  "--------------------------------------------------------------
  " Fakturabelege bestimmen; Vorgänger ist Lieferung  HB170115
  " falls jedoch Menge 1 ist die Pos noch nicht enthalten
  " dazuselektieren/abmischen...                      HB180116
  "--------------------------------------------------------------
  IF NOT lt_vbfa_h[] IS INITIAL.
    SELECT vbelv
           posnv
           vbeln                      "Kundenlieferung
           posnn
           erdat
           rfwrt
           waers
      FROM vbfa
      INTO TABLE lt_vbfa2
      FOR ALL ENTRIES IN lt_vbfa_h
      WHERE vbelv = lt_vbfa_h-vbeln   "Lieferschein
        AND posnv = lt_vbfa_h-posnn
        AND vbtyp_n = 'M'.            "Rechnung
    SORT lt_vbfa2 BY vbelv posnv.
    DELETE ADJACENT DUPLICATES FROM lt_vbfa2 COMPARING vbelv posnv.
    lt_vbfa_h2[] = lt_vbfa2[].
    CLEAR: lt_vbfa2[].
  ENDIF.

  "--------------------------------------------------------------
  " mit Serialnummern
  "--------------------------------------------------------------

  IF NOT lt_lif[] IS INITIAL.
    "SER01 lesen
    SELECT lief_nr
           posnr
           obknr
      FROM ser01
      INTO TABLE lt_ser01
      FOR ALL ENTRIES IN lt_lif
      WHERE lief_nr = lt_lif-vbeln
        AND posnr   = lt_lif-posnr.

    IF lt_ser01[] IS NOT INITIAL.
      lv_count = lines( lt_ser01 ).
      GET TIME.
      PERFORM prot_line USING lv_count   'Serialnummern gelesen                         :'.
      SORT lt_ser01 BY lief_nr posnr.
      DELETE ADJACENT DUPLICATES FROM lt_ser01 COMPARING lief_nr posnr.
      lt_ser01_h[] = lt_ser01[].


      "Serialnummern lesen
      SELECT obknr
             obzae
             equnr
             sernr
        FROM objk
        INTO TABLE lt_objk
        FOR ALL ENTRIES IN lt_ser01
        WHERE obknr = lt_ser01-obknr.

      IF NOT lt_objk[] IS INITIAL.
        "Equipmentinfos lesen
        SELECT equnr
               serge
          FROM equi
          INTO TABLE lt_equi
          FOR ALL ENTRIES IN lt_objk
          WHERE equnr = lt_objk-equnr.
      ENDIF.
    ENDIF.
  ENDIF.

  CLEAR lv_count.
  PERFORM prot_line USING lv_count   'Daten in Gesamttabelle übernehmen             :'.

  "Performance - Gesamttabelle umkopieren in sorted
  lt_orderview_s[] = gt_orderview[].
  CLEAR: gt_orderview[].
  lv_count = lines( lt_orderview_s ).
  PERFORM prot_line USING lv_count   'Kopiervorgang global -> lokal                 :'.


  "Daten in die Gesamttabelle eintragen
  LOOP AT lt_lif ASSIGNING <ls_lif>.

    CLEAR: ls_orderview,
           lv_count,                                        "HB240418
           lv_repdauer,
           lv_countrep0.


    "korrekte Serialnr für ersten 1804-433  HB240418
    LOOP AT lt_orderview_s ASSIGNING <ls_orderview> WHERE qmnum   = <ls_lif>-qmnum
                                                      AND fenum   = <ls_lif>-fenum.

      ADD 1 TO lv_count.  "unabhängiger Zähler

      "Repdauer nicht neu bestimmen; den letzen nehmen der da ist.
      IF <ls_orderview>-repdauer IS INITIAL.
        ADD 1 TO lv_countrep0.
      ELSE.
        lv_repdauer = <ls_orderview>-repdauer.
      ENDIF.


      IF lv_count = 1.
        "---------------------------------------------------------
        " Lieferscheinkopf und Posdaten; Gilt für gesamte Meldungsposition
        "   bei sehr wenigen Fällen mehrere LS pro Meldungspos
        "   kann aber nicht abgebildet werden
        "---------------------------------------------------------
        "Kopfdaten
        READ TABLE lt_likp ASSIGNING <ls_likp> WITH TABLE KEY vbeln = <ls_lif>-vbeln.
        IF sy-subrc = 0.
          <ls_orderview>-deliverdate = <ls_likp>-wadat_ist.  "Lieferdatum
          <ls_orderview>-likp_erdat  = <ls_likp>-erdat.

          CLEAR: <ls_orderview>-readytoship.
          IF <ls_likp>-tduhr IS NOT INITIAL.  "Bedingung für ReadyToShip: TDUHR nicht 00:00:00
            <ls_orderview>-readytoship = <ls_likp>-tddat.     "Transportdispositionsdatum
          ENDIF.
        ENDIF.


        "Lieferscheindruck
        READ TABLE gt_nast WITH KEY objky = <ls_lif>-vbeln.
        IF sy-subrc EQ 0.
          <ls_orderview>-delnoteprint = gt_nast-datvr.
        ENDIF.

        "Paketdienst + Trackingnr
        LOOP AT gt_vttp ASSIGNING <ls_vttp> WHERE vbeln = <ls_lif>-vbeln. "HB260920
          IF <ls_vttp>-xsitd = co_xsitd_transmed.  "'TRANSMED'.
            EXIT.
          ENDIF.
        ENDLOOP.

        IF sy-subrc = 0.
          READ TABLE gt_lfa1 WITH KEY lifnr = <ls_vttp>-tdlnr.
          IF sy-subrc EQ 0.
            <ls_orderview>-shipper = gt_lfa1-name1.
          ENDIF.
          <ls_orderview>-awb = <ls_vttp>-trackn.
        ENDIF.

        "-----------------------------------------------
        " Lieferschein-Positionsdaten
        "-----------------------------------------------

        "Fakturadaten                    HB170115
        READ TABLE lt_vbfa_h2 ASSIGNING <ls_vbfa> WITH TABLE KEY vbelv = <ls_lif>-vbeln
                                                                 posnv = <ls_lif>-posnr.
        IF sy-subrc = 0.
          <ls_orderview>-rechdatum    = <ls_vbfa>-erdat.
          <ls_orderview>-fakturapreis = <ls_vbfa>-rfwrt.
          <ls_orderview>-waers        = <ls_vbfa>-waers.
          <ls_orderview>-rechnummer   = <ls_vbfa>-vbeln.
        ENDIF.

        READ TABLE lt_lips ASSIGNING <ls_lips> WITH TABLE KEY vbeln = <ls_lif>-vbeln
                                                              posnr = <ls_lif>-posnr.
        IF sy-subrc = 0.
          <ls_orderview>-lieferwerk    = <ls_lips>-werks.
          <ls_orderview>-lieferlager   = <ls_lips>-lgort.
          <ls_orderview>-matnr_out     = <ls_lips>-matnr.

          READ TABLE lt_mara ASSIGNING <ls_mara> WITH TABLE KEY matnr = <ls_lips>-matnr.
          IF sy-subrc = 0.
            <ls_orderview>-partnumberout = <ls_mara>-mfrpn.
          ENDIF.
        ENDIF.

        UNASSIGN: <ls_ser01>.
        "gibt es Serialnummern?  einmalig pro Lieferschein-Pos ermitteln
        READ TABLE lt_ser01_h WITH TABLE KEY lief_nr = <ls_lif>-vbeln
                                             posnr   = <ls_lif>-posnr
                                 ASSIGNING <ls_ser01>.

        "Werte Counter 000001 zwischenspeichern als Kopiervorlage
        ls_orderview = <ls_orderview>.

      ELSE.  "lv_count > 1


        "aus COUNTER 1 übertragen

        "Closed übertragen aus erster Pos   HB240418
        <ls_orderview>-orderstatecompl   = ls_orderview-orderstatecompl.
        <ls_orderview>-dateclosed        = ls_orderview-dateclosed.
        <ls_orderview>-archivflag        = ls_orderview-archivflag.
        <ls_orderview>-akz               = ls_orderview-akz.

        <ls_orderview>-auftragsendesoll  = ls_orderview-auftragsendesoll.
        <ls_orderview>-initcommitdate    = ls_orderview-initcommitdate.

        <ls_orderview>-rechdatum         = ls_orderview-rechdatum. "HB170115
        <ls_orderview>-fakturapreis      = ls_orderview-fakturapreis.
        <ls_orderview>-waers             = ls_orderview-waers.
        <ls_orderview>-rechnummer        = ls_orderview-rechnummer.

        "weitere Felder belegen HB040222
        <ls_orderview>-delnotenumber     = ls_orderview-delnotenumber.
        <ls_orderview>-delnoteposnr      = ls_orderview-delnoteposnr.
        <ls_orderview>-partnumberout     = ls_orderview-partnumberout.
        <ls_orderview>-deliverdate       = ls_orderview-deliverdate.
        <ls_orderview>-delnoteprint      = ls_orderview-delnoteprint.
        <ls_orderview>-readytoship       = ls_orderview-readytoship.
        <ls_orderview>-lieferlager       = ls_orderview-lieferlager.
        <ls_orderview>-lieferwerk        = ls_orderview-lieferwerk.
        <ls_orderview>-likp_erdat        = ls_orderview-likp_erdat.

        <ls_orderview>-matnr_out         = ls_orderview-matnr_out.
        <ls_orderview>-shipper           = ls_orderview-shipper.
        <ls_orderview>-trackdate         = ls_orderview-trackdate. "HB171018
        <ls_orderview>-tracktime         = ls_orderview-tracktime. "HB171018
        <ls_orderview>-awb               = ls_orderview-awb.

        <ls_orderview>-tknum             = ls_orderview-tknum.      "HB040222 Transportnummer
        <ls_orderview>-wbsta             = ls_orderview-wbsta.      "HB040222 Warenbewegungsstatus
        <ls_orderview>-fkstk             = ls_orderview-fkstk.
        <ls_orderview>-exti1             = ls_orderview-exti1.
        <ls_orderview>-qmfe_usr08        = ls_orderview-qmfe_usr08.


        "Fakturadaten                    HB170115
        <ls_orderview>-rechdatum         = ls_orderview-rechdatum.
        <ls_orderview>-fakturapreis      = ls_orderview-fakturapreis.
        <ls_orderview>-waers             = ls_orderview-waers.
        <ls_orderview>-rechnummer        = ls_orderview-rechnummer.

      ENDIF.

      "--------------------------------------------------------
      " Individueller Werte pro COUNTER  Serialnummern
      "--------------------------------------------------------
      IF <ls_ser01> IS ASSIGNED.

        UNASSIGN: <ls_objk>, <ls_equi>.
        lv_obzae = <ls_orderview>-counter.
        READ TABLE lt_objk WITH TABLE KEY obknr = <ls_ser01>-obknr
                                          obzae = lv_obzae
                                 ASSIGNING <ls_objk>.

        IF <ls_objk> IS ASSIGNED.
          <ls_orderview>-sernrlif      = <ls_objk>-sernr.

          READ TABLE lt_equi WITH TABLE KEY equnr = <ls_objk>-equnr
                                   ASSIGNING <ls_equi>.
          IF <ls_equi> IS ASSIGNED.
            <ls_orderview>-serialdeliver   = <ls_equi>-serge.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.  "at gt_orderview pro Meldpos für alle COUNTER

    "Falls Reparaturdauer fehlt, jetzt bei allen nachtragen
    IF NOT lv_countrep0 IS INITIAL.
      IF NOT lv_repdauer IS INITIAL.
        LOOP AT lt_orderview_s ASSIGNING <ls_orderview> WHERE qmnum     = <ls_lif>-qmnum
                                                          AND fenum     = <ls_lif>-fenum
                                                          AND repdauer <> lv_repdauer.

          <ls_orderview>-repdauer = lv_repdauer.
        ENDLOOP.  "at gt_orderview pro Meldpos für alle COUNTER
      ENDIF.
    ENDIF.

  ENDLOOP. "at lt_lif ASSIGNING <ls_lif>


  CLEAR lv_count.
  PERFORM prot_line USING lv_count   'Ende Vereinzelung                             :'.

  "wieder in Globale Tabelle zurück kopieren
  gt_orderview[] = lt_orderview_s[].
  PERFORM prot_line USING lv_count   'Kopiervorgang lokal -> global                 :'.

ENDFORM.                    " VEREINZELUNG
*&---------------------------------------------------------------------*
*&      Form  BUILD_Z1_ZX_ADD
*&---------------------------------------------------------------------*
*       Globale Hilfstabellen füllen für Verknüpfung Z1 und ZX
*       Einträge erstellen, falls relevante Werte da
*       15.08.19: alle ZX dazulesen
*----------------------------------------------------------------------*
FORM build_z1_zx_add.

  TYPES: BEGIN OF tys_ord_add,
           qmnum     TYPE qmnum,
           fenum     TYPE fenum,
           counter   TYPE cim_count,
           remarksrs TYPE /cellag/remarksrs,
           remarksvm TYPE /cellag/remarksvm,
         END OF tys_ord_add,
         tyt_ord_add   TYPE STANDARD TABLE OF tys_ord_add,
         tyt_ord_add_h TYPE HASHED TABLE OF tys_ord_add WITH UNIQUE KEY qmnum fenum.


  DATA:
    lt_qmfe        TYPE tyt_qmfe_h,
    lt_ord_add     TYPE tyt_ord_add,
    lt_ord_add_new TYPE tyt_ord_add,
    lt_ord_add_h   TYPE tyt_ord_add_h,

    lv_qwrnum      TYPE qwrnum.

  FIELD-SYMBOLS:
    <ls_zx_add>      TYPE tys_zx_add,
    <ls_add>         TYPE /cellag/ord_add,
    <ls_orderview>   LIKE LINE OF gt_orderview,
    <ls_ord_add>     TYPE tys_ord_add,
    <ls_ord_add_new> TYPE tys_ord_add,
    <ls_qwrnum>      TYPE tys_qwrnum.

  "alle Einträge mit QWRNUM lesen   HB150819
  CHECK NOT gt_qwrnum[] IS INITIAL.
  SELECT qmnum
         fenum
         counter
         dockdate
         labelprint
         deliverdate
    FROM /cellag/ordview
    INTO CORRESPONDING FIELDS OF TABLE gt_zx_add
    FOR ALL ENTRIES IN gt_qwrnum
    WHERE qmnum = gt_qwrnum-qmnum.

  "QWRNUM ergänzen
  LOOP AT gt_zx_add ASSIGNING <ls_zx_add>.
    READ TABLE gt_qwrnum WITH TABLE KEY qmnum = <ls_zx_add>-qmnum ASSIGNING <ls_qwrnum>.
    IF sy-subrc = 0.
      <ls_zx_add>-qwrnum = <ls_qwrnum>-qwrnum.
    ENDIF.
  ENDLOOP.


  "Selektion der Bemerkungen gesammelt       HB300714
  CHECK NOT gt_zx_add[] IS INITIAL.

  SELECT qmnum
         fenum
         counter
         remarksrs
         remarksvm
    FROM /cellag/ord_add
    INTO TABLE lt_ord_add
    FOR ALL ENTRIES IN gt_zx_add
    WHERE qmnum = gt_zx_add-qmnum
      AND fenum = gt_zx_add-fenum.

  DELETE lt_ord_add WHERE remarksrs = space AND remarksvm = space.

  SORT lt_ord_add BY qmnum ASCENDING
                     fenum ASCENDING
                     counter DESCENDING.  "höchster gewinnt
  DELETE ADJACENT DUPLICATES FROM lt_ord_add COMPARING qmnum fenum.

  lt_ord_add_h[] = lt_ord_add[].

  "aktualisieren durch neuere Einträge aus gt_orderview_add; neue Einträge hinzufügen
  LOOP AT gt_orderview_add ASSIGNING <ls_add> WHERE remarksrs <> space OR
                                                    remarksvm <> space.
    READ TABLE lt_ord_add_h ASSIGNING <ls_ord_add> WITH TABLE KEY qmnum = <ls_add>-qmnum
                                                                  fenum = <ls_add>-fenum.
    IF sy-subrc = 0.
      <ls_ord_add>-remarksrs = <ls_add>-remarksrs.
      <ls_ord_add>-remarksvm = <ls_add>-remarksvm.
    ELSE.
      INSERT INITIAL LINE INTO TABLE lt_ord_add_new ASSIGNING <ls_ord_add_new>.
      <ls_ord_add_new>-qmnum     = <ls_add>-qmnum.
      <ls_ord_add_new>-fenum     = <ls_add>-fenum.
      <ls_ord_add_new>-counter   = <ls_add>-counter.
      <ls_ord_add_new>-remarksrs = <ls_add>-remarksrs.
      <ls_ord_add_new>-remarksvm = <ls_add>-remarksvm.
    ENDIF.
  ENDLOOP.

  IF NOT lt_ord_add_new[] IS INITIAL.
    lt_ord_add[] = lt_ord_add_h[].
    APPEND LINES OF lt_ord_add_new TO lt_ord_add.
    SORT lt_ord_add BY qmnum ASCENDING
                       fenum ASCENDING
                       counter DESCENDING.  "höchster gewinnt
    DELETE ADJACENT DUPLICATES FROM lt_ord_add COMPARING qmnum fenum.

    lt_ord_add_h[] = lt_ord_add[].
  ENDIF.

  "abmischen
  LOOP AT gt_zx_add ASSIGNING <ls_zx_add>.
    READ TABLE lt_ord_add_h ASSIGNING <ls_ord_add> WITH TABLE KEY qmnum = <ls_zx_add>-qmnum
                                                                  fenum = <ls_zx_add>-fenum.
    IF sy-subrc = 0.
      <ls_zx_add>-remarksrs = <ls_ord_add>-remarksrs.
      <ls_zx_add>-remarksvm = <ls_ord_add>-remarksvm.
    ENDIF.
  ENDLOOP.

  CLEAR: gt_qwrnum[].

ENDFORM.                    " BUILD_Z1_ZX_ADD
*&---------------------------------------------------------------------*
