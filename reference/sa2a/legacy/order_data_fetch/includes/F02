*----------------------------------------------------------------------*
FORM prot_line  USING    p_count TYPE i
                         p_text60 TYPE text60.

  DATA: lv_string  TYPE string,
        lv_uzeit_t TYPE text10,
        lv_count_t TYPE text10.

  IF p_text60 IS INITIAL.
    "Leerzeile
    lv_string = '------------------------------------------------------------------'.
    APPEND lv_string TO gt_string.
  ELSE.
    GET TIME.
    WRITE sy-uzeit TO lv_uzeit_t.
    IF NOT p_count IS INITIAL.
      WRITE p_count TO lv_count_t.
    ENDIF.
    CONCATENATE lv_uzeit_t p_text60 lv_count_t INTO lv_string SEPARATED BY space.
    APPEND lv_string TO gt_string.
  ENDIF.
ENDFORM.                    " PROT_LINE
*&---------------------------------------------------------------------*
*&      Form  GET_MATKOST_AUFM
*&---------------------------------------------------------------------*
*       Materialkosten aus AUFM ermitteln BWart 261/262
*       Falls weniger als 100 Meldung AUFM gezielt lesen, sonst komplett
*       Workshop_rate ermitteln aus PMCO, VORGA = RKL
*----------------------------------------------------------------------*
*----------------------------------------------------------------------*
FORM get_matkost_aufm .

  TYPES:
    BEGIN OF tys_aufm,
      mblnr TYPE mblnr,   "sehr seltsam - nur hinzugefügt weil zu wenig Daten selektiert...
      aufnr TYPE aufnr,
      dmbtr TYPE dmbtr,
      waers TYPE waers,
      shkzg TYPE shkzg,  "Soll-/Haben-Kennzeichen H/S
    END OF tys_aufm,
    tyt_aufm TYPE SORTED TABLE OF tys_aufm WITH NON-UNIQUE KEY aufnr,

    BEGIN OF tys_pmco,
      objnr TYPE bp_objekt,
      wrt00 TYPE bp_wpl,
      wrt01 TYPE bp_wpl,
      wrt02 TYPE bp_wpl,
      wrt03 TYPE bp_wpl,
      wrt04 TYPE bp_wpl,
      wrt05 TYPE bp_wpl,
      wrt06 TYPE bp_wpl,
      wrt07 TYPE bp_wpl,
      wrt08 TYPE bp_wpl,
      wrt09 TYPE bp_wpl,
      wrt10 TYPE bp_wpl,
      wrt11 TYPE bp_wpl,
      wrt12 TYPE bp_wpl,
      wrt13 TYPE bp_wpl,
      wrt14 TYPE bp_wpl,
      wrt15 TYPE bp_wpl,
      wrt16 TYPE bp_wpl,
    END OF tys_pmco,
    tyt_pmco TYPE SORTED TABLE OF tys_pmco WITH NON-UNIQUE KEY objnr,

    BEGIN OF tys_objnr,
      aufnr TYPE aufnr,
      objnr TYPE j_objnr,
    END OF tys_objnr,
    tyt_objnr   TYPE STANDARD TABLE OF tys_objnr,
    tyt_objnr_h TYPE HASHED TABLE OF tys_objnr WITH UNIQUE KEY aufnr.

  DATA:
    lt_aufm    TYPE tyt_aufm,
    lt_objnr   TYPE tyt_objnr,
    lt_objnr_h TYPE tyt_objnr_h,
    lt_pmco    TYPE tyt_pmco,

    lv_dmbtr   TYPE dmbtr,
    lv_waers   TYPE waers,
    lv_wrt     TYPE bp_wpl,

    lv_index   TYPE i,
    lv_count   TYPE i,
    lv_count2  TYPE i.

  FIELD-SYMBOLS:
    <ls_orderview> LIKE LINE OF gt_orderview,
    <ls_aufm>      TYPE tys_aufm,
    <ls_objnr>     TYPE tys_objnr,
    <lv_wrt>       TYPE bp_wpl,
    <ls_pmco>      TYPE tys_pmco.

  PERFORM show_progress USING TEXT-l17.

  lt_objnr[] = gt_aufnr_objnr[].
  SORT lt_objnr BY aufnr.
  DELETE ADJACENT DUPLICATES FROM lt_objnr COMPARING aufnr.
  lt_objnr_h[] = lt_objnr[].
  CLEAR: lt_objnr[].

  "----------------------------------------------------
  " Selektion der MSEG
  "----------------------------------------------------

  "alle mit 261/262 lesen; zB. 2016	261	241.340
  lv_count = lines( gt_orderview ).
  CHECK lv_count > 0.
  PERFORM prot_line USING lv_count 'Kosten Material/WSHop-Rate. Anzahl Ordview    :'.

  IF lv_count < 1000.
    SELECT
      mblnr
      aufnr
      dmbtr
      waers
      shkzg
    FROM aufm
    INTO TABLE lt_aufm
      FOR ALL ENTRIES IN gt_orderview
      WHERE aufnr = gt_orderview-fanumber AND
            ( bwart = '261' OR
              bwart = '262' OR
              bwart = '291' OR   "Buchungen aus PSP-Bestand auf Auftrag
              bwart = '292' ).
    "Workshop Rate
    IF NOT gt_aufnr_objnr[] IS INITIAL.
      SELECT objnr
             wrt00
             wrt01
             wrt02
             wrt03
             wrt04
             wrt05
             wrt06
             wrt07
             wrt08
             wrt09
             wrt10
             wrt11
             wrt12
             wrt13
             wrt14
             wrt15
             wrt16
        FROM pmco
        INTO TABLE lt_pmco
        FOR ALL ENTRIES IN gt_aufnr_objnr
        WHERE objnr = gt_aufnr_objnr-objnr
          AND vorga = 'RKL'.   "CO Ist Leistungsverrechnung
    ENDIF.

  ELSE.
    "alle lesen
    SELECT
      mblnr
      aufnr
      dmbtr
      waers
      shkzg
    FROM aufm
    INTO TABLE lt_aufm
      WHERE bwart = '261' OR
            bwart = '262' OR
            bwart = '291' OR   "Buchungen aus PSP-Bestand auf Auftrag
            bwart = '292'.

    "Workshop Rate
    SELECT objnr
           wrt00
           wrt01
           wrt02
           wrt03
           wrt04
           wrt05
           wrt06
           wrt07
           wrt08
           wrt09
           wrt10
           wrt11
           wrt12
           wrt13
           wrt14
           wrt15
           wrt16
      FROM pmco
      INTO TABLE lt_pmco
      WHERE vorga = 'RKL'.   "CO Ist Leistungsverrechnung

  ENDIF.

  lv_count  = lines( lt_aufm ).
  lv_count2 = lines( lt_pmco ).


  LOOP AT gt_orderview ASSIGNING <ls_orderview> WHERE fanumber > space.
    CLEAR:  lv_dmbtr, lv_waers.
    LOOP AT lt_aufm ASSIGNING <ls_aufm> WHERE aufnr = <ls_orderview>-fanumber.
      IF  <ls_aufm>-shkzg = 'H'.
        ADD <ls_aufm>-dmbtr TO lv_dmbtr.
      ELSE.
        SUBTRACT <ls_aufm>-dmbtr FROM lv_dmbtr.
      ENDIF.
      lv_waers = <ls_aufm>-waers.
    ENDLOOP.
    <ls_orderview>-matpreis = lv_dmbtr.
    <ls_orderview>-mswaers = lv_waers.
    <ls_orderview>-mwaers = lv_waers.

    "Workshop rate
    READ TABLE lt_objnr_h ASSIGNING <ls_objnr> WITH TABLE KEY aufnr = <ls_orderview>-fanumber.
    IF sy-subrc = 0.
      CLEAR: lv_wrt.
      LOOP AT lt_pmco ASSIGNING <ls_pmco> WHERE objnr = <ls_objnr>-objnr.
        lv_index = 1.
        DO 17 TIMES.  "WRT00 bis WRT16 summieren
          ADD 1 TO lv_index.
          ASSIGN COMPONENT lv_index OF STRUCTURE <ls_pmco> TO <lv_wrt>.
          lv_wrt = lv_wrt + <lv_wrt>.
        ENDDO.
      ENDLOOP.
      <ls_orderview>-workshop_rate =  lv_wrt.
    ENDIF.

  ENDLOOP.    "AT gt_orderview

  PERFORM prot_line USING lv_count  'Materialkosten aus AUFM   . Anzahl AUFM       :'.
  PERFORM prot_line USING lv_count2 'Workshoprate aus PMCO   . Anzahl PMCO         :'.


ENDFORM.                    " GET_MATKOST_AUFM
