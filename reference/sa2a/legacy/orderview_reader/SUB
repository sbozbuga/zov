FORM build_fieldcat .

  DATA: lwa_fieldcat TYPE slis_fieldcat_alv.

  CALL FUNCTION 'REUSE_ALV_FIELDCATALOG_MERGE'
    EXPORTING
      i_program_name         = gv_repid
      i_structure_name       = '/CELLAG/ORD_FULL'
    CHANGING
      ct_fieldcat            = gt_fieldcat[]
    EXCEPTIONS
      inconsistent_interface = 1
      program_error          = 2
      OTHERS                 = 3.

  CLEAR lwa_fieldcat.
  LOOP AT gt_fieldcat INTO lwa_fieldcat.
    CASE lwa_fieldcat-fieldname.
      WHEN 'QMNUM' OR 'FENUM' OR 'COUNTER'.
        lwa_fieldcat-key = c_true.
        MODIFY gt_fieldcat FROM lwa_fieldcat INDEX sy-tabix.
    ENDCASE.
  ENDLOOP.


