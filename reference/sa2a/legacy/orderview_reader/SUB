  PERFORM build_fieldcat.
  PERFORM get_layout.

  CLEAR lv_lines.
  DESCRIBE TABLE gt_ord_full LINES lv_lines.
  WRITE lv_lines TO gv_title LEFT-JUSTIFIED.
  CONCATENATE TEXT-t06 gv_title INTO gv_title
  SEPARATED BY space.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      i_callback_program       = gv_repid
      i_callback_pf_status_set = 'ALV_SET_PF_STATUS'
      i_callback_user_command  = 'ALV_USER_COMMAND'
      i_grid_title             = gv_title
      is_layout                = gwa_layout
      it_fieldcat              = gt_fieldcat[]
      i_save                   = 'A'
      is_variant               = gwa_variant
    TABLES
      t_outtab                 = gt_ord_full[]
    EXCEPTIONS
      program_error            = 1
      OTHERS                   = 2.


  CLEAR lwa_fieldcat.
  LOOP AT gt_fieldcat INTO lwa_fieldcat.
    CASE lwa_fieldcat-fieldname.
      WHEN 'SERNRREC' OR 'SERNRLIF'.
        lwa_fieldcat-no_out = c_true.
        MODIFY gt_fieldcat FROM lwa_fieldcat.
    ENDCASE.
  ENDLOOP.
