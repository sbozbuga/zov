FORM fcode_detail_alv USING if_selfield TYPE slis_selfield.
  DATA: lt_fieldcat_aux     TYPE slis_t_fieldcat_alv,
        lwa_fieldcat_aux    TYPE slis_fieldcat_alv,
        lt_fieldcat_detail  TYPE slis_t_fieldcat_alv,
        lwa_fieldcat_detail TYPE slis_fieldcat_alv,
        lwa_layout_detail   TYPE slis_layout_alv.

  DATA: lt_dfies LIKE dfies OCCURS 0 WITH HEADER LINE.

  DATA: lv_index    TYPE i,
        lv_len      TYPE i,
        lv_selected TYPE i.

  FIELD-SYMBOLS: <field>     TYPE any,
                 <wa_detail> LIKE gt_detail.


  IF NOT if_selfield-endsum IS INITIAL OR
     NOT if_selfield-sumindex = 0.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e01.
    EXIT.
  ENDIF.

  CLEAR lv_selected.
  CLEAR gt_ord_full.
  LOOP AT gt_ord_full WHERE selected EQ c_true.
    lv_selected = lv_selected + 1.
    IF lv_selected GE 2.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF lv_selected GT 1.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e02.
    EXIT.
  ENDIF.

  CLEAR gt_ord_full.
  READ TABLE gt_ord_full INDEX if_selfield-tabindex.
  IF sy-subrc NE 0.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e01.
    EXIT.
  ENDIF.

  CLEAR lt_fieldcat_aux. REFRESH lt_fieldcat_aux.
  CALL FUNCTION 'REUSE_ALV_GRID_LAYOUT_INFO_GET'
    IMPORTING
      et_fieldcat   = lt_fieldcat_aux
    EXCEPTIONS
      no_infos      = 1
      program_error = 2
      OTHERS        = 3.

  CLEAR gt_detail. REFRESH gt_detail.
  CLEAR lwa_fieldcat_aux.
  LOOP AT lt_fieldcat_aux INTO lwa_fieldcat_aux.
    MOVE-CORRESPONDING lwa_fieldcat_aux TO gt_detail.
    gt_detail-scrtext_l = lwa_fieldcat_aux-seltext_l.
    APPEND gt_detail.
    CLEAR gt_detail.
  ENDLOOP.

  CLEAR lt_dfies. REFRESH lt_dfies.
  CALL FUNCTION 'DDIF_NAMETAB_GET'
    EXPORTING
      tabname   = '/CELLAG/ORD_FULL'
    TABLES
      dfies_tab = lt_dfies
    EXCEPTIONS
      not_found = 1
      OTHERS    = 2.

  CLEAR: lv_index,
         lv_len.

  DESCRIBE TABLE lt_fieldcat_aux LINES lv_len.

  lv_index = 1.

  DO lv_len TIMES.
    ADD 1 TO lv_index.
    ASSIGN COMPONENT lv_index OF STRUCTURE gt_ord_full TO <field>.
    CLEAR lt_dfies.
    READ TABLE lt_dfies INDEX sy-index.
    IF sy-subrc EQ 0.
      CLEAR gt_detail.
      READ TABLE gt_detail WITH KEY fieldname = lt_dfies-fieldname
      ASSIGNING <wa_detail>.
      WRITE <field> TO <wa_detail>-value LEFT-JUSTIFIED.
    ENDIF.
  ENDDO.

  DELETE gt_detail WHERE no_out = c_true.
  SORT gt_detail BY col_pos.

  CLEAR lt_fieldcat_detail. REFRESH lt_fieldcat_detail.
  CALL FUNCTION 'REUSE_ALV_FIELDCATALOG_MERGE'
    EXPORTING
      i_program_name         = gv_repid
      i_structure_name       = '/CELLAG/DETAIL'
    CHANGING
      ct_fieldcat            = lt_fieldcat_detail[]
    EXCEPTIONS
      inconsistent_interface = 1
      program_error          = 2
      OTHERS                 = 3.
  IF sy-subrc <> 0.
  ENDIF.

  CLEAR lwa_fieldcat_detail.
  LOOP AT lt_fieldcat_detail INTO lwa_fieldcat_detail.
    CASE lwa_fieldcat_detail-fieldname.
      WHEN 'FIELDNAME' OR 'NO_OUT' OR 'COL_POS'.
        lwa_fieldcat_detail-no_out = c_true.
        MODIFY lt_fieldcat_detail FROM lwa_fieldcat_detail INDEX sy-tabix.
    ENDCASE.
  ENDLOOP.

  CLEAR lwa_layout_detail.
  lwa_layout_detail-colwidth_optimize = c_true.
  lwa_layout_detail-zebra = c_true.
  lwa_layout_detail-window_titlebar = TEXT-t00.

  CALL FUNCTION 'REUSE_ALV_GRID_DISPLAY'
    EXPORTING
      i_callback_program = gv_repid
      is_layout          = lwa_layout_detail
      it_fieldcat        = lt_fieldcat_detail[]
      i_default          = ' '
      i_save             = 'A'
    TABLES
      t_outtab           = gt_detail[]
    EXCEPTIONS
      program_error      = 1
      OTHERS             = 2.

ENDFORM.                    " FCODE_DETAIL_ALV
