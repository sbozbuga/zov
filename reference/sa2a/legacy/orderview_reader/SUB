*&---------------------------------------------------------------------*
*&      Form  GET_QMNUMP_DATA
*       1601-632 Sortierung beibehalten bei Angabe QMELPOS
*       ausgelagert
*&---------------------------------------------------------------------*
FORM get_qmnump_data .

  DATA: BEGIN OF lt_lifnr OCCURS 0,
          lifnr LIKE lfa1-lifnr,
        END OF lt_lifnr.
  DATA: lt_lifnr_par LIKE lt_lifnr OCCURS 0 WITH HEADER LINE.

  DATA: lv_len1  TYPE i,
        lv_pos   TYPE i,
        lv_qmnum LIKE qmfe-qmnum,
        lv_fenum LIKE qmfe-fenum,
        lv_cnt   TYPE felfd.

  RANGES: lr_qmnum FOR /cellag/ordview-qmnum,
          lr_qmnum_par FOR /cellag/ordview-qmnum,
          lr_qmnump FOR gv_qmnump.

  CLEAR lr_qmnump. REFRESH lr_qmnump.
  CLEAR lr_qmnum. REFRESH lr_qmnum.
  LOOP AT s_qmnump.
    lv_len1 = strlen( s_qmnump-low ).
    lv_pos = lv_len1 - 4.
    CHECK lv_pos GT 0.
    lv_qmnum = s_qmnump-low(lv_pos).
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = lv_qmnum
      IMPORTING
        output = lv_qmnum.
    lv_fenum = s_qmnump-low+lv_pos(4).
    lr_qmnump-sign = s_qmnump-sign.
    lr_qmnump-option = s_qmnump-option.
    CONCATENATE lv_qmnum lv_fenum INTO lr_qmnump-low.
    APPEND lr_qmnump.
    CLEAR lr_qmnump.
    lr_qmnum-sign = s_qmnump-sign.
    lr_qmnum-option = s_qmnump-option.
    lr_qmnum-low = lv_qmnum.
    APPEND lr_qmnum. CLEAR lr_qmnum.
  ENDLOOP.

  CLEAR gt_ordview. REFRESH gt_ordview.
  CLEAR gt_ordview_qmnump. REFRESH gt_ordview_qmnump.
  CLEAR gt_ord_add. REFRESH gt_ord_add.
  CLEAR gt_ord_full. REFRESH gt_ord_full.

  IF NOT lr_qmnum[] IS INITIAL.
    SELECT SINGLE * FROM /cellag/ordview
    WHERE qmnum IN lr_qmnum.
    IF sy-subrc NE 0.
      IF gv_auth_arch = abap_true.                          "HB071021
        SELECT SINGLE * FROM zordview_archiv
        WHERE qmnum IN lr_qmnum.
        IF sy-subrc NE 0.
          EXIT.
        ENDIF.
      ENDIF.
    ENDIF.

    DO.
      build_range lr_qmnum lr_qmnum_par.
      SELECT * FROM /cellag/ordview APPENDING TABLE gt_ordview
      WHERE qmnum IN lr_qmnum_par.
      IF gv_auth_arch = abap_true.                          "HB071021
        SELECT * FROM zordview_archiv APPENDING TABLE gt_ordview
        WHERE qmnum IN lr_qmnum_par.
      ENDIF.
    ENDDO.
  ENDIF.

  LOOP AT gt_ordview.
    MOVE-CORRESPONDING gt_ordview TO gt_ordview_qmnump.
    CONCATENATE gt_ordview-qmnum gt_ordview-fenum INTO gt_ordview_qmnump-qmnump.
    APPEND gt_ordview_qmnump. CLEAR gt_ordview_qmnump.
  ENDLOOP.

  SORT gt_ordview_qmnump BY qmnum fenum counter.

  DELETE gt_ordview_qmnump WHERE NOT qmnump IN lr_qmnump.

  CLEAR lt_lifnr. REFRESH lt_lifnr.
  CLEAR lr_qmnum. REFRESH lr_qmnum.
  lr_qmnum-sign = 'I'.
  lr_qmnum-option = 'EQ'.

  CLEAR gt_ordview_qmnump.
  LOOP AT gt_ordview_qmnump.
    lr_qmnum-low = gt_ordview_qmnump-qmnum.
    COLLECT lr_qmnum.
    IF NOT gt_ordview_qmnump-hersteller IS INITIAL.
      lt_lifnr-lifnr = gt_ordview_qmnump-hersteller.
      COLLECT lt_lifnr.
      CLEAR lt_lifnr.
    ENDIF.
  ENDLOOP.
  CLEAR lr_qmnum.

  SORT lr_qmnum.

  CLEAR lr_qmnum_par. REFRESH lr_qmnum_par.
  IF NOT lr_qmnum[] IS INITIAL.
    DO.
      build_table lr_qmnum lr_qmnum_par.
      SELECT * FROM /cellag/ord_add APPENDING TABLE gt_ord_add
      FOR ALL ENTRIES IN lr_qmnum_par
      WHERE qmnum = lr_qmnum_par-low.
    ENDDO.
  ENDIF.

  SORT gt_ord_add BY qmnum fenum counter.

  SORT lt_lifnr.
  CLEAR gt_lfa1. REFRESH gt_lfa1.
  IF NOT lt_lifnr[] IS INITIAL.
    DO.
      build_table lt_lifnr lt_lifnr_par.
      SELECT lifnr name1 FROM lfa1
      APPENDING TABLE gt_lfa1
      FOR ALL ENTRIES IN lt_lifnr_par
      WHERE lifnr = lt_lifnr_par-lifnr.
    ENDDO.
  ENDIF.

  SORT gt_lfa1 BY lifnr.

  CLEAR gt_ordview_qmnump.
  LOOP AT gt_ordview_qmnump.
    MOVE-CORRESPONDING gt_ordview_qmnump TO gt_ord_full.
    CLEAR gt_ord_add.
    READ TABLE gt_ord_add WITH KEY qmnum = gt_ordview_qmnump-qmnum
                                   fenum = gt_ordview_qmnump-fenum
                                   counter = gt_ordview_qmnump-counter
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      MOVE-CORRESPONDING gt_ord_add TO gt_ord_full.
    ENDIF.

    CLEAR gt_lfa1.
    READ TABLE gt_lfa1 WITH KEY lifnr = gt_ordview-hersteller
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      gt_ord_full-herstellername = gt_lfa1-name1.
    ENDIF.

    "Gesamtnr mit Counter: zuerst in NUMC konvertieren
    lv_cnt = gt_ord_full-counter.
    CONCATENATE gt_ord_full-meldpos lv_cnt INTO gt_ord_full-qmnumposcnt. "HB230116

    APPEND gt_ord_full.
    CLEAR gt_ord_full.
  ENDLOOP.
ENDFORM.                    " GET_QMNUMP_DATA
