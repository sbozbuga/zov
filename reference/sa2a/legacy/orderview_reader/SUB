FORM fcode_pick_alv USING if_selfield TYPE slis_selfield.
  IF NOT if_selfield-endsum IS INITIAL OR
     NOT if_selfield-sumindex = 0.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e01.
  ENDIF.

  CLEAR gt_ord_full.
  READ TABLE gt_ord_full INDEX if_selfield-tabindex.
  CHECK sy-subrc = 0.

  CASE if_selfield-fieldname.

* Meldungsnummer
    WHEN 'QMNUM'.
      CHECK NOT gt_ord_full-qmnum IS INITIAL.
      SET PARAMETER ID 'IQM' FIELD gt_ord_full-qmnum.
      CALL TRANSACTION 'IW53' AND SKIP FIRST SCREEN.
* Materialnr
    WHEN 'CTDISAPMATNUMMER'.
      CHECK NOT gt_ord_full-ctdisapmatnummer IS INITIAL.
      SET PARAMETER ID 'MAT' FIELD gt_ord_full-ctdisapmatnummer.
      CALL TRANSACTION 'MM03' AND SKIP FIRST SCREEN.
* Fertigungsauftrag
    WHEN 'FANUMBER'.
      CHECK NOT gt_ord_full-fanumber IS INITIAL.
      SET PARAMETER ID 'ANR' FIELD gt_ord_full-fanumber.
      CALL TRANSACTION 'IW33' AND SKIP FIRST SCREEN.
* Lieferung
    WHEN 'DELNOTENUMBER'.
      CHECK NOT gt_ord_full-delnotenumber IS INITIAL.
      SET PARAMETER ID 'VL' FIELD gt_ord_full-delnotenumber.
      CALL TRANSACTION 'VL03N' AND SKIP FIRST SCREEN.
* Bestellung
    WHEN 'PURCHASENUMBER'.
      CHECK NOT gt_ord_full-purchasenumber IS INITIAL.
      SET PARAMETER ID 'BES' FIELD gt_ord_full-purchasenumber.
      CALL TRANSACTION 'ME23N' AND SKIP FIRST SCREEN.
* Kundenauftrag
    WHEN 'VBELN'.
      CHECK NOT gt_ord_full-vbeln IS INITIAL.
      SET PARAMETER ID 'AUN' FIELD gt_ord_full-vbeln.
      CALL TRANSACTION 'VA03' AND SKIP FIRST SCREEN.
* Retoure
    WHEN 'RETOURE'.
      CHECK NOT gt_ord_full-retoure IS INITIAL.
      SET PARAMETER ID 'VL' FIELD gt_ord_full-retoure.
      CALL TRANSACTION 'VL03N' AND SKIP FIRST SCREEN.
* Rechnung
    WHEN 'RECHNUMMER'.
      CHECK NOT gt_ord_full-rechnummer IS INITIAL.
      SET PARAMETER ID 'VF' FIELD gt_ord_full-rechnummer.
      CALL TRANSACTION 'VF03' AND SKIP FIRST SCREEN.
* Equipment
    WHEN 'EQUIPMENTNUMMER'.
      CHECK NOT gt_ord_full-equipmentnummer IS INITIAL.
      SET PARAMETER ID 'SER' FIELD gt_ord_full-equipmentnummer.
      CALL TRANSACTION 'IQ03' AND SKIP FIRST SCREEN.
* Kunde
    WHEN 'KUNDENNUMMER'.
      CHECK NOT gt_ord_full-kundennummer IS INITIAL.
      SET PARAMETER ID 'KUN' FIELD gt_ord_full-kundennummer.
      CALL TRANSACTION 'XD03' AND SKIP FIRST SCREEN.      "#EC CI_USAGE_OK[2265093]    "INS S4CONV ECC - HPC(2508-614)
* Warenempfänger
    WHEN 'SHIPTO'.
      CHECK NOT gt_ord_full-shipto IS INITIAL.
      SET PARAMETER ID 'KUN' FIELD gt_ord_full-shipto.
      SET PARAMETER ID 'VKO' FIELD gt_ord_full-vkorg.
      SET PARAMETER ID 'VTW' FIELD gt_ord_full-vtweg.
      SET PARAMETER ID 'SPA' FIELD gt_ord_full-spart.
      CALL TRANSACTION 'XD03' AND SKIP FIRST SCREEN.      "#EC CI_USAGE_OK[2265093]    "INS S4CONV ECC - HPC(2508-614)
* Vendor
    WHEN 'VENDORNUMMER'.
      CHECK NOT gt_ord_full-vendornummer IS INITIAL.
      SET PARAMETER ID 'LIF' FIELD gt_ord_full-vendornummer.
      CALL TRANSACTION 'XK03'.      "#EC CI_USAGE_OK[2265093]    "INS S4CONV ECC - HPC(2508-614)
* Hersteller
    WHEN 'HERSTELLER'.
      CHECK NOT gt_ord_full-hersteller IS INITIAL.
      SET PARAMETER ID 'LIF' FIELD gt_ord_full-hersteller.
      CALL TRANSACTION 'XK03'.      "#EC CI_USAGE_OK[2265093]    "INS S4CONV ECC - HPC(2508-614)

* Z2 Meldung                                                         "HB290514
    WHEN 'QMNUM_Z2'.
      CHECK NOT gt_ord_full-qmnum_z2 IS INITIAL.
      SET PARAMETER ID 'IQM' FIELD gt_ord_full-qmnum_z2.
      CALL TRANSACTION 'IW53' AND SKIP FIRST SCREEN.

* Vendorlieferung                                                    "HB290514
    WHEN 'YLIEFVEND'.
      CHECK NOT gt_ord_full-yliefvend IS INITIAL.
      SET PARAMETER ID 'VL' FIELD gt_ord_full-yliefvend.
      CALL TRANSACTION 'VL03N' AND SKIP FIRST SCREEN.

    WHEN OTHERS.

  ENDCASE.
ENDFORM.                    " FCODE_PICK_ALV
