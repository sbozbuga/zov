FORM increment_statistic .       "MK 25.06.2020 Ticket 2006-849

  IF s_orded[] IS INITIAL AND s_orddt[] IS INITIAL.
    EXIT.
  ENDIF.

  DATA: ls_zordview_query TYPE zordview_query,
        lv_dat            TYPE sy-datum VALUE '20180101',
        lv_dat2           TYPE sy-datum.

  RANGES : lr_date FOR sy-datum.
  lr_date-sign = 'I'.
  lr_date-option = 'BT'.
  lr_date-low = '00000000'.
  lr_date-high = '20171231'.
  APPEND lr_date.

  LOOP AT s_orded.
    IF s_orded-sign = 'I'.
      CASE s_orded-option.
        WHEN 'EQ'.
          IF s_orded-low IN lr_date.
            lv_dat = s_orded-low.
            EXIT.
          ENDIF.
        WHEN 'BT'.
          IF s_orded-low IN lr_date OR s_orded-high IN lr_date.
            lv_dat = lv_dat - 1. "Hauptsache kleiner
            EXIT.
          ENDIF.
        WHEN 'GT'.
          lv_dat2 = s_orded-low + 1.
          IF lv_dat2 IN lr_date.
            lv_dat = lv_dat - 1. "Hauptsache kleiner
            EXIT.
          ENDIF.
        WHEN 'LT'.
          lv_dat2 = s_orded-low - 1.
          IF lv_dat2 IN lr_date.
            lv_dat = lv_dat - 1. "Hauptsache kleiner
            EXIT.
          ENDIF.
        WHEN 'GE' OR 'LE'.
          lv_dat2 = s_orded-low.
          IF lv_dat2 IN lr_date.
            lv_dat = lv_dat - 1. "Hauptsache kleiner
            EXIT.
          ENDIF.
      ENDCASE.
    ENDIF.
  ENDLOOP.

  IF lv_dat GE '20180101'.
    LOOP AT s_orddt.
      IF s_orddt-sign = 'I'.
        CASE s_orddt-option.
          WHEN 'EQ'.
            IF s_orddt-low IN lr_date.
              lv_dat = s_orddt-low.
              EXIT.
            ENDIF.
          WHEN 'BT'.
            IF s_orddt-low IN lr_date OR s_orddt-high IN lr_date.
              lv_dat = lv_dat - 1. "Hauptsache kleiner
              EXIT.
            ENDIF.
          WHEN 'GT'.
            lv_dat2 = s_orddt-low + 1.
            IF lv_dat2 IN lr_date.
              lv_dat = lv_dat - 1. "Hauptsache kleiner
              EXIT.
            ENDIF.
          WHEN 'LT'.
            lv_dat2 = s_orddt-low - 1.
            IF lv_dat2 IN lr_date.
              lv_dat = lv_dat - 1. "Hauptsache kleiner
              EXIT.
            ENDIF.
          WHEN 'GE' OR 'LE'.
            lv_dat2 = s_orddt-low.
            IF lv_dat2 IN lr_date.
              lv_dat = lv_dat - 1. "Hauptsache kleiner
              EXIT.
            ENDIF.
        ENDCASE.
      ENDIF.
    ENDLOOP.
  ENDIF.

  IF lv_dat < '20180101'.
    SELECT SINGLE * FROM zordview_query INTO ls_zordview_query.
    IF sy-subrc = 0.
      ls_zordview_query-anz_old_query = ls_zordview_query-anz_old_query + 1.
      UPDATE zordview_query FROM ls_zordview_query.
    ELSE.
      ls_zordview_query-anz_old_query = 1.
      INSERT zordview_query FROM ls_zordview_query.
    ENDIF.
  ENDIF.

ENDFORM.