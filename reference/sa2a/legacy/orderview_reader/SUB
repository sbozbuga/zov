*&---------------------------------------------------------------------*
FORM update_z2_data USING if_qmnum.
  DATA: lwa_qmel  LIKE qmel,
        lwa_jest  LIKE jest,
        lwa_tj02t LIKE tj02t.

  CLEAR lwa_qmel.
  SELECT SINGLE * FROM qmel INTO lwa_qmel
  WHERE qmart = 'Z2' AND
        qmnum = if_qmnum.

  CLEAR gwa_ord_add.
  gwa_ord_add-qmnum = gt_ord_full-qmnum.
  gwa_ord_add-fenum = gt_ord_full-fenum.
  gwa_ord_add-counter = gt_ord_full-counter.
  gwa_ord_add-qmnum_z2 = if_qmnum.

  IF lwa_qmel-kzloesch IS INITIAL.

    CLEAR lwa_tj02t.
    SELECT SINGLE * FROM tj02t INTO lwa_tj02t WHERE txt04 = 'LÖVM'.

    CLEAR lwa_jest.
    SELECT SINGLE * FROM jest INTO lwa_jest
    WHERE objnr = lwa_qmel-objnr AND
          stat = lwa_tj02t-istat AND
          inact = ' '.

    IF sy-subrc NE 0.

      PERFORM select_z2_data USING if_qmnum.

      CLEAR gwa_ordview.
      READ TABLE gt_ordview INTO gwa_ordview
      WITH KEY qmnum = gt_ord_full-qmnum
               fenum = gt_ord_full-fenum
               counter = gt_ord_full-counter.

      CLEAR gt_qmfe.
      READ TABLE gt_qmfe WITH KEY qmnum = if_qmnum
      BINARY SEARCH.

      PERFORM build_remakrs_data USING if_qmnum.
    ENDIF.

  ENDIF.

  MODIFY (gv_tabname) FROM gwa_ordview.

  IF gv_tabname <> co_tab_ordview.
    "immer auch in Orignaltabelle ändern
    MODIFY (co_tab_ordview) FROM gwa_ordview.
  ENDIF.

  MODIFY /cellag/ord_add FROM gwa_ord_add.

ENDFORM.                    " UPDATE_Z2_DATA
*&---------------------------------------------------------------------*
*&      Form  SELECT_Z2_DATA
*&---------------------------------------------------------------------*
FORM select_z2_data USING if_qmnum.

  DATA: lt_tlines  TYPE STANDARD TABLE OF tline,
        lwa_tlines TYPE tline.

  DATA: lv_name LIKE thead-tdname.

  RANGES: lr_urcod FOR qmur-urcod.

  CLEAR lr_urcod. REFRESH lr_urcod.
  lr_urcod-sign = 'I'.
  lr_urcod-option = 'CP'.
  lr_urcod-low = 'A*'.
  APPEND lr_urcod. REFRESH lr_urcod.

  SELECT a~qmnum a~aufnr a~matnr a~qmcod a~serialnr
  b~fenum b~erdat b~fetxt b~fegrp b~fecod b~otgrp
  b~oteil b~kzloesch b~besz
  FROM qmel AS a LEFT OUTER JOIN qmfe AS b
  ON a~qmnum = b~qmnum
  INTO TABLE gt_qmfe
  WHERE a~qmnum = if_qmnum.

  SORT gt_qmfe DESCENDING BY kzloesch.
  DELETE gt_qmfe WHERE NOT kzloesch IS INITIAL.
  SORT gt_qmfe BY qmnum fenum.

  CLEAR gt_qmma_aux. REFRESH gt_qmma_aux.
  CLEAR gt_qmur. REFRESH gt_qmur.

  SELECT qmnum manum fenum mngrp mncod matxt ernam erdat
  aenam aedat peter indtx kzmla
  erzeit aezeit qmanum
*  FROM qmma INTO TABLE gt_qmma
  FROM qmma INTO TABLE gt_qmma_aux                          "HB260113
  WHERE qmnum = if_qmnum AND
        kzloesch EQ space.
  SELECT qmnum erdat urgrp urcod FROM qmur
  INTO TABLE gt_qmur
  WHERE qmnum = if_qmnum AND
        urgrp = 'ZAKZ' AND
        urcod IN lr_urcod AND
        kzloesch = ' '.

  SORT gt_qmma_aux BY qmnum ASCENDING aedat DESCENDING aezeit DESCENDING qmanum ASCENDING.

  CLEAR gt_qmma. REFRESH gt_qmma.

  CLEAR gt_qmma_aux.
  LOOP AT gt_qmma_aux.
    MOVE-CORRESPONDING gt_qmma_aux TO gt_qmma.
    IF gt_qmma-aenam IS INITIAL.
      gt_qmma-aenam = gt_qmma-ernam.
    ENDIF.
    IF gt_qmma-aedat IS INITIAL.
      gt_qmma-aedat = gt_qmma-erdat.
    ENDIF.
    IF gt_qmma-aezeit IS INITIAL.
      gt_qmma-aezeit = gt_qmma-erzeit.
    ENDIF.

    MOVE gt_qmma-matxt TO gt_qmma-line.

    IF NOT gt_qmma-indtx IS INITIAL.
      "Trenner Kurz/Langtext
      CONCATENATE gt_qmma-line '/' INTO gt_qmma-line.

      CLEAR lt_tlines. REFRESH lt_tlines.
      CLEAR lv_name.
      CONCATENATE gt_qmma-qmnum gt_qmma-manum INTO lv_name.
      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          id                      = 'LTXT'
          language                = gt_qmma-kzmla   "HB291123 in der gespeicherten Sprache
          name                    = lv_name
          object                  = 'QMMA'
        TABLES
          lines                   = lt_tlines
        EXCEPTIONS
          id                      = 1
          language                = 2
          name                    = 3
          not_found               = 4
          object                  = 5
          reference_check         = 6
          wrong_access_to_archive = 7
          OTHERS                  = 8.
      IF sy-subrc EQ 0.
        CLEAR lwa_tlines.
        LOOP AT lt_tlines INTO lwa_tlines.
*          CONDENSE lwa_tlines-tdline.
          IF gt_qmma-line IS INITIAL.
            gt_qmma-line = lwa_tlines-tdline.
          ELSE.
            CONCATENATE gt_qmma-line lwa_tlines-tdline INTO gt_qmma-line.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.

    APPEND gt_qmma.
    CLEAR gt_qmma.
  ENDLOOP.

  SORT gt_qmur BY qmnum.

ENDFORM.                    " SELECT_Z2_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_REMAKRS_DATA
*&---------------------------------------------------------------------*
FORM build_remakrs_data USING if_qmnum.
  DATA: BEGIN OF lt_termin OCCURS 0,
          aedat     LIKE qmma-aedat,
          aezeit    LIKE qmma-aezeit,
          qmanum    LIKE qmma-qmnum,
          value(20),
        END OF lt_termin.

  DATA: lv_index_qmma   TYPE sytabix,
        lv_index_termin TYPE sytabix,
        lv_datum        TYPE sydatum,
        lv_week         LIKE scal-week,
        lv_string       TYPE string.

  IF NOT gt_qmfe-qmcod IS INITIAL.
    gwa_ordview-akz = gt_qmfe-qmcod.
  ENDIF.

  gwa_ordview-fcode = gt_qmfe-fegrp.
  gwa_ordview-flage = gt_qmfe-oteil.

  CLEAR gt_tq80.
  READ TABLE gt_tq80 WITH KEY qmart = 'Z2'.

  CLEAR gt_qpct.
  READ TABLE gt_qpct WITH KEY katalogart = gt_tq80-otkat    "katalogart = '5'
                              codegruppe = gt_qmfe-otgrp
                              code = gt_qmfe-oteil
  BINARY SEARCH.
  gwa_ordview-flagetxt = gt_qpct-kurztext.

  CLEAR gt_qpgt.
  READ TABLE gt_qpgt WITH KEY katalogart = gt_tq80-fekat    "katalogart = 'Z'
                              codegruppe = gt_qmfe-fegrp
  BINARY SEARCH.
  gwa_ordview-fcodetext = gt_qpgt-kurztext.

  gwa_ordview-fart = gt_qmfe-fecod.

  CLEAR gt_qpct.
  READ TABLE gt_qpct WITH KEY katalogart = gt_tq80-fekat    "katalogart = 'Z'
                              codegruppe = gt_qmfe-fegrp
                              code = gt_qmfe-fecod
  BINARY SEARCH.
  gwa_ordview-farttext = gt_qpct-kurztext.
  gwa_ordview-errortext = gt_qmfe-fetxt.
  gwa_ordview-fehler1 = gt_qmfe-besz.

  SORT gt_qmma BY qmnum ASCENDING aedat DESCENDING aezeit DESCENDING qmanum ASCENDING.

  CLEAR gt_qmma.
  READ TABLE gt_qmma WITH KEY qmnum = gt_qmfe-qmnum
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    lv_datum = sy-datum - 7.
    gwa_ord_add-aedat = gt_qmma-aedat.
    gwa_ord_add-aeuhr = gt_qmma-aezeit.
    gwa_ord_add-aenam = gt_qmma-aenam.

    IF gt_qmma-aedat GE lv_datum.
      gwa_ord_add-changes = c_true.
    ENDIF.
  ENDIF.

  CLEAR lt_termin. REFRESH lt_termin.

  CLEAR lv_index_termin.
  CLEAR gt_qmma.
  READ TABLE gt_qmma WITH KEY qmnum = gt_qmfe-qmnum
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    lv_index_qmma = sy-tabix.
    LOOP AT gt_qmma FROM lv_index_qmma.
      IF gt_qmma-qmnum <> gt_qmfe-qmnum.
        EXIT.
      ENDIF.
      IF gt_qmma-mngrp ='ZRGSIDT'.
        lv_index_termin = lv_index_termin + 1.
        IF lv_index_termin LE 5.
          lt_termin-aedat = gt_qmma-aedat.
          lt_termin-aezeit = gt_qmma-aezeit.
          lt_termin-qmanum = gt_qmma-qmanum.
          CASE gt_qmma-mncod.
            WHEN '00'.
              lt_termin-value = gt_qmma-peter.
            WHEN '99'.
              lt_termin-value = 'MISSING'.
          ENDCASE.
          COLLECT lt_termin.
          CLEAR lt_termin.
        ENDIF.
        IF lv_index_termin = 1.
          CASE gt_qmma-mncod.
            WHEN '00'.
              gwa_ord_add-actualcommitdate = gt_qmma-peter.
              CLEAR lv_week.
              CALL FUNCTION 'GET_WEEK_INFO_BASED_ON_DATE' "#EC CI_USAGE_OK[2296016] "INS S4CONV ECC - HPC(2508-614)
                EXPORTING
                  date = gwa_ord_add-actualcommitdate
                IMPORTING
                  week = lv_week.
              CONCATENATE 'CW' lv_week+4(2) INTO gwa_ord_add-deliverplan
              SEPARATED BY space.
              CONCATENATE gwa_ord_add-deliverplan ',' lv_week(4) INTO gwa_ord_add-deliverplan.
            WHEN '99'.
              gwa_ord_add-actualcommitdate = '20201010'.
              gwa_ord_add-deliverplan = 'MISSING'.
          ENDCASE.
          gwa_ord_add-lastcommitdate = gt_qmma-aedat.

        ELSEIF lv_index_termin = 2.
          CASE gt_qmma-mncod.
            WHEN '00'.
              gwa_ord_add-recommitedhist = gt_qmma-peter.
            WHEN '99'.
              gwa_ord_add-recommitedhist = '20201010'.
          ENDCASE.
        ENDIF.
      ELSE.
        PERFORM fill_remarks_data USING gt_qmma.
      ENDIF.
    ENDLOOP.
  ENDIF.

  CLEAR lt_termin.
  SORT lt_termin BY aedat aezeit qmanum.

  CLEAR lt_termin.
  LOOP AT lt_termin.
    IF lt_termin-value = 'MISSING'.
      IF gwa_ord_add-deliverplanhist IS INITIAL.
        gwa_ord_add-deliverplanhist = lt_termin-value.
      ELSE.
        CONCATENATE gwa_ord_add-deliverplanhist ';' lt_termin-value
        INTO gwa_ord_add-deliverplanhist.
      ENDIF.
    ELSE.
      CLEAR lv_datum.
      MOVE lt_termin-value TO lv_datum.
      CLEAR: lv_string,
             lv_week.
      CALL FUNCTION 'GET_WEEK_INFO_BASED_ON_DATE' "#EC CI_USAGE_OK[2296016] "INS S4CONV ECC - HPC(2508-614)
        EXPORTING
          date = lv_datum
        IMPORTING
          week = lv_week.
      CONCATENATE 'CW' lv_week+4(2) INTO lv_string
      SEPARATED BY space.
      CONCATENATE lv_string ',' lv_week(4) INTO lv_string.
      IF gwa_ord_add-deliverplanhist IS INITIAL.
        gwa_ord_add-deliverplanhist = lv_string.
      ELSE.
        CONCATENATE gwa_ord_add-deliverplanhist ';' lv_string
        INTO gwa_ord_add-deliverplanhist.
      ENDIF.
    ENDIF.
  ENDLOOP.

  PERFORM build_gsi_remarks TABLES gt_qmma.

ENDFORM.                    " BUILD_REMAKRS_DATA
*&---------------------------------------------------------------------*
*&      Form  BUILD_GSI_REMARKS
*&---------------------------------------------------------------------*
FORM build_gsi_remarks TABLES it_qmma STRUCTURE gt_qmma.
  DATA: lwa_qmma    LIKE gt_qmma,
        lwa_ord_add LIKE /cellag/ord_add.

  MOVE-CORRESPONDING gwa_ord_add TO lwa_ord_add.

  CLEAR it_qmma.
  SORT it_qmma BY qmnum mngrp qmanum.

* First remarks with code '9999'
  CLEAR lwa_qmma.
  READ TABLE it_qmma INTO lwa_qmma
  WITH KEY qmnum = gt_qmfe-qmnum
           mngrp = 'ZRRS01'
           qmanum = '9999'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    MOVE lwa_ord_add-remarksrs TO gwa_ord_add-gsiremarks.
    CLEAR lwa_ord_add-remarksrs.
  ENDIF.

  CLEAR lwa_qmma.
  READ TABLE it_qmma INTO lwa_qmma
  WITH KEY qmnum = gt_qmfe-qmnum
           mngrp = 'ZRLO01'
           qmanum = '9999'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarkslog TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarkslog
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
    CLEAR lwa_ord_add-remarkslog.
  ENDIF.

  CLEAR lwa_qmma.
  READ TABLE it_qmma INTO lwa_qmma
  WITH KEY qmnum = gt_qmfe-qmnum
           mngrp = 'ZRVM01'
           qmanum = '9999'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarksvm TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarksvm
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
    CLEAR lwa_ord_add-remarksvm.
  ENDIF.

  CLEAR lwa_qmma.
  READ TABLE it_qmma INTO lwa_qmma
  WITH KEY qmnum = gt_qmfe-qmnum
            mngrp = 'ZRSP01'
            qmanum = '9999'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarksspm TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarksspm
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
    CLEAR lwa_ord_add-remarksspm.
  ENDIF.

  CLEAR lwa_qmma.
  READ TABLE it_qmma INTO lwa_qmma
  WITH KEY qmnum = gt_qmfe-qmnum
           mngrp = 'ZRPU01'
           qmanum = '9999'
  BINARY SEARCH.
  IF sy-subrc EQ 0.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarkspur TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarkspur
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
    CLEAR lwa_ord_add-remarkspur.
  ENDIF.

* Texts without any code '9999'
  IF NOT lwa_ord_add-remarksrs IS INITIAL.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarksrs TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarksrs
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
  ENDIF.

  IF NOT lwa_ord_add-remarkslog IS INITIAL.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarkslog TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarkslog
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
  ENDIF.

  IF NOT lwa_ord_add-remarksvm IS INITIAL.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarksvm TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarksvm
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
  ENDIF.

  IF NOT lwa_ord_add-remarksspm IS INITIAL.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarksspm TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarksspm
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
  ENDIF.

  IF NOT lwa_ord_add-remarkspur IS INITIAL.
    IF gwa_ord_add-gsiremarks IS INITIAL.
      MOVE lwa_ord_add-remarkspur TO gwa_ord_add-gsiremarks.
    ELSE.
      CONCATENATE gwa_ord_add-gsiremarks '/' lwa_ord_add-remarkspur
      INTO gwa_ord_add-gsiremarks.
    ENDIF.
  ENDIF.

ENDFORM.                    " BUILD_GSI_REMARKS
*&---------------------------------------------------------------------*
*&      Form  FILL_REMARKS_DATA
*&---------------------------------------------------------------------*
FORM fill_remarks_data USING if_qmma STRUCTURE gt_qmma.
  CASE gt_qmma-mngrp.
    WHEN 'ZRRS01'.   "Repairshop
      IF gwa_ord_add-remarksrs IS INITIAL.
        gwa_ord_add-remarksrs = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarksrs '/' if_qmma-line
        INTO gwa_ord_add-remarksrs.
      ENDIF.
      IF gwa_ord_add-timestamprs IS INITIAL.
        gwa_ord_add-timestamprs = if_qmma-aedat.
      ENDIF.
    WHEN 'ZROC01'.   "Order control
      IF gwa_ord_add-remarksoc IS INITIAL.
        gwa_ord_add-remarksoc = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarksoc '/' if_qmma-line
        INTO gwa_ord_add-remarksoc.                         "HB180115
      ENDIF.
      IF gwa_ord_add-timestampoc IS INITIAL.
        gwa_ord_add-timestampoc = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRVM01'.   "Vendor Management
      IF gwa_ord_add-remarksvm IS INITIAL.
        gwa_ord_add-remarksvm = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarksvm '/' if_qmma-line
        INTO gwa_ord_add-remarksvm.
      ENDIF.
      IF gwa_ord_add-timestampvm IS INITIAL.
        gwa_ord_add-timestampvm = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRSP01'.   "SpareParsManagement
      IF gwa_ord_add-remarksspm IS INITIAL.
        gwa_ord_add-remarksspm = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarksspm '/' if_qmma-line
        INTO gwa_ord_add-remarksspm.
      ENDIF.
      IF gwa_ord_add-timestampspm IS INITIAL.
        gwa_ord_add-timestampspm = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRPU01'.   "Purschasing
      IF gwa_ord_add-remarkspur IS INITIAL.
        gwa_ord_add-remarkspur = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarkspur '/' if_qmma-line
        INTO gwa_ord_add-remarkspur.
      ENDIF.
      IF gwa_ord_add-timestamppur IS INITIAL.
        gwa_ord_add-timestamppur = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRLO01'.   "Logistik
      IF gwa_ord_add-remarkslog IS INITIAL.
        gwa_ord_add-remarkslog = if_qmma-line.
      ELSE.
        CONCATENATE gwa_ord_add-remarkslog '/' if_qmma-line
        INTO gwa_ord_add-remarkslog.
      ENDIF.
      IF gwa_ord_add-timestamplog IS INITIAL.
        gwa_ord_add-timestamplog = if_qmma-aedat.
      ENDIF.
    WHEN 'ZRGSIST'.
      IF gwa_ord_add-status IS INITIAL.
        gwa_ord_add-status = if_qmma-mncod.
      ENDIF.
  ENDCASE.
ENDFORM.                    " FILL_REMARKS_DATA
*&---------------------------------------------------------------------*
*&      Form  DELETE_Z2_DATA
*&---------------------------------------------------------------------*
FORM delete_z2_data USING if_qmnum.

  CLEAR gwa_ordview.
  CLEAR gwa_ord_add.

  SELECT SINGLE qmnum fenum counter qmnum_z2 FROM /cellag/ord_add
  INTO CORRESPONDING FIELDS OF gwa_ord_add
  WHERE qmnum = gt_ord_full-qmnum AND
        fenum = gt_ord_full-fenum AND
        counter = gt_ord_full-counter AND
        qmnum_z2 = if_qmnum.

  CHECK sy-subrc EQ 0.

  CLEAR gwa_ordview.
  READ TABLE gt_ordview INTO gwa_ordview
  WITH KEY qmnum = gt_ord_full-qmnum
           fenum = gt_ord_full-fenum
           counter = gt_ord_full-counter.

  CLEAR: gwa_ordview-akz,
         gwa_ordview-fcode,
         gwa_ordview-flage,
         gwa_ordview-flagetxt,
         gwa_ordview-fcodetext,
         gwa_ordview-fart,
         gwa_ordview-farttext,
         gwa_ordview-errortext,
         gwa_ordview-fehler1.

* AKZ--> Retoure
  SELECT SINGLE /cellag/akz INTO gwa_ordview-akz FROM lips
  WHERE vbeln = gwa_ordview-retoure AND
        posnr = gwa_ordview-retoure_posnr.

  MODIFY /cellag/ord_add FROM gwa_ord_add.

  IF sy-subrc NE 0.
    ROLLBACK WORK.
    EXIT.
  ENDIF.

  MODIFY (gv_tabname) FROM gwa_ordview.
  IF sy-subrc NE 0.
    ROLLBACK WORK.
  ENDIF.

  IF gv_tabname <> co_tab_ordview.
    "immer auch in Orignaltabelle ändern
    MODIFY (co_tab_ordview) FROM gwa_ordview.
    IF sy-subrc NE 0.
      ROLLBACK WORK.
    ENDIF.
  ENDIF.

  IF sy-subrc EQ 0.
    COMMIT WORK.
  ENDIF.
ENDFORM.                    " DELETE_Z2_DATA
*&---------------------------------------------------------------------*
*&      Form  SHOW_PROGRESS
*&---------------------------------------------------------------------*
FORM show_progress USING if_per if_text.
  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      percentage = if_per
      text       = if_text.

ENDFORM.                    " SHOW_PROGRESS
*&---------------------------------------------------------------------*
*&      Form  SELECT_RETURNS
*&---------------------------------------------------------------------*
FORM select_returns.
  DATA: lt_ordview_ruck  LIKE gt_ordview OCCURS 0 WITH HEADER LINE,
        lt_ord_add_ruck  LIKE gt_ord_add OCCURS 0 WITH HEADER LINE,
        lt_ord_full_ruck LIKE gt_ord_full OCCURS 0 WITH HEADER LINE.

  DATA: BEGIN OF lt_lifnr OCCURS 0,
          lifnr LIKE lfa1-lifnr,
        END OF lt_lifnr.

  DATA: lt_key_par   LIKE gt_key OCCURS 0 WITH HEADER LINE,
        lt_lifnr_par LIKE lt_lifnr OCCURS 0 WITH HEADER LINE.

  DATA: lv_begdatum TYPE sydatum,
        lv_enddatum TYPE sydatum,
        lv_lastdock TYPE sydatum,
        lv_difdays  TYPE i.

  DATA: lv_count1   TYPE i,
        lv_count2   TYPE i,
        lv_countsub TYPE i,
        lv_sercount TYPE c LENGTH 6,
        lv_subcount TYPE c LENGTH 5.

  DATA: lv_text TYPE c LENGTH 50.

  RANGES: lr_dockdate FOR /cellag/ordview-dockdate.
  DELETE gt_ord_full WHERE dockdate EQ space OR
                           serialrec EQ space.

  SORT gt_ord_full BY serialrec.

  DELETE ADJACENT DUPLICATES FROM gt_ord_full COMPARING serialrec.

  IF pa_vorwa EQ c_true.
    SORT gt_ord_full BY dockdate DESCENDING.
  ELSE.
    SORT gt_ord_full BY dockdate ASCENDING.
  ENDIF.

  CLEAR gt_ord_full.
  READ TABLE gt_ord_full INDEX 1.

  lv_begdatum = gt_ord_full-dockdate.

  IF NOT pa_rudat IS INITIAL.
    lv_enddatum = pa_rudat.
  ELSE.
    CASE c_true.
      WHEN pa_01mon.
        lv_difdays = 30.
      WHEN pa_03mon.
        lv_difdays = 90.
      WHEN pa_06mon.
        lv_difdays = 180.
      WHEN pa_12mon.
        lv_difdays = 360.
    ENDCASE.
    IF pa_vorwa EQ c_true.
      lv_enddatum = lv_begdatum + lv_difdays.
    ELSE.
      lv_enddatum = lv_begdatum - lv_difdays.
    ENDIF.
  ENDIF.

  CLEAR lr_dockdate. REFRESH lr_dockdate.

  lr_dockdate-sign = 'I'.
  lr_dockdate-option = 'EQ'.

  IF pa_vorwa EQ c_true.
    lr_dockdate-low = lv_begdatum.
    lr_dockdate-high = lv_enddatum.
  ELSE.
    lr_dockdate-low = lv_enddatum.
    lr_dockdate-high = lv_begdatum.
  ENDIF.

  APPEND lr_dockdate. CLEAR lr_dockdate.

  PERFORM show_progress USING 30 TEXT-t08.

  CLEAR lt_ordview_ruck. REFRESH lt_ordview_ruck.

  SELECT * FROM /cellag/ordview INTO TABLE lt_ordview_ruck
  FOR ALL ENTRIES IN gt_ord_full
  WHERE serialrec = gt_ord_full-serialrec AND
        qmnum <> gt_ord_full-qmnum AND
        dockdate IN lr_dockdate.

  SORT lt_ordview_ruck BY qmnum fenum counter.

  CLEAR lt_lifnr. REFRESH lt_lifnr.
  CLEAR gt_key. REFRESH gt_key.
  CLEAR lt_ordview_ruck.
  LOOP AT lt_ordview_ruck.
    gt_key-qmnum = lt_ordview_ruck-qmnum.
    gt_key-fenum = lt_ordview_ruck-fenum.
    gt_key-counter = lt_ordview_ruck-counter.
    APPEND gt_key. CLEAR gt_key.
    IF NOT lt_ordview_ruck-hersteller IS INITIAL.
      lt_lifnr-lifnr = lt_ordview_ruck-hersteller.
      COLLECT lt_lifnr.
      CLEAR lt_lifnr.
    ENDIF.
  ENDLOOP.

  SORT gt_key BY qmnum fenum counter.
  SORT lt_lifnr.

  CLEAR lt_ord_add_ruck. REFRESH lt_ord_add_ruck.
  IF NOT gt_key[] IS INITIAL.
    DO.
      build_table gt_key lt_key_par.
      SELECT * FROM /cellag/ord_add APPENDING TABLE lt_ord_add_ruck
      FOR ALL ENTRIES IN lt_key_par
      WHERE qmnum = lt_key_par-qmnum AND
            fenum = lt_key_par-fenum AND
            counter = lt_key_par-counter.
    ENDDO.
  ENDIF.

  CLEAR gt_lfa1. REFRESH gt_lfa1.
  IF NOT lt_lifnr[] IS INITIAL.
    DO.
      build_table lt_lifnr lt_lifnr_par.
      SELECT lifnr name1 FROM lfa1
      APPENDING TABLE gt_lfa1
      FOR ALL ENTRIES IN lt_lifnr_par
      WHERE lifnr = lt_lifnr_par-lifnr.
    ENDDO.
  ENDIF.

  SORT gt_lfa1 BY lifnr.

  SORT lt_ord_add_ruck BY qmnum fenum counter.
  CLEAR lt_ord_full_ruck. REFRESH lt_ord_full_ruck.

  CLEAR lt_ordview_ruck.
  LOOP AT lt_ordview_ruck.
    MOVE-CORRESPONDING lt_ordview_ruck TO lt_ord_full_ruck.
    CLEAR lt_ord_add_ruck.
    READ TABLE lt_ord_add_ruck WITH KEY qmnum = lt_ordview_ruck-qmnum
                                        fenum = lt_ordview_ruck-fenum
                                        counter = lt_ordview_ruck-counter
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      MOVE-CORRESPONDING lt_ord_add_ruck TO lt_ord_full_ruck.
    ENDIF.
    CLEAR gt_lfa1.
    READ TABLE gt_lfa1 WITH KEY lifnr = lt_ordview_ruck-hersteller
    BINARY SEARCH.
    IF sy-subrc EQ 0.
      lt_ord_full_ruck-herstellername = gt_lfa1-name1.
    ENDIF.
    APPEND lt_ord_full_ruck.
    CLEAR lt_ord_full_ruck.
  ENDLOOP.

  IF pa_vorwa EQ c_true.
    SORT lt_ord_full_ruck BY serialrec dockdate ASCENDING.
  ELSE.
    SORT lt_ord_full_ruck BY serialrec dockdate DESCENDING.
  ENDIF.

  CLEAR: lv_count1.
  CLEAR gt_ord_full.
  LOOP AT gt_ord_full.
    CLEAR lr_dockdate. REFRESH lr_dockdate.
    lr_dockdate-sign = 'I'.
    lr_dockdate-option = 'EQ'.
    IF NOT pa_rudat IS INITIAL.
      lv_enddatum = pa_rudat.
    ELSE.
      IF pa_vorwa EQ c_true.
        lv_enddatum = gt_ord_full-dockdate + lv_difdays.
      ELSE.
        lv_enddatum = gt_ord_full-dockdate - lv_difdays.
      ENDIF.
    ENDIF.

    IF pa_vorwa EQ c_true.
      lr_dockdate-low = gt_ord_full-dockdate.
      lr_dockdate-high = lv_enddatum.
    ELSE.
      lr_dockdate-low = lv_enddatum.
      lr_dockdate-high = gt_ord_full-dockdate.
    ENDIF.
    APPEND lr_dockdate. CLEAR lr_dockdate.

    CLEAR: lv_count2, lv_lastdock.

    CLEAR lt_ord_full_ruck.
    LOOP AT lt_ord_full_ruck WHERE
    serialrec = gt_ord_full-serialrec AND
    dockdate IN lr_dockdate.
      ADD 1 TO lv_count2.
      IF lv_count2 = 1.
        ADD 1 TO lv_count1.
        WRITE lv_count1 TO lv_sercount LEFT-JUSTIFIED.
        lv_lastdock = gt_ord_full-dockdate.
      ENDIF.
      lt_ord_full_ruck-retdays = abs( lv_lastdock - lt_ord_full_ruck-dockdate ).
      lv_lastdock = lt_ord_full_ruck-dockdate.

*--- return-counter in der Form <serialzähler>/<subzähler>
      lv_countsub = lv_count2 + 1.
      WRITE lv_countsub TO lv_subcount LEFT-JUSTIFIED.
      CONCATENATE lv_sercount'/' lv_subcount INTO lt_ord_full_ruck-retcounter.
    ENDLOOP.
    IF NOT lv_count2 IS INITIAL.
      WRITE lv_count2 TO gt_ord_full-retqty LEFT-JUSTIFIED.
      CONCATENATE lv_sercount'/1' INTO gt_ord_full-retcounter.

      CONCATENATE 'Rückläufer' gt_ord_full-retcounter INTO lv_text.
      PERFORM show_progress USING 50 lv_text.
    ELSE.
      IF pa_ruecr = abap_true.
        DELETE gt_ord_full.
      ENDIF.
    ENDIF.
  ENDLOOP.

  DELETE lt_ord_full_ruck WHERE retcounter = space.

*--- Die mit Anzahl 0 durch Stern ersetzen                       "HB280210
  LOOP AT lt_ord_full_ruck WHERE retcounter <> space AND
                                 retqty = space.
    lt_ord_full_ruck-retqty = '*'.
    MODIFY lt_ord_full_ruck.
  ENDLOOP.

  APPEND LINES OF lt_ord_full_ruck TO gt_ord_full.

  IF pa_vorwa EQ c_true.
    SORT gt_ord_full BY serialrec dockdate DESCENDING.
  ELSE.
    SORT gt_ord_full BY serialrec dockdate ASCENDING.
  ENDIF.
ENDFORM.                    " SELECT_RETURNS
*&---------------------------------------------------------------------*
*&      Form  CREATE_Z2_MELDUNG
*&---------------------------------------------------------------------*
FORM create_z2_meldung USING if_objk STRUCTURE objk
                             if_selfield TYPE slis_selfield.
  DATA: lwa_riqs5            LIKE riqs5,
        lwa_viqmel           LIKE viqmel,
        lwa_notifheader_save LIKE bapi2080_nothdre,
        lv_okcode            LIKE t185-fcode,
        lv_answer.

  DATA: lwa_caufv LIKE caufv,
        lwa_afih  LIKE afih,
        lwa_iloa  LIKE iloa.

  DATA: lt_return LIKE bapiret2 OCCURS 0 WITH HEADER LINE.

  CLEAR: lwa_riqs5,
         lwa_viqmel,
         lv_okcode.

  CLEAR lwa_caufv.
  SELECT SINGLE * FROM caufv INTO lwa_caufv WHERE aufnr = gt_ord_full-fanumber.

  CLEAR lwa_afih.
  SELECT SINGLE * FROM afih INTO lwa_afih WHERE aufnr = gt_ord_full-fanumber.

  CLEAR lwa_iloa.
  SELECT SINGLE * FROM iloa INTO lwa_iloa WHERE iloan = lwa_afih-iloan.

  CLEAR lwa_riqs5.

  lwa_riqs5-deviceid = lwa_afih-deviceid.
  lwa_riqs5-tplnr = lwa_iloa-tplnr.
  lwa_riqs5-bautl = lwa_afih-bautl.
  lwa_riqs5-qmtxt = lwa_caufv-ktext.


  IF lwa_afih-priok IS INITIAL.
    lwa_riqs5-strmn = lwa_caufv-gstrp.
    lwa_riqs5-ltrmn = lwa_caufv-gltrp.
    lwa_riqs5-strur = lwa_caufv-gsuzp.
    lwa_riqs5-ltrur = lwa_caufv-gluzp.

  ELSE.
    lwa_riqs5-strmn = sy-datlo.
    lwa_riqs5-strur = sy-timlo.
  ENDIF.

  lwa_riqs5-priok = lwa_afih-priok.

  lwa_riqs5-arbplwerk = lwa_caufv-wawrk.
  lwa_riqs5-arbpl = lwa_afih-gewrk.
  lwa_riqs5-crobjty = lwa_afih-pm_objty.
  lwa_riqs5-kdauf = lwa_caufv-kdauf.
  lwa_riqs5-kdpos = lwa_caufv-kdpos.
  lwa_riqs5-iwerk = lwa_afih-iwerk.
  lwa_riqs5-ingrp = lwa_afih-ingpr.

  lwa_riqs5-equnr = if_objk-equnr.
  lwa_riqs5-serialnr = if_objk-sernr.
  lwa_riqs5-matnr = if_objk-matnr.
  lwa_riqs5-bautl = if_objk-bautl.
  lwa_riqs5-uii = if_objk-uii.

  CALL FUNCTION 'IQS0_CREATE_NOTIF_TO_ORDER'
    EXPORTING
      i_aufnr                    = gt_ord_full-fanumber
      i_tcode                    = 'ZW51Z2'
      i_qmart                    = 'Z2'
      i_riqs5                    = lwa_riqs5
    IMPORTING
      e_viqmel                   = lwa_viqmel
      e_okcode                   = lv_okcode
    EXCEPTIONS
      invalid_entry              = 1
      notification_not_in_buffer = 2
      OTHERS                     = 3.

  IF sy-subrc NE 0.
    EXIT.
  ENDIF.

  CLEAR lv_answer.

  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      titlebar       = TEXT-t09  "Meldung speichern
      text_question  = TEXT-t10  "Soll die Meldung gesichert werden?
    IMPORTING
      answer         = lv_answer
    EXCEPTIONS
      text_not_found = 1
      OTHERS         = 2.

  CASE lv_answer.
    WHEN '1'.

      CLEAR lt_return. REFRESH lt_return.
      CLEAR lwa_notifheader_save.
      CALL FUNCTION 'BAPI_ALM_NOTIF_SAVE'      "#EC CI_USAGE_OK[2438131]     "INS S4CONV ECC - HPC(2508-614)
        EXPORTING
          number      = lwa_viqmel-qmnum
        IMPORTING
          notifheader = lwa_notifheader_save
        TABLES
          return      = lt_return.

      CLEAR lt_return.
      READ TABLE lt_return WITH KEY type = 'E'.
      CHECK sy-subrc NE 0.

      CLEAR lt_return. REFRESH lt_return.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          wait   = c_true
        IMPORTING
          return = lt_return.

      CLEAR lt_return.
      READ TABLE lt_return WITH KEY type = 'E'.
      CHECK sy-subrc NE 0.

      CLEAR: if_objk-equnr,
             if_objk-bautl,
             if_objk-iloan,
             if_objk-sortf,
             if_objk-bearb,
             if_objk-sernr,
             if_objk-matnr.

      if_objk-ihnum = lwa_notifheader_save-notif_no.
      MODIFY objk FROM if_objk.
      COMMIT WORK AND WAIT.

      PERFORM update_z2_data USING lwa_notifheader_save-notif_no.
      PERFORM get_data.
      if_selfield-refresh = 'X'.
      EXIT.

    WHEN OTHERS.

  ENDCASE.

ENDFORM.                    " CREATE_Z2_MELDUNG
*&---------------------------------------------------------------------*
*&      Form  MODIFY_Z2_MELDUNG
*&---------------------------------------------------------------------*
FORM modify_z2_meldung USING if_qmnum
                             if_selfield TYPE slis_selfield.
  DATA: lwa_qmel  LIKE qmel,
        lwa_jest  LIKE jest,
        lwa_tj02t LIKE tj02t.

  SET PARAMETER ID 'IQM' FIELD if_qmnum.

  CALL FUNCTION 'RS_HDSYS_CALL_TC_VARIANT'
    EXPORTING
      tcode                     = 'IW52'
      variant                   = 'ZW52_Z2'
      i_flag_client_independent = c_true
      call_mode                 = c_true
      i_flag_skip_first_screen  = c_true
    EXCEPTIONS
      no_variant                = 1
      no_authority_tcode        = 2
      OTHERS                    = 3.

  WAIT UP TO 1 SECONDS.

  CLEAR lwa_qmel.
  SELECT SINGLE * FROM qmel INTO lwa_qmel
  WHERE qmnum = if_qmnum.

  IF NOT lwa_qmel-kzloesch IS INITIAL.
* Service notif. deleted
    PERFORM delete_z2_data USING if_qmnum.
    PERFORM get_data.
    if_selfield-refresh = 'X'.
    EXIT.
  ENDIF.

  CLEAR lwa_tj02t.
  SELECT SINGLE * FROM tj02t INTO lwa_tj02t WHERE txt04 = 'LÖVM'.

  CLEAR lwa_jest.
  SELECT SINGLE * FROM jest INTO lwa_jest
  WHERE objnr = lwa_qmel-objnr AND
        stat = lwa_tj02t-istat AND
        inact = ' '.

  IF sy-subrc EQ 0.
* Service notif. deleted
    PERFORM delete_z2_data USING if_qmnum.
    PERFORM get_data.
    if_selfield-refresh = 'X'.
  ELSEIF sy-subrc NE 0.
* Service notif. changed
    PERFORM update_z2_data USING if_qmnum.
    PERFORM get_data.
    if_selfield-refresh = 'X'.
  ENDIF.


ENDFORM.                    " MODIFY_Z2_MELDUNG
