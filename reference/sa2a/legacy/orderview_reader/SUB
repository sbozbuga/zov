*&      Define BUILD_RANGE
*&---------------------------------------------------------------------*
DEFINE build_range.
  CLEAR &2. REFRESH &2[].

  gv_index_from = ( sy-index - 1 ) * c_max_lines_range + 1.
  gv_index_to = sy-index * c_max_lines_range.

  APPEND LINES OF &1[] FROM gv_index_from TO gv_index_to
  TO &2[].

  IF &2[] IS INITIAL.
    EXIT.
  ENDIF.
END-OF-DEFINITION.

*&---------------------------------------------------------------------*
*&      Define BUILD_TABLE
*&---------------------------------------------------------------------*
DEFINE build_table.
  CLEAR: gv_index_from,
         gv_index_to.

  CLEAR &2. REFRESH &2[].

  gv_index_from = ( sy-index - 1 ) * c_max_lines_table + 1.
  gv_index_to = sy-index * c_max_lines_table.

  APPEND LINES OF &1[] FROM gv_index_from TO gv_index_to
  TO &2[].

  IF &2[] IS INITIAL.
    EXIT.
  ENDIF.
END-OF-DEFINITION.


