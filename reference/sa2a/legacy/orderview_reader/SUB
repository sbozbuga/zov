    "auch ohne FANUMBER möglich  HB021123; Kommentare auch bei Z1
*    IF gt_ord_full-fanumber IS NOT INITIAL.
*      MOVE-CORRESPONDING gt_ord_full TO gs_ord_viele.
*      APPEND gs_ord_viele TO gt_ord_viele[].
    lv_selected = lv_selected + 1.
*    ENDIF.
    IF lv_selected GE 2.
      EXIT.
    ENDIF.
** End of Insertation  CAGGERWAS 22.08.2012
  ENDLOOP.
* Start of Insertation  CAGGERWAS 22.08.2012
  IF lv_selected EQ 0.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e01.  "Kein Eintrag wurde selektiert
    EXIT.
  ENDIF.
* wenn mehrere Zeilen markiert wurden auf dem ALV
* Aufruf neuer Fuba mit Übergabe der internen Tabelle gt_ord_viele[]
*  IF lv_viele GT 1.
*
*    CALL FUNCTION '/CELLAG/SAVE_COMMENT'
*      TABLES
*        et_ord_viele = gt_ord_viele.
** outtab aktualisieren
*    EXIT.
*  ENDIF.
* End of Insertation  CAGGERWAS 22.08.2012


  CLEAR gt_ord_full.
  READ TABLE gt_ord_full INDEX if_selfield-tabindex.
  IF sy-subrc NE 0.
* Error message
    MESSAGE i000(/cellag/messages_sd) WITH TEXT-e01.  "Kein Eintrag wurde selektiert
    EXIT.
  ENDIF.

  "--------------------------------------------------------------
  " Prüfen der Datenlase
  " - ORD_ADD existiert?
  " - Fertigungsauftrag vorhanden?
  "--------------------------------------------------------------
  CLEAR: gt_ord_add.

  IF gt_ord_full-fanumber IS INITIAL.
    lv_fa_exist = abap_false.  "Fertigungsauftrag ist vorhanden
  ELSE.
    lv_fa_exist = abap_true.
  ENDIF.

  READ TABLE gt_ord_add WITH KEY qmnum = gt_ord_full-qmnum
                                 fenum = gt_ord_full-fenum
                                 counter = gt_ord_full-counter
  BINARY SEARCH.
  IF sy-subrc <> 0.
    lv_ordadd_exist = abap_false.
  ELSE.
    lv_ordadd_exist = abap_true.
  ENDIF.

  "Entscheidung über Abfrage Customizing-Tabelle oder Popup
  CALL METHOD zcl_orderview=>decide_main_or_z2
    EXPORTING
      iv_vbeln  = gt_ord_full-vbeln
      iv_posnr  = gt_ord_full-posnr
      iv_otgrp  = gt_ord_full-otgrp
      iv_werks  = gt_ord_full-werks
    RECEIVING
      rs_answer = lv_answer.

  IF lv_answer = 'C'.  "Cancel
    EXIT.  "Abbruch raus
  ENDIF.



  IF lv_answer = '2'.

    "--------------------------------------------------------------
    " Anlegen/Ändern zu Z2
    "--------------------------------------------------------------
*    IF lv_ordadd_exist = abap_false.
    "der ORD_ADD Eintrag existiert bereits  (auf der Hauptmeldung wurde Kommentar angelegt)

* Can we create a service notice?
    IF lv_fa_exist = abap_false.
* Error message-->Service notice cannot be created
      MESSAGE i000(/cellag/messages_sd) WITH TEXT-e04.  "Es wurde kein Fertigungsauftrag gefunden
      EXIT.
    ENDIF.

    CLEAR lv_obknr.
    SELECT SINGLE obknr FROM afih INTO lv_obknr
    WHERE aufnr = gt_ord_full-fanumber.
    CHECK NOT lv_obknr IS INITIAL.

    CLEAR gt_objk. REFRESH gt_objk.
    SELECT * FROM objk INTO TABLE gt_objk WHERE obknr = lv_obknr AND
                                                objvw = 'A'.

    CLEAR lv_lines.
    DESCRIBE TABLE gt_objk LINES lv_lines.
    IF lv_lines IS INITIAL.
* Error
      MESSAGE i000(/cellag/messages_sd) WITH TEXT-e08.  "Der CS-Auftrag hat keine Objkektliste
      EXIT.
    ENDIF.

    CLEAR lt_qmnum. REFRESH lt_qmnum.
    CLEAR gt_objk.
    LOOP AT gt_objk.
      IF NOT gt_objk-ihnum IS INITIAL.
        lt_qmnum-qmnum = gt_objk-ihnum.
        COLLECT lt_qmnum.
        CLEAR lt_qmnum.
      ENDIF.
    ENDLOOP.

    SORT lt_qmnum.
    CLEAR lt_qmel. REFRESH lt_qmel.
    IF NOT lt_qmnum[] IS INITIAL.
      SELECT qmnum serialnr FROM qmel INTO TABLE lt_qmel
      FOR ALL ENTRIES IN lt_qmnum
      WHERE qmnum = lt_qmnum-qmnum.
    ENDIF.

    SORT lt_qmel.

    CLEAR gt_objk.
    LOOP AT gt_objk.
      IF NOT gt_objk-ihnum IS INITIAL.
        CLEAR lt_qmel.
        READ TABLE lt_qmel WITH KEY qmnum = gt_objk-ihnum
        BINARY SEARCH.
        gt_objk-equnr = gt_objk-sernr = lt_qmel-serialnr.
        MODIFY gt_objk.
      ENDIF.
    ENDLOOP.

    CLEAR lv_equnr.
    IF NOT gt_ord_full-sernraufnr IS INITIAL.
      lv_equnr = gt_ord_full-sernraufnr.
    ELSE.
      lv_equnr = gt_ord_full-equipmentnummer.
    ENDIF.

    CLEAR lwa_objk.
    READ TABLE gt_objk INTO lwa_objk WITH KEY obknr = lv_obknr
                                              equnr = lv_equnr.
    IF sy-subrc EQ 0.
      IF lwa_objk-ihnum IS INITIAL.
        CLEAR lv_qmnum.
        SELECT SINGLE qmnum FROM qmel INTO lv_qmnum
        WHERE qmart = 'Z2' AND
              aufnr = gt_ord_full-fanumber AND
              matnr = lwa_objk-matnr AND
              serialnr = lwa_objk-equnr.
        IF sy-subrc EQ 0.
          PERFORM modify_z2_meldung USING lv_qmnum
                                          if_selfield.

        ELSEIF sy-subrc NE 0.
          PERFORM create_z2_meldung USING lwa_objk
                                          if_selfield.
        ENDIF.
      ELSE.
        PERFORM modify_z2_meldung USING lwa_objk-ihnum
                                        if_selfield.
      ENDIF.

    ELSEIF sy-subrc NE 0.
      CLEAR lt_ordview_equnr. REFRESH lt_ordview_equnr.
      SELECT equipmentnummer FROM /cellag/ordview INTO TABLE lt_ordview_equnr
      WHERE qmnum = gt_ord_full-qmnum AND
            fenum = gt_ord_full-fenum.
      SORT lt_ordview_equnr.

      CLEAR lt_objk_equnr. REFRESH lt_objk_equnr.
      lt_objk_equnr[] = gt_objk[].

      SORT lt_objk_equnr BY equnr.

      CLEAR lt_ordview_equnr.
      LOOP AT lt_ordview_equnr.
        CLEAR lt_objk_equnr.
        READ TABLE lt_objk_equnr WITH KEY equnr = lt_ordview_equnr-equnr
        BINARY SEARCH.
        IF sy-subrc EQ 0.
          lv_index_objk = sy-tabix.
          DELETE lt_ordview_equnr.
          DELETE lt_objk_equnr INDEX lv_index_objk.
        ENDIF.
      ENDLOOP.

      CLEAR lv_lines.
      DESCRIBE TABLE lt_objk_equnr LINES lv_lines.

      IF lv_lines EQ 1.
        CLEAR lwa_objk.
        READ TABLE lt_objk_equnr INTO lwa_objk.

        IF lwa_objk-ihnum IS INITIAL.
          CLEAR lv_qmnum.
          SELECT SINGLE qmnum FROM qmel INTO lv_qmnum
          WHERE qmart = 'Z2' AND
                aufnr = gt_ord_full-fanumber AND
                matnr = lwa_objk-matnr AND
                serialnr = lwa_objk-equnr.
          IF sy-subrc EQ 0.
            PERFORM modify_z2_meldung USING lv_qmnum
                                            if_selfield.
          ELSEIF sy-subrc NE 0.
            PERFORM create_z2_meldung USING lwa_objk
                                            if_selfield.
          ENDIF.
        ELSE.
          PERFORM modify_z2_meldung USING lwa_objk-ihnum
                                          if_selfield.
        ENDIF.

      ELSE.
* Error message  im CS-Auftrag nicht vorhanden
        MESSAGE i000(/cellag/messages_sd) WITH TEXT-e09 lv_equnr TEXT-e10.
      ENDIF.
    ENDIF.

*    ELSEIF sy-subrc EQ 0.
*      "--------------------------------------------------------------
*      " Kommentar bereits hinterlegt
*      "--------------------------------------------------------------
*
*      CHECK NOT gt_ord_add-qmnum_z2 IS INITIAL.
*      PERFORM modify_z2_meldung USING gt_ord_add-qmnum_z2
*                                      if_selfield.
*  ENDIF.  "IF lv_ordadd_exist = abap_false.
  ENDIF.  "Z2 ausgewählt

  IF lv_answer = '1'.
    MOVE-CORRESPONDING gt_ord_full TO ls_ord_full.
    PERFORM change_comment_z1 USING    lv_ordadd_exist
                              CHANGING if_selfield
                                       ls_ord_full.
  ENDIF.
ENDFORM.                    " FCODE_CHANGE_DATA
