*&---------------------------------------------------------------------*
*&      Form  GET_QMNUMP_DATA_NEW
*&---------------------------------------------------------------------*
*       Sortierung bei Eingabe beibehalten, doppelte aber entfernen
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_qmnump_data_new .

  TYPES:
    BEGIN OF tys_meldpos,
      sortf TYPE i,
      qmnum TYPE qmnum,
      fenum TYPE fenum,
    END OF tys_meldpos,
    tyt_meldpos TYPE STANDARD TABLE OF tys_meldpos.

  DATA:
    lv_leng    TYPE i,
    lv_pos     TYPE i,
    lv_sortf   TYPE i,
    lv_qmnum   TYPE qmfe-qmnum,
    lv_fenum   TYPE qmfe-fenum,
    lt_meldpos TYPE tyt_meldpos,
    ls_meldpos TYPE tys_meldpos.

  FIELD-SYMBOLS:
    <ls_meldpos>  TYPE tys_meldpos.

  CLEAR: gt_ordview[], lv_sortf.

  LOOP AT s_qmnump.   "mit Kopfzeile
    ADD 1 TO lv_sortf. "ursprüngliche Sortierung
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
      EXPORTING
        input  = s_qmnump-low
      IMPORTING
        output = s_qmnump-low.
    lv_leng  = strlen( s_qmnump-low ).
    lv_pos   = lv_leng - 4.
    IF lv_pos > 4.
      lv_qmnum = s_qmnump-low(lv_pos).
      lv_fenum = s_qmnump-low+lv_pos(4).
    ENDIF.

    ls_meldpos-sortf = lv_sortf.
    ls_meldpos-qmnum = lv_qmnum.
    ls_meldpos-fenum = lv_fenum.
    APPEND ls_meldpos TO lt_meldpos.
  ENDLOOP.

  "Doppelte entfernen
  SORT lt_meldpos BY qmnum fenum.
  DELETE ADJACENT DUPLICATES FROM lt_meldpos  COMPARING qmnum fenum.
  "Ursprüngliche Sortierung
  SORT lt_meldpos BY sortf.

  LOOP AT lt_meldpos ASSIGNING  <ls_meldpos>.
    SELECT *
      FROM (gv_tabname) APPENDING TABLE gt_ordview
      WHERE qmnum = <ls_meldpos>-qmnum
        AND fenum = <ls_meldpos>-fenum.
    IF gv_auth_arch = abap_true.                            "HB071021
      SELECT *
        FROM zordview_archiv APPENDING TABLE gt_ordview
        WHERE qmnum = <ls_meldpos>-qmnum
          AND fenum = <ls_meldpos>-fenum.
    ENDIF.
  ENDLOOP.

ENDFORM.                    " GET_QMNUMP_DATA_NEW
*&---------------------------------------------------------------------*
*&      Form  GET_ADD_DATA
*&---------------------------------------------------------------------*
*       ADD-Data und Lieferantendaten lesen und Gesamttabelle aufbauen
*&---------------------------------------------------------------------*
FORM get_add_data .

  TYPES:
    BEGIN OF tys_lfa1,
      lifnr TYPE lifnr,
      name1 TYPE name1,
    END OF tys_lfa1,
    tyt_lfa1      TYPE HASHED TABLE OF tys_lfa1 WITH UNIQUE KEY lifnr,

    tyt_ord_add   TYPE STANDARD TABLE OF /cellag/ord_add,
    tyt_ord_add_h TYPE HASHED TABLE OF /cellag/ord_add WITH UNIQUE KEY qmnum fenum.

  DATA:
    lt_ordview   TYPE STANDARD TABLE OF /cellag/ordview,
    lt_lfa1      TYPE tyt_lfa1,
    lt_ord_add   TYPE tyt_ord_add,
    lt_ord_add_h TYPE tyt_ord_add_h,                        "HB20240410
    lv_cnt       TYPE felfd.


  FIELD-SYMBOLS:
    <ls_ordview>  TYPE /cellag/ordview,
    <ls_ord_add>  TYPE /cellag/ord_add,
    <ls_ord_full> LIKE LINE OF gt_ord_full,
    <ls_lfa1>     TYPE tys_lfa1.


  CHECK NOT gt_ordview[] IS INITIAL.

  "Lieferantendaten lesen
  lt_ordview[] = gt_ordview[].

  SELECT *                                                  "HB030416
    FROM /cellag/ord_add
    INTO TABLE gt_ord_add
    FOR ALL ENTRIES IN lt_ordview
    WHERE qmnum = lt_ordview-qmnum.

  IF gv_auth_arch  = abap_true.                             "HB071021
    SELECT *
      FROM zord_add_archiv APPENDING TABLE gt_ord_add
        FOR ALL ENTRIES IN lt_ordview
        WHERE qmnum = lt_ordview-qmnum.

    SORT gt_ord_add BY qmnum fenum counter.
    DELETE ADJACENT DUPLICATES FROM gt_ord_add COMPARING qmnum fenum.

  ENDIF.


  SORT lt_ordview BY hersteller.
  DELETE ADJACENT DUPLICATES FROM lt_ordview COMPARING hersteller.

  SELECT lifnr
         name1
    FROM lfa1
    INTO TABLE lt_lfa1
    FOR ALL ENTRIES IN lt_ordview
    WHERE lifnr = lt_ordview-hersteller.

  SELECT *
    FROM /cellag/ord_add
    INTO TABLE lt_ord_add
    FOR ALL ENTRIES IN gt_ordview
    WHERE qmnum = gt_ordview-qmnum
      AND fenum = gt_ordview-fenum.

  IF gv_auth_arch = abap_true.                              "HB071021
    SELECT *
      FROM zord_add_archiv APPENDING TABLE lt_ord_add
      FOR ALL ENTRIES IN gt_ordview
      WHERE qmnum = gt_ordview-qmnum
        AND fenum = gt_ordview-fenum.
  ENDIF.

  SORT lt_ord_add BY qmnum fenum counter.                   "HB20240410
  DELETE ADJACENT DUPLICATES FROM lt_ord_add COMPARING qmnum fenum.
  lt_ord_add_h[] = lt_ord_add[].

  "Mischen
  LOOP AT gt_ordview ASSIGNING <ls_ordview>.

    INSERT INITIAL LINE INTO TABLE gt_ord_full ASSIGNING <ls_ord_full>.
    MOVE-CORRESPONDING <ls_ordview> TO <ls_ord_full>.

    "Gesamtnr mit Counter: zuerst in NUMC konvertieren
    lv_cnt = <ls_ord_full>-counter.
    CONCATENATE <ls_ord_full>-meldpos lv_cnt INTO <ls_ord_full>-qmnumposcnt.

    IF <ls_ordview>-hersteller IS NOT INITIAL.
      READ TABLE lt_lfa1 ASSIGNING <ls_lfa1> WITH TABLE KEY lifnr = <ls_ordview>-hersteller.
      IF sy-subrc = 0.
        <ls_ord_full>-herstellername = <ls_lfa1>-name1.
      ENDIF.
    ENDIF.

    READ TABLE lt_ord_add_h ASSIGNING <ls_ord_add> WITH TABLE KEY qmnum = <ls_ordview>-qmnum
                                                                  fenum = <ls_ordview>-fenum.
    IF sy-subrc = 0.
      MOVE-CORRESPONDING <ls_ord_add> TO  <ls_ord_full>.
    ENDIF.
  ENDLOOP.


ENDFORM.                    " GET_ADD_DATA
