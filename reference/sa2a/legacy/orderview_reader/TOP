DATA: BEGIN OF gt_ordview_qmnump OCCURS 0.
DATA: qmnump TYPE char16.
      INCLUDE STRUCTURE gt_ordview.
      DATA: END OF gt_ordview_qmnump.

DATA: BEGIN OF gt_key OCCURS 0,
        qmnum   LIKE /cellag/ordview-qmnum,
        fenum   LIKE /cellag/ordview-fenum,
