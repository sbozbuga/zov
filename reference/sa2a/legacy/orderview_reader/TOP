* Rückmeldunq
DATA: BEGIN OF gt_qmfe OCCURS 0,
        qmnum    LIKE qmel-qmnum,
        aufnr    LIKE qmel-aufnr,
        matnr    LIKE qmel-matnr,
        qmcod    LIKE qmel-qmcod,
        serialnr LIKE qmel-serialnr,
        fenum    LIKE qmfe-fenum,
        erdat    LIKE qmfe-erdat,
        fetxt    LIKE qmfe-fetxt,
        fegrp    LIKE qmfe-fegrp,
        fecod    LIKE qmfe-fecod,
        otgrp    LIKE qmfe-otgrp,
        oteil    LIKE qmfe-oteil,
        kzloesch LIKE qmfe-kzloesch,
        besz     LIKE qmfe-besz,
      END OF gt_qmfe.

* Qualitaetsmeldung - Aktionen
DATA: BEGIN OF gt_qmma_aux OCCURS 0,
        qmnum  LIKE qmma-qmnum,
        manum  LIKE qmma-manum,
        fenum  LIKE qmma-fenum,
        mngrp  LIKE qmma-mngrp,
        mncod  LIKE qmma-mncod,
        matxt  LIKE qmma-matxt,
        ernam  LIKE qmma-ernam,
        erdat  LIKE qmma-erdat,
        aenam  LIKE qmma-aenam,
        aedat  LIKE qmma-aedat,
        peter  LIKE qmma-peter,
        indtx  LIKE qmma-indtx,
        kzmla  TYPE kzmla,    "HB291123 Sprache Text
        erzeit LIKE qmma-erzeit,
        aezeit LIKE qmma-aezeit,
        qmanum LIKE qmma-qmanum,
      END OF gt_qmma_aux.

DATA: BEGIN OF gt_qmma OCCURS 0.
        INCLUDE STRUCTURE gt_qmma_aux.
        DATA: line(255).
DATA: END OF gt_qmma.

* Qualitaetsmeldung - Ursachen
DATA: BEGIN OF gt_qmur OCCURS 0,
        qmnum LIKE qmur-qmnum,
        erdat LIKE qmur-erdat,
        urgrp LIKE qmur-urgrp,
        urcod LIKE qmur-urcod,
      END OF gt_qmur.

* Lieferantenstamm
DATA: BEGIN OF gt_lfa1 OCCURS 0,
        lifnr LIKE lfa1-lifnr,
        name1 LIKE lfa1-name1,
      END OF gt_lfa1.

